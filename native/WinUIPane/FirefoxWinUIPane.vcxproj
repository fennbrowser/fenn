    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- Framework-dependent on Microsoft.WindowsAppRuntime.2: hosts put the
         framework in their package graph (MSIX dependency, or the bootstrapper
         when unpackaged) before loading this DLL. It must not initialize WinUI
         under loader lock. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
