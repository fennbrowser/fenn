    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Pane.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inputs for the incremental check below: cargo does its own dependency
         tracking, but MSBuild needs to know when to call it at all. -->
    <ShellCoreSource Include="$(ShellCoreDir)Cargo.toml" />
    <ShellCoreSource Include="$(ShellCoreDir)src\**\*.rs" />
  </ItemGroup>
  <Target Name="BuildShellCore" BeforeTargets="ClCompile" Inputs="@(ShellCoreSource)" Outputs="$(ShellCoreLib)">
    <Error Condition="'$(ShellCoreTriple)'==''" Text="No Rust target triple for Platform=$(Platform)." />
    <Message Importance="high" Text="Building the Rust shell core ($(ShellCoreTriple), $(ShellCoreProfile))" />
    <!-- +crt-static so the staticlib uses the same CRT as this project's /MT
         objects. CARGO_TARGET_DIR keeps Rust output under build/ with every
         other build artifact, not inside the source tree. -->
    <Exec Command="&quot;$(CargoExe)&quot; build --offline --locked $(ShellCoreCargoProfile) --target $(ShellCoreTriple)"
          WorkingDirectory="$(ShellCoreDir)"
          EnvironmentVariables="CARGO_TARGET_DIR=$(ShellCoreTargetDir);RUSTFLAGS=-C target-feature=+crt-static" />
    <Error Condition="!Exists('$(ShellCoreLib)')" Text="cargo did not produce $(ShellCoreLib)." />
  </Target>
