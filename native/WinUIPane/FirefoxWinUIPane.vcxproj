  <!-- The project-owned Rust shell core (native/ShellCore) links in as a static
       library. Its C boundary is the checked-in, cbindgen-generated
       bridge/v2/shell_core.h, so an ordinary build never needs cbindgen. -->
  <PropertyGroup Label="ShellCore">
    <ShellCoreDir>$(MSBuildThisFileDirectory)..\ShellCore\</ShellCoreDir>
    <ShellCoreTargetDir>$(MSBuildThisFileDirectory)..\..\build\shell-core\</ShellCoreTargetDir>
    <ShellCoreProfile Condition="'$(Configuration)'=='Release'">release</ShellCoreProfile>
    <ShellCoreProfile Condition="'$(Configuration)'!='Release'">debug</ShellCoreProfile>
    <ShellCoreCargoProfile Condition="'$(Configuration)'=='Release'">--release</ShellCoreCargoProfile>
    <ShellCoreTriple Condition="'$(Platform)'=='x64'">x86_64-pc-windows-msvc</ShellCoreTriple>
    <ShellCoreTriple Condition="'$(Platform)'=='Win32'">i686-pc-windows-msvc</ShellCoreTriple>
    <ShellCoreTriple Condition="'$(Platform)'=='ARM64'">aarch64-pc-windows-msvc</ShellCoreTriple>
    <ShellCoreLib>$(ShellCoreTargetDir)$(ShellCoreTriple)\$(ShellCoreProfile)\firefox_winui_shell_core.lib</ShellCoreLib>
    <CargoExe Condition="'$(CargoExe)'==''">cargo</CargoExe>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <!-- The native static libraries rustc reports for this crate on
           x86_64-pc-windows-msvc. The crate is built with +crt-static, so it
           requests libcmt, matching this project's /MT RuntimeLibrary in every
           configuration: one CRT, not two. -->
      <AdditionalDependencies>gdi32.lib;Ole32.lib;$(ShellCoreLib);ntdll.lib;userenv.lib;ws2_32.lib;dbghelp.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Firefox loads this DLL with LOAD_LIBRARY_SEARCH_* flags, which skip a
           packaged process's dependency graph. Delay-loading the only static
           Windows App SDK import resolves it on first use through the standard
           search: the framework package when packaged, the app-local runtime
           otherwise. -->
      <DelayLoadDLLs>Microsoft.UI.Windowing.Core.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\bridge\v2;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(WinUIPaneTesting)'=='true'">WINUI_PANE_TESTING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PreprocessorDefinitions>DISABLE_XAML_GENERATED_MAIN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard Condition="'$(VisualStudioVersion)' &gt;= '18.0'">stdcpp20</LanguageStandard>
      <LanguageStandard Condition="'$(VisualStudioVersion)' &lt; '18.0'">stdcpp17</LanguageStandard>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
