+add_task(function test_shared_query_construction() {
+  const { UrlbarQueryModel } = ChromeUtils.importESModule(
+    "chrome://browser/content/urlbar/UrlbarQueryModel.mjs"
+  );
+  const prefs = {
+    "browser.urlbar.maxRichResults": 11,
+    "browser.urlbar.smartbar.maxResults": 6,
+    "browser.urlbar.maxCharsForSearchSuggestions": 8,
+    "browser.urlbar.unifiedSearchButton.historyInSearchMode": false,
+  };
+  for (const [name, value] of Object.entries(prefs)) {
+    if (typeof value == "boolean") Services.prefs.setBoolPref(name, value);
+    else Services.prefs.setIntPref(name, value);
+  }
+  try {
+    const state = {isPrivate: false, sapName: "urlbar",
+      browser: {userContextId: 4, tabGroup: "group", currentPage: "https://example.com/"}};
+    const create = (extra = {}, request = {}) => UrlbarQueryModel.create(
+      {...state, ...extra}, {searchString: "query", ...request}
+    );
+    const ordinary = create();
+    Assert.ok(ordinary instanceof UrlbarQueryContext);
+    Assert.equal(ordinary.maxResults, 11);
+    Assert.equal(ordinary.userContextId, 4);
+    Assert.equal(ordinary.tabGroup, "group");
+    Assert.equal(ordinary.currentPage, "https://example.com/");
+    Assert.equal(ordinary.excludeSponsoredResults, false);
+    Assert.notEqual(ordinary.id, create().id, "Firefox allocates query IDs");
+    const privateQuery = create({isPrivate: true});
+    Assert.equal(privateQuery.userContextId, UrlbarShared.normalizedUserContextId(4, true));
+    const smartbar = create({smartbar: true, sapName: "smartbar", excludeSponsoredResults: true});
+    Assert.equal(smartbar.maxResults, 6);
+    Assert.ok(smartbar.excludeSponsoredResults);
+    Assert.equal(create({smartbar: true, searchMode: {source: UrlbarShared.RESULT_SOURCE.ACTIONS}}).maxResults, 99);
+    const mode = {source: UrlbarShared.RESULT_SOURCE.HISTORY};
+    Assert.deepEqual(create({searchMode: mode}).sources, [mode.source]);
+    Services.prefs.setBoolPref("browser.urlbar.unifiedSearchButton.historyInSearchMode", true);
+    Assert.equal(create({searchMode: mode}).sources, undefined);
+    const pasted = create({}, {isPaste: true, pasteLength: 9});
+    Assert.ok(pasted.prohibitRemoteResults);
+    Assert.equal(pasted.allowRemoteResults(), false);
+    Assert.equal(create({}, {isPaste: true, pasteLength: 8}).prohibitRemoteResults, false);
+    Assert.equal(create({}, {isPaste: false, pasteLength: 99}).prohibitRemoteResults, false);
+    Assert.equal(create({browser: {userContextId: 4, tabGroup: null, currentPage: ""}}).currentPage, undefined);
+    Assert.equal(create({browser: null}).currentPage, undefined);
+    Assert.throws(() => create({}, {searchString: null}), /searchString/, "Firefox still validates queries");
+  } finally {
+    for (const name of Object.keys(prefs)) Services.prefs.clearUserPref(name);
+  }
+});
