+      this.#hadText = true;
+    }
+    return snapshot;
+  }
+
+  /**
+   * Finish a composition. Clear old selection/result state before transitioning,
+   * preserving the editor callback's ordering. The callback is never retained.
+   * Returns true for an empty composition that must reopen without another input.
+   */
+  end(hasData, keepPanelOpen, clearSelection) {
+    if (!this.isComposing) {
+      throw new Error("Trying to stop a non existing composition?");
+    }
+    if (typeof hasData !== "boolean" || typeof keepPanelOpen !== "boolean") {
+      throw new TypeError("Invalid composition end facts");
+    }
+    if (!keepPanelOpen) clearSelection();
+    // Selection clearing can reenter input; read history afterward, as before.
+    const policy = UrlbarCompositionModel.endPolicy({ hasData, keepPanelOpen,
+      hadText: this.#hadText, closedPopup: this.#closedPopup });
+    this.#state = policy.nextInput.state;
+    this.#closedPopup = policy.nextInput.closedPopup;
+    return policy.reopen;
+  }
+
+  /** Inspect owned event history without ending composition or consuming input. */
+  describeEnd(hasData, keepPanelOpen) {
+    if (!this.isComposing) throw new Error("Trying to stop a non existing composition?");
+    return UrlbarCompositionModel.endPolicy({ hasData, keepPanelOpen,
+      hadText: this.#hadText, closedPopup: this.#closedPopup });
+  }
+
+  /** End-event effects; nextInput is consumed by the following input, not here. */
+  static endPolicy({ hasData, hadText, closedPopup, keepPanelOpen }) {
+    if ([hasData, hadText, closedPopup, keepPanelOpen].some(fact => typeof fact !== "boolean")) {
+      throw new TypeError("Invalid composition end facts");
+    }
+    const reopen = !hasData && !hadText && closedPopup && !keepPanelOpen;
+    return Object.freeze({ clearSelection: !keepPanelOpen, clearResultForCurrentValue: !keepPanelOpen,
+      reopen, resetSearchState: false,
+      nextInput: Object.freeze({ state: reopen ? UrlbarShared.COMPOSITION.NONE :
+        (hasData ? UrlbarShared.COMPOSITION.COMMIT : UrlbarShared.COMPOSITION.CANCELED),
+      closedPopup: reopen ? false : closedPopup }) });
+  }
+
+  /** Describe composition-start effects without reading or mutating a presenter. */
+  static startPolicy({ keepPanelOpen, viewIsOpen, hasSearchMode, value }) {
+    if ([keepPanelOpen, viewIsOpen, hasSearchMode].some(fact => typeof fact !== "boolean") ||
+        typeof value !== "string") throw new TypeError("Invalid composition start facts");
+    const closePopup = !keepPanelOpen && viewIsOpen;
+    const confirmSearchMode = closePopup && hasSearchMode;
+    return Object.freeze({ closePopup, confirmSearchMode,
+      clearUserTypedValue: confirmSearchMode && !value });
+  }
+
+  static allowsQuery(snapshot, keepPanelOpen) {
+    return keepPanelOpen ||
+      (snapshot.state != UrlbarShared.COMPOSITION.COMPOSING &&
+        (snapshot.state != UrlbarShared.COMPOSITION.CANCELED || snapshot.closedPopup));
+  }
+
+  static allowsAutofill(snapshot, keepPanelOpen) {
+    return !keepPanelOpen || snapshot.state != UrlbarShared.COMPOSITION.COMPOSING;
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarAutofillModel.mjs b/browser/components/urlbar/content/UrlbarAutofillModel.mjs
new file mode 100644
index 0000000000..ed9a06b8c0
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarAutofillModel.mjs
@@ -0,0 +1,84 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/** Shared autofill decisions over editor facts; never retains an editor. */
+export class UrlbarAutofillModel {
+  /** Input intent shared by editor bindings; composition is checked separately. */
+  static allowsInput(inputType, isPaste) {
+    return !inputType?.startsWith("delete") &&
+      !inputType?.startsWith("history") && !isPaste;
+  }
+
+  /** Explicit deselection confirms only the currently displayed placeholder. */
+  static confirmsSelection({ placeholder, value, selectionStart, selectionEnd }) {
+    return !!(placeholder && placeholder.value === value &&
+      (placeholder.selectionStart !== selectionStart || placeholder.selectionEnd !== selectionEnd));
+  }
+
+  /** Whether a first result may replace the current selection. */
+  static acceptsResult({
+    placeholder, searchString, selectionStart, selectionEnd,
+    ignoresSelection = false, handlingMentions = false,
+  }) {
+    if (handlingMentions) {
+      return false;
+    }
+    const placeholderSelected =
+      placeholder &&
+      selectionEnd == placeholder.value.length &&
+      selectionStart == searchString.length &&
+      placeholder.value.toLocaleLowerCase().startsWith(searchString.toLocaleLowerCase());
+    return !!(placeholderSelected || ignoresSelection ||
+      (selectionStart == selectionEnd && selectionEnd == searchString.length));
+  }
+
+  /**
+   * Plan speculative completion before providers return. The caller applies
+   * clear/discard/edit operations through its own editor and undo machinery.
+   * A valid but unapplied placeholder stays available for the next query.
+   */
+  static planPlaceholder({
+    searchString, value, selectionStart, selectionEnd, searchMode, placeholder,
+    enabled, handlingMentions = false, suppressRedundantEdit = false,
+  }) {
+    if (selectionEnd != searchString.length || searchMode?.engineName ||
+        searchMode?.source == UrlbarShared.RESULT_SOURCE.SEARCH || handlingMentions) {
+      return { allowAutofill: false, operation: "clear" };
+    }
+    let matches = false;
+    if (placeholder) {
+      if (placeholder.type == "adaptive_url" || placeholder.type == "adaptive_origin") {
+        matches = searchString.length >= placeholder.adaptiveHistoryInput.length &&
+          placeholder.value.toLocaleLowerCase().startsWith(searchString.toLocaleLowerCase());
+      } else {
+        matches = UrlbarShared.canAutofillURL(placeholder.value, searchString);
+      }
+    }
+    if (!matches) {
+      return { allowAutofill: true, operation: "discard" };
+    }
+    if (selectionEnd != value.length || !enabled) {
+      return { allowAutofill: true, operation: "retain" };
+    }
+    const autofillValue = searchString + placeholder.value.substring(searchString.length);
+    if (suppressRedundantEdit && value === autofillValue &&
+        selectionStart === searchString.length && selectionEnd === autofillValue.length) {
+      return { allowAutofill: true, operation: "retain" };
+    }
+    return {
+      allowAutofill: true,
+      operation: "apply",
+      autofill: {
+        value: autofillValue,
+        selectionStart: searchString.length,
+        selectionEnd: autofillValue.length,
+        type: placeholder.type,
+        adaptiveHistoryInput: placeholder.adaptiveHistoryInput,
+        untrimmedValue: placeholder.untrimmedValue,
+      },
+    };
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarQueryModel.mjs b/browser/components/urlbar/content/UrlbarQueryModel.mjs
new file mode 100644
index 0000000000..d76aa67401
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarQueryModel.mjs
@@ -0,0 +1,282 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+import { UrlbarQueryContext } from "chrome://browser/content/urlbar/UrlbarQueryContext.mjs";
+import { isSchemelessInput, losslessDecodeURL } from "chrome://browser/content/urlbar/UrlbarUrlValue.mjs";
+
+/** Firefox query policy over explicit state, without retaining an input/view. */
+export class UrlbarQueryModel {
+  /** Retained engine-search terms prefer the current-value result's suggestion/query. */
+  static engineSearchTerms(result, lastSearchString) {
+    return (result && (result.payload.suggestion || result.payload.query)) || lastSearchString;
+  }
+
+  /** Preserve retained short-circuiting: result text is read only for typed non-tip, non-heuristic results. */
+  static safeToPickNavigationResult(result, state) {
+    return !!(result && (result.heuristic || !state.valueIsTyped || result.type == UrlbarShared.RESULT_TYPE.TIP ||
+      state.value == state.getResultValue(result)));
+  }
+
+  /** Retained selected-element precedence, including the private-engine exception. */
+  static pickSelectedNavigationResult({ isComposing, hasSelectedElement, hasSearchModeEngine,
+    hasOneOffEngine, selectedPrivateEngineResult, safeToPickResult }) {
+    return !!(!isComposing && hasSelectedElement && !hasSearchModeEngine &&
+      (!hasOneOffEngine || selectedPrivateEngineResult) && safeToPickResult);
+  }
+
+  /** Called only when there is no selected result and the displayed value starts with @. */
+  static pickTokenAliasResult(result) {
+    return !!(result?.autofill && result?.payload.keyword);
+  }
+
+  /** Query start stops before reset/confirmation when suppressed, after them in overflow. */
+  static startQueryDisposition({ suppressStartQuery = false, inOverflowPanel = false } = {}) {
+    return suppressStartQuery ? "suppressed" : inOverflowPanel ? "overflow" : "dispatch";
+  }
+
+  /** Final row/popup policy; one-off visibility may resolve asynchronously. */
+  static finishedQueryPresentation({ updatedResults, searchMode, oneOffsWillHide = null, open = false }) {
+    const rows = updatedResults ? "remove-stale" : "clear";
+    let action = "keep";
+    if (!updatedResults) {
+      if (!searchMode) action = "close";
+      else if (oneOffsWillHide === null) action = "resolve-one-offs";
+      else if (!oneOffsWillHide) action = "open-one-offs";
+      else if (open) action = "close";
+    }
+    return Object.freeze({ rows, action });
+  }
+
+  /** Firefox's aggregate zero-prefix counter is tied to successful query completion. */
+  static finishedQueryRecording({ cancelled, searchString }) {
+    return !cancelled && !searchString ? "exposure" : null;
+  }
+
+  /** Measurement policy for a surface that was actually open before closing. */
+  static closeRecording({ open, focused, elementPicked, zeroPrefix }) {
+    return Object.freeze({ discardEngagement: !!(open && !focused && !elementPicked),
+      zeroPrefix: open && zeroPrefix ? (elementPicked ? "engagement" : "abandonment") : null });
+  }
+
+  /** Input popup policy; host effects remain separate from composition policy. */
+  static inputPresentation({ value, open, suggestTopSites, searchMode, oneOffsHaveView }) {
+    const clearResults = !open || (!value && !suggestTopSites);
+    const close = open && clearResults && !(searchMode && oneOffsHaveView);
+    return Object.freeze({ rollupPopups: !!open, clearResults, close,
+      removeAccessibleFocus: !close, stopQuery: close });
+  }
+
+  /** Primary user-activation events accepted by independent activation/recording. */
+  static isResultActivationEvent(event) {
+    return !!(((event?.type === "keydown" && event.key === "Enter") ||
+      (["click", "auxclick"].includes(event?.type) && [0, 1].includes(event.button))) &&
+      Number.isFinite(event.timeStamp) && event.timeStamp >= 0);
+  }
+
+  /** Pre-selection adaptive-backspace cleanup, before specialized result actions. */
+  static autofillBackspaceURL(result, isPrivate) {
+    return UrlbarPrefs.get("autoFill.adaptiveHistory.enabled") && result.autofill &&
+      result.payload?.url && !isPrivate ? result.payload.url : null;
+  }
+
+  /** Describe history writes at activation; planning itself performs no persistence. */
+  static resultHistoryEffects(result, loadRequest, { searchString, isPrivate }) {
+    let inputHistory = null, reintegrateURL = null;
+    if (!isPrivate && loadRequest?.urlLoad) {
+      const url = loadRequest.urlLoad.url;
+      let input;
+      if (!result.heuristic) input = searchString;
+      else if (["adaptive_url", "adaptive_origin"].includes(result.autofill?.type)) {
+        input = result.autofill.adaptiveHistoryInput;
+      } else if (UrlbarPrefs.get("autoFill.adaptiveHistory.enabled") &&
+          result.autofill?.type === "origin" && searchString?.length > 0) {
+        // Derived origin roots may not have a Places row until the visit lands.
+        inputHistory = Object.freeze({ url, input: searchString, whenReady: true });
+      }
+      if (input !== undefined) inputHistory = Object.freeze({ url, input, whenReady: false });
+      if (UrlbarPrefs.get("autoFill.adaptiveHistory.enabled") &&
+          (!result.autofill || result.autofill.type === "url") && result.type === UrlbarShared.RESULT_TYPE.URL) {
+        reintegrateURL = url;
+      }
+    }
+    return Object.freeze({ inputHistory, reintegrateURL });
+  }
+
+  /** Pre-load editor/focus/parameter policy. The host applies and acknowledges effects. */
+  static navigationPlan({ loadRequest, where, params, sapName, isPrivate, deferEnterFocus = false }) {
+    const isAddressbar = sapName === "urlbar";
+    const openParams = { ...params, allowThirdPartyFixup: true };
+    if (deferEnterFocus && where === "current") openParams.avoidBrowserFocus = true;
+    let editorValue;
+    if (isAddressbar && where === "current") {
+      if (loadRequest.engineSearch) {
+        editorValue = loadRequest.engineSearch.query;
+      } else {
+        const { url } = loadRequest.urlLoad;
+        try { editorValue = losslessDecodeURL(new URL(url)); }
+        catch { editorValue = url; }
+      }
+    }
+    if (where === "current") {
+      openParams.indicateErrorPageLoad = true;
+      openParams.allowPinnedTabHostChange = isAddressbar;
+      openParams.allowPopups = loadRequest.urlLoad?.url.startsWith("javascript:") ?? false;
+    }
+    if (isPrivate && !("private" in openParams)) openParams.private = true;
+    return { editorValue, openParams,
+      resetSelection: isAddressbar && !openParams.avoidBrowserFocus,
+      revertBeforeLoad: where !== "current" && !UrlbarShared.isSearchbarSAP(sapName) };
+  }
+
+  /** nsILoadInfo schemeful/schemeless values, also usable in content realms. */
+  static schemelessInput(value) {
+    return isSchemelessInput(value) ? 2 : 1;
+  }
+
+  /** URL/keyword adjustments shared with pickResult; never resolves or loads. */
+  static resultLoadPolicy(result, loadRequest, originalUntrimmedValue) {
+    const openParams = {};
+    if (result.type === UrlbarShared.RESULT_TYPE.URL && result.heuristic) {
+      // Keep enterprise DNS-first single-word resolution in docshell, as before.
+      if (UrlbarPrefs.get("browser.fixup.dns_first_for_single_words") &&
+          UrlbarShared.looksLikeSingleWordHost(originalUntrimmedValue)) {
+        loadRequest = { ...loadRequest, urlLoad: { ...loadRequest.urlLoad, url: originalUntrimmedValue } };
+      }
+      openParams.schemelessInput = this.schemelessInput(originalUntrimmedValue);
+    } else if (result.type === UrlbarShared.RESULT_TYPE.KEYWORD) {
+      // Bookmark keywords retain the document principal for bookmarklets.
+      openParams.allowInheritPrincipal = true;
+    }
+    return { loadRequest, openParams };
+  }
+
+  /** Initial result-opening policy; result-specific actions and loads run later. */
+  static resultOpenPolicy({ result, sapName, isPrivate, resultAction = null }, whereToOpen, willLoadInBackground) {
+    const openParams = {
+      allowInheritPrincipal: false,
+      globalHistoryOptions: { triggeringSource: sapName,
+        triggeringSearchEngine: result.payload?.engine,
+        triggeringSponsoredURL: result.payload?.isSponsored ? result.payload.url : undefined },
+      private: isPrivate,
+    };
+    const userContextId = resultAction?.userContextId;
+    const openIn = userContextId ? "container-tab" : resultAction?.openIn;
+    let where;
+    if (openIn) {
+      switch (openIn) {
+        case "tab": where = "tab"; break;
+        case "container-tab":
+          where = "tab";
+          openParams.userContextId = parseInt(userContextId);
+          openParams.eventDetail = { containerSource: "urlbar_result_context_menu" };
+          break;
+        case "window": where = "window"; break;
+        case "private-window": where = "window"; openParams.private = true; break;
+      }
+      openParams.forceForeground = false;
+    } else {
+      where = whereToOpen();
+      if (resultAction?.url && where === "current") where = "tab";
+      openParams.forceForeground = true;
+    }
+    const keepViewOpen = willLoadInBackground(where, openParams);
+    openParams.avoidBrowserFocus = keepViewOpen;
+    return { where, openParams, keepViewOpen };
+  }
+
+  /** Post-search DNS check policy; the parent owns lookup and browser identity. */
+  static searchFixupHost(result, { isAddressbar, searchMode, originalUntrimmedValue }) {
+    return isAddressbar && !searchMode && result.heuristic &&
+      !UrlbarPrefs.get("browser.fixup.dns_first_for_single_words") &&
+      UrlbarPrefs.get("dnsResolveSingleWordsAfterSearch") > 0 &&
+      UrlbarShared.looksLikeSingleWordHost(originalUntrimmedValue)
+      ? originalUntrimmedValue.trim() : null;
+  }
+
+  /** Initial selected-search backend eligibility, before backend/origin policy. */
+  static searchBackendEligible(result, { isAddressbar, isPrivate, engine, defaultEngine }) {
+    return !!(isAddressbar && result.source != UrlbarShared.RESULT_SOURCE.HISTORY &&
+      !result.payload.inPrivateWindow && !isPrivate && engine?.isAppProvided && engine === defaultEngine);
+  }
+
+  /** Search-result override applied after initial opening policy in pickResult. */
+  static searchResultDestination(result, where) {
+    return result.payload.inPrivateWindow ? { where: "window", openParams: { private: true } }
+      : { where, openParams: {} };
+  }
+
+  /** Search recorder payload and destination, shared with the original input. */
+  static searchRecording({ engineId, query, where = "current", searchSource,
+    searchActionDetails = {}, isOneOff, newtabSessionId, opensInPrivateWindow = false }) {
+    return { method: where.startsWith("tab") ? "recordSearchInOpenedTab" : "recordSearch",
+      data: { engineId, searchSource, query, opensInPrivateWindow,
+        details: { ...searchActionDetails, isOneOff, newtabSessionId } } };
+  }
+
+  /** Search attribution from Firefox-owned facts, independent of event targets. */
+  static searchSource({ sapName, isAddressbar, isHandoff = false,
+    switcherItem = false, searchMode = null, isOneOff = false,
+    persistedSearchTerms = false }) {
+    if (!isAddressbar) return sapName;
+    if (isHandoff) return "urlbar_handoff";
+    if (switcherItem || (searchMode && !isOneOff)) return "urlbar_searchmode";
+    if (persistedSearchTerms && !isOneOff) return "urlbar_persisted";
+    return sapName;
+  }
+
+  /** Choose query text from Firefox-owned page-proxy validity and displayed value. */
+  static resolveSearchString({ value, pageProxyValid }, searchString) {
+    if (!searchString) return pageProxyValid ? "" : value;
+    if (!value.startsWith(searchString)) {
+      throw new Error("The current value doesn't start with the search string");
+    }
+    return searchString;
+  }
+
+  /**
+   * State supplies private/SAP identity, searchMode and optional browser facts
+   * {userContextId, tabGroup, currentPage}. Smartbar presentation and sponsored
+   * eligibility are separate facts: a SmartbarInput may serve another SAP.
+   * Request supplies text, autofill eligibility and paste metadata, never an
+   * event or editor. Firefox's QueryContext retains validation and ID ownership.
+   */
+  static create(state, {
+    allowAutofill = true, searchString = null, isPaste = false, pasteLength,
+  } = {}) {
+    const maxResults = state.searchMode?.source == UrlbarShared.RESULT_SOURCE.ACTIONS
+      ? 99
+      : UrlbarPrefs.get(state.smartbar ? "smartbar.maxResults" : "maxRichResults");
+    const options = {
+      allowAutofill,
+      isPrivate: state.isPrivate,
+      sapName: state.sapName,
+      maxResults,
+      searchString,
+      prohibitRemoteResults: !!(isPaste &&
+        UrlbarPrefs.get("maxCharsForSearchSuggestions") < pasteLength),
+    };
+    if (state.excludeSponsoredResults !== undefined) {
+      options.excludeSponsoredResults = state.excludeSponsoredResults;
+    }
+    if (state.browser) {
+      options.userContextId = state.browser.userContextId;
+      options.tabGroup = state.browser.tabGroup;
+      // A tab-drag docshell swap can temporarily have no current URI. Omit it
+      // rather than passing an empty value rejected by QueryContext validation.
+      if (state.browser.currentPage) {
+        options.currentPage = state.browser.currentPage;
+      }
+    }
+    if (state.searchMode) {
+      options.searchMode = state.searchMode;
+      if (state.searchMode.source &&
+          !UrlbarPrefs.get("unifiedSearchButton.historyInSearchMode")) {
+        options.sources = [state.searchMode.source];
+      }
+    }
+    return new UrlbarQueryContext(options);
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarQueryLifecycle.mjs b/browser/components/urlbar/content/UrlbarQueryLifecycle.mjs
new file mode 100644
index 0000000000..1fec37fd9e
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarQueryLifecycle.mjs
@@ -0,0 +1,76 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Query admission and identity shared by controller consumers. It holds no
+ * input, view, DOM events or results. Engine readiness and parent dispatch are
+ * Firefox services; the active editor decides how to defer its own commands.
+ */
+export class UrlbarQueryLifecycle {
+  #queryId = 0;
+  #cancelled = false;
+  #engineStore;
+  #dispatch;
+  #cancel;
+  #arm;
+
+  constructor({ engineStore, dispatch, cancel, arm }) {
+    this.#engineStore = engineStore;
+    this.#dispatch = dispatch;
+    this.#cancel = cancel;
+    this.#arm = arm;
+  }
+
+  start(queryContext) {
+    this.#queryId = queryContext.id;
+    this.#cancelled = false;
+    if (this.#engineStore.initialized || this.#engineStore.failed) {
+      return this.#dispatchQuery(queryContext);
+    }
+    // An editor must defer Enter even while engine initialization holds the
+    // query back. No previous-query teardown runs until dispatch below.
+    this.#arm(queryContext);
+    return this.whenReady().then(() =>
+      this.#queryId == queryContext.id && !this.#cancelled
+        ? this.#dispatchQuery(queryContext)
+        : queryContext
+    );
+  }
+
+  #dispatchQuery(queryContext) {
+    const promise = this.#dispatch(queryContext);
+    // Direct dispatch synchronously cancels the preceding query. Arm after
+    // that teardown, but before a message-path round trip can deliver STARTED.
+    this.#arm(queryContext);
+    return promise;
+  }
+
+  async whenReady() {
+    if (this.#engineStore.initialized || this.#engineStore.failed) {
+      return;
+    }
+    try {
+      await this.#engineStore.init();
+    } catch {
+      // A failed search service must not permanently block navigation.
+    }
+  }
+
+  cancel() {
+    // Cancellation prevents a held query from dispatching. It does not revoke
+    // in-flight results: presenters also cancel to freeze the current list.
+    this.#cancelled = true;
+    return this.#cancel();
+  }
+
+  discard() {
+    // The input is replacing this query (e.g. a search-mode transition).
+    // Its late results and completion must not reach any active presenter.
+    this.#queryId++;
+  }
+
+  acceptsResults(queryContext) {
+    return queryContext.id >= this.#queryId;
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarSearchModeModel.mjs b/browser/components/urlbar/content/UrlbarSearchModeModel.mjs
new file mode 100644
index 0000000000..812e5f9c00
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarSearchModeModel.mjs
@@ -0,0 +1,503 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Shared search-mode policy. Services supply engine/localization data, semantic
+// state and browser commands; no presenter, element or window is retained here.
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+export class UrlbarSearchModeModel {
+  static MAX_OPENSEARCH_ENGINES = 3;
+
+  /** One-off destinations differ from generic link modifier policy. */
+  static oneOffOpenPolicy({ forceNewTab = false, loadInBackground = false,
+    wantsNewTab = false, tabIsEmpty = true, mouseBackground = false }) {
+    const where = forceNewTab || (wantsNewTab && !tabIsEmpty) || mouseBackground ? "tab" : "current";
+    const background = forceNewTab ? loadInBackground : mouseBackground;
+    return Object.freeze({ where, params: background ? Object.freeze({ inBackground: true }) : undefined });
+  }
+
+  static oneOffAllowsAutofill(searchMode) {
+    return !searchMode.engineName && searchMode.source !== UrlbarShared.RESULT_SOURCE.SEARCH;
+  }
+
+  /** Keep immediate engine searches distinct from entering a search mode. */
+  static oneOffCommandKind({ userTypedSearchString, hasEngine, shiftKey, where }) {
