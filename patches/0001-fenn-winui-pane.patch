+    return Promise.resolve();
+  }
+
+  #flushRestart() {
+    const request = this.#restartRequest;
+    this.#restartRequest = null;
+    if (request && !this.#closed && this.#isCurrent()) {
+      this.#onPresentationRequest?.(Object.freeze({ kind: "restart-query", ...request }));
+    }
+  }
+
+  #finish(query) {
+    const state = this.#finishState;
+    if (!state || state.query !== query || state.finished || state.cancelled || this.#frozen ||
+        this.#closed || !this.#isCurrent() || this.#query !== query) return;
+    // Consume before the parent recorder can reenter, throw or repeat FINISHED.
+    state.finished = true;
+    state.description = Object.freeze({ queryId: query.id, updatedResults: state.updatedResults });
+    const recording = UrlbarQueryModel.finishedQueryRecording({
+      cancelled: state.cancelled, searchString: query.searchString });
