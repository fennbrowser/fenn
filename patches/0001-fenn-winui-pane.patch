+    if (engineName) {
+      mode = { engineName, isGeneralPurposeEngine: engine.isGeneralPurposeEngine };
+      if (source) mode.source = source;
+      else if (mode.isGeneralPurposeEngine) mode.source = UrlbarShared.RESULT_SOURCE.SEARCH;
