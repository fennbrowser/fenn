+        value.trim() !== result.payload.autofillKeyword?.trim())) return null;
+    const mode = resolveMode(result);
+    if (!mode) return null;
+    const confirmed = startQuery || nativeAction;
+    return Object.freeze({
+      searchMode: Object.freeze({ ...mode, ...(confirmed ? { isPreview: false } : {}) }),
+      value: result.payload.query?.trimStart() || "",
+      storeTypedValue: !!confirmed,
+      startQuery: !!startQuery,
+    });
+  }
