+  }
+
+  /** Commit browser state only while acknowledged result/engine facts remain live. */
+  commitAcknowledgedModeState(queryId, result, description, options, observation, isCurrent, onCommitted = null) {
+    this.#check();
+    if (!Number.isSafeInteger(this.#context.browserId) || this.#context.browserId <= 0) {
+      throw new Error("Mode state requires a pinned browser");
+    }
+    if (!this.ownsQuery(queryId) || (result !== null && !this.ownsResult(queryId, result))) return null;
+    const requestedSearchMode = result === null ? null :
+      this.describeResultModeTransition(queryId, result, options)?.searchMode;
+    const engineName = description.searchMode?.engineName;
+    const engineId = engineName ? this.#controller.engineStore.getEngineByName(engineName)?.id : null;
+    const current = () => !this.#closed && this.#isCurrent() && isCurrent() &&
+      (!engineName || (engineId && this.#controller.engineStore.getEngineByName(engineName)?.id === engineId)) &&
+      this.ownsQuery(queryId) && this.#controller.resultsOpen &&
+      (result === null ? description.kind === "mode-exit" && description.searchMode === null :
+        this.ownsResult(queryId, result) && this.#controller.visibleResults.includes(result) &&
+        UrlbarShared.deepEqual(this.describeResultModeTransition(queryId, result, options)?.searchMode, requestedSearchMode) &&
+        UrlbarShared.deepEqual(this.describeResultModeApplication(queryId, result, options), description));
+    if (!current()) return null;
+    return this.#controller.parentController.commitIndependentModeState(this.#context.browserId,
+      description.searchMode, { userTypedValue: description.storeTypedValue ? description.value : undefined,
+        persistedSearchTerms: observation.persistedSearchTerms, engineId, requestedSearchMode,
+        modeEntry: observation.modeEntry }, current, onCommitted);
+  }
+
+  /** Popup dismissal clears a preview without granting query or activation authority. */
+  commitPreviewDismissal(previousMode, observation, isCurrent) {
+    this.#check();
+    const current = () => !this.#closed && this.#isCurrent() && isCurrent();
+    if (!current()) return null;
+    const parent = this.#controller.parentController;
+    const outcome = parent.commitIndependentPreviewDismissal(
+      this.#context.browserId, previousMode, observation, current);
+    if (!outcome?.applied) return outcome;
+    const browserCurrent = outcome.current ? parent.captureIndependentQueryAuthority(
+      this.#context.browserId, outcome.stateToken, null) : null;
+    return Object.freeze({ ...outcome, browserCurrent });
+  }
+
+  /** Explicit mode exit has no result/query authority; bind it to the scoped editor. */
+  commitExplicitModeExit(observation, isCurrent, onCommitted = null) {
+    this.#check();
+    if (!Number.isSafeInteger(this.#context.browserId) || this.#context.browserId <= 0) {
+      throw new Error("Mode state requires a pinned browser");
+    }
+    const current = () => !this.#closed && this.#isCurrent() && isCurrent();
+    if (!current()) return null;
+    return this.#controller.parentController.commitIndependentModeState(this.#context.browserId,
+      null, { persistedSearchTerms: observation.persistedSearchTerms }, current, onCommitted);
+  }
+
+  /**
+   * Prepare provider notification for a host selection. The host must validate
+   * the token before applying selection, then acknowledge its observation.
+   * This neither selects a row nor writes editor text or activates a result.
+   * No DOM element is supplied to the provider's pre-selection hook.
+   * Explicit null clears selection without notifying a result provider.
+   */
+  beginResultSelection(queryId, result) {
+    this.#check();
+    this.#selectionRequest = null;
+    if (!this.ownsQuery(queryId) || !this.#controller.resultsOpen ||
+        (result !== null && (!this.ownsResult(queryId, result) ||
+          !this.#controller.visibleResults.includes(result)))) {
+      throw new Error("Invalid result selection");
+    }
+    const request = Object.freeze({ queryId, result, token: Object.freeze({}) });
+    this.#selectionRequest = request;
+    try {
+      if (result !== null) this.#controller.parentController.onBeforeSelection(result);
+    } catch (error) {
+      if (this.#selectionRequest === request) this.#selectionRequest = null;
+      throw error;
+    }
+    // Provider hooks may synchronously remove results, hide the presentation,
+    // replace the query or begin another selection. Do not revive this request.
+    return this.getResultSelection(request.token);
+  }
+
+  getResultSelection(token) {
+    this.#check();
+    const request = this.#selectionRequest;
+    return request && request.token === token &&
+      this.ownsQuery(request.queryId) && this.#controller.resultsOpen &&
+      (request.result === null || (this.ownsResult(request.queryId, request.result) &&
+        this.#controller.visibleResults.includes(request.result)))
+      ? request : null;
+  }
+
+  acknowledgeResultSelection(token) {
+    const request = this.getResultSelection(token);
+    if (!request) return false;
+    // Consume before invoking a potentially reentrant provider callback.
+    this.#selectionRequest = null;
+    if (request.result !== null) this.#controller.parentController.onSelection(request.result);
+    return true;
+  }
+
+  publishPresentation(queryId, visibleResults, open) {
+    this.#check();
+    if (
+      !this.#query || queryId !== this.#query.id ||
+      !Array.isArray(visibleResults) || typeof open != "boolean" ||
+      new Set(visibleResults).size !== visibleResults.length ||
+      visibleResults.some(result => !this.ownsResult(queryId, result))
+    ) {
+      throw new Error("Invalid query presentation");
+    }
+    if (!open || (this.#selectionRequest?.result !== null &&
+        !visibleResults.includes(this.#selectionRequest?.result))) {
+      this.#selectionRequest = null;
+    }
+    if (!open) this.#oneOffDismissalGeneration++;
+    // Engagement telemetry indexes the visible list by `rowIndex`, which only a view assigned.
+    visibleResults.forEach((result, index) => { result.rowIndex = index; });
+    this.#controller.visibleResults = [...visibleResults];
+    this.#controller.resultsOpen = open;
+  }
+
+  /** Queue Firefox's exposure telemetry for a result of this exact query, on this session's recorder. */
+  addExposure(queryId, result) {
+    this.#check();
+    if (!this.ownsResult(queryId, result)) throw new Error("Stale exposure result");
+    this.#controller.engagementEvent.addExposure(result, this.#query);
+  }
+
+  cancel() {
+    if (this.#closed) return;
+    this.#query = null;
+    this.#finishState = null;
+    this.#removedIds.clear();
+    this.#activationCleanup.clear();
+    this.#selectionRequest = null;
+    this.#frozen = null;
+    this.#onUpdate = null;
+    this.#controller.visibleResults = [];
+    this.#controller.resultsOpen = false;
+    this.#controller.cancelQuery();
+    this.#controller.discardResults(null);
+  }
+
+  close() {
+    if (this.#closed) return;
+    this.#closed = true;
+    this.#query = null;
+    this.#finishState = null;
+    this.#removedIds.clear();
+    this.#activationCleanup.clear();
+    this.#selectionRequest = null;
+    this.#frozen = null;
+    this.#onUpdate = null;
+    this.#onPresentationRequest = null;
+    this.#engagementActive = false;
+    this.#controller.engagementEvent.discard();
+    this.#controller.destroy();
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarCompositionModel.mjs b/browser/components/urlbar/content/UrlbarCompositionModel.mjs
new file mode 100644
index 00000000000..139c755f557
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarCompositionModel.mjs
@@ -0,0 +1,101 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/** Firefox composition transitions, independent of an editor or DOM event. */
+export class UrlbarCompositionModel {
+  #state = UrlbarShared.COMPOSITION.NONE;
+  #closedPopup = false;
+  #hadText = false;
+
+  get isComposing() {
+    return this.#state == UrlbarShared.COMPOSITION.COMPOSING;
+  }
+
+  begin() {
+    if (this.isComposing) {
+      throw new Error("Trying to start a nested composition?");
+    }
+    this.#state = UrlbarShared.COMPOSITION.COMPOSING;
+    this.#hadText = false;
+  }
+
+  setPopupClosed(closed) {
+    this.#closedPopup = closed;
+  }
+
+  /** Capture this input's transition before consuming a commit/cancel state. */
+  input(hasData) {
+    const snapshot = { state: this.#state, closedPopup: this.#closedPopup };
+    if (!this.isComposing) {
+      this.#state = UrlbarShared.COMPOSITION.NONE;
+      this.#closedPopup = false;
+    } else if (hasData) {
+      this.#hadText = true;
+    }
+    return snapshot;
+  }
+
+  /**
+   * Finish a composition. Clear old selection/result state before transitioning,
+   * preserving the editor callback's ordering. The callback is never retained.
+   * Returns true for an empty composition that must reopen without another input.
+   */
+  end(hasData, keepPanelOpen, clearSelection) {
+    if (!this.isComposing) {
+      throw new Error("Trying to stop a non existing composition?");
+    }
+    if (typeof hasData !== "boolean" || typeof keepPanelOpen !== "boolean") {
+      throw new TypeError("Invalid composition end facts");
+    }
+    if (!keepPanelOpen) clearSelection();
+    // Selection clearing can reenter input; read history afterward, as before.
+    const policy = UrlbarCompositionModel.endPolicy({ hasData, keepPanelOpen,
+      hadText: this.#hadText, closedPopup: this.#closedPopup });
+    this.#state = policy.nextInput.state;
+    this.#closedPopup = policy.nextInput.closedPopup;
+    return policy.reopen;
+  }
+
+  /** Inspect owned event history without ending composition or consuming input. */
+  describeEnd(hasData, keepPanelOpen) {
+    if (!this.isComposing) throw new Error("Trying to stop a non existing composition?");
+    return UrlbarCompositionModel.endPolicy({ hasData, keepPanelOpen,
+      hadText: this.#hadText, closedPopup: this.#closedPopup });
+  }
+
+  /** End-event effects; nextInput is consumed by the following input, not here. */
+  static endPolicy({ hasData, hadText, closedPopup, keepPanelOpen }) {
+    if ([hasData, hadText, closedPopup, keepPanelOpen].some(fact => typeof fact !== "boolean")) {
+      throw new TypeError("Invalid composition end facts");
+    }
+    const reopen = !hasData && !hadText && closedPopup && !keepPanelOpen;
+    return Object.freeze({ clearSelection: !keepPanelOpen, clearResultForCurrentValue: !keepPanelOpen,
+      reopen, resetSearchState: false,
+      nextInput: Object.freeze({ state: reopen ? UrlbarShared.COMPOSITION.NONE :
+        (hasData ? UrlbarShared.COMPOSITION.COMMIT : UrlbarShared.COMPOSITION.CANCELED),
+      closedPopup: reopen ? false : closedPopup }) });
+  }
+
+  /** Describe composition-start effects without reading or mutating a presenter. */
+  static startPolicy({ keepPanelOpen, viewIsOpen, hasSearchMode, value }) {
+    if ([keepPanelOpen, viewIsOpen, hasSearchMode].some(fact => typeof fact !== "boolean") ||
+        typeof value !== "string") throw new TypeError("Invalid composition start facts");
+    const closePopup = !keepPanelOpen && viewIsOpen;
+    const confirmSearchMode = closePopup && hasSearchMode;
+    return Object.freeze({ closePopup, confirmSearchMode,
+      clearUserTypedValue: confirmSearchMode && !value });
+  }
+
+  static allowsQuery(snapshot, keepPanelOpen) {
+    return keepPanelOpen ||
+      (snapshot.state != UrlbarShared.COMPOSITION.COMPOSING &&
+        (snapshot.state != UrlbarShared.COMPOSITION.CANCELED || snapshot.closedPopup));
+  }
+
+  static allowsAutofill(snapshot, keepPanelOpen) {
+    return !keepPanelOpen || snapshot.state != UrlbarShared.COMPOSITION.COMPOSING;
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarAutofillModel.mjs b/browser/components/urlbar/content/UrlbarAutofillModel.mjs
new file mode 100644
index 00000000000..ed9a06b8c02
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarAutofillModel.mjs
@@ -0,0 +1,84 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/** Shared autofill decisions over editor facts; never retains an editor. */
+export class UrlbarAutofillModel {
+  /** Input intent shared by editor bindings; composition is checked separately. */
+  static allowsInput(inputType, isPaste) {
+    return !inputType?.startsWith("delete") &&
+      !inputType?.startsWith("history") && !isPaste;
+  }
+
+  /** Explicit deselection confirms only the currently displayed placeholder. */
+  static confirmsSelection({ placeholder, value, selectionStart, selectionEnd }) {
+    return !!(placeholder && placeholder.value === value &&
+      (placeholder.selectionStart !== selectionStart || placeholder.selectionEnd !== selectionEnd));
+  }
+
+  /** Whether a first result may replace the current selection. */
+  static acceptsResult({
+    placeholder, searchString, selectionStart, selectionEnd,
+    ignoresSelection = false, handlingMentions = false,
+  }) {
+    if (handlingMentions) {
+      return false;
+    }
+    const placeholderSelected =
+      placeholder &&
+      selectionEnd == placeholder.value.length &&
+      selectionStart == searchString.length &&
+      placeholder.value.toLocaleLowerCase().startsWith(searchString.toLocaleLowerCase());
+    return !!(placeholderSelected || ignoresSelection ||
+      (selectionStart == selectionEnd && selectionEnd == searchString.length));
+  }
+
+  /**
+   * Plan speculative completion before providers return. The caller applies
+   * clear/discard/edit operations through its own editor and undo machinery.
+   * A valid but unapplied placeholder stays available for the next query.
+   */
+  static planPlaceholder({
+    searchString, value, selectionStart, selectionEnd, searchMode, placeholder,
+    enabled, handlingMentions = false, suppressRedundantEdit = false,
+  }) {
+    if (selectionEnd != searchString.length || searchMode?.engineName ||
+        searchMode?.source == UrlbarShared.RESULT_SOURCE.SEARCH || handlingMentions) {
+      return { allowAutofill: false, operation: "clear" };
+    }
+    let matches = false;
+    if (placeholder) {
+      if (placeholder.type == "adaptive_url" || placeholder.type == "adaptive_origin") {
+        matches = searchString.length >= placeholder.adaptiveHistoryInput.length &&
+          placeholder.value.toLocaleLowerCase().startsWith(searchString.toLocaleLowerCase());
+      } else {
+        matches = UrlbarShared.canAutofillURL(placeholder.value, searchString);
+      }
+    }
+    if (!matches) {
+      return { allowAutofill: true, operation: "discard" };
+    }
+    if (selectionEnd != value.length || !enabled) {
+      return { allowAutofill: true, operation: "retain" };
+    }
+    const autofillValue = searchString + placeholder.value.substring(searchString.length);
+    if (suppressRedundantEdit && value === autofillValue &&
+        selectionStart === searchString.length && selectionEnd === autofillValue.length) {
+      return { allowAutofill: true, operation: "retain" };
+    }
+    return {
+      allowAutofill: true,
+      operation: "apply",
+      autofill: {
+        value: autofillValue,
+        selectionStart: searchString.length,
+        selectionEnd: autofillValue.length,
+        type: placeholder.type,
+        adaptiveHistoryInput: placeholder.adaptiveHistoryInput,
+        untrimmedValue: placeholder.untrimmedValue,
+      },
+    };
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarQueryModel.mjs b/browser/components/urlbar/content/UrlbarQueryModel.mjs
