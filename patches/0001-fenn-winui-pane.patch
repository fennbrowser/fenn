+      const spring = widget === 'spring' || /^customizableui-special-spring[0-9]+$/.test(widget);
+      if (spring && widget !== 'spring' && springs++ >= 16) continue;
+      const wrapper = widget === 'spring' ? null : ui.getWidget(widget), node = wrapper?.forWindow(window)?.node;
+      if (spring) {
+        control = widget === 'spring' ? 'new-spring' : widget;
+        label = this.widgetStrings.GetStringFromName('toolbarspring.label');
+      } else if (!control) {
+        const button = node?.querySelector('.webextension-browser-action');
+        const policy = button && window.WebExtensionPolicy.getByID(button.dataset.extensionid);
+        if (!policy || !policy.extension.canAccessWindow(window) || !window.gUnifiedExtensions.browserActionFor(policy)) continue;
