+  // These are presentation candidates, not proof of viewport visibility.
+  // Each presenter must separately report the results it actually exposes.
+  candidates(context) {
+    let span = 0;
+    return context.results.filter(result => {
+      if (result.isHiddenExposure ||
+          (result.heuristic && !this.shouldShowHeuristic(result))) {
+        return false;
+      }
+      span += UrlbarShared.getSpanForResult(result);
+      return span <= context.maxResults;
+    });
+  }
+
+  urlPresentation(result) {
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+      case UrlbarShared.RESULT_TYPE.REMOTE_TAB:
+        return {showUrl:true, isVisitAction:false};
+      case UrlbarShared.RESULT_TYPE.KEYWORD:
+        return {showUrl:false, isVisitAction:result.payload.input.trim() == result.payload.keyword};
+      case UrlbarShared.RESULT_TYPE.SEARCH:
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+      case UrlbarShared.RESULT_TYPE.TIP:
+      case UrlbarShared.RESULT_TYPE.AI_CHAT:
+        return {showUrl:false, isVisitAction:false};
+      case UrlbarShared.RESULT_TYPE.URL:
+        if (result.providerName == "UrlbarProviderClipboard") {
+          return {showUrl:false, isVisitAction:false};
+        }
