+}
diff --git a/browser/base/content/WinUIActionStamp.sys.mjs b/browser/base/content/WinUIActionStamp.sys.mjs
new file mode 100644
index 00000000000..6db39b4aab1
--- /dev/null
+++ b/browser/base/content/WinUIActionStamp.sys.mjs
@@ -0,0 +1,22 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Identity only. Each surface still parses its command grammar and revalidates
+// Firefox's live prerequisites before invoking the original controller.
+export function readActionStamp(revision, session = null, maximum = Number.MAX_SAFE_INTEGER) {
+  const read = value => {
+    if (typeof value !== "number" && (typeof value !== "string" || !/^[0-9]+$/.test(value))) return null;
+    const number = Number(value);
+    return Number.isSafeInteger(number) && number >= 0 && number <= maximum ? number : null;
+  };
+  const structure = read(revision);
+  const opening = session === null ? null : read(session);
+  if (structure === null || (session !== null && (opening === null || opening === 0))) return null;
+  return {revision: structure, session: opening};
+}
+
+export function actionStampMatches(stamp, revision, session = null) {
+  return !!stamp && Number.isSafeInteger(revision) && revision >= 0 &&
+    stamp.revision === revision && stamp.session === session;
+}
