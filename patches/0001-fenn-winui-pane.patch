+    t.owner.invalidateAddress();
+  }
+  execute(action) {
+    const match=/^profile-menu:(open|dismiss|invoke):([1-9][0-9]*)(?::([1-9][0-9]*):([1-9][0-9]*))?$/.exec(action.command);
+    if(!match)return 2;
+    const session=Number(match[2]);if(!Number.isInteger(session) || session>0xffffffff)return 2;
+    if(match[1]==="open") {
+      const t=this.toolbar;
+      if(this.closed || match[3] || session<=this.lastSession || !t.navigationState().profile.enabled ||
+          t.customization?.nativeOverflow.has("fxa-toolbar-menu-button") || !t.menuAnchor("profile",action))return 2;
+      this.lastSession=session;
+      this.open(session,action).catch(error=>{if(this.session===session)this.dismiss();console.error(error);});return 1;
+    }
+    if(session!==this.session)return 2;
+    if(match[1]==="dismiss"){if(match[3])return 2;this.dismiss();return 1;}
+    if(!this.live() || Number(match[3])!==this.description?.revision)return 2;
+    const entry=this.actions.get(Number(match[4]));if(!entry)return 2;
