+  }
+  if (message==WM_POINTERDOWN+WINUI_PANE_ENDPOINT_KEY_OFFSET ||
+      message==WM_POINTERUP+WINUI_PANE_ENDPOINT_KEY_OFFSET ||
+      message==WM_POINTERUPDATE+WINUI_PANE_ENDPOINT_KEY_OFFSET ||
+      message==WM_POINTERLEAVE+WINUI_PANE_ENDPOINT_KEY_OFFSET) {
+    auto* copy=reinterpret_cast<WinUIPanePenMessage*>(w);
+    const WinUIPanePenMessage* outerPen=sIndependentPen;
+    sIndependentPen=copy;
+    const auto result=ShellInput(hwnd,*link,message-WINUI_PANE_ENDPOINT_KEY_OFFSET,copy->wParam,l);
+    sIndependentPen=outerPen;
+    InterlockedDecrement(copy->pending);
+    HeapFree(GetProcessHeap(),0,copy);
+    return result;
+  }
+  // The proxy is never under the pointer: Gecko's own leave tracking on it ends at once.
+  if (message==WM_MOUSELEAVE) return 0;
+  if (message==WM_MOUSELEAVE+WINUI_PANE_ENDPOINT_KEY_OFFSET) return ShellInput(hwnd,*link,WM_MOUSELEAVE,0,0);
+  static UINT dpiMessage=RegisterWindowMessageW(L"Fenn.NativeWindowHost.EndpointDpi.v1");
+  static UINT layoutMessage=RegisterWindowMessageW(L"Fenn.NativeWindowHost.EndpointLayout.v1");
+  if (message==layoutMessage) {
+    ActivateKeyboardLayout(reinterpret_cast<HKL>(l),0);
+    return ShellInput(hwnd,*link,WM_INPUTLANGCHANGE,w,l);
+  }
+  if (message==dpiMessage) {
+    SyncFromShell(hwnd,*link);
+    RECT bounds{};
+    if (!GetWindowRect(shell,&bounds)) return 0;
+    return ShellInput(hwnd,*link,WM_DPICHANGED,w,reinterpret_cast<LPARAM>(&bounds));
+  }
+  switch (message) {
+    case WM_ACTIVATE: case WM_SETFOCUS: case WM_KILLFOCUS:
+    case WM_KEYDOWN: case WM_KEYUP: case WM_SYSKEYDOWN: case WM_SYSKEYUP:
+    case WM_CHAR: case WM_SYSCHAR: case WM_CONTEXTMENU:
+    case WM_MOUSEWHEEL: case WM_MOUSEHWHEEL:
+    case WM_TOUCH:
+      return ShellInput(hwnd,*link,message,w,l);
+    case WM_MOUSEMOVE:
+    case WM_LBUTTONDOWN: case WM_LBUTTONUP: case WM_RBUTTONDOWN: case WM_RBUTTONUP:
+    case WM_MBUTTONDOWN: case WM_MBUTTONUP:
+    case WM_LBUTTONDBLCLK: case WM_RBUTTONDBLCLK: case WM_MBUTTONDBLCLK:
+      // Gecko asks GetMessageExtraInfo whether touch or pen made this message.
+      ::SetMessageExtraInfo(static_cast<LPARAM>(w>>32));
+      return ShellInput(hwnd,*link,message,w&0xffffffffu,l);
+    // nsWindow would have kept a disabled button from producing this.
+    case WM_APPCOMMAND:
+      if (GET_DEVICE_LPARAM(l)==FAPPCOMMAND_MOUSE &&
+          ((GET_APPCOMMAND_LPARAM(l)==APPCOMMAND_BROWSER_BACKWARD && !Preferences::GetBool("mousebutton.4th.enabled",true)) ||
+           (GET_APPCOMMAND_LPARAM(l)==APPCOMMAND_BROWSER_FORWARD && !Preferences::GetBool("mousebutton.5th.enabled",true)))) return 0;
+      return ShellInput(hwnd,*link,message,w,l);
+  }
+  const LRESULT result=CallWindowProcW(callback,hwnd,message,w,l);
+  if (message==WM_SETTEXT && ProxyOf(hwnd) && sPaneApi.setIndependentTitle)
+    sPaneApi.setIndependentTitle(shell,reinterpret_cast<const wchar_t*>(l));
+  return result;
+}
+void EnsureIndependentAccessibility(HWND proxy) {
+#ifdef ACCESSIBILITY
+  HiddenProxy* link=ProxyOf(proxy);
+  if (!link || link->processPending) return;
+  if (link->accessibility) {
+    if (!link->accessibility->NeedsRebind()) return;
+    link->accessibility->Disconnect();
+    link->accessibility=nullptr;
+    sPaneApi.setIndependentAccessibility(link->shell,nullptr);
+  }
+  // The native page input window carries page focus, so it answers for the page; the root finds
+  // it when asked, since it can be created after this.
+  link->accessibility=new WinUIAccessibleRoot(link->shell,proxy);
+  HRESULT accessibilityResult=link->accessibility->Initialize();
+  if (SUCCEEDED(accessibilityResult))
+    accessibilityResult=sPaneApi.setIndependentAccessibility(link->shell,static_cast<IRawElementProviderSimple*>(link->accessibility.get()));
+  MOZ_LOG(sWinUIPrototypeLog,LogLevel::Debug,("Independent accessibility proxy=%p shell=%p initialize=%lx",proxy,link->shell,accessibilityResult));
+  if (FAILED(accessibilityResult)) {
+    link->accessibility->Disconnect();
+    link->accessibility=nullptr;
+  }
+#endif
+}
+}
+bool HasHiddenProxy(HWND proxy) { return ProxyOf(proxy) != nullptr; }
+HWND ShellOfProxy(HWND aWindow) {
+  HWND shell=aWindow ? static_cast<HWND>(GetPropW(aWindow,kProxyShell)) : nullptr;
+  return shell ? shell : aWindow;
+}
+// True while our bound native host's startup editor is being typed
+// into (or was adopted a moment ago). Windows opened meanwhile, such as the first-run graphics
+// sanity window, must not take activation from it.
+bool NativeStartupEditorOwnsForeground() {
+  HWND foreground = ::GetForegroundWindow();
+  if (!foreground) return false;
+  DWORD pid = 0;
+  ::GetWindowThreadProcessId(foreground, &pid);
+  if (pid != ::GetCurrentProcessId()) {
+    // A process shell is recognized through the engine-local current binding,
+    // established only after pipe authentication and HWND ownership validation.
+    // A foreign HWND's properties alone are not an identity proof.
+    const HWND proxy = static_cast<HWND>(
+        ::GetPropW(foreground, WINUI_PANE_ENDPOINT_PROPERTY));
+    DWORD proxyPid = 0;
+    ::GetWindowThreadProcessId(proxy, &proxyPid);
+    if (proxyPid != ::GetCurrentProcessId()) return false;
+    const HiddenProxy* link = ProxyOf(proxy);
+    if (!link || link->processPending || link->shell != foreground) return false;
+  }
+  if (::GetPropW(foreground, L"Fenn.NativeStartupEditorOwned")) return true;
+  const auto until = reinterpret_cast<ULONGLONG>(
+      ::GetPropW(foreground, L"Fenn.NativeStartupEditorGraceUntil"));
+  return until && ::GetTickCount64() < until;
+}
+bool SetIndependentDropTarget(HWND proxy,nsNativeDragTarget* target) {
+  HiddenProxy* link=ProxyOf(proxy);
+  if(!link || !NS_IsMainThread())return false;
+  if(link->dropTarget!=target) {
+    RevokePageDrop(proxy,*link);
+    link->dropAttempt=nullptr;
+    link->dropTarget=target;
+  }
+  UpdatePageDrop(proxy,*link);
+  return true;
+}
+HWND TakeNativeShell(DWORD aExStyle, DWORD aStyle, const RECT& aBounds) {
+  if(ProcessShellEnabled())return nullptr;
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped || !FennStartupWindowIndependent())
+    return nullptr;
+  if (FennStartupWindowMode() && !FennStartupWindowClaimed()) {
+    HWND shell=TakeFennStartupWindow();
+    return shell && LoadPane() && IsNativeWindowHost(shell) ? shell : nullptr;
+  }
+  HWND shell=nullptr;
+  return LoadPane() && SUCCEEDED(sPaneApi.createWindowHost(aExStyle,L"",aStyle&~WS_VISIBLE,&aBounds,nullptr,nullptr,&shell))
+             ? shell : nullptr;
+}
+bool LinkHiddenProxy(HWND aProxy, HWND aShell) {
+  auto* link=new HiddenProxy{aShell};
+  link->processPending=ProcessShellEnabled() && aProxy==aShell;
+  if (!SetPropW(aProxy,kProxyLink,link) || !SetPropW(aProxy,kProxyShell,aShell) ||
+      !SetPropW(aProxy,kEndpointProperty,aProxy)) {
+    RemovePropW(aProxy,kProxyLink); RemovePropW(aProxy,kProxyShell); RemovePropW(aProxy,kEndpointProperty);
+    delete link;
+    return false;
+  }
+  SetWindowLongPtrW(aProxy,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(ProxyDefault));
+  return true;
+}
+bool AttachHiddenProxy(HWND aProxy, uintptr_t aIdentity) {
+  HiddenProxy* link=ProxyOf(aProxy);
+  if (!link || !NS_IsMainThread()) return false;
+  link->gecko=reinterpret_cast<WNDPROC>(GetWindowLongPtrW(aProxy,GWLP_WNDPROC));
+  SetWindowLongPtrW(aProxy,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(HiddenProxyProc));
+  link->identity=aIdentity;
+  if(link->processPending) {
+    RECT bounds{};GetWindowRect(aProxy,&bounds);
+    if(LoadPane() && SUCCEEDED(sPaneApi.createProcessWindow(aProxy,aIdentity,&bounds,0)))return true;
+    SetWindowLongPtrW(aProxy,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(link->gecko));
+    RemovePropW(aProxy,kProxyLink);RemovePropW(aProxy,kProxyShell);RemovePropW(aProxy,kEndpointProperty);
+    delete link;SetEnvironmentVariableW(L"FENN_NATIVE_HOST_FAILED",L"1");
+    return true; // Accepted local browser creation continues as usable stock Firefox.
+  }
+  // The window under the pointer is the shell, so Gecko's wheel handling has to find this widget there.
+  WinUtils::SetNSWindowPtr(link->shell,reinterpret_cast<nsWindow*>(aIdentity));
+  if (!SetPropW(link->shell,kEndpointProperty,aProxy) ||
+      FAILED(sPaneApi.bindIndependentEndpoint(link->shell,aIdentity,aProxy))) {
+    RemovePropW(link->shell,kEndpointProperty);
+    WinUtils::SetNSWindowPtr(link->shell,nullptr);
+    SetWindowLongPtrW(aProxy,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(link->gecko));
+    link->gecko=nullptr;
+    return false;
+  }
+  SyncFromShell(aProxy,*link);
+  // nsWindow set its icons before it was attached.
+  for (const WPARAM kind : {WPARAM(ICON_BIG),WPARAM(ICON_SMALL)}) {
+    const auto icon=reinterpret_cast<HICON>(SendMessageW(aProxy,WM_GETICON,kind,0));
+    if (HICON copy=icon ? CopyIcon(icon) : nullptr)
+      RequestShell(*link,WinUIPaneWindowIcon,reinterpret_cast<LONG_PTR>(copy),static_cast<uint32_t>(kind));
+  }
+  EnsureIndependentAccessibility(aProxy);
+  return true;
+}
+void ReleaseHiddenProxy(HWND aProxy) {
+  HiddenProxy* link=ProxyOf(aProxy);
+  if (!link || !NS_IsMainThread()) return;
+  RevokePageDrop(aProxy,*link);
+  link->dropTarget=nullptr;
+  ForgetIndependentPageIME(aProxy);
+  // Provider cookies are revoked on Gecko, then the native agile identity is
+  // dropped before the shell goes.
+#ifdef ACCESSIBILITY
+  if (link->accessibility) {
+    link->accessibility->Disconnect();
+    sPaneApi.setIndependentAccessibility(link->shell,nullptr);
+    link->accessibility=nullptr;
+  }
+#endif
+  if (link->gecko) SetWindowLongPtrW(aProxy,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(link->gecko));
+  if(link->shell!=aProxy)WinUtils::SetNSWindowPtr(link->shell,nullptr);
+  RemovePropW(link->shell,kEndpointProperty);
+  // Waits, so every request queued before it has run and nothing on the shell's
+  // thread refers to this link any more.
+  if (sPaneApi.destroyWindowHost) sPaneApi.destroyWindowHost(link->shell);
+  RemovePropW(aProxy,kProxyLink); RemovePropW(aProxy,kProxyShell); RemovePropW(aProxy,kEndpointProperty);
+  delete link;
+}
+bool ForwardProxyShow(HWND aProxy, int aCommand) {
+  HiddenProxy* link=ProxyOf(aProxy);
+  if (!link) return false;
+  // Like a move or resize, leaving minimized applies to the proxy at once: a resize that follows
+  // in the same turn must not reach the shell at the icon's size.
+  const LONG_PTR style=GetWindowLongPtrW(aProxy,GWL_STYLE);
+  if ((style&WS_MINIMIZE) && aCommand!=SW_MINIMIZE && aCommand!=SW_SHOWMINIMIZED && aCommand!=SW_SHOWMINNOACTIVE) {
+    WINDOWPLACEMENT placement{sizeof(placement)};
+    const bool maximized=aCommand==SW_MAXIMIZE ||
+        (aCommand==SW_RESTORE && GetWindowPlacement(link->shell,&placement) && (placement.flags&WPF_RESTORETOMAXIMIZED));
+    link->fromShell=true;
+    SetWindowLongPtrW(aProxy,GWL_STYLE,(style&~(WS_MINIMIZE|WS_MAXIMIZE))|(maximized?WS_MAXIMIZE:0));
+    link->fromShell=false;
+    ShowOwnedPopups(aProxy,TRUE);
+  }
+  RequestShell(*link,WinUIPaneWindowShow,aCommand);
+  return true;
+}
+void ShowHiddenProxy(HWND aProxy, bool aShow, int aSizeMode) {
+  HiddenProxy* link=ProxyOf(aProxy);
+  if(link && link->processPending && !aShow)return;
+  // Showing a visible window activates it, which only the user or Gecko's focus request may do.
+  if (!link || (!link->pending && aShow==!!IsWindowVisible(link->shell))) return;
+  RequestShell(*link,WinUIPaneWindowShow,!aShow ? SW_HIDE :
+      aSizeMode==nsSizeMode_Maximized ? SW_SHOWMAXIMIZED :
+      aSizeMode==nsSizeMode_Minimized ? SW_SHOWMINIMIZED : SW_SHOW);
+}
+bool PrepareDefaultNativeStartupHost(HINSTANCE instance, const wchar_t* presentation) {
+  if(ProcessShellEnabled())return false;
+  // BrowserWindowTracker also opens headless browser documents. They have no
+  // Windows widget to claim a native host, so never create one for that mode.
+  if (gfxPlatform::IsHeadless() || FennNativeHostFailed()) return false;
+  static bool attempted=false;
+  if(attempted || !FennIndependentHostRequested() || FennStartupWindowMode())return false;
+  attempted=true;
+  if(!Preferences::GetBool("fenn.winui.window.independent",FennDevelopmentNativeHostDefault()) ||
+      !Preferences::GetBool("fenn.winui.window.host",FennDevelopmentNativeHostDefault()) ||
+      !XRE_IsParentProcess())return false;
+  nsCOMPtr<nsIFile> profile;
+  nsAutoString path;
+  if(NS_FAILED(NS_GetSpecialDirectory(NS_APP_USER_PROFILE_50_DIR,getter_AddRefs(profile))) ||
+      NS_FAILED(profile->GetPath(path)))return false;
+  if (!PrepareFennStartupWindowForProfile(
+          instance, static_cast<const wchar_t*>(path.get()), presentation)) return false;
+  // Populate Gecko's routed ABI before binding its endpoint to the native HWND.
+  return ShowNativeStartupSurface();
+}
+bool PrepareRoutedNativeStartupHost(const char16_t* presentation) {
+  if(gfxPlatform::IsHeadless())return false;
+  if(ProcessShellEnabled()) {
+    nsCOMPtr<nsIFile> profile;nsAutoString path;
+    if(NS_FAILED(NS_GetSpecialDirectory(NS_APP_USER_PROFILE_50_DIR,getter_AddRefs(profile))) ||
+       NS_FAILED(profile->GetPath(path)) || !LoadPane())return false;
+    return SUCCEEDED(sPaneApi.startProcessHost(path.get(),reinterpret_cast<const wchar_t*>(presentation),1));
+  }
+  wchar_t interactive[2]{};
+  if(GetEnvironmentVariableW(L"FENN_NATIVE_INTERACTIVE_STARTUP",interactive,2)!=1 || interactive[0]!=L'1')return false;
+  if(PrepareDefaultNativeStartupHost(GetModuleHandleW(nullptr),
+      reinterpret_cast<const wchar_t*>(presentation))) {
+    if(HWND hwnd=PeekFennStartupWindow())SetPropW(hwnd,L"Fenn.RoutedStartupPrepared",reinterpret_cast<HANDLE>(1));
+    PROFILER_MARKER_UNTYPED("FennNativeStartupRoutingResolved", OTHER);
+    return true;
+  }
+  return false;
+}
+// Only a plain browser launch may start the native host before Firefox has decided what to open.
+// Any other switch (-chrome, -jsconsole, -preferences, ...) opens something that is not the
+// browser window the host is for, so it is refused rather than guessed at.
+static bool EarlyStartupArgumentsAllowed(int aArgc, char** aArgv) {
+  static const char* const kAllowed[] = {
+      "no-remote",       "new-instance",   "new-window",        "new-tab",
+      "private-window",  "url",            "marionette",        "remote-debugging-port",
+      "remote-allow-system-access", "foreground", "wait-for-browser", "profile", "p", "osint"};
+  for (int i = 1; i < aArgc; ++i) {
+    const char* arg = aArgv[i];
+    if (!arg || arg[0] != '-') continue;
+    while (*arg == '-') ++arg;
+    bool allowed = false;
+    for (const char* name : kAllowed) {
+      if (!_stricmp(arg, name)) {
+        allowed = true;
+        break;
+      }
+    }
+    if (!allowed) return false;
+  }
+  return true;
+}
+static void EarlyTrace(const char* aEvent) {
+  static const bool enabled = GetEnvironmentVariableW(L"FENN_PANE_DIAGNOSTICS", nullptr, 0) != 0;
+  if (!enabled) return;
+  FILETIME now;
+  GetSystemTimeAsFileTime(&now);
+  const unsigned long long ticks = (static_cast<unsigned long long>(now.dwHighDateTime) << 32) | now.dwLowDateTime;
+  fprintf(stderr, "FennFocus ms=%llu event=%s detail=0\n", ticks / 10000ULL - 11644473600000ULL, aEvent);
+}
+bool PrepareEarlyNativeStartupHost(nsIFile* aProfile, int aArgc, char** aArgv) {
+  if(gfxPlatform::IsHeadless())return false;
+  if(ProcessShellEnabled()) {
+      if(!aProfile)return false;
+      if(!Preferences::GetBool("fenn.winui.window.host",FennDevelopmentNativeHostDefault()) ||
+         !Preferences::GetBool("fenn.winui.window.independent",FennDevelopmentNativeHostDefault())) {
+        CleanupFennStartupWindow();
+        SetEnvironmentVariableW(L"FENN_NATIVE_HOST_FAILED",L"1");
+        return false;
+      }
+      // Not eligible early is not attachment failure. Firefox may later confirm a
+      // browser window (for example after profile selection); that routed hook owns it.
+      if(!EarlyStartupArgumentsAllowed(aArgc,aArgv))return false;
+      if(!LoadPane())return false;
+    nsAutoString path;if(NS_FAILED(aProfile->GetPath(path)))return false;
+    return SUCCEEDED(sPaneApi.startProcessHost(path.get(),nullptr,1));
+  }
+  // Prototype, behind FENN_NATIVE_EARLY_STARTUP=1. Called once user preferences are loaded, so the
+  // same opt-outs as the routed path apply. Firefox's Fluent labels are not available yet, so the
+  // native side uses its cache or defaults until Firefox publishes live labels.
+  wchar_t early[2]{}, interactive[2]{};
+  if (GetEnvironmentVariableW(L"FENN_NATIVE_EARLY_STARTUP", early, 2) != 1 || early[0] != L'1' ||
+      GetEnvironmentVariableW(L"FENN_NATIVE_INTERACTIVE_STARTUP", interactive, 2) != 1 ||
+      interactive[0] != L'1' || !aProfile || !FennIndependentHostRequested() ||
+      FennStartupWindowMode() || FennNativeHostFailed() || !XRE_IsParentProcess() ||
+      !EarlyStartupArgumentsAllowed(aArgc, aArgv)) {
+    return false;
+  }
+  if (!Preferences::GetBool("fenn.winui.window.independent", FennDevelopmentNativeHostDefault()) ||
+      !Preferences::GetBool("fenn.winui.window.host", FennDevelopmentNativeHostDefault())) {
+    return false;
+  }
+  nsAutoString path;
+  if (NS_FAILED(aProfile->GetPath(path))) return false;
+  EarlyTrace("early-hook-begin");
+  // Direction-only presentation: Fluent labels are not available yet, but the negotiated app locale
+  // and its direction (including the bidi pseudo-locale) are. The native side applies the profile's
+  // label cache only if it was written for this locale.
+  nsAutoString presentation;
+  if (auto* locales = mozilla::intl::LocaleService::GetInstance()) {
+    nsAutoCString locale;
+    locales->GetAppLocaleAsBCP47(locale);
+    bool valid = !locale.IsEmpty() && locale.Length() <= 64;
+    for (uint32_t i = 0; valid && i < locale.Length(); ++i) {
+      const char c = locale[i];
+      valid = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_';
+    }
+    if (valid) {
+      presentation.AssignLiteral(u"{\"version\":2,\"locale\":\"");
+      AppendUTF8toUTF16(locale, presentation);
+      if (locales->IsAppLocaleRTL()) {
+        presentation.AppendLiteral(u"\",\"rtl\":true}");
+      } else {
+        presentation.AppendLiteral(u"\",\"rtl\":false}");
+      }
+    }
+  }
+  if (!PrepareFennStartupWindowForProfile(
+          GetModuleHandleW(nullptr), static_cast<const wchar_t*>(path.get()),
+          presentation.IsEmpty() ? nullptr : static_cast<const wchar_t*>(presentation.get()))) {
+    return false;
+  }
+  EarlyTrace("early-hook-end");
+  // The native thread builds and shows the startup surface itself; waiting for it here would block
+  // Gecko for the whole construction (ShowNativeStartupSurface is a job on that thread).
+  if (HWND hwnd = PeekFennStartupWindow()) {
+    SetPropW(hwnd, L"Fenn.RoutedStartupPrepared", reinterpret_cast<HANDLE>(1));
+    // Distinguishes this hook from the JavaScript-hook path, which sets only the property above.
+    SetPropW(hwnd, L"Fenn.NativeEarlyStartupHook", reinterpret_cast<HANDLE>(1));
+  }
+  PROFILER_MARKER_UNTYPED("FennNativeStartupEarlyHost", OTHER);
+  return true;
+}
+void CancelRoutedNativeStartupHost() {
+  // Never close a successfully claimed browser or another window's host.
+  HWND hwnd=PeekFennStartupWindow();
+  if(hwnd && GetPropW(hwnd,L"Fenn.RoutedStartupPrepared"))CleanupFennStartupWindow();
+}
+bool ShowNativeStartupSurface() {
+  if (!FennStartupWindowMode()) return true;
+  HWND hwnd = PeekFennStartupWindow();
+  // An early native Close cancels the one-use startup lease. Let normal
+  // startup unwind through nsWindow's abort path instead of failing XPCOM init.
+  if (!hwnd) return true;
+  if (!NS_IsMainThread() || sPaneStopped || !LoadPane()) return false;
+  if (FAILED(sPaneApi.showStartupSurface(hwnd))) {
+    // The native STA can process early Close after Peek but before this
+    // dispatched call. Cancellation is not an XPCOM initialization failure.
+    return !PeekFennStartupWindow();
+  }
+  PROFILER_MARKER_UNTYPED("FennNativeStartupSurfaceShown", OTHER);
+  return true;
+}
+void DismissNativeStartupSurface(HWND hwnd) {
+  if (sPaneApi.dismissStartupSurface && NS_IsMainThread() &&
+      sPaneApi.dismissStartupSurface(ShellOfProxy(hwnd)) == S_OK) {
+    PROFILER_MARKER_UNTYPED("FennNativeStartupSurfaceDismissed", OTHER);
+  }
+}
+bool IsNativeWindowHost(HWND hwnd) { return GetPropW(hwnd, L"Fenn.NativeWindowHost") != nullptr; }
+void SetIndependentCursor(HWND hwnd, HCURSOR cursor, bool custom) {
+  // Gecko asks on nearly every mouse move, and Windows keeps only the newest.
+  static HWND sWindow = nullptr;
+  static HCURSOR sCursor = nullptr;
+  HiddenProxy* link = ProxyOf(hwnd);
+  if (!sPaneApi.setIndependentCursor || !link) return;
+  hwnd = link->shell;
+  if (sWindow == hwnd && sCursor == cursor) return;
+  // Gecko destroys its custom cursor on its own schedule, so the owner gets a copy.
+  HCURSOR held = custom ? reinterpret_cast<HCURSOR>(::CopyIcon(cursor)) : cursor;
+  if (held && SUCCEEDED(sPaneApi.setIndependentCursor(hwnd, held, custom))) {
+    sWindow = hwnd;
+    sCursor = cursor;
+  } else {
+    sWindow = nullptr;
+  }
+}
+bool RegisterIndependentTouch(HWND hwnd) {
+  return sPaneApi.registerIndependentTouch && ProxyOf(hwnd) &&
+         SUCCEEDED(sPaneApi.registerIndependentTouch(ShellOfProxy(hwnd)));
+}
+const POINTER_PEN_INFO* IndependentPenInfo(uint32_t pointerId) {
+  return sIndependentPen && GET_POINTERID_WPARAM(sIndependentPen->wParam)==pointerId
+             ? &sIndependentPen->pen : nullptr;
+}
