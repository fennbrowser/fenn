+      t.owner.addressSession?.sessionId===this.context?.session &&
+      t.owner.addressTab===this.context?.tab && t.owner.addressDocument===this.context?.document &&
+      t.owner.addressTab===w.gBrowser.selectedTab && t.owner.addressDocument===w.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+  }
+  label(id,attribute) {
+    this.l10n ??= new this.window.Localization(["branding/brand.ftl","browser/appmenu.ftl","browser/sync.ftl","browser/accounts.ftl","browser/tabbrowser.ftl"],true);
+    const [message]=this.l10n.formatMessagesSync([{id}]);
