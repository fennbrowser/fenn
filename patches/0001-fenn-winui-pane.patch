+      Services.obs.removeObserver(this, "winui-pane-drain");
+      Services.obs.removeObserver(this, "intl:app-locales-changed");
+      for (const topic of ["created", "updated", "deleted", "reordered", "service-load-finished"])
+        Services.obs.removeObserver(this, `contextual-identity-${topic}`);
+    } catch {}
+    this.addressSession?.close();
+    this.addressSession = null;
+    this.addressToolbar?.close();
+    this.addressToolbar = null;
+    this.tabMenuSession = null;
+    this.stripSession = null;
+    this.tabMenuL10n = null;
+    this.nativeLabelCache = null;
+    this.tabMenuLabelCache = null;
+    for (const type of this.tabEvents)
+      gBrowser.tabContainer.removeEventListener(type, this);
+    // Unconditional: the strip pref can have been flipped since init(), and
+    // removing a listener that was never added is a no-op.
+    for (const type of this.stripStateEvents)
+      gBrowser.tabContainer.removeEventListener(type, this);
+    for (const type of this.windowEvents)
+      window.removeEventListener(type, this, true);
+    if (this.urlbarInput) {
+      for (const type of ["input", "focus", "blur"])
+        this.urlbarInput.removeEventListener(type, this, true);
+      this.urlbarInput = null;
+    }
+    if (this.attached) {
+      try {
+        window.windowUtils.updateWinUIPane(0, 0, 0, 0, false, false, false, []);
+      } catch {}
+    }
+    this.attached = false;
+    cancelAnimationFrame(this.frame);
+    this.frame = 0;
+    this.observer.disconnect();
+    this.mutation.disconnect();
+    for (let type of this.events) {
+      window.removeEventListener(type, this, true);
+    }
+    for (const query of this.groupColorMedia || []) query.removeEventListener("change", this.groupColorChanged);
+    this.groupColorMedia = null;
+    this.groupColorChanged = null;
+    Services.prefs.removeObserver("sidebar.verticalTabs", this);
+    Services.prefs.removeObserver(this.stripHeightPref, this);
+    Services.prefs.removeObserver(this.containerDotPref, this);
+    Services.prefs.removeObserver(this.tabGlowsPref, this);
+    Services.prefs.removeObserver(this.stripBackdropPref, this);
+    Services.prefs.removeObserver(this.groupReachPref, this);
+    Services.prefs.removeObserver(this.groupHoverPref, this);
+    Services.prefs.removeObserver(this.groupHaloPref, this);
+    Services.prefs.removeObserver(this.groupGlowAnimationsPref, this);
+    Services.prefs.removeObserver(this.groupGlowFadeOutPref, this);
+    for (const pref of this.groupingPrefs) Services.prefs.removeObserver(pref, this);
+    Services.prefs.removeObserver(this.addressToolbarPref, this);
+    Services.prefs.removeObserver(this.navigationToolbarPref, this);
+    Services.prefs.removeObserver("privacy.userContext.enabled", this);
+    Services.prefs.removeObserver("browser.nova.enabled", this);
+    this.element.remove();
+    this.element = null;
+    this.allTabsAnchor = null;
+    this.popups.clear();
+    this.urlbar = null;
+    this.urlbarPanel = null;
+  },
+};
+
+window.addEventListener("load", () => {
+  gWinUIPane.initOptions();
+  gWinUIPane.init();
+}, { once: true });
+window.addEventListener("unload", () => {
+  gWinUIPane.uninitOptions();
+  gWinUIPane.uninit();
+}, { once: true });
diff --git a/widget/windows/WinUIPrototype.cpp b/widget/windows/WinUIPrototype.cpp
new file mode 100644
index 0000000000..3c26bffa40
--- /dev/null
+++ b/widget/windows/WinUIPrototype.cpp
@@ -0,0 +1,328 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "WinUIPrototype.h"
+
+#include <appmodel.h>
+#include <objbase.h>
+
+#include <iterator>
+
+#include "WinUIPaneApi.h"
+#include "mozilla/Logging.h"
+#include "mozilla/CycleCollectedJSContext.h"
+#include "mozilla/Preferences.h"
+#include "mozilla/Services.h"
+#include "nsIObserverService.h"
+#include "nsPrintfCString.h"
+#include "nsThreadUtils.h"
+#include "mozilla/UniquePtr.h"
+#include "nsXULAppAPI.h"
+
+namespace mozilla::widget {
+bool HasWinUISystemCaption(HWND aWindow) {
+  return GetPropW(aWindow, WINUI_PANE_SYSTEM_CAPTION_PROPERTY) != nullptr;
+}
+}  // namespace mozilla::widget
+
+namespace mozilla::widget {
+static LazyLogModule sWinUIPrototypeLog("WinUIPrototype");
+static bool sTraceEnabled = false;  // Main-thread only; set once a pane updates.
+static HMODULE sPaneModule = nullptr;
+static WinUIPaneApi sPaneApi{};
+static bool sPaneAttempted = false;
+static bool sPaneStopped = false;
+
+static bool LoadPane() {
+  if (sPaneAttempted) return sPaneApi.updateTabStrip != nullptr;
+  sPaneAttempted = true;
+  wchar_t path[32768];
+  DWORD length = GetModuleFileNameW(nullptr, path, std::size(path));
+  if (!length || length >= std::size(path)) return false;
+  wchar_t* separator = wcsrchr(path, L'\\');
+  constexpr wchar_t suffix[] = L"FennPane.dll";
+  if (!separator ||
+      size_t(separator + 1 - path) + std::size(suffix) > std::size(path))
+    return false;
+  wcscpy(separator + 1, suffix);
+  sPaneModule = LoadLibraryExW(path, nullptr,
+                               LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR |
+                                   LOAD_LIBRARY_SEARCH_APPLICATION_DIR |
+                                   LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!sPaneModule) {
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Warning,
+            ("pane=unavailable win32Error=%lu", GetLastError()));
+    return false;
+  }
+  auto getApi = reinterpret_cast<WinUIPaneGetApiFn>(
+      GetProcAddress(sPaneModule, "WinUIPaneGetApi"));
+  WinUIPaneApi api{};
+  HRESULT hr = getApi ? getApi(WINUI_PANE_ABI_VERSION, sizeof(api), &api)
+                      : E_NOINTERFACE;
+  if (FAILED(hr) || api.size != sizeof(api) ||
+      api.version != WINUI_PANE_ABI_VERSION || !api.focus ||
+      !api.destroy || !api.translate || !api.shutdown || !api.clip || !api.syncTabs || !api.syncAddress || !api.syncTabMenu || !api.updateTabStrip ||
+      !api.setNotifySink || !api.drainRequests || !api.completeRequests || !api.applyTabDelta ||
+      !api.updateAddress || !api.focusAddress) {
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Warning,
+            ("pane=incompatible hr=0x%08lx", hr));
+    return false;
+  }
+  sPaneApi = api;
+  return true;
+}
+
+// The endpoint's identity as chrome JavaScript sees it: the same formatting
+// nsIBaseWindow::nativeHandle uses, so a window can match the notification to
+// its own HWND without a new interface.
+static nsPrintfCString EndpointName(HWND aWindow) {
+  return nsPrintfCString("0x%p", aWindow);
+}
+
+// The pane's wakeup. Called on the main thread, usually from inside a XAML
+// callback, so it may only *post*: entering browser JavaScript from this stack
+// is exactly the reentrancy the request path exists to avoid. Returning false
+// tells the pane the wakeup did not happen, so a later request schedules a
+// fresh one instead of waiting for one that will never arrive.
+static BOOL WINAPI NotifyWinUIPaneDrain(void* aContext) {
+  if (!NS_IsMainThread() || sPaneStopped) return FALSE;
+  HWND window = static_cast<HWND>(aContext);
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "mozilla::widget::WinUIPaneDrain", [window]() {
+        if (sPaneStopped) return;
+        nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+        if (!observers) return;
+        // Keep custom-element reactions and mutation observers inside one
+        // browser command turn (an empty new group must survive until filled).
+        nsAutoMicroTask microtask;
+        observers->NotifyObservers(
+            nullptr, "winui-pane-drain",
+            NS_ConvertUTF8toUTF16(EndpointName(window)).get());
+      }));
+  return NS_SUCCEEDED(rv) ? TRUE : FALSE;
+}
+
+bool DrainWinUIRequests(HWND aWindow, nsAString& aBatch) {
+  aBatch.Truncate();
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.drainRequests)
+    return false;
+  auto output = mozilla::MakeUnique<wchar_t[]>(262144);
+  output[0] = 0;
+  HRESULT hr = sPaneApi.drainRequests(aWindow, output.get(), 262144);
+  if (FAILED(hr)) return false;
+  aBatch.Assign(reinterpret_cast<const char16_t*>(output.get()));
+  return true;
+}
+
+bool CompleteWinUIRequests(HWND aWindow, const nsAString& aOutcomes) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.completeRequests || aOutcomes.Length() > 1048576)
+    return false;
+  nsAutoString outcomes(aOutcomes);
+  return SUCCEEDED(sPaneApi.completeRequests(aWindow, outcomes.get()));
+}
+
+uint32_t ApplyWinUITabDelta(HWND aWindow, const nsAString& aDelta) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.applyTabDelta || aDelta.Length() > 1048576)
+    return 0;
+  nsAutoString delta(aDelta);
+  uint32_t revision = 0;
+  // A zero revision is the caller's signal to send one full snapshot; it is
+  // never a reason to retry the same delta.
+  HRESULT hr = sPaneApi.applyTabDelta(aWindow, delta.get(), &revision);
+  if (FAILED(hr)) return 0;
+  // S_FALSE means the delta applied but the pane has fallen behind and wants a
+  // snapshot. Reporting no revision is how that reaches the producer, which
+  // sends exactly one -- the documented bounded recovery.
+  return hr == S_FALSE ? 0 : revision;
+}
+
+static bool PaneEnabled() {
+  return Preferences::GetBool("fenn.winui.pane.enabled",
+                              false) ||
+         Preferences::GetBool(
+             "fenn.winui.tabstrip.replaceFirefoxTabs",
+             false);
+}
+
+bool UpdateWinUIPane(HWND aWindow, const RECT& aRect, bool aVisible,
+                     bool aFocus, bool aBackwards,
+                     const nsTArray<LayoutDeviceIntRect>& aOcclusions) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || sPaneStopped)
+    return false;
+  if (!PaneEnabled()) {
+    DestroyWinUIPane(aWindow);
+    return false;
+  }
+  sTraceEnabled = true;
+  if (!LoadPane()) return false;
+  HRESULT hr = sPaneApi.updateTabStrip(aWindow, &aRect, aVisible);
+  if (SUCCEEDED(hr) && sPaneApi.setNotifySink) {
+    // Registered by the widget, not by chrome script, so the request path
+    // cannot end up with a queue and no wakeup because script failed to set
+    // one up. The context is the endpoint's own HWND.
+    hr = sPaneApi.setNotifySink(aWindow, NotifyWinUIPaneDrain, aWindow);
+  }
+  if (SUCCEEDED(hr)) {
+    nsTArray<RECT> occlusions;
+    for (const auto& r : aOcclusions) {
+      occlusions.AppendElement(RECT{r.x - aRect.left, r.y - aRect.top,
+                                    r.XMost() - aRect.left,
+                                    r.YMost() - aRect.top});
+    }
+    hr = sPaneApi.clip(aWindow, occlusions.Elements(), occlusions.Length());
+  }
+  if (SUCCEEDED(hr) && aVisible && aFocus)
+    hr = sPaneApi.focus(aWindow, aBackwards);
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("pane=update hwnd=%p visible=%d rect=%ld,%ld,%ld,%ld hr=0x%08lx",
+           aWindow, aVisible, aRect.left, aRect.top, aRect.right, aRect.bottom,
+           hr));
+  TraceWinUIPrototype("pane-update", aWindow);
+  if (FAILED(hr)) DestroyWinUIPane(aWindow);
+  return SUCCEEDED(hr);
+}
+
+uint32_t SyncWinUITabs(HWND aWindow, const nsTArray<uint32_t>& aIds,
+                       const nsTArray<nsString>& aTitles, const nsTArray<uint32_t>& aCommands, uint32_t aSelected, uint32_t aRevision) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || sPaneStopped ||
+      !sPaneApi.syncTabs || aIds.Length() != aTitles.Length() || aIds.Length() != aCommands.Length() ||
+      !PaneEnabled())
+    return 0;
+  nsTArray<WinUITab> tabs;
+  for (size_t i = 0; i < aIds.Length(); ++i) {
+    tabs.AppendElement(WinUITab{aIds[i], aTitles[i].get(), aCommands[i]});
+  }
+  uint32_t requested = 0;
+  if (FAILED(sPaneApi.syncTabs(aWindow, tabs.Elements(), tabs.Length(), aSelected, aRevision, &requested)))
+    return 0;
+  return requested;
+}
+
+bool SyncWinUIAddress(HWND aWindow, const nsAString& aSnapshot) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.syncAddress || aSnapshot.Length() > 1048576 ||
+      !PaneEnabled()) return false;
+  nsAutoString snapshot(aSnapshot);
+  return SUCCEEDED(sPaneApi.syncAddress(aWindow, snapshot.get()));
+}
+
+bool UpdateWinUIAddress(HWND aWindow, const RECT& aRect, bool aVisible,
+                       bool aFocus, bool aSelectAll) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.updateAddress || !PaneEnabled()) return false;
+  if (aVisible && !Preferences::GetBool(
+          "fenn.winui.address.toolbar.enabled", false) &&
+      !Preferences::GetBool(
+          "fenn.winui.navigation.toolbar.enabled", false)) return false;
+  HRESULT hr = sPaneApi.updateAddress(aWindow, &aRect, aVisible);
+  if (SUCCEEDED(hr) && aVisible && aFocus)
+    hr = sPaneApi.focusAddress(aWindow, aSelectAll);
+  return SUCCEEDED(hr);
+}
+
+// Publication only: since ABI v12 the pane returns nothing here, so there is
+// no output buffer to allocate on every call either.
+bool SyncWinUITabMenu(HWND aWindow, const nsAString& aSnapshot) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.syncTabMenu || aSnapshot.Length() > 1048576 ||
+      !PaneEnabled()) return false;
+  nsAutoString snapshot(aSnapshot);
+  return SUCCEEDED(sPaneApi.syncTabMenu(aWindow, snapshot.get()));
+}
+
+void DestroyWinUIPane(HWND aWindow) {
+  if (!NS_IsMainThread() || !sPaneApi.destroy || sPaneStopped) return;
+  // Drop the wakeup before the endpoint goes away, so nothing can be posted
+  // for a pane that is already being torn down.
+  if (sPaneApi.setNotifySink) sPaneApi.setNotifySink(aWindow, nullptr, nullptr);
+  HRESULT hr = sPaneApi.destroy(aWindow);
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("pane=destroy hwnd=%p hr=0x%08lx", aWindow, hr));
+}
+
+void InitializeWinUIRuntime() {
+  // Every lane uses the shared Microsoft.WindowsAppRuntime.2 framework. A
+  // packaged Firefox has it in its package graph; an unpackaged one joins it
+  // here, before the pane or WindowsUIUtils loads any Windows App SDK DLL, so
+  // that every such DLL comes from one runtime. On failure the pane cannot
+  // start and Firefox keeps its own UI.
+  static bool sAttempted = false;
+  if (sAttempted || !XRE_IsParentProcess()) return;
+  sAttempted = true;
+  UINT32 length = 0;
+  if (GetCurrentPackageFullName(&length, nullptr) != APPMODEL_ERROR_NO_PACKAGE) {
+    return;
+  }
+  wchar_t path[32768];
+  DWORD pathLength = GetModuleFileNameW(nullptr, path, std::size(path));
+  wchar_t* separator = pathLength && pathLength < std::size(path)
+                           ? wcsrchr(path, L'\\')
+                           : nullptr;
+  constexpr wchar_t bootstrap[] = WINUI_PANE_RUNTIME_BOOTSTRAP_DLL;
+  if (!separator || size_t(separator + 1 - path) + std::size(bootstrap) >
+                        std::size(path)) {
+    return;
+  }
+  wcscpy(separator + 1, bootstrap);
+  // Fixed executable-relative location, as for the pane itself.
+  HMODULE module = LoadLibraryExW(path, nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR |
+                                      LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!module) {
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Warning,
+            ("runtime=unavailable bootstrapWin32Error=%lu", GetLastError()));
+    return;
+  }
+  using InitializeFn = HRESULT(WINAPI*)(UINT32, PCWSTR, PACKAGE_VERSION, UINT32);
+  auto initialize = reinterpret_cast<InitializeFn>(
+      GetProcAddress(module, "MddBootstrapInitialize2"));
+  PACKAGE_VERSION minimum{};
+  minimum.Version = WINUI_PANE_RUNTIME_MIN_VERSION;
+  // MddBootstrapInitializeOptions_OnPackageIdentity_NOOP.
+  constexpr UINT32 kNoopWhenPackaged = 0x0010;
+  HRESULT hr = initialize ? initialize(WINUI_PANE_RUNTIME_MAJOR_MINOR, L"",
+                                       minimum, kNoopWhenPackaged)
+                          : E_NOINTERFACE;
+  MOZ_LOG(sWinUIPrototypeLog,
+          SUCCEEDED(hr) ? LogLevel::Info : LogLevel::Warning,
+          ("runtime=bootstrap hr=0x%08lx", static_cast<unsigned long>(hr)));
+}
+
+bool TranslateWinUIPane(MSG& aMessage) {
+  return NS_IsMainThread() && !sPaneStopped && sPaneApi.translate &&
+         sPaneApi.translate(&aMessage);
+}
+
+void ShutdownWinUIPane() {
+  if (!NS_IsMainThread() || sPaneStopped) return;
+  sPaneStopped = true;
+  if (sPaneApi.shutdown) {
+    HRESULT hr = sPaneApi.shutdown();
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+            ("pane=shutdown hr=0x%08lx", hr));
+  }
+}
+
+void TraceWinUIPrototype(const char* aPhase, HWND aWindow) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || !sTraceEnabled) return;
+  APTTYPE apartment = APTTYPE_CURRENT;
+  APTTYPEQUALIFIER qualifier = APTTYPEQUALIFIER_NONE;
+  const HRESULT hr = CoGetApartmentType(&apartment, &qualifier);
+  DWORD ownerProcess = 0;
+  DWORD ownerThread =
+      aWindow ? GetWindowThreadProcessId(aWindow, &ownerProcess) : 0;
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("phase=%s pid=%lu tid=%lu hwnd=%p ownerPid=%lu ownerTid=%lu "
+           "apartmentHr=0x%08lx apartment=%d qualifier=%d "
+           "windowing=%p frameworkUdk=%p xaml=%p",
+           aPhase, GetCurrentProcessId(), GetCurrentThreadId(), aWindow,
+           ownerProcess, ownerThread, static_cast<unsigned long>(hr),
+           static_cast<int>(apartment), static_cast<int>(qualifier),
+           GetModuleHandleW(L"Microsoft.UI.Windowing.dll"),
+           GetModuleHandleW(L"Microsoft.Internal.FrameworkUdk.dll"),
+           GetModuleHandleW(L"Microsoft.UI.Xaml.dll")));
+}
+}  // namespace mozilla::widget
diff --git a/widget/windows/WinUIPrototype.h b/widget/windows/WinUIPrototype.h
new file mode 100644
index 0000000000..cf68f6fb6f
--- /dev/null
+++ b/widget/windows/WinUIPrototype.h
@@ -0,0 +1,39 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef widget_windows_WinUIPrototype_h
+#define widget_windows_WinUIPrototype_h
+#include <windows.h>
+
+#include "Units.h"
+#include "nsTArray.h"
+#include "nsString.h"
+namespace mozilla::widget {
+void TraceWinUIPrototype(const char* aPhase, HWND aWindow = nullptr);
+bool UpdateWinUIPane(HWND aWindow, const RECT& aRect, bool aVisible,
+                     bool aFocus, bool aBackwards,
+                     const nsTArray<LayoutDeviceIntRect>& aOcclusions);
+uint32_t SyncWinUITabs(HWND aWindow, const nsTArray<uint32_t>& aIds,
+                       const nsTArray<nsString>& aTitles, const nsTArray<uint32_t>& aCommands, uint32_t aSelected, uint32_t aRevision);
+bool SyncWinUIAddress(HWND aWindow, const nsAString& aSnapshot);
+bool UpdateWinUIAddress(HWND aWindow, const RECT& aRect, bool aVisible,
+                       bool aFocus, bool aSelectAll);
+bool SyncWinUITabMenu(HWND aWindow, const nsAString& aSnapshot);
+// ABI v11 request path. The pane wakes the browser through a sink registered
+// here, which only posts a task to this thread's event queue; these are the
+// host side of that exchange. The notification topic is
+// "winui-pane-drain", whose data is the endpoint's HWND formatted the same way
+// nsIBaseWindow::nativeHandle formats it, so a chrome window can recognise its
+// own endpoint.
+bool DrainWinUIRequests(HWND aWindow, nsAString& aBatch);
+bool CompleteWinUIRequests(HWND aWindow, const nsAString& aOutcomes);
+uint32_t ApplyWinUITabDelta(HWND aWindow, const nsAString& aDelta);
+void DestroyWinUIPane(HWND aWindow);
+bool TranslateWinUIPane(MSG& aMessage);
+bool HasWinUISystemCaption(HWND aWindow);
+void ShutdownWinUIPane();
+// Parent process, before any window: joins an unpackaged Firefox to the shared
+// Windows App SDK runtime the pane is built against. No-op when packaged.
+void InitializeWinUIRuntime();
+}  // namespace mozilla::widget
+#endif
diff --git a/widget/windows/WinUIPaneApi.h b/widget/windows/WinUIPaneApi.h
new file mode 100644
index 0000000000..4c2af64a22
--- /dev/null
+++ b/widget/windows/WinUIPaneApi.h
@@ -0,0 +1,136 @@
+#pragma once
+#include <windows.h>
+#include <stdint.h>
+
+// Owning-thread HWND marker: while present, Windows App SDK owns caption
+// button input and Gecko must not redirect non-client presses to DOM buttons.
+#define WINUI_PANE_SYSTEM_CAPTION_PROPERTY L"FennPane.SystemCaption.1"
+
+// v16 retires the 240-px sidebar presentation and its `update` entry point:
+// every pane is the TabView strip, created and positioned by updateTabStrip.
+// v14 puts the last two commands -- close and new tab -- on the v11 request
+// path. syncTabs therefore drains nothing: it loses its close/new-tab
+// out-parameters and the reserved context/command pair with them, keeping only
+// the presentation-model revision. No call in this ABI drains anything, and
+// nothing in the shell polls.
+// v13 put the address surface's own intents on the v11 request path as well,
+// including the visibility of its rows -- the one thing about it that no
+// browser event reports. syncAddress therefore returns nothing and loses its
+// output buffer, and no entry point in this ABI is asked whether it has work.
+// v12 put the TabView strip's own gestures (group toggle, reorder, detach,
+// adopt) on the v11 request path, so syncTabMenu no longer returns anything and
+// loses its output buffer: it is now a publication only, and nothing in the
+// pane's protocol has to be asked whether it has work.
+// v11 added the event-driven request path (setNotifySink / drainRequests /
+// completeRequests) and incremental tab deltas (applyTabDelta), and retired
+// syncTabs' selection out-parameter. v10 added an explicit strip-only host,
+// retaining the sidebar entry point.
+#define WINUI_PANE_ABI_VERSION 17u
+
+// The pane is built framework-dependent on the shared Windows App SDK runtime
+// (Microsoft.WindowsAppRuntime.2, at least 2.5.1.0). A packaged host declares it
+// as a package dependency; an unpackaged host joins it with the bootstrapper
+// (MddBootstrapInitialize2, which ignores the minor version from 2.0) before
+// loading the pane or any other Windows App SDK DLL. Keep the minimum in step
+// with native/WinUIPane/packages.config.
+#define WINUI_PANE_RUNTIME_MAJOR_MINOR 0x00020000u
+#define WINUI_PANE_RUNTIME_MIN_VERSION 0x0002000500010000ull
+#define WINUI_PANE_RUNTIME_BOOTSTRAP_DLL L"Microsoft.WindowsAppRuntime.Bootstrap.dll"
+
+// All calls run on the browser's owning STA. Coordinates are client physical
+// pixels. The module remains loaded until process exit, including after shutdown.
+// Legacy availability bits for tab snapshots and invalidation. Menu action IDs
+// are opaque strings in the published state; native code assigns no command
+// semantics.
+enum WinUITabCommand : uint32_t {
+    WinUITabReload = 1u, WinUITabDuplicate = 2u,
+    WinUITabPin = 4u, WinUITabUnpin = 8u,
+};
+constexpr uint32_t WinUITabPinned = 16u; // State, not an executable command.
+struct WinUITab {
+    uint32_t id; // Nonzero, window-local identity; never reused during a pane lifetime.
+    const wchar_t* title; // Borrowed only for the duration of syncTabs.
+    uint32_t commands{}; // Availability plus Pinned state; never both Pin and Unpin.
+};
+
+// Wakeup callback for the v11 request path. The pane calls this when, and only
+// when, its queue transitions from "nothing outstanding" to "work waiting": at
+// most one call is outstanding per endpoint until the host drains.
+//
+// It is called on the owning STA, frequently from inside a XAML callback. The
+// implementation may only *schedule* work -- post a task to the browser's own
+// event loop -- and must never run browser code on that stack. `context` is the
+// value passed to setNotifySink and is never interpreted by the pane.
+//
+// Return FALSE if the wakeup could not be scheduled (shutdown, a failed task
+// post). The pane then puts its queue back into a state where the next request
+// schedules a fresh wakeup, rather than waiting forever for one that will never
+// arrive. Returning FALSE is not an error the host must otherwise handle.
+using WinUIPaneNotifyFn = BOOL (WINAPI*)(void* context);
+
+struct WinUIPaneApi {
+    uint32_t size;
+    uint32_t version;
+    HRESULT (WINAPI* focus)(HWND, BOOL);
+    HRESULT (WINAPI* destroy)(HWND);
+    BOOL (WINAPI* translate)(MSG*);
+    HRESULT (WINAPI* shutdown)();
+    // Publication only since v14. v17 adds Firefox's nonzero revision input
+    // after selected; all earlier fields remain. The output acknowledges that
+    // exact stamp, which the next applyTabDelta names as its base.
+    // Complete replay is a no-op; a conflicting or stale stamp is refused.
+    // Native actions travel through the request path. A close never removes
+    // its row or chooses a successor before Firefox publishes the result.
+    HRESULT (WINAPI* syncTabs)(HWND, const WinUITab*, uint32_t, uint32_t, uint32_t, uint32_t*);
+    // Versioned JSON messages, copied during the call; output capacity is in wchar_t.
+    // Publication only since v13; intents arrive through drainRequests.
+    HRESULT (WINAPI* syncAddress)(HWND, const wchar_t*);
+    // Exclusions are pane-local physical pixels; an empty list restores the pane.
+    HRESULT (WINAPI* clip)(HWND, const RECT*, uint32_t);
+    // Menu protocol v2: published state, copied as JSON. The published state
+    // carries tab identities and the selected set only; a tab's command
+    // description is published on demand under the "menu" key, in answer to a
+    // drained menu-open request. Since v12 this returns nothing: every native
+    // intent, including the strip's own gestures, arrives through
+    // drainRequests.
+    HRESULT (WINAPI* syncTabMenu)(HWND, const wchar_t*);
+    // Creates, positions, shows or hides the HWND's strip island. Client
+    // physical pixels; hiding a window that has no island creates nothing.
+    HRESULT (WINAPI* updateTabStrip)(HWND, const RECT*, BOOL);
+
+    // --- v11: event-driven requests -------------------------------------
+    // Register (or, with a null callback, clear) the wakeup for one endpoint.
+    // Clearing is part of teardown: the pane makes no further calls afterwards.
+    HRESULT (WINAPI* setNotifySink)(HWND, WinUIPaneNotifyFn, void*);
+    // Take one bounded batch of native requests as JSON:
+    //   {"version":1,"generation":N,"legacy":bool,
+    //    "requests":[{"id":..,"kind":..,"tab":..,"revision":..,"action":{...}}]}
+    // "kind" is 1 select-tab, 2 tab-menu transition, 3 close tab, 4 new tab,
+    // 5 strip gesture, 6 address intent, 7 search-mode intent, 8 address
+    // visibility report, 9 tab hover-card request. Every native intent appears here and nowhere else, so
+    // none of them has two executors.
+    // Returns S_FALSE with an empty output when there was nothing to take, or
+    // when a drain is already open. Every batch must be closed by
+    // completeRequests, including when execution is refused; otherwise the
+    // endpoint stays busy.
+    HRESULT (WINAPI* drainRequests)(HWND, wchar_t*, uint32_t);
+    // Close the drain with explicit per-request outcomes:
+    //   {"version":1,"generation":N,"outcomes":[{"id":..,"outcome":1..4}],
+    //    "blocked":bool}
+    // "blocked" tells the pane the host cannot execute right now (a nested
+    // modal loop, a command already running); the pane then waits for an
+    // unblocking completeRequests rather than re-posting notifications.
+    HRESULT (WINAPI* completeRequests)(HWND, const wchar_t*);
+    // Apply an incremental presentation update:
+    //   {"version":1,"base":R,"selected":id?,"titles":[{"id":..,"title":".."}]}
+    // "base" must equal the pane's current model revision; the out-parameter
+    // receives the revision after applying, for the next delta's base.
+    // E_NOT_VALID_STATE means the producer and the pane have diverged: answer
+    // with one syncTabs snapshot, never with a retry loop. S_FALSE means the
+    // delta applied but the pane wants a snapshot for an unrelated reason.
+    HRESULT (WINAPI* applyTabDelta)(HWND, const wchar_t*, uint32_t*);
+    // v15: independent toolbar address island; the request endpoint is shared.
+    HRESULT (WINAPI* updateAddress)(HWND, const RECT*, BOOL);
+    HRESULT (WINAPI* focusAddress)(HWND, BOOL);
+};
+using WinUIPaneGetApiFn = HRESULT (WINAPI*)(uint32_t, uint32_t, WinUIPaneApi*);
