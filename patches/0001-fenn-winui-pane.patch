+    finally { this.events.delete(trigger); }
+    return 1;
+  }
+  close() {
+    this.closed = true;
+    this.ui.removeListener(this.listener);
+    this.observer.disconnect();
+    this.theme.removeEventListener("change", this.invalidate);
+    this.entries.clear();
+    this.paletteEntries?.clear();
+    this.images.clear();
+  }
+}
