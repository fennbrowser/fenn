+  }
+  services() {
+    const {UIState}=ChromeUtils.importESModule("resource://services-sync/UIState.sys.mjs");
+    const {SelectableProfileService}=ChromeUtils.importESModule("resource:///modules/profiles/SelectableProfileService.sys.mjs");
+    return {UIState,profiles:SelectableProfileService};
+  }
+  accountSignature(state) {return JSON.stringify([state.status,state.email || "",state.syncEnabled,Services.prefs.getBoolPref("identity.fxaccounts.enabled",true)]);}
+  profilesAllowed(profiles) {return profiles.isEnabled && Services.policies.isAllowed("profileManagement");}
