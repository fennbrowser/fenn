+      searchMode: this.input.searchMode ?? null,
+    };
+    let context = null;
+    try {
+      context = await editor.acknowledgeRestartQuery(request.token, observation, state);
+    } catch (error) {
+      console.error("Independent address restart failed", error);
+    }
+    if (!context) {
+      // The old rows must not stay on screen as if the provider's restart ran.
+      this.tipQueryRestart = null;
+      this.window.gWinUIPane.addressFallback("restart-not-acknowledged");
+    }
+  }
+
+  #fallback(reason) {
+    WinUIAddressSession.recordFallback(reason, { privateWindow: this.windowPrivate });
+    try {
+      this.editor?.discardEngagement();
+    } catch (_) {
+      // No engagement was started.
+    }
+    return "firefox-fallback";
+  }
+
+  cancel() {
+    try {
+      this.editor?.cancel();
+    } catch (_) {
+      // A closed editor has nothing left to cancel.
+    }
+    this.legacyCancel();
+  }
+
+  close() {
+    if (this.closed) return;
+    const editor = this.editor;
+    this.editor = null;
+    this.legacyClose();
+    try {
+      editor?.close();
+    } catch (_) {
+      // Already closed with its scope.
+    }
+    WinUIAddressSession.flush().catch(console.error);
+  }
+}
