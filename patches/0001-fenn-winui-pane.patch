+    return result.payload.buttons || [];
+  }
+  static fromElement(element) {
+    if (!element) return null;
+    const d=element.dataset;
+    return {command:d.command,url:d.url,input:d.input,openIn:d.openIn,
+      userContextId:d.usercontextid,name:d.name,help:d.l10nName==="learn-more-link"};
+  }
+  buttonAction(button) {
+    return {name:button.name,command:button.command,url:button.url,input:button.input};
+  }
+  helpAction(result) {
+    return {help:true,url:this.host.getHelpLinkURL(result.payload.descriptionLearnMoreTopic)};
+  }
