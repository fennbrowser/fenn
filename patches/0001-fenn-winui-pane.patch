+    // Preserve initialization even when preferences will hide all one-offs.
+    await store.init();
+    this.#check();
+    const facts = this.#oneOffVisibilityFacts();
+    if (!facts) return null;
+    const signature = JSON.stringify(facts);
+    return Object.freeze({ willHide: facts.willHide, isCurrent: () => current() &&
+      store.initialized && !store.failed && JSON.stringify(this.#oneOffVisibilityFacts()) === signature });
