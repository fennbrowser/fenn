+    if(this.session!==session || !this.live())return;
+    // An account transition during an async list read must not publish old identities.
+    if(this.accountSignature(UIState.get())!==this.accountState){this.dismiss();return;}
+    const add=(key,label,kind,extra={},enabled=true)=>{
+      if(!label)return;
