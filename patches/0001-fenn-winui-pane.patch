+        if(state.syncEnabled)add("sync",this.label("appmenuitem-fxa-toolbar-sync-now2"),"sync");
+        add("settings",this.label("fxa-menu-manage-sync-settings","label"),"settings");
+        add("signout",this.label("fxa-menu-sign-out","label"),"signout");
+      } else {
+        const key=state.status===UIState.STATUS_NOT_VERIFIED ? "account-finish-account-setup" : "appmenuitem-fxa-sign-in";
+        add("account",this.label(key),"account");
+      }
+    }
+    separator();add("more",this.label("winui-profile-more-options"),"original");
