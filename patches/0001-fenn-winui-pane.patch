+    if (fingerprint !== this.fingerprint) { this.fingerprint = fingerprint; this.revision++; }
+    this.description = {enabled:true,closed:this.closedSession || 0,session:this.session,revision:this.revision,actionRevision:this.actionRevision,...description};
+    return this.description;
+  }
+  execute(action) {
+    const match = /^downloads-panel:(open|dismiss|invoke):([1-9][0-9]*)(?::([1-9][0-9]*):([0-9]+))?$/.exec(action.command);
+    if (!match) return 2;
+    const session = Number(match[2]);
+    if (!Number.isSafeInteger(session) || session > 0xffffffff) return 2;
+    if (match[1] === "open") {
+      if (match[3] || this.closed || session <= this.lastSession || !this.toolbar.navigationState().downloads.shown ||
+          this.toolbar.customization?.nativeOverflow.has("downloads-button") || !this.toolbar.menuAnchor("downloads",action)) return 2;
+      this.lastSession = session;
+      this.open(session,action).catch(error => { if(this.session===session && this.live()){this.failure=this.ready=true;this.toolbar.owner.invalidateAddress();} console.error(error); });
