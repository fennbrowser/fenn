+++ b/browser/base/content/WinUIAddressContextMenu.sys.mjs
@@ -0,0 +1,105 @@
+// Firefox owns context item eligibility, localization and browser actions.
+export class WinUIAddressContextMenu {
+  constructor(session) { this.session = session; this.generation = 0; }
+  close() {
+    this.generation++;
+    this.state = null;
+    this.nodes = null;
+    this.commands = null;
+    this.session.contextSnapshot = null;
+    const popup = this.popup;
+    this.popup = null;
+    if (popup?.state === "closed") popup.dispatchEvent(new this.session.window.Event("popuphidden"));
+  }
+  async open(request) {
+    this.close();
+    const session = this.session, win = session.window;
+    if (win.gDialogBox?.isOpen || session.syncNativeSelection(request) !== 1 || session.closed) return;
+    const generation = this.generation;
+    const tab = win.gBrowser.selectedTab;
+    const document = tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+    const event = new win.MouseEvent("contextmenu", {view:win});
+    const popup = win.EditContextMenu.prepare(session.input.inputField, event);
+    this.popup = popup;
+    await win.document.l10n.translateElements([...popup.querySelectorAll("[data-l10n-id]")]);
+    if (generation !== this.generation || session.closed || win.gDialogBox?.isOpen || request.editId !== session.editId ||
+        request.text !== session.input.inputField.value || win.gBrowser.selectedTab !== tab ||
+        document !== tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId) return;
+    const nodes = new Map(), commands = new Map(); let count = 0;
+    const standard = new Set(["cmd_undo", "cmd_redo", "cmd_cut", "cmd_copy", "cmd_paste", "cmd_delete", "cmd_selectAll"]);
+    const read = (parent, depth=0) => {
+      if (depth > 4) throw new Error("Context menu too deep");
+      return [...parent.children].filter(node => !node.hidden && !node.collapsed && node.getAttribute("hidden") !== "true" && node.getAttribute("collapsed") !== "true").map(node => {
+        if (++count > 128) throw new Error("Context menu too large");
+        if (node.localName === "menuseparator") return {separator:true};
+        const command = node.getAttribute("command");
+        const id = standard.has(command) ? command : `${generation}:${count}`;
+        const pasteAndGo = node.id === "paste-and-go";
+        if (pasteAndGo) commands.set(id, "paste-and-go");
+        else nodes.set(id, node);
+        const item = {id, label:(node.getAttribute("label") || "").slice(0,4096),
+          accessKey:node.getAttribute("accesskey") || "", enabled:node.getAttribute("disabled") !== "true",
+          checked:node.getAttribute("checked") === "true", checkable:node.getAttribute("type") === "checkbox"};
+        if (pasteAndGo) item.enabled = !!session.input.canPasteAndGo();
+        if (standard.has(command)) item.enabled = !!session.input.inputField.controllers.getControllerForCommand(command)?.isCommandEnabled(command);
+        if (node.localName === "menu") item.children = read(node.menupopup || node.querySelector("menupopup"), depth+1);
+        return item;
+      }).filter(item => item.separator || item.label);
+    };
+    const items = read(popup);
+    this.nodes = nodes;
+    this.commands = commands;
+    this.state = {generation, tab, document, text:request.text, editId:request.editId};
+    session.contextSnapshot = {generation, editId:request.editId, items};
+    session.changed();
+  }
+  execute(request) {
+    const s = this.session, state = this.state, win = s.window;
+    if (!request || request.version !== 1 || !["context-action", "context-close"].includes(request.kind)) return 2;
+    if (request.generation !== this.generation || !state || request.session !== s.sessionId) return 2;
+    // A close request can carry an edit just like activation. Validate its
+    // document before accepting text, even if outer session teardown is late.
+    if (s.closed || win.EditContextMenu.input !== s.input.inputField || win.gBrowser.selectedTab !== state.tab ||
+        state.document !== state.tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId) {
+      this.close();
+      return 2;
+    }
+    if (request.kind === "context-close") {
+      // Closing can overtake TextChanged (Undo/Redo/Delete). The request carries
+      // that edit, so acknowledge it before revoking this menu opening.
+      const result = s.syncNativeSelection(request);
+      this.close();
+      return result;
+    }
+    if (win.gDialogBox?.isOpen || s.editId !== state.editId || s.input.inputField.value !== state.text) {
+      this.close();
+      return 2;
+    }
+    if (this.commands?.get(request.id) === "paste-and-go") {
+      // Recheck the live editor, not a cached disabled attribute. The opening
+      // still uses Firefox's menu localization; activation retains no node.
+      try {
+        if (!s.input.canPasteAndGo()) return 2;
+        s.input.pasteAndGo();
+        return 1;
+      } finally { this.close(); }
+    }
+    const node = this.nodes?.get(request.id);
+    if (!node || win.gDialogBox?.isOpen || s.editId !== state.editId || s.input.inputField.value !== state.text ||
+        win.gBrowser.selectedTab !== state.tab || state.document !== state.tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId ||
+        !node.isConnected || node.hidden || node.collapsed || node.getAttribute("disabled") === "true") { this.close(); return 2; }
