+#ifndef widget_windows_WinUIPrototype_h
+#define widget_windows_WinUIPrototype_h
+#include <windows.h>
+
+#include "Units.h"
+#include "nsTArray.h"
+#include "nsString.h"
+class nsIFile;
+class nsNativeDragTarget;
+namespace mozilla::widget {
+bool IsNativeWindowHost(HWND);
+bool ProcessShellEnabled();
+// nsWindow's hidden window (the proxy) stands for a shell window that the native thread owns.
+// Returns the shell for a proxy, and any other window unchanged.
+HWND ShellOfProxy(HWND);
+// A startup shell if one waits, otherwise a new one; null without the independent host.
+HWND TakeNativeShell(DWORD aExStyle, DWORD aStyle, const RECT& aBounds);
+// Before nsWindow associates with the proxy, then after.
+bool LinkHiddenProxy(HWND aProxy, HWND aShell);
+bool HasHiddenProxy(HWND aProxy);
+bool AttachHiddenProxy(HWND aProxy, uintptr_t aIdentity);
+// Gecko's OLE thread registers its local target on the engine-owned page HWND.
+// Returns false for stock windows, whose registration remains in nsWindow.
+bool SetIndependentDropTarget(HWND aProxy, nsNativeDragTarget* aTarget);
+// Before the proxy is destroyed. Waits for the shell to apply earlier requests, then destroys it.
+void ReleaseHiddenProxy(HWND aProxy);
+// Return false for any window that is not a proxy; the shell applies the change later.
+bool ForwardProxyShow(HWND aProxy, int aCommand);
+void ShowHiddenProxy(HWND aProxy, bool aShow, int aSizeMode);
+// The native owner applies page cursors; another thread's SetCursor has no effect.
+void SetIndependentCursor(HWND, HCURSOR, bool custom);
+// Returns true when the native owner will register the window for touch.
+bool RegisterIndependentTouch(HWND);
+// The copied data of the pen message being delivered, which this thread cannot read from Windows.
+const POINTER_PEN_INFO* IndependentPenInfo(uint32_t pointerId);
+// Returns true when the independent native owner handles the request.
+bool FocusIndependentWindowHost(HWND);
+bool NativeStartupEditorOwnsForeground();
+void TraceWinUIPrototype(const char* aPhase, HWND aWindow = nullptr);
+bool UpdateWinUIPane(HWND aWindow, const RECT& aRect, bool aVisible,
+                     bool aFocus, bool aBackwards,
+                     const nsTArray<LayoutDeviceIntRect>& aOcclusions);
+uint32_t SyncWinUITabs(HWND aWindow, const nsTArray<uint32_t>& aIds,
+                       const nsTArray<nsString>& aTitles, const nsTArray<uint32_t>& aCommands, uint32_t aSelected, uint32_t aRevision);
+bool SyncWinUIAddress(HWND aWindow, const nsAString& aSnapshot);
+bool RequestWinUIShare(HWND, uint64_t, uint64_t, const nsAString&, const nsAString&);
+bool GetWinUIChromeLayout(HWND aWindow, uint32_t aStripHeight, bool aNavigation,
+                         uint32_t aInset, nsTArray<LayoutDeviceIntRect>& aRects);
+bool UpdateWinUIAddress(HWND aWindow, const RECT& aRect, bool aVisible,
+                       bool aFocus, bool aSelectAll);
+bool SyncWinUITabMenu(HWND aWindow, const nsAString& aSnapshot);
+// ABI v11 request path. The pane wakes the browser through a sink registered
+// here, which only posts a task to this thread's event queue; these are the
+// host side of that exchange. The notification topic is
+// "winui-pane-drain", whose data is the endpoint's HWND formatted the same way
+// nsIBaseWindow::nativeHandle formats it, so a chrome window can recognise its
+// own endpoint.
+bool DrainWinUIRequests(HWND aWindow, nsAString& aBatch);
+bool TransferWinUIStartup(HWND aWindow, const nsAString& aMessage, nsAString& aReply);
+bool CompleteWinUIRequests(HWND aWindow, const nsAString& aOutcomes);
+uint32_t ApplyWinUITabDelta(HWND aWindow, const nsAString& aDelta);
+void DestroyWinUIPane(HWND aWindow);
+bool TranslateWinUIPane(MSG& aMessage);
+void ShutdownWinUIPane();
+// Parent process, before any window: joins an unpackaged Firefox to the shared
+// Windows App SDK runtime the pane is built against. No-op when packaged.
+void InitializeWinUIRuntime();
+bool ShowNativeStartupSurface();
+bool PrepareDefaultNativeStartupHost(HINSTANCE, const wchar_t* = nullptr);
+bool PrepareRoutedNativeStartupHost(const char16_t*);
+// Parent process, profile locked and launch routing final, before any browser window.
+bool PrepareEarlyNativeStartupHost(nsIFile* aProfile, int aArgc, char** aArgv);
+void CancelRoutedNativeStartupHost();
+void DismissNativeStartupSurface(HWND);
