+let updateOwner = null;
+const RESOURCES = [
+  "branding/brand.ftl",
+  "browser/appmenu.ftl",
+  "browser/menubar.ftl",
+  "browser/toolbarContextMenu.ftl",
+  "browser/browser.ftl",
+  "browser/tabbrowser.ftl",
