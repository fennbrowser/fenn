+const id = value => typeof value === "string" && /^[1-9][0-9]{0,19}$/.test(value) &&
+  BigInt(value) <= 18446744073709551615n;
+
+// Commands, not publications: one pending execution and one retained receipt.
+// U64 identities stay decimal strings across JSON; never round through Number.
+export class WinUIStartupTransfer {
+  constructor(identity, backend) {
+    if (![identity?.context, identity?.session, identity?.generation].every(id)) {
+      throw new TypeError("Invalid startup identity");
+    }
+    this.identity = Object.freeze({ context: identity.context, session: identity.session, generation: identity.generation });
+    this.backend = backend;
+    this.mappings = new Map();
+    this.highWatermark = 0n;
+    this.latest = null;
+    this.closed = false;
+  }
+
+  disconnect() { this.closed = true; }
+
+  current() {
+    try { return !this.closed && this.backend.current(); }
+    catch { this.disconnect(); return false; }
+  }
+
+  execute(input) {
+    const reject = reason => Promise.resolve(Object.freeze({ terminal: false, accepted: false, reason }));
+    if (!this.current()) { this.disconnect(); return reject("disconnected"); }
+    if (!input || ![input.context, input.session, input.generation, input.request, input.draft].every(id) ||
+        ![1, 2, 3, 4, 5, 6].includes(input.kind) ||
+        Object.keys(this.identity).some(key => input[key] !== this.identity[key]) ||
+        (input.kind === 6 && (typeof input.text !== "string" || input.text.length > 32768 ||
+          ![0, 1].includes(input.modifiers) || !Number.isInteger(input.selectionStart) ||
+          !Number.isInteger(input.selectionLength) || input.selectionStart < 0 || input.selectionLength < 0 ||
+          input.selectionStart + input.selectionLength > input.text.length)) ||
+        (input.kind !== 1 && !id(input.browser)) ||
+        (input.kind === 2 && (typeof input.text !== "string" || !input.text.length || input.text.length > 32768 ||
+          !Number.isInteger(input.modifiers) || input.modifiers < 0 || input.modifiers > 7))) {
+      return reject("invalid-envelope");
+    }
+    // Copy only validated fields before yielding. Later caller mutation cannot
+    // rewrite a request already admitted for execution.
+    const command = Object.freeze({ ...this.identity, request: input.request, draft: input.draft,
+      kind: input.kind, browser: input.kind === 1 ? "0" : input.browser,
+      text: [2, 6].includes(input.kind) ? input.text : "", modifiers: [2, 6].includes(input.kind) ? input.modifiers : 0,
+      selectionStart: input.kind === 6 ? input.selectionStart : 0,
+      selectionLength: input.kind === 6 ? input.selectionLength : 0 });
+    const fingerprint = JSON.stringify(command);
+    if (this.latest?.command.request === command.request) {
+      return this.latest.fingerprint === fingerprint ? this.latest.promise : reject("conflicting-replay");
+    }
+    if (BigInt(command.request) <= this.highWatermark) return reject("stale-request");
+    if (this.latest && !this.latest.done) return reject("busy");
+    this.highWatermark = BigInt(command.request);
+    const entry = { command, fingerprint, done: false };
+    this.latest = entry;
+    entry.promise = Promise.resolve().then(async () => {
+      const current = () => this.current();
+      let browser = command.browser;
+      let accepted = false;
+      let uncertain = false;
+      try {
+        if (!current()) { this.disconnect(); return Object.freeze({ ...this.identity,
+          request: command.request, draft: command.draft, browser, terminal: false, accepted: false, reason: "disconnected" }); }
+        if (command.kind === 1) {
+          if (!this.mappings.has(command.draft) && this.mappings.size < 32) {
+            const created = await this.backend.create();
+            if (created !== null) {
+              browser = String(created);
+              if (!id(browser) || [...this.mappings.values()].includes(browser)) throw new Error("Invalid created tab identity");
+              this.mappings.set(command.draft, browser);
+              accepted = true;
+            }
+          }
+        } else if (command.kind === 4 || command.kind === 5) {
+          if (this.mappings.has(command.draft) &&
+              (command.kind === 4 ? ![...this.mappings.values()].includes(browser) : this.mappings.get(command.draft) === browser)) {
+            accepted = await this.backend.select(browser);
+            if (accepted && !this.backend.selected(browser)) throw new Error("Startup selection superseded");
+          }
+        } else if (this.mappings.get(command.draft) === browser) {
+          if (command.kind === 6) {
+            accepted = await this.backend.adopt(browser, command.text, command.selectionStart,
+              command.selectionLength, !!command.modifiers, current);
+          } else if (command.kind === 2) {
+            accepted = await this.backend.submit(browser, command.text, command.modifiers, current);
+          } else {
+            accepted = await this.backend.close(browser);
+            if (accepted) this.mappings.delete(command.draft);
+          }
+        }
+        if (!current()) { accepted = false; uncertain = true; }
+      } catch {
+        // A controller may have changed browser state before throwing. Freeze
+        // the connection rather than retry or claim a safe terminal rejection.
+        accepted = false; uncertain = true;
+      } finally {
+        entry.done = true;
+      }
+      if (uncertain) this.disconnect();
+      return Object.freeze({ ...this.identity, request: command.request, draft: command.draft,
+        browser, terminal: !uncertain, accepted: !!accepted, uncertain,
+        reason: accepted ? "completed" : uncertain ? "uncertain" : this.backend.reason?.() || "rejected" });
+    });
+    return entry.promise;
+  }
+}
+
+// Browser identity publication only. No session-file parsing or tab adoption.
+export class WinUIStartupRowsPublisher {
+  constructor(identity, send, capture) {
+    this.identity = identity;
+    this.send = send;
+    this.capture = capture;
+    this.revision = 0n;
+    this.fingerprint = null;
+    this.rows = [];
+  }
+
+  async publish(force = false) {
+    const snapshot = this.capture();
+    if (!snapshot) return this.rows; // Transient selection during tab teardown.
+    const { ids, selected } = snapshot;
+    if (!Array.isArray(ids) || ids.length > 4096 || !ids.every(id) ||
+        new Set(ids).size !== ids.length ||
+        (ids.length ? !ids.includes(selected) : selected !== "0")) throw new Error("Invalid browser rows");
+    const fingerprint = JSON.stringify([ids, selected]);
+    if (!force && fingerprint === this.fingerprint) return this.rows;
+    const revision = fingerprint === this.fingerprint ? this.revision : this.revision + 1n;
+    if (revision > 18446744073709551615n) throw new Error("Startup row revision exhausted");
+    const result = await this.send(11, { revision: String(revision), ids, selected });
+    if (Object.keys(this.identity).some(key => result[key] !== this.identity[key]) ||
+        !Array.isArray(result.rows) || result.rows.length > 4128) throw new Error("Invalid row projection");
+    const seen = new Set();
+    for (const row of result.rows) {
+      if (!Array.isArray(row) || row.length !== 4 || !Number.isInteger(row[0]) || row[0] <= 0 ||
+          row[0] > 4294967295 || seen.has(row[0]) ||
+          !(row[1] === "0" || id(row[1])) || !(row[2] === "0" || id(row[2])) ||
+          (row[1] === "0" && row[2] === "0") || typeof row[3] !== "boolean")
+        throw new Error("Invalid row identity");
+      seen.add(row[0]);
+    }
+    this.revision = revision;
+    this.fingerprint = fingerprint;
+    this.rows = result.rows;
+    return this.rows;
+  }
+}
+
+// The native side answers each startup transfer later, by token (WinUIPaneApi v41).
+const pendingReplies = new Map();
+let observingReplies = false;
+function observeReplies() {
+  if (observingReplies) return;
+  observingReplies = true;
+  Services.obs.addObserver({ observe(_subject, _topic, data) {
+    const split = data.search(/[:!]/);
+    const entry = split > 0 && pendingReplies.get(data.slice(0, split));
+    if (!entry) return;
+    pendingReplies.delete(data.slice(0, split));
+    if (data[split] === "!") {
+      entry.reject(new Error(`Native startup transfer refused: operation ${entry.operation}, 0x${data.slice(split + 1)}`));
+      return;
+    }
+    try { entry.resolve(JSON.parse(data.slice(split + 1))); } catch (error) { entry.reject(error); }
+  } }, "winui-startup-reply");
+}
+export function transferStartup(window, message) {
+  observeReplies();
+  let token;
+  try { token = window.windowUtils.transferWinUIStartup(JSON.stringify(message)); }
+  catch (error) { return Promise.reject(error); }
+  if (!token) return Promise.reject(new Error("Native startup transfer unavailable"));
+  return new Promise((resolve, reject) => pendingReplies.set(token, { resolve, reject, operation: message.operation }));
+}
+
+// One lease, one execution, one terminal acknowledgment. A wake is a hint, not
+// permission to replay an in-flight command. Failure freezes automatic draining.
+export class WinUIStartupConnection {
+  constructor(identity, consumer, transport, schedule = callback => setTimeout(callback, 0)) {
+    this.identity = Object.freeze({ ...identity });
+    this.consumer = consumer;
+    this.transport = transport;
+    this.schedule = schedule;
+    this.running = null;
+    this.again = false;
+    this.stopped = false;
+    this.lastOutcome = null;
+    // Held until the caller has finished its setup: a wake meanwhile, such as the one a drain
+    // brings, is only recorded. Setup spans several turns now that replies are asynchronous.
+    this.held = true;
+  }
+
+  start() {
+    this.held = false;
+    return this.wake();
+  }
+
+  send(operation, fields = {}) {
+    return this.transport({ version: 1, ...this.identity, operation, ...fields });
+  }
+
+  disconnect() {
+    if (this.stopped) return;
+    this.stopped = true;
+    this.onDisconnect?.();
+    this.consumer.disconnect();
+    this.send(7).catch(() => { /* Endpoint teardown is already terminal. */ });
+  }
+
+  wake() {
+    if (this.stopped) return Promise.resolve();
+    if (this.held) { this.again = true; return Promise.resolve(); }
+    if (this.running) { this.again = true; return this.running; }
+    this.running = Promise.resolve().then(async () => {
+      try {
+        for (let count = 0; count < 16 && !this.stopped; count++) {
+          this.again = false;
+          const command = await this.send(8);
+          if (command.lost || Object.keys(this.identity).some(key => command[key] !== this.identity[key]))
+            throw new Error("Startup lease identity changed");
+          if (!command.kind) { await this.publishRows?.(true); return; }
+          const outcome = await this.consumer.execute(command);
+          this.lastOutcome = outcome;
+          if (this.stopped) return;
+          if (!outcome.terminal || outcome.uncertain ||
+              ["context", "session", "generation", "request", "draft"].some(key => outcome[key] !== command[key])) {
+            this.disconnect(); return;
+          }
+          const acknowledged = await this.send(6, { request: outcome.request, browser: outcome.browser, accepted: outcome.accepted });
+          // Only an acknowledged background adoption retires this mapping.
+          // A locally closed draft still needs it for the explicit Close command.
+          if (command.kind === 6 && outcome.accepted && acknowledged.mappings < command.mappings)
+            this.consumer.mappings.delete(command.draft);
+          await this.publishRows?.(true);
+          if (!outcome.accepted) {
+            this.again = false;
+            if (command.kind !== 4 && command.kind !== 5 && command.kind !== 6) this.disconnect();
+            return;
+          }
+        }
+        this.again = !this.stopped;
+      } catch (error) {
+        this.lastOutcome = { terminal: false, accepted: false, uncertain: true, reason: "transport-failed" };
+        this.disconnect();
+      }
+    }).finally(() => {
+      this.running = null;
+      if (this.again && !this.stopped) this.schedule(() => this.wake());
+    });
+    return this.running;
+  }
+}
+
+// Explicit integration entry; normal startup does not call this until restore
+// and same-control presentation reconciliation are installed. The trusted caller
+// supplies the context token only after resolving the profile/privacy binding.
+export async function connectFirefoxStartup(window, context, generation) {
+  if (!id(context) || !id(generation)) throw new TypeError("Invalid startup binding");
+  const pane = window.gWinUIPane;
+  if (!pane || pane.startupConnection) throw new Error("Startup connection already active or unavailable");
+  const transport = message => transferStartup(window, message);
+  const prepared = await transport({ version: 1, operation: 1, context });
+  const identity = { context, session: prepared.session, generation };
+  let connection;
+  try {
+    const consumer = createFirefoxStartupTransfer(window, identity);
+    connection = new WinUIStartupConnection(identity, consumer, transport,
+      callback => Services.tm.dispatchToMainThread(callback));
+    connection.onDisconnect = () => {
+      if (pane.startupConnection === connection) pane.startupConnection = null;
+    };
+    const publisher = new WinUIStartupRowsPublisher(identity,
+      (operation, fields) => connection.send(operation, fields), () => {
+        if (!consumer.current()) throw new Error("Startup browser context lost");
+        const tabs = pane.visibleTabs();
+        const ids = tabs.map(tab => {
+          if (!pane.tabIds.has(tab)) pane.tabIds.set(tab, pane.nextTabId++);
+          return String(pane.tabIds.get(tab));
+        });
+        const selected = String(pane.tabIds.get(window.gBrowser.selectedTab) || 0);
+        return ids.length && !ids.includes(selected) ? null : { ids, selected: ids.length ? selected : "0" };
+      });
+    const publishOnce = async force => {
+      connection.rows = await publisher.publish(force);
+      if (!connection.presentationActive || connection.stopped) return;
+      let state = await connection.send(0);
+      if ((state.editorBrowser || "0") === "0" && !state.kind && !state.lost) {
+        state = await connection.send(14, { browser: String(pane.tabIds.get(window.gBrowser.selectedTab) || 0) });
+        connection.rows = await publisher.publish(true);
+      }
+      const selected = connection.rows.find(row => row[3]);
+      if (!connection.rows.some(row => row[1] !== "0") && (state.editorBrowser || "0") === "0" &&
+          selected && !state.kind && !state.mappings && !state.lost) {
+        state = await connection.send(13, { browser: selected[2] });
+      }
+      if (state.adoptionReady && !state.kind) {
+        pane.addressPublication = null;
+        pane.syncAddress();
+        state = await connection.send(0);
+      }
+      const target = state.editorBrowser || "0";
+      connection.editorReady = target !== "0";
+      if (target !== connection.editorTarget) {
+        connection.editorTarget = target;
+        pane.addressPublication = null;
+        if (connection.editorReady) pane.syncAddress();
+      }
+      if (connection.adoptDrafts && connection.editorReady && !state.kind && !state.mappings &&
+          !connection.rows.some(row => row[1] !== "0") && (await connection.send(18)).normal) {
+        connection.presentationActive = false;
+        connection.stopped = true;
+        consumer.disconnect();
+        pane.startupConnection = null;
+        // The startup presenter intentionally ignored normal strip metadata. Its
+        // retirement reply is the ordering barrier: seed that stream completely
+        // before the next tab snapshot can render against its grouped layout.
+        pane.publishStrip(true);
+        pane.structuralDirty = true;
+        pane.syncTabs();
+        pane.publish(true);
+        pane.addressPublication = null;
+        pane.syncAddress();
+      }
+    };
+    // One publication at a time, in order: a request asked for meanwhile runs once after it.
+    connection.publishRows = force => {
+      if (connection.stopped) return Promise.resolve();
+      connection.rowsForce ||= !!force;
+      // Until binding (operation 2) is answered a publication is only recorded: the first one
+      // after it carries every request, so rows never precede the binding.
+      if (!connection.bound) return Promise.resolve();
+      if (connection.rowsRunning) { connection.rowsAgain = true; return connection.rowsRunning; }
+      connection.rowsRunning = (async () => {
+        try {
+          do {
+            connection.rowsAgain = false;
+            const forced = connection.rowsForce;
+            connection.rowsForce = false;
+            await publishOnce(forced);
+          } while (connection.rowsAgain && !connection.stopped);
+        } catch (error) { connection.rowFailure = String(error); connection.disconnect(); }
+        finally { connection.rowsRunning = null; }
+      })();
+      return connection.rowsRunning;
+    };
+    // The pane can publish rows from here on, while the binding is answered.
+    pane.startupConnection = connection;
+    await transport({ version: 1, operation: 2, ...identity });
+    connection.bound = true;
+    await connection.publishRows();
+    connection.enableNormalTabs = async () => {
+      await connection.send(17);
+      connection.adoptDrafts = true;
+    };
+    connection.attachPresenter = async () => {
+      if (connection.stopped || !consumer.current()) throw new Error("Startup connection unavailable");
+      pane.syncTabs();
+      await connection.send(12);
+      connection.presentationActive = true;
+      await connection.publishRows(true);
+    };
+    window.addEventListener("unload", () => connection.disconnect(), { once: true });
+    // The caller starts the connection after its own setup, so the first command request (operation 8)
+    // follows presenter attachment and normal-tab enablement, as it did when they were synchronous.
+    return connection;
+  } catch (error) {
+    if (pane.startupConnection === connection) pane.startupConnection = null;
+    transport({ version: 1, operation: 7, ...identity }).catch(() => {});
+    throw error;
+  }
+}
+
+// Called only from a trusted, window-scoped adapter. The native transport must
+// validate its matching profile/privacy context before constructing the consumer.
+export function createFirefoxStartupTransfer(window, identity) {
+  const { PrivateBrowsingUtils } = ChromeUtils.importESModule("resource://gre/modules/PrivateBrowsingUtils.sys.mjs");
+  const pane = window.gWinUIPane;
+  const browser = window.gBrowser;
+  if (!pane || !browser) throw new Error("Browser startup adapter is unavailable");
+  const profile = Services.dirsvc.get("ProfD", Ci.nsIFile).path;
+  const privateWindow = PrivateBrowsingUtils.isWindowPrivate(window);
+  const current = () => !window.closed && window.gBrowser === browser &&
+    window.gWinUIPane === pane && Services.dirsvc.get("ProfD", Ci.nsIFile).path === profile &&
+    PrivateBrowsingUtils.isWindowPrivate(window) === privateWindow;
+  const resolve = token => [...browser.tabs].find(tab => String(pane.tabIds.get(tab)) === token &&
+    tab.isConnected && !tab.closing);
+  let reason = "rejected";
+  const refuse = value => { reason = value; return false; };
+  return new WinUIStartupTransfer(identity, {
+    current,
+    reason: () => reason,
+    selected(token) { return browser.selectedTab === resolve(token); },
+    select(token) {
+      const tab = resolve(token);
+      if (!tab || tab.hidden || !tab.visible) return refuse("target-unavailable");
+      if (window.gDialogBox.isOpen || pane.processingAction) return refuse("browser-busy");
+      browser.selectedTab = tab;
+      pane.syncAddress();
+      if (browser.selectedTab !== tab) throw new Error("Startup selection superseded");
+      return true;
+    },
+    create() {
+      if (window.gDialogBox.isOpen || pane.processingAction) return null;
+      const tab = browser.addTrustedTab("about:blank", { inBackground: true });
+      if (!pane.tabIds.has(tab)) pane.tabIds.set(tab, pane.nextTabId++);
+      return String(pane.tabIds.get(tab));
+    },
+    adopt(token, text, start, length, selected, live) {
+      const tab = resolve(token);
+      if (!live() || !tab || tab.hidden || !tab.visible) return refuse("target-unavailable");
+      if (pane.processingAction || window.gDialogBox.isOpen) return refuse("browser-busy");
+      if (selected) {
+        browser.selectedTab = tab;
+        pane.syncAddress();
+        const session = pane.addressSession;
+        if (!session || session.closed || browser.selectedTab !== tab) return refuse("address-unavailable");
+        session.cancel();
+        session.beginNativePresentation();
+        session.input.setNativeInputValue(text);
+        session.input.userTypedValue = text;
+        session.input.inputField.setSelectionRange(start, start + length);
+      } else {
+        tab.linkedBrowser.userTypedValue = text;
+      }
+      // Firefox owns restoration when this background tab is subsequently selected.
+      window.gURLBar.getBrowserState(tab.linkedBrowser).selection = {
+        start, end: start + length, shouldUntrim: true,
+      };
+      pane.addressPublication = null;
+      return true;
+    },
+    async submit(token, text, modifiers, live) {
+      const tab = resolve(token);
+      if (!tab || tab.hidden || !tab.visible) return refuse("target-unavailable");
+      if (pane.processingAction || window.gDialogBox.isOpen) return refuse("browser-busy");
+      browser.selectedTab = tab;
+      pane.syncAddress();
+      const session = pane.addressSession;
+      if (!session || session.closed) return refuse("address-unavailable");
+      pane.processingAction = true;
+      try {
+        session.beginNativePresentation();
+        session.nativeOpen = true;
+        const editId = session.editId + 1;
+        const result = await session.edit({ version: 1, session: session.sessionId,
+          revision: session.revision, editId, text, selectionStart: text.length,
+          selectionEnd: text.length, composing: false, inputType: "insertReplacementText" });
+        if (!live() || browser.selectedTab !== tab || resolve(token) !== tab || tab.hidden || !tab.visible)
+          return refuse("target-changed");
+        if (pane.addressSession !== session || session.editId !== editId) return refuse("edit-superseded");
+        if (result.status !== "queried") return refuse("query-" + result.status);
+        if (window.gDialogBox.isOpen) return refuse("browser-busy");
+        const activated = session.submitStartup(result.revision, editId, { shiftKey: !!(modifiers & 1),
+          ctrlKey: !!(modifiers & 2), altKey: !!(modifiers & 4), metaKey: false });
+        return activated === "activated" || refuse(activated);
+      } finally {
+        pane.processingAction = false;
+        pane.addressPublication = null;
+        pane.invalidateAddress();
+        pane.resumePublication();
+      }
+    },
+    close(token) {
+      const tab = resolve(token);
+      if (!tab) return true;
+      if (browser.isTabPendingPermitUnload(tab) || window.gDialogBox.isOpen || pane.processingAction) return false;
+      pane.processingAction = true;
+      try {
+        browser.removeTab(tab, { animate: false });
+        return !tab.isConnected || tab.closing;
+      } finally {
+        pane.processingAction = false;
+        pane.structuralDirty = true;
+        pane.resumePublication();
+      }
+    },
+  });
+}
diff --git a/dom/ipc/FennPageGeometry.cpp b/dom/ipc/FennPageGeometry.cpp
new file mode 100644
index 00000000000..975fd14c587
--- /dev/null
+++ b/dom/ipc/FennPageGeometry.cpp
@@ -0,0 +1,34 @@
+/* Licensed under the Mozilla Public License, v. 2.0. */
+#include "mozilla/dom/BrowserChild.h"
+#include "mozilla/IMEStateManager.h"
+#include "mozilla/TextEvents.h"
+#include "PuppetWidget.h"
+#include "nsFocusManager.h"
+
+namespace mozilla::dom {
+mozilla::ipc::IPCResult BrowserChild::RecvFennQueryPageGeometry(
+    const uint32_t& aOffset, const uint32_t& aLength,
+    FennQueryPageGeometryResolver&& aResolve) {
+  FennPageGeometryResult result(false, LayoutDeviceIntRect(), LayoutDeviceIntRect());
+  RefPtr<Element> focused=nsFocusManager::GetFocusedElementStatic();
+  if(!mPuppetWidget || !focused || aLength>65536 ||
+      uint64_t(aOffset)+aLength>UINT32_MAX ||
+      IMEStateManager::GetWidgetForTextInputHandling()!=mPuppetWidget) {
+    aResolve(result);return IPC_OK();
+  }
+  // Query in the process which owns the editor, not the parent's limited IME
+  // composition cache. No text or document object crosses this reply boundary.
+  WidgetQueryContentEvent text(true,aLength ? eQueryTextRect : eQueryCaretRect,mPuppetWidget);
+  if(aLength)text.InitForQueryTextRect(aOffset,aLength);
+  else text.InitForQueryCaretRect(aOffset);
+  mPuppetWidget->DispatchEvent(&text);
+  WidgetQueryContentEvent editor(true,eQueryEditorRect,mPuppetWidget);
+  mPuppetWidget->DispatchEvent(&editor);
+  if(text.Succeeded() && editor.Succeeded() &&
+      nsFocusManager::GetFocusedElementStatic()==focused &&
+      IMEStateManager::GetWidgetForTextInputHandling()==mPuppetWidget) {
+    result=FennPageGeometryResult(true,text.mReply->mRect,editor.mReply->mRect);
+  }
+  aResolve(result);return IPC_OK();
+}
+}
diff --git a/mozglue/misc/FennStartupWindow.cpp b/mozglue/misc/FennStartupWindow.cpp
new file mode 100644
index 00000000000..1e4f85ac782
--- /dev/null
+++ b/mozglue/misc/FennStartupWindow.cpp
@@ -0,0 +1,161 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "FennStartupWindow.h"
+#include <cstring>
+#include <cstdlib>
+#include <initializer_list>
+#include "../../widget/windows/WinUIPaneApi.h"
+#include <appmodel.h>
+#include "mozilla/BaseProfilerMarkers.h"
+
+namespace mozilla {
+// A thread-confined, one-use HWND resource slot. Browser binding and close
+// decisions move to ShellCore when the native pane takes ownership.
+// mozglue also loads in sandbox children: never add static user32 imports.
+static decltype(&::IsWindow) sIsWindow;
+static bool LoadWindowFunctions() {
+  HMODULE user = LoadLibraryExW(L"user32.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!user) return false;
+  sIsWindow = reinterpret_cast<decltype(sIsWindow)>(GetProcAddress(user, "IsWindow"));
+  return sIsWindow != nullptr;
+}
+static HWND sWindow;
+static DWORD sThread;
+static bool sMode;
+static bool sIndependent;
+static WinUIPaneGetApiFn sGetPane;
+static bool sTaken;
+static WinUIPaneGetApiFn sProcessPane;
+bool FennProcessShellRequested() {
+  wchar_t value[2]{}, host[2]{};
+  const DWORD processSize = GetEnvironmentVariableW(L"FENN_NATIVE_SHELL_PROCESS", value, 2);
+  const DWORD hostSize = GetEnvironmentVariableW(L"FENN_NATIVE_STARTUP_HOST", host, 2);
+  if (hostSize == 1 && host[0] == L'0') return false;
+  if (processSize) return processSize == 1 && value[0] == L'1';
+  // An explicit retained-host fixture remains in-process. Otherwise only the
+  // development build selects the process shell before profile preferences load.
+  if (hostSize || !FennDevelopmentNativeHostDefault()) return false;
+  // Some launches skip the pre-XUL skeleton hook. Normalize at the first route
+  // read, so late native binding, JS observers and replacements share one choice.
+  // NSPR/Services.env reads the CRT environment; SetEnvironmentVariable alone
+  // would update spawned peers but leave the current JS observers unchanged.
+  _putenv_s("FENN_NATIVE_SHELL_PROCESS", "1");
+  for (const char* name : {"FENN_NATIVE_SHELL_RECOVERY", "FENN_NATIVE_ENGINE_RECOVERY"}) {
+    if (!GetEnvironmentVariableA(name, nullptr, 0)) _putenv_s(name, "1");
+  }
+  return true;
+}
+bool PrepareFennProcessShell(HINSTANCE, int argc, char** argv) {
+  if (!FennProcessShellRequested()) return false;
+  if (GetEnvironmentVariableW(L"MOZ_HEADLESS", nullptr, 0)) return false;
+  // Actual browser parent, after launcher handoff and ProcessRuntime/DPI setup.
+  // Unknown/admin/headless/child modes defer to Firefox without a speculative process.
+  const char* profile="";
+  for(int i=1;i<argc;++i) {
+    const char* arg=argv[i];if(!arg || *arg!='-')continue;while(*arg=='-')++arg;
+    if(!_stricmp(arg,"profile") || !_stricmp(arg,"p") || !_stricmp(arg,"url") || !_stricmp(arg,"remote-debugging-port")) {
+      if(i+1>=argc || !*argv[i+1] || *argv[i+1]=='-')return false;
+      if(!_stricmp(arg,"profile"))profile=argv[i+1];++i;continue;
+    }
+    if(!_stricmp(arg,"no-remote") || !_stricmp(arg,"new-instance") || !_stricmp(arg,"new-window") ||
+       !_stricmp(arg,"new-tab") || !_stricmp(arg,"private-window") || !_stricmp(arg,"marionette") ||
+       !_stricmp(arg,"foreground") || !_stricmp(arg,"wait-for-browser") || !_stricmp(arg,"osint") ||
+       !_stricmp(arg,"remote-allow-system-access"))continue;
+    return false;
+  }
+  wchar_t path[32768]{}, wide[32768]{};
+  const DWORD length=GetModuleFileNameW(nullptr,path,32768);auto* name=length && length<32768?wcsrchr(path,L'\\'):nullptr;
+  if(!name || size_t(name-path)+64>=32768 || !MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,profile,-1,wide,32768))return false;
+  wcscpy(name+1,L"FennEngineLink.dll");
+  HMODULE module=LoadLibraryExW(path,nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_APPLICATION_DIR|LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if(!module)return false;
+  sProcessPane=reinterpret_cast<WinUIPaneGetApiFn>(GetProcAddress(module,"WinUIPaneGetApi"));
+  WinUIPaneApi api{};
+  return sProcessPane && SUCCEEDED(sProcessPane(WINUI_PANE_ABI_VERSION,sizeof(api),&api)) &&
+      api.startProcessHost && SUCCEEDED(api.startProcessHost(wide,nullptr,0));
+}
+bool FennDevelopmentNativeHostDefault() {
+#ifdef FENN_DEVELOPMENT_NATIVE_HOST
+  return true;
+#else
+  return false;
+#endif
+}
+bool FennIndependentHostRequested() {
+  if(FennProcessShellRequested())return false;
+  wchar_t value[2]{};
+  DWORD size=GetEnvironmentVariableW(L"FENN_NATIVE_STARTUP_HOST",value,2);
+  return size ? size==1 && value[0]==L'2' : FennDevelopmentNativeHostDefault();
+}
+bool PrepareFennStartupWindowForProfile(HINSTANCE instance,const wchar_t* profilePath,const wchar_t* presentation) {
+  if(sThread || sTaken || !profilePath || !LoadWindowFunctions())return false;
+  sThread=GetCurrentThreadId();
+  auto prepare=[&]() -> bool {
+    wchar_t path[32768]{};
+    DWORD size = GetModuleFileNameW(nullptr,path,32768);
+    wchar_t* name = size && size < 32768 ? wcsrchr(path,L'\\') : nullptr;
+    if (!name || size_t(name-path)+128 >= 32768) return false;
+    ++name;
+    UINT32 packageLength=0;
+    if (GetCurrentPackageFullName(&packageLength,nullptr)==APPMODEL_ERROR_NO_PACKAGE) {
+      wcscpy(name,WINUI_PANE_RUNTIME_BOOTSTRAP_DLL);
+      HMODULE bootstrap=LoadLibraryExW(path,nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_SYSTEM32);
+      if (!bootstrap) return false;
+      using Init=HRESULT(WINAPI*)(UINT32,PCWSTR,PACKAGE_VERSION,UINT32);
+      auto init=reinterpret_cast<Init>(GetProcAddress(bootstrap,"MddBootstrapInitialize2"));
+      PACKAGE_VERSION minimum{}; minimum.Version=WINUI_PANE_RUNTIME_MIN_VERSION;
+      if (!init || FAILED(init(WINUI_PANE_RUNTIME_MAJOR_MINOR,L"",minimum,0x10))) return false;
+    }
+    wcscpy(name,L"FennPane.dll");
+    HMODULE pane=LoadLibraryExW(path,nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_APPLICATION_DIR|LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!pane) return false;
+    sGetPane=reinterpret_cast<WinUIPaneGetApiFn>(GetProcAddress(pane,"WinUIPaneGetApi"));
+    WinUIPaneApi api{};
+    if (!sGetPane || FAILED(sGetPane(WINUI_PANE_ABI_VERSION,sizeof(api),&api)) ||
+        !api.startIndependentHost || FAILED(api.startIndependentHost(profilePath,presentation,&sWindow))) return false;
+    sMode=true;sIndependent=true;
+    BASE_PROFILER_MARKER_UNTYPED("FennIndependentStartupWindowCreated", OTHER);
+    return true;
+  };
+  if(prepare())return true;
+  sThread=0;sMode=false;sIndependent=false;return false;
+}
+bool FennStartupWindowMode() { return sMode; }
+bool FennStartupWindowIndependent() { return sIndependent; }
+bool FennStartupWindowClaimed() { return sTaken; }
+bool FennStartupWindowReady() { return sMode && !sTaken && sWindow && sIsWindow(sWindow); }
+HWND PeekFennStartupWindow() {
+  return GetCurrentThreadId() == sThread && FennStartupWindowReady() ? sWindow : nullptr;
+}
+HWND TakeFennStartupWindow() {
+  if (GetCurrentThreadId() != sThread || !FennStartupWindowReady()) return nullptr;
+  sTaken = true;
+  HWND result = sWindow;
+  sWindow = nullptr;
+  return result;
+}
+bool FennNativeHostFailed() {
+  wchar_t value[2]{};
+  return GetEnvironmentVariableW(L"FENN_NATIVE_HOST_FAILED", value, 2) == 1 && value[0] == L'1';
+}
+void AbandonFennStartupWindow() {
+  CleanupFennStartupWindow();
+  sMode = false;
+  sIndependent = false;
+  sThread = 0;
+  sTaken = false;
+  sWindow = nullptr;
+}
+void CleanupFennStartupWindow() {
+  if(sProcessPane) {
+    WinUIPaneApi api{};if(SUCCEEDED(sProcessPane(WINUI_PANE_ABI_VERSION,sizeof(api),&api)))api.shutdown();
+    sProcessPane=nullptr;
+  }
+  if (sIndependent && sGetPane) {
+    WinUIPaneApi api{};
+    if (SUCCEEDED(sGetPane(WINUI_PANE_ABI_VERSION,sizeof(api),&api))) api.shutdown();
+    sWindow=nullptr;
+  }
+}
+}
