+++ b/browser/components/urlbar/content/UrlbarQueryModel.mjs
@@ -0,0 +1,343 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+import { UrlbarQueryContext } from "chrome://browser/content/urlbar/UrlbarQueryContext.mjs";
+import { isSchemelessInput, losslessDecodeURL } from "chrome://browser/content/urlbar/UrlbarUrlValue.mjs";
+
+/** Firefox query policy over explicit state, without retaining an input/view. */
+export class UrlbarQueryModel {
+  /** Retained engine-search terms prefer the current-value result's suggestion/query. */
+  static engineSearchTerms(result, lastSearchString) {
+    return (result && (result.payload.suggestion || result.payload.query)) || lastSearchString;
+  }
+
+  /** Preserve retained short-circuiting: result text is read only for typed non-tip, non-heuristic results. */
+  static safeToPickNavigationResult(result, state) {
+    return !!(result && (result.heuristic || !state.valueIsTyped || result.type == UrlbarShared.RESULT_TYPE.TIP ||
+      state.value == state.getResultValue(result)));
+  }
+
+  /** Retained selected-element precedence, including the private-engine exception. */
+  static pickSelectedNavigationResult({ isComposing, hasSelectedElement, hasSearchModeEngine,
+    hasOneOffEngine, selectedPrivateEngineResult, safeToPickResult }) {
+    return !!(!isComposing && hasSelectedElement && !hasSearchModeEngine &&
+      (!hasOneOffEngine || selectedPrivateEngineResult) && safeToPickResult);
+  }
+
+  /** Called only when there is no selected result and the displayed value starts with @. */
+  static pickTokenAliasResult(result) {
+    return !!(result?.autofill && result?.payload.keyword);
+  }
+
+  /** Query start stops before reset/confirmation when suppressed, after them in overflow. */
+  static startQueryDisposition({ suppressStartQuery = false, inOverflowPanel = false } = {}) {
+    return suppressStartQuery ? "suppressed" : inOverflowPanel ? "overflow" : "dispatch";
+  }
+
+  /** Final row/popup policy; one-off visibility may resolve asynchronously. */
+  static finishedQueryPresentation({ updatedResults, searchMode, oneOffsWillHide = null, open = false }) {
+    const rows = updatedResults ? "remove-stale" : "clear";
+    let action = "keep";
+    if (!updatedResults) {
+      if (!searchMode) action = "close";
+      else if (oneOffsWillHide === null) action = "resolve-one-offs";
+      else if (!oneOffsWillHide) action = "open-one-offs";
+      else if (open) action = "close";
+    }
+    return Object.freeze({ rows, action });
+  }
+
+  /** Firefox's aggregate zero-prefix counter is tied to successful query completion. */
+  static finishedQueryRecording({ cancelled, searchString }) {
+    return !cancelled && !searchString ? "exposure" : null;
+  }
+
+  /** Measurement policy for a surface that was actually open before closing. */
+  static closeRecording({ open, focused, elementPicked, zeroPrefix }) {
+    return Object.freeze({ discardEngagement: !!(open && !focused && !elementPicked),
+      zeroPrefix: open && zeroPrefix ? (elementPicked ? "engagement" : "abandonment") : null });
+  }
+
+  /** Input popup policy; host effects remain separate from composition policy. */
+  static inputPresentation({ value, open, suggestTopSites, searchMode, oneOffsHaveView }) {
+    const clearResults = !open || (!value && !suggestTopSites);
+    const close = open && clearResults && !(searchMode && oneOffsHaveView);
+    return Object.freeze({ rollupPopups: !!open, clearResults, close,
+      removeAccessibleFocus: !close, stopQuery: close });
+  }
+
+  /** Primary user-activation events accepted by independent activation/recording. */
+  static isResultActivationEvent(event) {
+    return !!(((event?.type === "keydown" && event.key === "Enter") ||
+      (["click", "auxclick"].includes(event?.type) && [0, 1].includes(event.button))) &&
+      Number.isFinite(event.timeStamp) && event.timeStamp >= 0);
+  }
+
+  /** Pre-selection adaptive-backspace cleanup, before specialized result actions. */
+  static autofillBackspaceURL(result, isPrivate) {
+    return UrlbarPrefs.get("autoFill.adaptiveHistory.enabled") && result.autofill &&
+      result.payload?.url && !isPrivate ? result.payload.url : null;
+  }
+
+  /** Describe history writes at activation; planning itself performs no persistence. */
+  static resultHistoryEffects(result, loadRequest, { searchString, isPrivate }) {
+    let inputHistory = null, reintegrateURL = null;
+    if (!isPrivate && loadRequest?.urlLoad) {
+      const url = loadRequest.urlLoad.url;
+      let input;
+      if (!result.heuristic) input = searchString;
+      else if (["adaptive_url", "adaptive_origin"].includes(result.autofill?.type)) {
+        input = result.autofill.adaptiveHistoryInput;
+      } else if (UrlbarPrefs.get("autoFill.adaptiveHistory.enabled") &&
+          result.autofill?.type === "origin" && searchString?.length > 0) {
+        // Derived origin roots may not have a Places row until the visit lands.
+        inputHistory = Object.freeze({ url, input: searchString, whenReady: true });
+      }
+      if (input !== undefined) inputHistory = Object.freeze({ url, input, whenReady: false });
