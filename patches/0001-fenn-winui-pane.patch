+          if (this.tabMenuSession !== session || session.active?.session !== action.session) return;
+          if (session.revalidateActive()) this.publishMenu(session.snapshot());
+          else this.publishMenu(answer);
+        }).catch(error => console.error("Native container icons failed", error));
+      } else this.publishMenu(session.snapshot());
+    } else if (!accepted || action.kind === "activate") {
+      this.publishMenu(session.snapshot());
