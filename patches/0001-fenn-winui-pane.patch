@@ -0,0 +1,39 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Transitional binding to the retained input. This is the remaining input
+// dependency, kept separate from the shared model and from switcher rendering.
+import { UrlbarSearchModeModel } from "chrome://browser/content/urlbar/UrlbarSearchModeModel.mjs";
+import { UrlbarContentUtils } from "chrome://browser/content/urlbar/UrlbarContentUtils.mjs";
+
+const lazy = typeof ChromeUtils != "undefined" ? {} : null;
+if (lazy) ChromeUtils.defineESModuleGetters(lazy, {
+  OpenSearchManager: "moz-src:///browser/components/search/OpenSearchManager.sys.mjs",
+  SearchUIUtils: "moz-src:///browser/components/search/SearchUIUtils.sys.mjs",
+});
+
+export function bindSearchModeModel(input) {
+  return new UrlbarSearchModeModel({
+    sapName: input.sapName,
+    engineStore: input.controller.engineStore,
+    l10n: new Localization(["browser/browser.ftl"]),
+    readState: () => ({value: input.value,
+      pageProxyValid: input.getAttribute("pageproxystate") == "valid",
+      searchMode: input.searchMode}),
+    offeredEngines: () => {
+      const browser = input.window.gBrowser?.selectedBrowser;
+      return browser ? lazy.OpenSearchManager.getInstallableEngines(browser) : [];
+    },
+    installEngine: engine => lazy.SearchUIUtils.addOpenSearchEngine(
+      engine.uri, engine.icon, input.window.gBrowser.selectedBrowser.browsingContext),
+    whereToOpenLink: event => UrlbarContentUtils.whereToOpenLink(event),
+    search: (value, options) => input.search(value, options),
+    exit: () => { input.searchMode = null; },
+    openEngine: (value, options) => input.openSearchEnginePage(value, options),
+    openPreferences: () => input.parentController.openPreferences("paneSearch"),
+    recordPicked: kind => {
+      if (input.sapName == "urlbar") Glean.urlbarUnifiedsearchbutton.picked[kind].add(1);
+    },
+  });
+}
