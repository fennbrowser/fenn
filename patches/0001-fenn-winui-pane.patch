+let nextSession = 0;
+
+const TALLY_FILE = "fenn-address-engine.json";
+const TALLY_DELAY_MS = 10000;
+const TALLY_DAYS = 60;
+// The bar for retiring the retained session (the native address host binding plan).
+const BAR = Object.freeze({ minAttempts: 200, maxDroppedPer200: 1, maxErrors: 0 });
