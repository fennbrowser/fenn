+  }
+
+  rowLabel(result, context) {
+    if (!UrlbarPrefs.get("groupLabels.enabled")) {
+      return null;
+    }
+
+    if (result.rowLabel) {
+      return result.rowLabel;
+    }
+
+    let engineName =
+      result.payload.engine || this.input.controller.engineStore.default?.name;
+
+    if (result.payload.trending) {
+      return {
