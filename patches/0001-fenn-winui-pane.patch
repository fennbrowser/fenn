+add_task(function test_cache_invalidation_without_view_and_destroy() {
+  const { UrlbarProviderTopSites } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/urlbar/UrlbarProviderTopSites.sys.mjs"
+  );
+  const local = sinon.createSandbox();
+  let topSitesChanged;
+  local.stub(UrlbarProviderTopSites, "addTopSitesListener").callsFake(callback => {
+    topSitesChanged = callback;
+  });
+  const notifications = [];
+  const parent = new UrlbarParentController({ sapName: "urlbar" });
+  parent.setChild({
+    get input() { throw new Error("No input"); },
+    get view() { throw new Error("No view"); },
+    notify: (...args) => notifications.push(args),
+  });
+  try {
+    topSitesChanged();
+    parent.observe(null, "intl:app-locales-changed");
+    Assert.deepEqual(notifications, [
+      ["onPresentationCacheInvalidated", "topsites"],
+      ["onPresentationCacheInvalidated", "l10n"],
+    ]);
+    const wireNotifications = [];
+    parent.setChild({ isProxy: true, notifyFromWire: (...args) => wireNotifications.push(args) });
+    topSitesChanged();
+    parent.observe(null, "intl:app-locales-changed");
+    Assert.deepEqual(wireNotifications, notifications, "Cache events also use the actor wire notification path");
+    parent.destroy();
+    parent.destroy();
+    topSitesChanged();
+    parent.observe(null, "intl:app-locales-changed");
+    Assert.equal(notifications.length, 2, "Direct child receives no later notifications");
+    Assert.equal(wireNotifications.length, 2, "Destroyed parents stop wire notifications");
+  } finally {
+    parent.destroy();
+    local.restore();
+  }
+});
+
+add_task(async function test_destroy_during_engine_initialization() {
+  const local = sinon.createSandbox();
+  const { SearchService } = ChromeUtils.importESModule(
+    "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+  );
+  const gate = Promise.withResolvers();
+  local.stub(SearchService, "hasSuccessfullyInitialized").get(() => false);
+  local.stub(SearchService, "init").returns(gate.promise);
+  const parent = new UrlbarParentController({ sapName: "urlbar" });
+  let updates = 0;
+  parent.setChild({ updateEngineStore() { updates++; } });
+  try {
+    const pending = parent.initEngineStore();
+    parent.destroy();
+    gate.resolve();
+    await pending;
+    await parent.initEngineStore();
+    Assert.equal(updates, 0, "No engine publication or observer registration after teardown");
+  } finally {
+    parent.destroy();
+    local.restore();
+  }
+});
+
+
+add_task(async function test_destroy_during_failed_engine_initialization() {
+  const local = sinon.createSandbox();
+  const { SearchService } = ChromeUtils.importESModule(
+    "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+  );
+  const gate = Promise.withResolvers();
+  local.stub(SearchService, "hasSuccessfullyInitialized").get(() => false);
+  local.stub(SearchService, "init").returns(gate.promise);
+  const parent = new UrlbarParentController({ sapName: "urlbar" });
+  let updates = 0;
+  parent.setChild({ updateEngineStore() { updates++; } });
+  try {
+    const pending = parent.initEngineStore();
+    parent.destroy();
+    gate.reject(new Error("Search initialization failed after teardown"));
+    await pending;
+    Assert.equal(updates, 0, "No failed-engine publication after teardown either");
+  } finally {
+    parent.destroy();
+    local.restore();
+  }
+});
