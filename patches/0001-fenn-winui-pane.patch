+
+/** Read totals into the readout: attempts, dropped actions, rates per 200 and the bar. */
+function summarize(totals) {
+  const handoffs = totals.handoffs ?? 0;
+  const attempts = totals.activations + totals.commands + totals.modes + totals.inherited + totals.fallbackTotal - handoffs;
+  const dropped = Math.max(0, totals.fallbackTotal - totals.replays - handoffs);
+  const per200 = n => (attempts ? Math.round((n / attempts) * 200 * 100) / 100 : null);
+  const errorFallbacks = Object.entries(totals.fallbackReasons)
+    .reduce((sum, [reason, count]) => sum + (reason === "error" || reason.endsWith("-error") ? count : 0), 0);
