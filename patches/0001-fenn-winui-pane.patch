+      this.#edit === request.edit && this.#searchMode === null && browserCurrent() && stillOwned() });
+  }
+
+  get inputPresentationState() {
+    if (this.#closed) return null;
+    if (!this.#isCurrent()) { this.close(); return null; }
+    return this.#inputPresentationState?.edit === this.#edit &&
+      this.#inputPresentationState.searchMode === this.#searchMode ? this.#inputPresentationState : null;
+  }
+
+  /** Describe only the exact latest observed edit, never an autofill/preview write. */
+  describeInputIdentity(revision, facts) {
+    this.#check();
+    if (!this.#identityEdit || this.#edit !== this.#identityEdit || this.#edit.revision !== revision) return null;
+    return Object.freeze({ revision, ...UrlbarInputIdentity.describe(this.#edit.text, facts) });
+  }
+
+  /** Request host identity metadata for an actual observed edit, not a preview. */
+  beginInputIdentity(revision, facts = {}) {
+    this.#check();
+    const edit = this.#edit;
+    const pageProxyValid = facts.pageProxyValid, lastValidURL = facts.lastValidURL;
+    if (lastValidURL !== undefined && lastValidURL !== null && typeof lastValidURL !== "string") {
+      throw new TypeError("Invalid last valid display");
+    }
+    const description = this.describeInputIdentity(revision, { pageProxyValid, lastValidURL });
+    if (!description || this.#closed || !this.#isCurrent() || this.#edit !== edit || this.#identityEdit !== edit) return null;
+    // Browser text and controller selection effects have their own owned paths.
+    const effects = { ...description };
+    delete effects.userTypedValue;
+    delete effects.userSelectionBehavior;
+    const proposal = Object.freeze({ ...effects, edit, token: Object.freeze({}), lastValidURL });
+    this.#identityRequest = proposal;
+    this.#identityState = null;
+    return proposal;
+  }
+
+  getInputIdentity(token) {
+    this.#check();
+    const request = this.#identityRequest;
+    if (!request || request.token !== token) return null;
+    if (this.#edit !== request.edit || this.#identityEdit !== request.edit) {
+      this.#identityRequest = null;
+      return null;
+    }
+    return request;
+  }
+
+  /** Observe exact host metadata without changing browser state or querying. */
+  acknowledgeInputIdentity(token, observation) {
+    const request = this.getInputIdentity(token);
+    if (!request || !observation) return false;
+    const expected = { ...request.edit, ...request };
+    const keys = ["text", "selectionStart", "selectionEnd", "selectionDirection", "composing",
+      "valueIsTyped", "untrimmedValue", "protocolIsTrimmed", "wwwIsTrimmed", "resultForCurrentValue",
+      "userTyping", "actionType", "pageProxyValid", "lastValidURL"];
+    if (keys.some(key => observation[key] !== expected[key]) ||
+        this.#closed || !this.#isCurrent() || this.#identityRequest !== request ||
+        this.#edit !== request.edit || this.#identityEdit !== request.edit) return false;
+    this.#identityRequest = null;
+    // Publish the validated immutable request, never caller-owned observations.
+    this.#identityState = request;
+    return true;
+  }
+
+  /** Acknowledged host identity is valid only for its exact observed edit. */
+  get inputIdentityState() {
+    if (this.#closed) return null;
+    if (!this.#isCurrent()) { this.close(); return null; }
+    if (this.#identityState?.edit !== this.#edit || this.#identityEdit !== this.#edit) this.#identityState = null;
+    return this.#identityState;
+  }
+
+  /** Prepare end-event host effects from observed IME history, without querying. */
+  beginCompositionEnd(revision, { hasData, hadText, closedPopup } = {}) {
+    this.#check();
+    const edit = this.#edit;
+    if (!edit?.composing || edit.revision !== revision || this.#compositionStart ||
+        this.#compositionStateReady || this.#committingComposition) return null;
+    const keepPanelOpen = UrlbarPrefs.get("keepPanelOpenDuringImeComposition");
+    const history = this.#compositionHistory;
+    if (history && (hadText !== undefined || closedPopup !== undefined)) {
+      throw new TypeError("Owned composition history cannot be overridden");
+    }
+    const policy = history ? history.describeEnd(hasData, keepPanelOpen) :
+      UrlbarCompositionModel.endPolicy({ hasData, hadText, closedPopup, keepPanelOpen });
+    const identity = policy.reopen ? this.#queries.captureCompositionMode(this.#searchMode) : null;
+    if (policy.reopen && !identity) return null;
+    const proposal = Object.freeze({ ...policy, edit, token: Object.freeze({}) });
+    this.#compositionEnd = { proposal, keepPanelOpen, history, hasData, mode: this.#searchMode, engineId: identity?.engineId };
+    return proposal;
+  }
+
+  getCompositionEnd(token) {
+    this.#check();
+    const pending = this.#compositionEnd;
+    if (!pending || pending.proposal.token !== token) return null;
+    if (pending.proposal.edit !== this.#edit || pending.mode !== this.#searchMode ||
+        pending.history !== this.#compositionHistory ||
+        (pending.proposal.reopen && !this.#queries.isCompositionModeCurrent(pending.mode, pending.engineId)) ||
+        pending.keepPanelOpen !== UrlbarPrefs.get("keepPanelOpenDuringImeComposition")) {
+      this.#compositionEnd = null;
+      return null;
+    }
+    return pending.proposal;
+  }
+
+  /** End only after exact host text/caret and required selection-clear observations. */
+  acknowledgeCompositionEnd(token, { text, selectionStart, selectionEnd, selectionDirection,
+    composing, selectionCleared, resultForCurrentValue }) {
+    const request = this.getCompositionEnd(token);
+    if (!request || text !== request.edit.text || selectionStart !== request.edit.selectionStart ||
+        selectionEnd !== request.edit.selectionEnd || selectionDirection !== request.edit.selectionDirection ||
+        composing !== false || (request.clearSelection && selectionCleared !== true) ||
+        (request.clearResultForCurrentValue && resultForCurrentValue !== null)) return false;
+    const pending = this.#compositionEnd;
+    this.#compositionEnd = null;
+    // Host selection effects have already been observed; model transition is local.
+    pending.history?.end(pending.hasData, pending.keepPanelOpen, () => {});
+    // The end event does not consume the next input transition or start its query.
+    const edit = { ...request.edit, composing: false };
+    delete edit.composition;
+    this.#edit = Object.freeze(edit);
+    this.#compositionReopen = request.reopen ? { token, edit: this.#edit,
+      mode: pending.mode, engineId: pending.engineId, keepPanelOpen: pending.keepPanelOpen } : null;
+    this.#compositionPresentation = null;
