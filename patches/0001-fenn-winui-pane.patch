+      const t=this.toolbar,w=this.window;
+      return !this.closed && t.active && t.navigation && t.supported() && !w.gDialogBox?.isOpen && !t.customization?.editorOpen &&
+        t.owner.addressSession?.sessionId===context.session && t.owner.addressTab===context.tab && t.owner.addressDocument===context.document &&
+        t.owner.addressTab===w.gBrowser.selectedTab && t.owner.addressDocument===w.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+    };
+    // Consume before any asynchronous service work or nested Firefox dialog.
+    this.dismiss();
+    const w=this.window,source=w.document.getElementById("fxa-toolbar-menu-button");
+    if(["launch","edit","copy","create","manage"].includes(entry.kind) && !this.profilesAllowed(profiles))return 2;
+    if(["edit","copy"].includes(entry.kind) && profiles.currentProfile?.id!==entry.profileId)return 2;
+    switch(entry.kind) {
+      case "launch": {
+        void profiles.getProfile(entry.profileId).then(profile=>{
+          if(!profile || !this.profilesAllowed(profiles) || !currentContext() || profiles.currentProfile?.id===profile.id)return;
+          return profiles.launchInstance(profile);
+        }).catch(console.error);break;
+      }
+      case "edit":w.openTrustedLinkIn("about:editprofile","tab");break;
+      case "copy": {
+        const current=profiles.currentProfile;
+        void profiles.maybeSetupDataStore().then(()=>{
+          if(currentContext() && this.profilesAllowed(profiles) && profiles.currentProfile?.id===entry.profileId)return current.copyProfile();
+        }).catch(console.error);break;
+      }
+      case "create":w.gProfiles.createNewProfile("profiles-panel");break;
+      case "manage":void w.gProfiles.manageProfiles();break;
+      case "account":void w.gSync.clickFxAMenuHeaderButton(source);break;
+      case "sync":w.gSync.doSyncFromFxaMenu(source);break;
+      case "settings":w.gSync.openPrefsFromFxaMenu("sync_settings",source);break;
+      case "signout":void w.gSync.disconnect();break;
+      case "original":return this.toolbar.openMenu("profile",bounds,new w.MouseEvent("click",{view:w}));
+      default:return 2;
+    }
+    return 1;
+  }
+}
diff --git a/browser/base/content/WinUIOverflowMenu.sys.mjs b/browser/base/content/WinUIOverflowMenu.sys.mjs
