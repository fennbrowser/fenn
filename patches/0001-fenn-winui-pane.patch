+    if (command === 'customize:editor:open') {
+      this.editorOpen = true; this.ownsReset = false; this.invalidate(); return 1;
+    }
+    const layout = /^customize:([0-9]+):overflow-layout:(none|widget-[0-9]+(?:,widget-[0-9]+)*)$/.exec(command);
