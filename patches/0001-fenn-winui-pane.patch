+bool NotifyIndependentPageIME(nsWindow*, const IMENotification&);
+void DrainIndependentPageIME(HWND);
+void ForgetIndependentPageIME(HWND);
+void RefreshIndependentPageIME(HWND);
+void SuspendIndependentPageIME(HWND);
