+      // trusting the cached target.exists bit after an external file removal.
+      const {FileUtils}=ChromeUtils.importESModule("resource://gre/modules/FileUtils.sys.mjs");
+      const target=entry.download.target;
+      const exists=new FileUtils.File(target.path).exists() ||
+        (entry.command==="downloadsCmd_show" && target.partFilePath && new FileUtils.File(target.partFilePath).exists());
+      if(!exists){entry.download.refresh().catch(console.error);return 2;}
+    }
+    for(const [key,action] of this.actions)if(action.download===entry.download && action.command===entry.command)this.consumed.add(key);
+    this.actions.delete(id);
+    row.dirty = true;
+    if (entry.close) this.dismiss();
+    if (entry.command === "downloadsCmd_chooseUnblock") shell.confirmUnblock(this.window,"chooseUnblock");
+    else shell.doCommand(entry.command);
+    if(entry.command==="downloadsCmd_copyLocation")row.capabilities.delete(7);
+    this.toolbar.owner.invalidateAddress();
+    return 1;
+  }
+}
