index 0000000000..82d5029bd9
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarClipboardText.mjs
@@ -0,0 +1,155 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Firefox copy formatting from an explicit editor/URL-state snapshot.
+ * The caller owns selection and clipboard I/O. URI operations remain Firefox
+ * services, evaluated only when the selected text requires URL formatting.
+ */
+export function formatUrlbarClipboardText(state, services) {
+  let selectedVal = state.selectedValue;
+  // Handle multiple-range selection as a string for simplicity.
+  if (state.rangeCount > 1) {
+    return selectedVal;
+  }
+
+  // If the selection doesn't start at the beginning or doesn't span the
+  // full domain or the URL bar is modified or there is no text at all,
+  // nothing else to do here.
+  // TODO (Bug 1908360): the valueIsTyped usage here is confusing, as often
+  // it doesn't really indicate a user typed a value, it's rather used as
+  // a way to tell if the value was modified.
+  if (
+    state.selectionStart > 0 ||
+    selectedVal == "" ||
+    (state.valueIsTyped && !state.protocolIsTrimmed && !state.wwwIsTrimmed)
+  ) {
+    return selectedVal;
+  }
+
+  // The selection doesn't span the full domain if it doesn't contain a slash and is
+  // followed by some character other than a slash.
+  if (!selectedVal.includes("/")) {
+    let remainder = state.value.replace(selectedVal, "");
+    if (remainder != "" && remainder[0] != "/") {
+      return selectedVal;
+    }
+  }
+
+  let uri;
+  if (state.pageProxyValid) {
+    uri = services.getPageURI();
+  } else {
+    // The value could be:
+    // 1. a trimmed url, set by selecting a result
+    // 2. a search string set by selecting a result
+    // 3. a url that was confirmed but didn't finish loading yet
+    // If it's an url the untrimmedValue should resolve to a valid URI,
+    // otherwise it's a search string that should be copied as-is.
+
+    // If the copied text is that autofilled value, return the url including
+    // the protocol from its suggestion.
+    let result = state.resultForCurrentValue;
+
+    if (result?.autofill?.value == selectedVal) {
+      return result.payload.url;
+    }
+
+    uri = services.parseURI(state.untrimmedValue);
+    if (!uri) {
+      return selectedVal;
+    }
+  }
+  uri = services.makeURIReadable(uri);
+  let displaySpec = uri.displaySpec;
+
+  // If the entire URL is selected, just use the actual loaded URI,
+  // unless we want a decoded URI, or it's a data: or javascript: URI,
+  // since those are hard to read when encoded.
+  if (
+    state.value == selectedVal &&
+    !uri.schemeIs("javascript") &&
+    !uri.schemeIs("data") &&
+    !state.decodeURLsOnCopy
+  ) {
+    return displaySpec;
+  }
+
+  // Just the beginning of the URL is selected, or we want a decoded
+  // url. First check for a trimmed value.
+
+  // _trimValue may also trim a trailing slash, so we can't compare strings
+  // directly to tell what was trimmed; consult the trimmed prefix instead.
+  let trimmedPrefix = services.getTrimmedURLPrefix(displaySpec);
+  if (trimmedPrefix && !selectedVal.startsWith(trimmedPrefix)) {
+    selectedVal = trimmedPrefix + selectedVal;
+  }
+
+  // If selection starts from the beginning and part or all of the URL
+  // is selected, we check for decoded characters and encode them.
+  // Unless decodeURLsOnCopy is set. Do not encode data: URIs.
+  if (!state.decodeURLsOnCopy && !uri.schemeIs("data")) {
+    try {
+      if (services.canParse(selectedVal)) {
+        // Use encodeURI instead of URL.href because we don't want
+        // trailing slash.
+        selectedVal = encodeURI(selectedVal);
+      }
+    } catch (ex) {
+      // URL is invalid. Return original selected value.
+    }
+  }
+
+  return selectedVal;
+}
+
+// A semantic edit, not an editor transaction. The active presenter applies the
+// replacement and owns undo. Offsets use the editor's UTF-16 convention.
+function selectionReplacement(state, replacement) {
+  const {text, start, end} = state;
+  if (typeof text != "string" || !Number.isInteger(start) ||
+      !Number.isInteger(end) || start < 0 || end < start || end > text.length) {
+    return null;
+  }
+  const caret = start + replacement.length;
+  return {before: text, replaceStart: start, replaceEnd: end, replacement,
+    text: text.slice(0, start) + replacement + text.slice(end),
+    start: caret, end: caret};
+}
+
+export function planUrlbarCut(state) {
+  if (state.readOnly || state.start === state.end) return null;
+  return selectionReplacement(state, "");
+}
+
+/**
+ * Firefox's URL-specific paste override. Null means leave the trusted editor
+ * paste unchanged, including its newline, undo and event handling. It does not
+ * mean reject a paste. The caller supplies Firefox fixup and sanitizer services.
+ */
+export function planUrlbarPaste(state, originalPasteData, services) {
+  if (!originalPasteData || !selectionReplacement(state, "") ||
+      state.text.slice(0, state.start).trim()) return null;
+  const pasteData = services.sanitize(originalPasteData,
+    services.fixup(originalPasteData, state.isPrivate));
+  return originalPasteData === pasteData ? null : selectionReplacement(state, pasteData);
+}
+
+
+/**
+ * Shared Paste and Go command ordering. The binding supplies the existing
+ * trusted editor paste operation; this never reads or inserts clipboard text.
+ * Navigation remains fire-and-forget, as in the original menu command.
+ */
+export function executeUrlbarPasteAndGo(commands) {
+  commands.suppressQuery();
+  try {
+    commands.paste();
+    commands.clearResult();
+    commands.submit();
+    commands.clearQueryCache();
+  } finally {
+    commands.resumeQuery();
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarResultPresentation.mjs b/browser/components/urlbar/content/UrlbarResultPresentation.mjs
new file mode 100644
index 0000000000..4df5efe958
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarResultPresentation.mjs
@@ -0,0 +1,320 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/**
+ * Firefox result-display policy shared by DOM and native presenters. The model
+ * retains only a localization service; query results remain controller-owned.
+ * It neither constructs a view nor owns selection, exposure or blob lifetimes.
+ */
+export class UrlbarResultPresentation {
+  /** Firefox classification without row elements or selection. */
+  static telemetryTypeFromResult(result) {
+    if (!result) {
+      return "unknown";
+    }
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+        return "switchtab";
+      case UrlbarShared.RESULT_TYPE.SEARCH:
+        if (result.providerName == "UrlbarProviderRecentSearches") {
+          return "recent_search";
+        }
+        if (result.source == UrlbarShared.RESULT_SOURCE.HISTORY) {
+          return "formhistory";
+        }
+        if (result.providerName == "UrlbarProviderTabToSearch") {
+          return "tabtosearch";
+        }
+        if (result.providerName == "UrlbarProviderAiChat") {
+          return "ai_search_fallback";
+        }
+        if (result.payload.suggestion) {
+          let type = result.payload.trending ? "trending" : "searchsuggestion";
+          if (result.isRichSuggestion) {
+            type += "_rich";
+          }
+          return type;
+        }
+        return "searchengine";
+      case UrlbarShared.RESULT_TYPE.URL:
+        if (result.autofill) {
+          let { type } = result.autofill;
+          if (!type) {
+            type = "other";
+            console.error(
+              new Error(
+                "`result.autofill.type` not set, falling back to 'other'"
+              )
+            );
+          }
+          return `autofill_${type}`;
+        }
+        if (
+          result.source == UrlbarShared.RESULT_SOURCE.OTHER_LOCAL &&
+          result.heuristic
+        ) {
+          return "visiturl";
+        }
+        if (result.providerName == "UrlbarProviderQuickSuggest") {
+          return "quicksuggest";
+        }
+        if (result.providerName == "UrlbarProviderClipboard") {
+          return "clipboard";
+        }
+        {
+          let type =
+            result.source == UrlbarShared.RESULT_SOURCE.BOOKMARKS
+              ? "bookmark"
+              : "history";
+          if (result.providerName == "UrlbarProviderInputHistory") {
+            return type + "adaptive";
+          }
+          return type;
+        }
+      case UrlbarShared.RESULT_TYPE.KEYWORD:
+        return "keyword";
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return "extension";
+      case UrlbarShared.RESULT_TYPE.REMOTE_TAB:
+        return "remotetab";
+      case UrlbarShared.RESULT_TYPE.TIP:
+        return "tip";
+      case UrlbarShared.RESULT_TYPE.DYNAMIC:
+        if (result.providerName == "UrlbarProviderTabToSearch") {
+          // This is the onboarding result.
+          return "tabtosearch";
+        }
+        return "dynamic";
+      case UrlbarShared.RESULT_TYPE.RESTRICT:
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.BOOKMARK) {
+          return "restrict_keyword_bookmarks";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.OPENPAGE) {
+          return "restrict_keyword_tabs";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.HISTORY) {
+          return "restrict_keyword_history";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.ACTION) {
+          return "restrict_keyword_actions";
+        }
+        break;
+      case UrlbarShared.RESULT_TYPE.AI_CHAT:
+        return "ai_chat";
+    }
+    return "unknown";
+  }
+
+  constructor(l10n) {
+    this.l10n = l10n;
+  }
+
+  shouldShowHeuristic(result) {
+    if (!result?.heuristic) {
+      throw new Error("A heuristic result must be given");
+    }
+    return !UrlbarPrefs.get("experimental.hideHeuristic") ||
+      result.type == UrlbarShared.RESULT_TYPE.TIP;
+  }
+
+  allowEmptySelection(context) {
+    return !context?.heuristicResult ||
+      !this.shouldShowHeuristic(context.heuristicResult);
+  }
+
+  /**
+   * Initial choice when neither a result nor a one-off is selected. The host
+   * resolves select-first to its first selectable element; associate-first
+   * binds the input's value without selecting a row (hidden heuristics and
+   * filtered search-mode offers). This never moves an existing user selection.
+   */
+  defaultSelection(context) {
+    const first = context?.results?.[0];
+    if (first?.heuristic) {
+      return Object.freeze(this.shouldShowHeuristic(first)
+        ? { kind: "select-first", valueResult: null }
+        : { kind: "associate-first", valueResult: first });
+    }
+    if (first?.payload.providesSearchMode && context.trimmedSearchString != "@") {
+      return Object.freeze({ kind: "associate-first", valueResult: first });
+    }
+    return Object.freeze({ kind: "none", valueResult: null });
+  }
+
+  /**
+   * Arrow-key row traversal. Row count and eligibility describe the presenter's
+   * complete displayed candidate list, including rows outside its viewport.
+   * The callback is synchronous and never retained. It keeps action controls
+   * and disabled-state inspection in the presenter, without passing nodes here.
+   *
+   * A clear descriptor preserves the original explicit deselection path; a row
+   * descriptor (including index -1) uses the presenter's row-selection path.
+   * Query freezing, preview, focus and provider notifications remain binding
+   * responsibilities. Tab-key traversal is a separate element-level policy.
+   */
+  arrowSelection({ selectedRowIndex, rowCount, amount, reverse = false,
+    allowEmptySelection, isSelectable }) {
+    const end = rowCount - 1;
+    const step = reverse ? -1 : 1;
+    if (selectedRowIndex == (reverse ? 0 : end)) {
+      return Object.freeze(allowEmptySelection
+        ? { kind: "clear" }
+        : { kind: "row", index: reverse ? end : 0 });
+    }
+    let index = reverse ? end : 0;
+    if (selectedRowIndex != -1) {
+      index = Math.min(end, Math.max(0, selectedRowIndex + amount * step));
+    }
+    // Preserve Firefox's edge wrap and directional scan order. In particular,
+    // the edge-wrap branch above does not rescan eligibility.
+    while (index >= 0 && index <= end && !isSelectable(index)) {
+      index += step;
+    }
+    return Object.freeze({ kind: "row", index: index > end ? -1 : index });
+  }
+
+  /**
+   * Non-URL input text for a selected result. Bindings capture dynamic element
+   * facts and semantic tip actions; no node or editor crosses this boundary.
+   * Null means use the binding's URL decoding/trimming path, not empty text.
+   * This describes text only: it does not authorize selection or navigation.
+   */
+  inputText(result, { dynamicQuery, dynamicUrl, resultAction = null } = {}) {
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.KEYWORD:
+        return Object.freeze({ value: result.payload.input });
+      case UrlbarShared.RESULT_TYPE.SEARCH: {
+        let value = "";
+        if (result.payload.keyword) {
+          value += result.payload.keyword + " ";
+        }
+        value += result.payload.suggestion || result.payload.query;
+        return Object.freeze({ value });
+      }
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return Object.freeze({ value: result.payload.content });
+      case UrlbarShared.RESULT_TYPE.DYNAMIC:
+        return Object.freeze({
+          value: dynamicQuery || dynamicUrl || result.payload.input || result.payload.query || "",
+        });
+      case UrlbarShared.RESULT_TYPE.RESTRICT:
+        return Object.freeze({ value: result.payload.autofillKeyword + " " });
+      case UrlbarShared.RESULT_TYPE.AI_CHAT:
+        return Object.freeze({ value: result.payload.query ?? "" });
+      case UrlbarShared.RESULT_TYPE.TIP: {
+        let value = resultAction?.url || resultAction?.input;
+        if (value) {
+          return Object.freeze({ value });
+        }
+        break;
+      }
+    }
+
+    return null;
+  }
+
+  actionType(result) {
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+        return "switchtab";
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return "extension";
+      default:
+        return undefined;
+    }
+  }
+
+  // These are presentation candidates, not proof of viewport visibility.
+  // Each presenter must separately report the results it actually exposes.
+  candidates(context) {
+    let span = 0;
+    return context.results.filter(result => {
+      if (result.isHiddenExposure ||
+          (result.heuristic && !this.shouldShowHeuristic(result))) {
+        return false;
+      }
+      span += UrlbarShared.getSpanForResult(result);
+      return span <= context.maxResults;
+    });
+  }
+
+  title(result) {
+    if (result.payload.titleL10n) {
+      return {l10n: result.payload.titleL10n};
+    }
+    // Legacy extension result text precedes the search-mode title policy.
+    if (result.payload.text) {
+      return {text: result.payload.text};
+    }
+    if (!result.payload.providesSearchMode) {
+      return null;
+    }
+    if (result.type == UrlbarShared.RESULT_TYPE.RESTRICT) {
+      return {l10n: {
+        id: "urlbar-result-search-with-local-search-mode",
+        args: {
+          keywords: result.payload.l10nRestrictKeywords
+            .map(keyword => `@${keyword.toLowerCase()}`).join(", "),
+          localSearchMode: result.payload.l10nRestrictKeywords[0].toLowerCase(),
+        },
+      }};
+    }
+    if (result.providerName == "UrlbarProviderTokenAliasEngines" &&
+        UrlbarPrefs.getScotchBonnetPref("searchRestrictKeywords.featureGate")) {
+      return {l10n: {
+        id: "urlbar-result-search-with-engine-keywords",
+        args: {keywords: result.payload.keywords, engine: result.payload.engine},
+      }};
+    }
+    return {l10n: {
+      id: "urlbar-result-action-search-w-engine",
+      args: {engine: result.payload.engine},
+    }};
+  }
+
+  async searchModeTitle(result) {
+    if (!result.payload.providesSearchMode) {
+      return "";
+    }
+    const descriptor = this.title(result);
+    if (descriptor.text !== undefined) {
+      return descriptor.text;
+    }
+    const [message] = await this.l10n.formatMessages([descriptor.l10n]);
+    return message?.value || "";
+  }
+
+  // DOM callers resolve blobs into their own revocable object URLs. Native
+  // callers retain the blob for Gecko's existing bounded image decoder.
+  icon(result, iconUrlOverride = null, resolveBlob = (_result, blob) => blob) {
+    if (result.source == UrlbarShared.RESULT_SOURCE.HISTORY &&
+        (result.type == UrlbarShared.RESULT_TYPE.SEARCH ||
+         result.type == UrlbarShared.RESULT_TYPE.KEYWORD)) {
+      return UrlbarShared.ICON.HISTORY;
+    }
+    if (iconUrlOverride) {
+      return iconUrlOverride;
+    }
+    if (result.payload.icon) {
+      return result.payload.icon;
+    }
+    if (result.payload.iconBlob) {
+      const icon = resolveBlob(result, result.payload.iconBlob);
+      if (icon) {
+        return icon;
+      }
+    }
+    if (result.type == UrlbarShared.RESULT_TYPE.SEARCH && result.payload.trending) {
+      return UrlbarShared.ICON.TRENDING;
+    }
+    if (result.type == UrlbarShared.RESULT_TYPE.SEARCH ||
+        result.type == UrlbarShared.RESULT_TYPE.KEYWORD) {
+      return UrlbarShared.ICON.SEARCH_GLASS;
+    }
+    return UrlbarShared.ICON.DEFAULT;
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarResultActions.mjs b/browser/components/urlbar/content/UrlbarResultActions.mjs
new file mode 100644
index 0000000000..cd182f9217
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarResultActions.mjs
@@ -0,0 +1,314 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Shared Firefox result actions. No element creation, node storage or native ABI.
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarContentUtils } from "chrome://browser/content/urlbar/UrlbarContentUtils.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+import { UrlbarResult } from "chrome://browser/content/urlbar/UrlbarResult.mjs";
+const RESULT_MENU_COMMANDS = {DISMISS:"dismiss",HELP:"help",MANAGE:"manage",TOGGLE_KEYBOARD_ACCESSIBLE:"toggle-keyboard-accessible"};
+const CONTAINER_SOURCE = "urlbar_result_context_menu";
+
+export class UrlbarResultActions {
+  constructor(input) { this.input=input; this.commandsCache=new WeakMap(); }
+  invalidate(result) { this.commandsCache.delete(result); }
+  buttons(result) {
+    for (const [index, button] of (result.payload.buttons || []).entries()) button.name ??= String(index);
+    return result.payload.buttons || [];
+  }
+  static fromElement(element) {
+    if (!element) return null;
+    const d=element.dataset;
+    return {command:d.command,url:d.url,input:d.input,openIn:d.openIn,
+      userContextId:d.usercontextid,name:d.name,help:d.l10nName==="learn-more-link"};
+  }
+  buttonAction(button) {
+    return {name:button.name,command:button.command,url:button.url,input:button.input};
+  }
+  helpAction(result) {
+    return {help:true,url:this.input.window.getHelpLinkURL(result.payload.descriptionLearnMoreTopic)};
+  }
+  async label(l10n) {
+    if (!l10n) return {label:"",accessKey:""};
+    const [message]=await this.input.document.l10n.formatMessages([l10n]);
+    const attrs=Object.fromEntries((message?.attributes || []).map(a=>[a.name,a.value]));
+    return {label:message?.value || attrs.label || attrs["aria-label"] || "",accessKey:attrs.accesskey || ""};
+  }
+  async describeCommands(commands, includeContainers=true) {
+    const items=[];
+    for (const data of commands || []) {
+      if (data.name==="separator") { items.push({separator:true}); continue; }
+      const action={command:data.openIn ? undefined : data.name,openIn:data.openIn,
+        userContextId:data.userContextId,operation:data.operation};
+      const item={...await this.label(data.l10n),action,enabled:!data.disabled,
+        checkable:data.type==="checkbox",checked:data.checked===true,
+        l10n:data.l10n,iconURL:data.iconURL,colorCode:data.colorCode};
+      if (data.label !== undefined) item.label=data.label;
+      if (data.submenu) item.children=includeContainers ? await this.describeContainers() : [];
+      items.push(item);
+    }
+    return items;
+  }
+  async describeContainers() {
+    const containers=await UrlbarContentUtils.getContainers();
+    return this.describeCommands([
+      ...containers.map(c=>({label:c.name,userContextId:String(c.userContextId),iconURL:c.iconURL,colorCode:c.colorCode})),
+      {name:"separator"},
+      {operation:"add-container",l10n:{id:"user-context-add-container2-panel-item"}},
+      {operation:"manage-containers",l10n:{id:"user-context-manage-containers2-panel-item"}},
+    ],false);
+  }
+  async describeMenu(result, buttonName=null) {
+    if (buttonName===null && !UrlbarPrefs.get("contextMenu.featureGate")) return null;
+    const commands=buttonName===null ? this.getMenuCommands(result) : this.buttons(result).find(b=>b.name===buttonName)?.menu;
+    return commands?.length ? this.describeCommands(commands) : null;
+  }
+  invokeMenu(result, action, event, browserId=null) {
+    if (action.command===RESULT_MENU_COMMANDS.TOGGLE_KEYBOARD_ACCESSIBLE) {
+      UrlbarPrefs.toggleResultMenuKeyboardAccessible();
+      this.input.view.updateMenuButtonKeyboardAccessibility();
+      return;
+    }
+    if (action.operation==="add-container") return this.input.controller.parentController.openContainerCreationPanel(CONTAINER_SOURCE);
+    if (action.operation==="manage-containers") return this.input.controller.parentController.openPreferences("paneContainers",{urlParams:{entrypoint:CONTAINER_SOURCE}});
+    if (action.command==="help") action={...action,url:result.payload.helpUrl || UrlbarContentUtils.getSupportUrl("awesome-bar-result-menu")};
+    return this.input.pickResult({result,event,browserId,resultAction:action});
+  }
+  async describeButtons(result, acknowledgment=false) {
+    if (result.type!==UrlbarShared.RESULT_TYPE.TIP || (!acknowledgment && result.payload.type==="dismissalAcknowledgment") ||
+        !result.payload.buttons?.length || result.payload.buttons.length>8) return null;
+    return Promise.all(this.buttons(result).map(async button=>({
+      ...await this.label(button.l10n), name:button.name, menu:!!button.menu,
+      enabled:!["hidden","disabled"].some(key=>button.attributes?.[key] != null && button.attributes[key] !== false),
+      action:this.buttonAction(button),
+    })));
+  }
+  // Fluent's supported description contract is text with one named help link.
+  // Reject richer markup explicitly so native can restore Firefox presentation.
+  description(result, value) {
+    const match=/^([^<>]*)<a\s+data-l10n-name=["']learn-more-link["']\s*>([^<>]*)<\/a>([^<>]*)$/s.exec(value || "");
+    // Do not display unknown HTML entities literally. Their original Fluent
+    // markup remains available through the retained Firefox renderer.
+    if (!match || /&(?!(?:amp|lt|gt|quot|apos|#x[0-9a-f]+|#\d+);)[a-z#]/i.test(value)) return {unsupported:true};
+    const decode=text=>text.replace(/&(#x[0-9a-f]+|#\d+|amp|lt|gt|quot|apos);/gi,(_,entity)=>{
+      const named={amp:"&",lt:"<",gt:">",quot:'"',apos:"'"};
+      if (entity[0]!=="#") return named[entity.toLowerCase()];
+      const value=entity[1].toLowerCase()==="x" ? parseInt(entity.slice(2),16) : Number(entity.slice(1));
+      return value>0 && value<=0x10ffff && !(value>=0xd800 && value<=0xdfff) ? String.fromCodePoint(value) : "\uFFFD";
+    });
+    return {before:decode(match[1]),label:decode(match[2]),after:decode(match[3]),
+      action:this.helpAction(result)};
+  }
+  async describeDescription(result) {
+    if (result.type!==UrlbarShared.RESULT_TYPE.TIP || !result.payload.descriptionLearnMoreTopic || !result.payload.descriptionL10n) return null;
+    const {id,args}=result.payload.descriptionL10n;
+    return this.description(result,await this.input.document.l10n.formatValue(id,args));
+  }
+  get openInCommands() {
+    /** @type {UrlbarResultCommand[]} */
+    let commands = [
+      {
+        openIn: "tab",
+        l10n: { id: "urlbar-view-context-menu-open-in-tab2" },
+      },
+    ];
+    if (
+      !this.input.isPrivate &&
+      UrlbarPrefs.get("privacy.userContext.enabled")
+    ) {
+      commands.push({
+        openIn: "container-tab",
+        submenu: true,
+        l10n: { id: "urlbar-view-context-menu-open-in-container-tab2" },
+      });
+    }
+    commands.push(
+      {
+        openIn: "window",
+        l10n: { id: "urlbar-view-context-menu-open-in-window2" },
+      },
+      {
+        openIn: "private-window",
+        l10n: { id: "urlbar-view-context-menu-open-in-private-window2" },
+      }
+    );
+    return commands;
+  }
+
+  canOpenInNewTarget(result) {
+    return (
+      UrlbarPrefs.get("contextMenu.featureGate") &&
+      this.input.handlesOpenInCommands &&
+      result.type != UrlbarShared.RESULT_TYPE.TAB_SWITCH &&
+      !!UrlbarShared.getLoadRequestFromResult(result)
+    );
+  }
+
+  /**
+   * @param {UrlbarResult} result
+   *   The result to get menu commands for.
+   * @returns {?UrlbarResultCommand[]}
+   *   Everything the result's menu shows, null if it has nothing to show. The
+   *   three-dot button and a right-click both open this menu, so it combines
+   *   the result's own commands with the ones that open it in a new tab or
+   *   window, and closes with the checkbox that skips the menu button when
+   *   tabbing through the results.
+   */
+  getMenuCommands(result) {
+    let commands = this.getResultMenuCommands(result);
+    if (this.canOpenInNewTarget(result)) {
+      let openInCommands = this.openInCommands;
+      commands = commands
+        ? [...openInCommands, { name: "separator" }, ...commands]
+        : openInCommands;
+    }
+    if (!commands) {
+      return null;
+    }
+    return [
+      ...commands,
+      { name: "separator" },
+      {
+        name: RESULT_MENU_COMMANDS.TOGGLE_KEYBOARD_ACCESSIBLE,
+        type: "checkbox",
+        checked: !UrlbarPrefs.get("resultMenu.keyboardAccessible"),
+        l10n: { id: "urlbar-view-context-menu-skip-menu-with-tab" },
+      },
+    ];
+  }
+
+  /**
+   * @param {UrlbarResult} result
+   *   The result to get menu commands for.
+   * @returns {Array}
+   *   Array of the result's own menu commands, null if there are none.
+   */
+  getResultMenuCommands(result) {
+    if (this.commandsCache.has(result)) {
+      return this.commandsCache.get(result);
+    }
+
+    /**
+     * @type {?UrlbarResultCommand[]}
+     */
+    let commands = result.commands;
+    if (commands) {
+      this.commandsCache.set(result, commands);
+      return commands;
+    }
+
+    commands = [];
+    if (result.payload.isBlockable) {
+      commands.push({
+        name: RESULT_MENU_COMMANDS.DISMISS,
+        l10n: result.payload.blockL10n || {
+          id: "urlbar-result-menu-dismiss-suggestion2",
+        },
+      });
+    }
+    if (result.payload.helpUrl) {
+      commands.push({
+        name: RESULT_MENU_COMMANDS.HELP,
+        l10n: result.payload.helpL10n || {
+          id: "urlbar-result-menu-learn-more2",
+        },
+      });
+    }
+    if (result.payload.isManageable) {
+      commands.push({
+        name: RESULT_MENU_COMMANDS.MANAGE,
+        l10n: {
+          id: "urlbar-result-menu-manage-firefox-suggest2",
+        },
+      });
+    }
