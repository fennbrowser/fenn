+      *out=static_cast<IRawElementProviderSimple*>(this);
+    else if (mSupportsUia && iid==__uuidof(IRawElementProviderFragment)) *out=static_cast<IRawElementProviderFragment*>(this);
+    else if (mSupportsUia && iid==__uuidof(IRawElementProviderFragmentRoot)) *out=static_cast<IRawElementProviderFragmentRoot*>(this);
