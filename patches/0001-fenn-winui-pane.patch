index 00000000000..567667b7311
--- /dev/null
+++ b/browser/base/content/browser-winui-pane.js
@@ -0,0 +1,2484 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+var gWinUIPane = {
+  pref: "fenn.winui.pane.enabled",
+  addressPrivatePref: "fenn.winui.address.private",
+  navigationToolbarPref: "fenn.winui.navigation.toolbar.enabled",
+  hideToolbarPref: "fenn.winui.navigation.hideFirefoxToolbar",
+  replaceTabsPref: "fenn.winui.tabstrip.replaceFirefoxTabs",
+  containerDotPref: "fenn.winui.tabstrip.containerDot",
+  tabGlowsPref: "fenn.winui.tabstrip.glows",
+  stripBackdropPref: "fenn.winui.tabstrip.backdrop",
+  groupReachPref: "fenn.winui.tabstrip.groupReach",
+  groupHoverPref: "fenn.winui.tabstrip.groupHover",
+  groupHaloPref: "fenn.winui.tabstrip.groupHalo",
+  groupGlowAnimationsPref: "fenn.winui.tabstrip.groupGlowAnimations",
+  groupGlowFadeOutPref: "fenn.winui.tabstrip.groupGlowFadeOut",
+  stripHeightPref: "fenn.winui.tabstrip.height",
+  chromeLayoutPref: "fenn.winui.chrome.layout",
+  groupingPrefs: ["browser.tabs.groups.enabled", "browser.tabs.dragDrop.createGroup.enabled",
+    "browser.tabs.dragDrop.createGroup.delayMS"],
+  element: null,
+  frame: 0,
+  publicationTimer: 0,
+  publicationDeferred: false,
+  publishing: false,
+  uninitializing: false,
+  popups: new Set(),
+  backwards: false,
+  tabIds: new WeakMap(),
+  processingAction: false,
+  nextTabId: 1,
+  // Producer-side dirty tracking. A quiet window records nothing and publishes
+  // nothing; a changed title or active tab records exactly what changed, so the
+  // native side is handed one tab instead of every tab.
+  dirtyTitles: new Set(),
+  dirtySelection: false,
+  // The published context (tab identities, order, active tab and the
+  // multiselected set) needs republishing. Distinct from a structural change:
+  // a native selection Firefox accepted changes the multiselected set without
+  // changing the tab list, and the next request is validated against the
+  // published context, so it has to be republished or that request is refused.
+  contextDirty: false,
+  structuralDirty: true,
+  stripDirty: true,
+  // Last observed selection eligibility, not a cached action decision. Identity
+  // changes still invalidate context; only crossing this threshold changes the
+  // strip rows' group-drag metadata. Other strip dirty reasons remain sticky.
+  stripSingleSelection: null,
+  // The address surface needs republishing. Set by everything that can change
+  // what a publication would say: the session's own counters (which advance on
+  // every mutation, including asynchronous label and image completions), the
+  // urlbar's input and focus, window activation, tab changes, and the prefs
+  // and fullscreen state that decide whether the surface runs at all.
+  addressDirty: true,
+  addressPublication: null,
+  // The pane's presentation-model revision as of the last snapshot or delta.
+  // Every delta names it; a mismatch means producer and consumer diverged, and
+  // is answered with one snapshot rather than a retry.
+  nativeRevision: 0,
+  tabPublicationRevision: 0,
+  // Complete publications sent because a delta was refused.
+  publicationRecoveries: 0,
+  publishedIds: new Set(),
+  // True for the duration of one drain. A drained command can spin a nested
+  // modal loop, and the pane must not be asked for another batch from inside
+  // one.
+  draining: false,
+  blocked: false,
+  unblockDelay: 0,
+  unblockTimer: 0,
+  // Decoded favicons for the native tab strip, keyed by icon URL so tabs
+  // sharing a site (or an unchanged favicon) skip re-decoding. Gecko owns
+  // all image loading/decoding; native code only ever receives raw pixels.
+  faviconCache: new Map(),
+  faviconLoads: new Set(),
+  // Last successfully decoded icon per tab, kept across a favicon URL change
+  // so the strip doesn't flash to no-icon while the new URL decodes.
+  faviconLastKnownByTab: new WeakMap(),
+  tabEvents: [
+    "TabOpen",
+    "TabClose",
+    "TabSelect",
+    // The multiselected set can change with no other tab event -- clearing it,
+    // or a range selection that leaves the active tab alone. The published
+    // context carries that set and every request is validated against it, so
+    // this is not optional.
+    "TabMultiSelect",
+    "TabAttrModified",
+    "TabMove",
+    "TabHide",
+    "TabShow",
+    "TabPinned",
+    "TabUnpinned",
+  ],
+  // Group and split-view state the TabView strip presents, and which no tab
+  // event reports. These are not decoration: tab.visible is false for a tab in
+  // a collapsed group (tab.js `get visible()`), so a collapse changes the
+  // published row set with no TabHide behind it. Without these the strip only
+  // corrected itself on the next unrelated tab event -- which is exactly what
+  // the retired timer was papering over. All of them bubble, and the group
+  // ones are dispatched on the group element precisely so they still arrive
+  // when the tab itself has left the DOM.
+  stripStateEvents: [
+    // Change the visible row set or its order.
+    "TabGroupCreate",
+    "TabGroupRemoved",
+    "TabGroupMoved",
+    "TabGroupCollapse",
+    "TabGroupExpand",
+    "TabGrouped",
+    "TabUngrouped",
+    // Presentation only: a group's name or colour, and split-view pairing,
+    // change what a row says about itself, not which rows exist.
+    "TabGroupUpdate",
+    "TabSplitViewActivate",
+    "TabSplitViewDeactivate",
+  ],
+  // Of those, the ones that change which rows exist or their order.
+  stripStructuralEvents: new Set([
+    "TabGroupCreate",
+    "TabGroupRemoved",
+    "TabGroupMoved",
+    "TabGroupCollapse",
+    "TabGroupExpand",
+    "TabGrouped",
+    "TabUngrouped",
+  ]),
+  // Window activation changes whether the native surface holds focus at all,
+  // which nothing inside the document reports.
+  windowEvents: ["activate", "deactivate"],
+  events: [
+    "resize",
+    "fullscreen",
+    "sizemodechange",
+    "popupshown",
+    "popuppositioned",
+    "popuphidden",
+    "keydown",
+  ],
+
+  initOptions() {
+    if (AppConstants.platform !== "win" || !window.toolbar.visible) return;
+    this.optionsObserver = {
+      observe: () => {
+        if (this.reinitPending) return;
+        this.reinitPending = true;
+        Services.tm.dispatchToMainThread(() => {
+          this.reinitPending = false;
+          if (!this.optionsObserver) return;
+          if (this.draining || this.processingAction) {
+            this.optionsRefreshDeferred = true;
+            return;
+          }
+          const replace = Services.prefs.getBoolPref(this.replaceTabsPref, true);
+          const enabled = replace || Services.prefs.getBoolPref(this.pref, true);
+          if (this.element && enabled) {
+            this.schedule();
+            return;
+          }
+          this.uninit();
+          this.init();
+        });
+      },
+    };
+    for (const pref of [this.pref, this.replaceTabsPref]) {
+      Services.prefs.addObserver(pref, this.optionsObserver);
+    }
+    this.replacementStyle = document.createElementNS("http://www.w3.org/1999/xhtml", "style");
+    this.replacementStyle.textContent =
+      `:root[winui-replaces-tabs] #TabsToolbar { display: none !important; }
+       @media not -moz-pref("browser.nova.enabled") {
+         :root[winui-replaces-tabs][privatebrowsingmode="temporary"] #nav-bar > .private-browsing-indicator-with-label {
+           display: flex !important;
+         }
+       }
+       @media -moz-pref("browser.nova.enabled") {
+         :root[winui-replaces-tabs][privatebrowsingmode="temporary"] #nav-bar > .private-browsing-indicator-button {
+           display: flex !important;
+         }
+       }
+       :root[winui-replaces-tabs][contentanalysisactive] #nav-bar > .content-analysis-indicator {
+         display: flex !important;
+       }`;
+    document.documentElement.appendChild(this.replacementStyle);
+    // The retained toolbar is taken out of flow, not display:none, so the
+    // address proxy, ResizeObservers and Firefox popup anchors keep layout.
+    this.hideToolbarStyle = document.createElementNS("http://www.w3.org/1999/xhtml", "style");
+    this.hideToolbarStyle.textContent =
+      `:root[winui-hides-nav-bar] #nav-bar {
+         position: fixed !important;
+         inset-block-start: 0;
+         inset-inline-start: -200vw;
+         inline-size: 100vw;
+         pointer-events: none;
+       }`;
+    document.documentElement.appendChild(this.hideToolbarStyle);
+    this.hideToolbarObserver = {observe: () => this.updateToolbarHidden()};
+    Services.prefs.addObserver(this.hideToolbarPref, this.hideToolbarObserver);
+  },
+
+  uninitOptions() {
+    if (!this.optionsObserver) return;
+    for (const pref of [this.pref, this.replaceTabsPref]) {
+      Services.prefs.removeObserver(pref, this.optionsObserver);
+    }
+    this.optionsObserver = null;
+    this.replacementStyle.remove();
+    Services.prefs.removeObserver(this.hideToolbarPref, this.hideToolbarObserver);
+    this.hideToolbarStyle.remove();
+    this.setToolbarHidden(false);
+  },
+
+  toggleReplacement() {
+    if (gDialogBox.isOpen || Services.prefs.prefIsLocked(this.replaceTabsPref)) return;
+    Services.prefs.setBoolPref(this.replaceTabsPref,
+      !Services.prefs.getBoolPref(this.replaceTabsPref, true));
+  },
+
+  setReplacementActive(active) {
+    const root = document.documentElement;
+    if (root.hasAttribute("winui-replaces-tabs") !== active) {
+      root.toggleAttribute("winui-replaces-tabs", active);
+    }
+  },
+
+  // Screen CSS rect of the native strip's reserved row. Tab-group popups that
+  // would anchor to a Firefox label use it while the Firefox tab row is hidden.
+  groupMenuFallbackRect() {
+    if (!this.element || this.element.style.display === "none") return null;
+    const r = this.chromeLayout?.plan?.strip || this.element.getBoundingClientRect();
+    if (!r.width || !r.height) return null;
+    return {x: window.mozInnerScreenX + r.x, y: window.mozInnerScreenY + r.y,
+            width: r.width, height: r.height};
+  },
+
+  setToolbarHidden(hidden) {
+    const root = document.documentElement;
+    if (root.hasAttribute("winui-hides-nav-bar") !== hidden) {
+      root.toggleAttribute("winui-hides-nav-bar", hidden);
+    }
+  },
+
+  // Hide Firefox's retained toolbar only while the native navigation row is
+  // attached and active and every visible widget has a native home; never in
+  // fullscreen or customization, which is the way back to the toolbar.
+  updateToolbarHidden() {
+    const toolbar = this.addressToolbar;
+    this.setToolbarHidden(
+      Services.prefs.getBoolPref(this.hideToolbarPref, true) &&
+      !!toolbar?.active && toolbar.navigation && this.attached &&
+      Object.values(toolbar.indicatorState()).every(item => !item.shown || !!item.label) &&
+      !toolbar.hasVisibleUnhostedWidgets() &&
+      !window.fullScreen && !document.fullscreenElement &&
+      !document.documentElement.hasAttribute("customizing"));
+    this.chromeLayout?.update();
+  },
+
+  hasUnreplacedTabControls() {
+    const target = document.getElementById("TabsToolbar-customization-target");
+    return Array.from(target?.children || []).some(child =>
+      !["tabbrowser-tabs", "new-tab-button", "alltabs-button"].includes(child.id) &&
+      !["toolbarspring", "spacer", "toolbarseparator", "toolbartabstop"].includes(child.localName) &&
+      getComputedStyle(child).display !== "none");
+  },
+
+  ensureChromeLayout() {
+    if (this.chromeLayout || !Services.prefs.getBoolPref(this.chromeLayoutPref, Services.prefs.getDefaultBranch("").getBoolPref(this.chromeLayoutPref, false))) return;
+    const {WinUIChromeLayout} = ChromeUtils.importESModule("chrome://browser/content/WinUIChromeLayout.sys.mjs");
+    this.chromeLayout = new WinUIChromeLayout(window, this);
+  },
+
+  init() {
+    if (
+      !(Services.prefs.getBoolPref(this.pref, true) ||
+        Services.prefs.getBoolPref(this.replaceTabsPref, true)) ||
+      !window.toolbar.visible
+    ) {
+      return;
+    }
+    this.uninitializing = false;
+    // This window's native endpoint, formatted exactly as nsIBaseWindow does,
+    // so the pane's drain notification can be matched to this window. An HWND
+    // alone is not a lifetime identity; the request path carries its own
+    // generation, and this only routes the wakeup.
+    try {
+      this.endpoint = window.docShell.treeOwner
+        .QueryInterface(Ci.nsIBaseWindow).nativeHandle;
+    } catch {
+      this.endpoint = "";
+    }
+    this.element = document.createElementNS(
+      "http://www.w3.org/1999/xhtml",
+      "div"
+    );
+    this.element.id = "winui-prototype-pane";
+    this.element.tabIndex = 0;
+    // This is a layout/focus router, not the accessible native TabView.
+    this.element.setAttribute("aria-hidden", "true");
+    this.element.setAttribute("aria-label", this.nativeLabels().tabs);
+    // The native header follows this reservation: 32-DIP tabs with 0, 8,
+    // or 16 DIPs of top padding. Unsupported preferences use the default.
+    const requested = Services.prefs.getIntPref(this.stripHeightPref, 40);
+    const height = [32, 40, 48].includes(requested) ? requested : 40;
+    this.element.style.cssText =
