+// Firefox owns widget eligibility and durable placement; native owns the editor.
+import { readActionStamp, actionStampMatches } from "chrome://browser/content/WinUIActionStamp.sys.mjs";
+export class WinUIToolbarCustomization {
+  constructor(toolbar) {
+    this.toolbar = toolbar;
