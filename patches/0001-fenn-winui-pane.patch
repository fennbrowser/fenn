+
+  async #restartQuery(request) {
+    const active = this.active;
+    const editor = this.editor;
+    if (!editor || active?.source !== "independent" || this.closed || !this.nativeOpen) {
+      WinUIAddressSession.#note(WinUIAddressSession.counters.requests, "restart-unowned");
+      return;
+    }
+    const proposal = editor.getRestartRequest(request.token);
+    WinUIAddressSession.#note(
+      WinUIAddressSession.counters.requests,
+      proposal ? "restart-current" : "restart-stale"
