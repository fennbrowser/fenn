+      title: String(title.value ?? ""),
+      displayUrl: String(url.value ?? ""),
+      // The DOM renderer leaves explicit/localized titles unhighlighted.
+      // Copy the formatter's ranges; never retain or mutate its cached object.
+      titleHighlights: !descriptor ? this.copyHighlights(title) : null,
+      urlHighlights: this.copyHighlights(url),
