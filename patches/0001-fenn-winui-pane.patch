+    if (DWORD cookie=mUia.exchange(0)) mGit->RevokeInterfaceFromGlobal(cookie);
+  }
+  bool NeedsRebind() const { return mStale.load(); }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid,void** out) override {
+    if (!out) return E_POINTER;
