+    for (const name of HOST_METHODS) {
+      if (typeof host?.[name] !== "function") throw new TypeError(`Missing result action host method: ${name}`);
+    }
+    this.host=host;
+    this.commandsCache=new WeakMap();
+  }
+  /** Adapt an original input; every member is read live, never captured. */
