+          (options.searchString !== undefined && !text(options.searchString))) {
+        pending.unsupported = true;
+      } else {
+        pending.startQuery = true;
+        if (options.allowAutofill !== undefined) pending.allowAutofill = options.allowAutofill;
+        if (options.searchString !== undefined) pending.value = options.searchString;
+      }
+    } else {
+      // input.search(): a value and, optionally, an engine and mode entry. The host
+      // drives it through the ordinary search-command handoff.
+      const options = call.options ?? {};
+      const engine = options.searchEngine, entry = options.searchModeEntry;
+      const known = ["searchEngine", "searchModeEntry", "focus", "startQuery"];
+      if (!text(call.value) || pending.startQuery || pending.value !== null || pending.search !== null ||
