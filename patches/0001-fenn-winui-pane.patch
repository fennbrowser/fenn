+      return { id: "urlbar-group-shortcuts" };
+    }
+
+    if (!context?.searchString || result.heuristic) {
+      return null;
+    }
+
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.KEYWORD:
+      case UrlbarShared.RESULT_TYPE.REMOTE_TAB:
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+      case UrlbarShared.RESULT_TYPE.URL:
+        return { id: "urlbar-group-firefox-suggest" };
+      case UrlbarShared.RESULT_TYPE.SEARCH:
+        return {
+          id: "urlbar-group-search-suggestions",
+          args: { engine: engineName },
+        };
+      case UrlbarShared.RESULT_TYPE.DYNAMIC:
+        if (result.providerName == "quickactions") {
+          return { id: "urlbar-group-quickactions" };
+        }
+        break;
+    }
+
+    return null;
+  }
+
+  createDismissalAcknowledgment(result, titleL10n, context) {
+    return new UrlbarResult({
+      type: UrlbarShared.RESULT_TYPE.TIP,
+      source: UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+      payload: {
+        type: "dismissalAcknowledgment",
+        titleL10n,
+        buttons: [{ l10n: { id: "urlbar-search-tips-confirm-short" } }],
+        icon: "chrome://branding/content/icon32.png",
+      },
+      rowLabel: !result.hideRowLabel && this.rowLabel(result, context),
+      hideRowLabel: result.hideRowLabel,
+      richSuggestionIconSize: 32,
+    });
+  }
+
+}
diff --git a/browser/base/content/WinUIActionStamp.sys.mjs b/browser/base/content/WinUIActionStamp.sys.mjs
new file mode 100644
index 0000000000..6db39b4aab
--- /dev/null
+++ b/browser/base/content/WinUIActionStamp.sys.mjs
@@ -0,0 +1,22 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Identity only. Each surface still parses its command grammar and revalidates
+// Firefox's live prerequisites before invoking the original controller.
+export function readActionStamp(revision, session = null, maximum = Number.MAX_SAFE_INTEGER) {
+  const read = value => {
+    if (typeof value !== "number" && (typeof value !== "string" || !/^[0-9]+$/.test(value))) return null;
+    const number = Number(value);
+    return Number.isSafeInteger(number) && number >= 0 && number <= maximum ? number : null;
+  };
+  const structure = read(revision);
+  const opening = session === null ? null : read(session);
+  if (structure === null || (session !== null && (opening === null || opening === 0))) return null;
+  return {revision: structure, session: opening};
+}
+
+export function actionStampMatches(stamp, revision, session = null) {
+  return !!stamp && Number.isSafeInteger(revision) && revision >= 0 &&
+    stamp.revision === revision && stamp.session === session;
+}
diff --git a/browser/base/content/WinUIHistoryMenu.sys.mjs b/browser/base/content/WinUIHistoryMenu.sys.mjs
new file mode 100644
index 0000000000..e4be8e911d
--- /dev/null
+++ b/browser/base/content/WinUIHistoryMenu.sys.mjs
@@ -0,0 +1,86 @@
+// Opt-in History root. Firefox owns data, navigation policy and commands.
+import { readActionStamp, actionStampMatches } from "chrome://browser/content/WinUIActionStamp.sys.mjs";
+export class WinUIHistoryMenu {
+  constructor(toolbar) {
+    this.toolbar=toolbar;this.session=0;this.lastSession=0;this.actions=new Map();
+    this.preferenceChanged=()=>{if(!this.enabled && this.session)this.dismiss();else toolbar.owner.invalidateAddress();};
+    Services.prefs.addObserver("fenn.winui.navigation.history.menu.enabled",this.preferenceChanged);
+  }
+  close() {this.dismiss();Services.prefs.removeObserver("fenn.winui.navigation.history.menu.enabled",this.preferenceChanged);}
+  get enabled() { return Services.prefs.getBoolPref("fenn.winui.navigation.history.menu.enabled",false); }
+  snapshot() {
+    if(this.session && (!this.enabled || !this.toolbar.active || this.toolbar.customization?.editorOpen ||
+       this.context?.tab!==this.toolbar.owner.addressTab || this.context?.document!==this.toolbar.owner.addressDocument))this.dismiss();
+    return {enabled:this.enabled,closed:this.closed || 0,...(this.description || {})};
+  }
+  dismiss() {
+    if(this.session)this.closed=this.session;
+    this.session=0;this.description=null;this.actions.clear();
+    if(this.root){this.root.containerOpen=false;this.root=null;}this.result=null;
+    this.toolbar.owner.invalidateAddress();
+  }
+  async open(session,bounds) {
+    this.dismiss();this.session=session;this.bounds=bounds;
+    this.context={tab:this.toolbar.owner.addressTab,document:this.toolbar.owner.addressDocument};
+    const {window,owner}=this.toolbar;
+    const messages=await window.document.l10n.formatMessages([
+      {id:"appmenu-search-history"},{id:"appmenu-clear-history"},{id:"appmenu-manage-history"}]);
+    if(this.session!==session || !this.enabled || !this.toolbar.active)return;
+    const label=m=>m.attributes?.find(a=>a.name==="label")?.value || m.value;
+    const labels=messages.map(label);
+    if(labels.some(v=>!v))throw new Error("Missing History menu localization");
+    const {PlacesUtils}=ChromeUtils.importESModule("resource://gre/modules/PlacesUtils.sys.mjs");
+    const query=PlacesUtils.history.getNewQuery(), options=PlacesUtils.history.getNewQueryOptions();
+    options.queryType=Ci.nsINavHistoryQueryOptions.QUERY_TYPE_HISTORY;
+    options.sortingMode=Ci.nsINavHistoryQueryOptions.SORT_BY_DATE_DESCENDING;
+    options.maxResults=42;options.excludeQueries=true;
+    this.result=PlacesUtils.history.executeQuery(query,options);this.root=this.result.root;this.root.containerOpen=true;
