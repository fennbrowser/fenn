+bool FocusIndependentWindowHost(HWND proxy) {
+  HWND endpoint = static_cast<HWND>(GetPropW(proxy, WINUI_PANE_ENDPOINT_PROPERTY));
+  if (!endpoint) return false;
+  HWND window = ShellOfProxy(proxy);
+  // A process window is still a hidden proxy while binding is pending. Do not
+  // fall through to Win32 focus or post a native-focus request to that proxy.
+  if (window == proxy) return true;
+  static const UINT message =
+      RegisterWindowMessageW(L"Fenn.NativeWindowHost.Focus.v1");
+  // Finish the current Gecko operation (notably AppWindow::Destroy) before
+  // requesting native focus. Posting straight to the other thread can run
+  // SetFocus while Gecko is still tearing down the previous active dialog,
+  // then deadlock against a synchronous native layout call from that teardown.
+  // The runnable owns only scalar identities; it never pumps borrowed ABI work.
+  NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+      "FocusIndependentWindowHost", [window, endpoint, proxy]() {
+        if (GetPropW(window, WINUI_PANE_ENDPOINT_PROPERTY) != endpoint) return;
+        // Gecko's focus is on an element that stands for a native control, such as the native
+        // address field, which has keyboard focus already. Focusing the window would take it away.
+        nsFocusManager* focus = nsFocusManager::GetFocusManager();
+        dom::Element* element = focus ? focus->GetFocusedElement() : nullptr;
+        if (element && element->HasAttribute(u"winui-native-focus"_ns)) {
+          nsIWidget* widget = nsContentUtils::WidgetForDocument(element->OwnerDoc());
+          if (widget && widget->GetNativeData(NS_NATIVE_WINDOW) == proxy) return;
+        }
+        if (!message || !PostMessageW(window, message,
+                                      reinterpret_cast<WPARAM>(endpoint), 0)) {
+          NS_WARNING("Native focus request failed");
+        }
+      }));
+  return true;
+}
