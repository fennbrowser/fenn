+    this.owner.addressFallback("toolbar-focus-failed");
+  }
+  restore() {
+    if(this.historyMenu?.session)this.historyMenu.dismiss();
+    if(this.downloadsPanel?.session)this.downloadsPanel.dismiss();
+    if(this.profileMenu?.session)this.profileMenu.dismiss();
+    if(this.overflowMenu?.session)this.overflowMenu.dismiss();
+    this.profilerPanel?.dismiss();
+    this.bookmarkPanel?.retire(true);
+    this.permissionsPanel?.dismiss();
+    this.notificationPanel?.dismiss();
+    this.pageContextMenu?.dismiss();
+    this.connectionPanel?.dismiss();
+    this.translationsPanel?.dismiss();
+    this.selectedTranslationsPanel?.dismiss();
+    if(this.backForwardMenu?.session)this.backForwardMenu.dismiss();
+    if(this.developerMenu?.session)this.developerMenu.dismiss();
+    if(this.tabGroupsMenu?.session)this.tabGroupsMenu.dismiss();
+    this.privacyPanels?.dismissAll();
+    if (this.activationFrame) this.window.cancelAnimationFrame(this.activationFrame);
+    this.activationFrame = 0;
+    for (const panel of this.window.document.querySelectorAll("panel, menupopup")) {
+      if (panel?.anchorNode && [...(this.menuAnchors?.values() || [])].includes(panel.anchorNode)) panel.hidePopup();
+    }
+    this.customization?.nativeOverflow.clear();
+    this.window.document.getElementById("nav-bar")?.overflowable?.setNativeOverflow(null);
+    // Firefox's focus decides, not focusOwned: an inactive window never reports the native blur that
+    // clears it, and a native F11 reports one before fullscreen retires the editor.
+    const hadFocus = this.active && this.window.document.activeElement === this.proxy;
+    this.active = false;
+    this.focusOwned = false;
+    this.customization?.endEditor();
+    this.row.hidden = true;
+    this.window.document.documentElement.removeAttribute("winui-address-active");
+    this.owner.updateToolbarHidden?.();
+    this.input.removeAttribute("aria-hidden");
+    this.switcher.removeAttribute("aria-hidden");
+    this.switcher.inert = !!this.switcherWasInert;
+    this.owner.addressSession?.releaseNativePresentation();
+    try { this.window.windowUtils.updateWinUIAddress(0, 0, 0, 0, false, false, false); } catch {}
+    if (hadFocus) this.window.gURLBar.focus();
+  }
+  // While the native toolbar is active, Firefox's Customize Toolbar command
+  // (from any of its menus) opens the native editor instead of Firefox's mode.
+  // The request counter travels with the navigation snapshot.
+  onCustomizeCommand(event) {
+    if (event.target?.id !== "cmd_CustomizeToolbars" || !this.active || !this.navigation) return;
+    event.stopImmediatePropagation();
+    event.preventDefault();
+    this.editorRequests++;
+    this.owner.invalidateAddress();
+  }
+  bounds() {
+    this.owner.chromeLayout?.update();
+    if (this.owner.chromeLayout?.plan) return this.owner.chromeLayout.plan.navigation;
+    return this.row.getBoundingClientRect();
+  }
+  close() {
+    this.restore();
+    this.historyMenu.close();
+    this.downloadsPanel.close();
+    this.profileMenu.close();
+    this.overflowMenu.close();
+    this.developerMenu.close();
+    this.backForwardMenu.close();
+    this.profilerPanel.close();
+    this.bookmarkPanel.close();
+    this.permissionsPanel.close();
+    this.notificationPanel.close();
+    this.pageContextMenu.close();
+    this.connectionPanel.close();
+    this.translationsPanel.close();
+    this.selectedTranslationsPanel.close();
+    this.tabGroupsMenu.close();
+    this.privacyPanels.close();
+    this.resize.disconnect();
+    Services.prefs.removeObserver("browser.nova.enabled", this.novaObserver);
+    this.navigationObserver.disconnect();
+    this.unhostedObserver.disconnect();
+    this.unhostedNodes.clear();
+    this.customization?.close();
+    this.pinned?.close();
+    this.omnibar?.close();
+    this.productMenu?.close();
+    this.window.removeEventListener("command", this.customizeListener, true);
+    this.window.gBrowser.removeTabsProgressListener(this.progress);
+    this.input.removeEventListener("beforefocus", this.beforeFocus);
+    this.input.removeEventListener("beforeselect", this.beforeFocus);
+    this.proxy.remove();
+    this.menuAnchors?.clear();
+    this.row.remove();
+    this.link.onload = null;
+    this.link.remove();
+  }
+}
diff --git a/browser/base/content/WinUINavigationState.sys.mjs b/browser/base/content/WinUINavigationState.sys.mjs
new file mode 100644
index 00000000000..9f282df768b
--- /dev/null
+++ b/browser/base/content/WinUINavigationState.sys.mjs
@@ -0,0 +1,84 @@
+// Command state and labels the native navigation toolbar publishes. Firefox owns
+// the commands and their availability; this module is the one place the native
+// toolbar reads them, so a command can move from its DOM source to a model
+// without touching the toolbar.
+
+// `command` is the Firefox command element that carries availability, `element`
+// the toolbar widget that carries label and visibility, `method` the
+// BrowserCommands entry and `menu` whether activation opens a Firefox panel.
+export const NAVIGATION_COMMANDS = Object.freeze([
+  { id: "home", element: "home-button", method: "home" },
+  { id: "downloads", element: "downloads-button", menu: true },
+  { id: "history", element: "history-panelmenu", menu: true },
+  { id: "bookmarks", element: "bookmarks-menu-button", menu: true },
+  { id: "reset-pbm", element: "reset-pbm-toolbar-button", menu: true },
+  { id: "back", command: "Browser:Back", element: "back-button", method: "back" },
+  { id: "forward", command: "Browser:Forward", element: "forward-button", method: "forward" },
+  { id: "reload", command: "Browser:Reload", element: "reload-button", method: "reloadOrDuplicate" },
+  { id: "stop", command: "Browser:Stop", element: "stop-button", method: "stop" },
+  { id: "profile", element: "fxa-toolbar-menu-button", menu: true },
+  { id: "extensions", element: "unified-extensions-button", menu: true },
+  { id: "overflow", element: "nav-bar-overflow-button", menu: true },
+  { id: "appmenu", element: "PanelUI-menu-button", menu: true },
+].map(Object.freeze));
+
+// Every element the state reads, by id. The tripwire test compares a run
+// against this list, so a new read has to be declared here.
+export const NAVIGATION_STATE_READS = Object.freeze([
+  "Browser:Stop",
+  ...NAVIGATION_COMMANDS.flatMap(item => [item.command, item.element].filter(Boolean)),
+  "downloads-button",
+  "widget-overflow-list",
+  "widget-overflow-fixed-list",
+]);
+
+const OVERFLOW_LISTS = ["widget-overflow-list", "widget-overflow-fixed-list"];
+
+export class WinUINavigationState {
+  /**
+   * @param {Window} window
+   * @param {(id: string) => string} fallbackLabel Localized label used when the
+   *   widget has none of its own.
+   */
+  constructor(window, fallbackLabel = () => "") {
+    this.window = window;
+    this.fallbackLabel = fallbackLabel;
+  }
+
+  // Element ids whose attributes change the published state.
+  observedIds() {
+    return [...new Set(NAVIGATION_COMMANDS.flatMap(item => [item.command, item.element].filter(Boolean)))];
+  }
+
+  snapshot() {
+    const document = this.window.document;
+    const stop = document.getElementById("Browser:Stop");
+    const stopping = !!stop && !stop.hasAttribute("disabled");
+    const state = Object.fromEntries(NAVIGATION_COMMANDS.filter(item => item.id !== "stop").map(slot => {
+      const item = slot.id === "reload" && stopping ? NAVIGATION_COMMANDS.find(entry => entry.id === "stop") : slot;
+      const command = document.getElementById(item.command || item.element);
+      const button = document.getElementById(item.element);
+      const label = button?.getAttribute("label") || button?.getAttribute("aria-label") ||
+        this.fallbackLabel(item.id) || "";
+      return [slot.id, {
+        ...(slot.id === "reload" ? { stopping } : {}),
+        enabled: !!command && command.getAttribute("disabled") !== "true",
+        label: label || button?.getAttribute("tooltiptext") || "",
+        tooltip: button?.getAttribute("tooltiptext") || label,
+      }];
+    }));
+    const downloads = document.getElementById("downloads-button");
+    if (state.downloads) {
+      Object.assign(state.downloads, {
+        shown: !!downloads && !downloads.hidden,
+        progress: downloads?.hasAttribute("progress")
+          ? Math.max(0, Math.min(100, this.window.DownloadsIndicatorView._percentComplete))
+          : -1,
+        attention: downloads?.getAttribute("attention") || "",
+      });
+    }
+    state.overflow.enabled = OVERFLOW_LISTS.some(id =>
+      [...(document.getElementById(id)?.children || [])].some(node => !node.hidden));
+    return state;
+  }
+}
diff --git a/browser/base/content/WinUIAddressToolbar.css b/browser/base/content/WinUIAddressToolbar.css
new file mode 100644
index 00000000000..102270633fe
--- /dev/null
+++ b/browser/base/content/WinUIAddressToolbar.css
@@ -0,0 +1,40 @@
+#winui-address-focus { display: none; }
+#winui-navigation-toolbar:not([hidden]) {
+  display: block;
+  position: relative;
+  min-block-size: 40px;
+  block-size: 40px;
+  flex-shrink: 0;
+  -moz-window-dragging: no-drag;
+}
+:root[winui-address-active] .urlbar-input-box { position: relative; }
+:root[winui-address-active] .urlbar-input-box > input { visibility: hidden; }
+:root[winui-address-active] .searchmode-switcher {
+  opacity: 0;
+  pointer-events: none;
+}
+:root[winui-address-active] #winui-address-focus {
+  display: block;
+  position: absolute;
+  inset: 0;
+}
+
+.winui-toolbar-menu-anchor { position: fixed; pointer-events: none; opacity: 0; }
+/* Span the live row so Firefox keeps both left- and right-aligned automatic
+   prompts inside the owning window, including after moves and resizes. */
+.winui-toolbar-notification-anchor { position: absolute; inset: 0; }
+
+/* The window backdrop frames the native navigation row and page together.
+   Keep their side insets aligned; the toolbar's bounds also position its native
+   island. Fullscreen and DOM fullscreen keep the full-bleed layout. */
+:root[winui-address-active]:not([inDOMFullscreen], [fullscreenNavToolboxHidden]) #winui-navigation-toolbar:not([hidden]) {
+  margin-inline: var(--winui-content-frame, 4px);
+}
+:root[winui-address-active]:not([inDOMFullscreen], [fullscreenNavToolboxHidden]) #browser {
+  padding: 0 var(--winui-content-frame, 4px) var(--winui-content-frame, 4px);
+  background-color: transparent;
+}
+:root[winui-address-active]:not([inDOMFullscreen], [fullscreenNavToolboxHidden]) #tabbrowser-tabbox {
+  border-radius: 0 0 var(--winui-content-radius, 8px) var(--winui-content-radius, 8px);
+  overflow: clip;
+}
diff --git a/browser/base/content/browser-winui-pane.js b/browser/base/content/browser-winui-pane.js
