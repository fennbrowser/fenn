+  // OLE invokes Firefox on Gecko, never on the input thread. Each registration
+  // has a fresh, revocable identity so a held old Drop cannot commit a new drag.
+  RefPtr<WinUIDropTarget> lease=new WinUIDropTarget(link.dropTarget);
