+  /** Confirm a preview without mutating the query's pre-confirmation mode facts. */
+  /** confirmSearchMode only invokes the setter and clears one-offs for a preview. */
+  static confirmationPolicy(mode) {
+    const applyMode = !!mode?.isPreview;
+    return Object.freeze({ applyMode, clearOneOffSelection: applyMode,
+      searchMode: applyMode ? this.confirmedMode(mode) : (mode ? Object.freeze({ ...mode }) : null) });
+  }
+
+  static confirmedMode(mode) {
