+    queries: totals.queries,
+    activations: totals.activations,
+    commands: totals.commands,
+    modes: totals.modes,
+    restarts: totals.restarts,
+    replays: totals.replays,
+    inherited: totals.inherited,
+    attempts,
+    fallbackTotal: totals.fallbackTotal,
+    handoffs,
