@@ -0,0 +1,345 @@
+/* Licensed under the Mozilla Public License, v. 2.0. */
+#include "WinUIPageInput.h"
+#include "WinIMEHandler.h"
+#include "nsWindow.h"
+#include "nsThreadUtils.h"
+#include "mozilla/RefPtr.h"
+#include "mozilla/TextEvents.h"
+#include "mozilla/TextEventDispatcher.h"
+#include "mozilla/TextRange.h"
+#include "mozilla/IMEStateManager.h"
+#include "mozilla/dom/BrowserParent.h"
+#include <deque>
+#include <map>
+
+namespace mozilla::widget {
+namespace {
+constexpr uint32_t kMaxText=65536;
+// The native store's event kind for an accepted publication (ShellCore's ACCEPTED).
+constexpr uint32_t kAccepted=7;
+struct Session final {
+  NS_INLINE_DECL_REFCOUNTING(Session)
+  RefPtr<nsWindow> window;
+  uint64_t id=0, revision=0, publishedRevision=0, dispatched=0, acknowledgment=0;
+  uint32_t textBase=0, textLength=0;
+  // Publications are posted. Their text base applies once the store accepts them, in order with
+  // the events it made against the previous one.
+  struct Pending { uint64_t revision; uint32_t base, length; };
+  std::deque<Pending> pending;
+  bool scheduled=false, draining=false, focused=true, suspended=false;
+  explicit Session(nsWindow* widget):window(widget) {}
+ private:
+  ~Session()=default;
+};
+std::map<HWND,RefPtr<Session>> sSessions;
+uint64_t sNextSession=0;
+RefPtr<Session> Find(HWND hwnd) {
+  auto it=sSessions.find(hwnd);return it==sSessions.end() ? nullptr : it->second;
+}
+bool Current(const RefPtr<Session>& session) {
+  return session && !session->window->Destroyed() && Find(session->window->GetWindowHandle())==session;
+}
+void Publish(const RefPtr<Session>& session) {
+  if(!Current(session) || !session->focused || session->suspended) return;
+  auto widget=session->window;
+  WinUIPageInput input{};input.session=session->id;input.revision=++session->revision;
+  input.acknowledgment=session->acknowledgment;
+  nsTArray<InputScope> scopes;
+  const auto& context=widget->GetInputContext();
+  IMEHandler::AppendInputScopeFromType(context.mHTMLInputType,scopes);
+  IMEHandler::AppendInputScopeFromInputMode(context.mHTMLInputMode,scopes);
+  if(context.mInPrivateBrowsing)scopes.AppendElement(IS_PRIVATE);
+  if(scopes.Length()>8)return;
+  input.scopeCount=scopes.Length();
+  for(uint32_t i=0;i<input.scopeCount;++i)input.scopes[i]=scopes[i];
+  // Never copy password text into a separate native presentation cache.
+  if(widget->GetInputContext().mIMEState.mEnabled!=IMEEnabled::Enabled) {
+    PublishIndependentPageInput(widget->GetWindowHandle(),input);return;
+  }
+  WidgetQueryContentEvent selection(true,eQuerySelectedText,widget);
+  selection.mNeedsToFlushLayout=false;widget->InitEvent(selection);widget->DispatchWindowEvent(selection);
+  if(!Current(session) || selection.Failed()) return;
+  const uint32_t start=selection.mReply->StartOffset(), end=selection.mReply->EndOffset();
+  // Keep a bounded surrounding-text window, leaving room for local composition
+  // growth. TSF ACPs are local to this view; Gecko offsets stay document-relative.
+  if(end<start || end-start>kMaxText-2) {PublishIndependentPageInput(widget->GetWindowHandle(),input);return;}
+  const uint32_t contextLength=std::max(kMaxText/2,end-start+2);
+  uint32_t base=session->textBase;
+  if(start<base || uint64_t(end)>uint64_t(base)+contextLength) {
+    const uint32_t before=(contextLength-(end-start))/2;
+    base=start>before ? start-before : 0;
+  }
+  const uint32_t queryBase=base ? base-1 : 0;
+  WidgetQueryContentEvent text(true,eQueryTextContent,widget);
+  text.InitForQueryTextContent(queryBase,contextLength+2);text.mNeedsToFlushLayout=false;
+  widget->InitEvent(text);widget->DispatchWindowEvent(text);
+  if(!Current(session) || text.Failed()) return;
+  const nsString& source=text.mReply->DataRef();
+  uint32_t skip=base-queryBase;
+  if(skip>source.Length())return;
+  // Do not split a surrogate pair at either edge of the context window.
+  if(skip && skip<source.Length() && source[skip]>=0xdc00 && source[skip]<=0xdfff && source[skip-1]>=0xd800 && source[skip-1]<=0xdbff) {--skip;--base;}
+  uint32_t length=std::min<size_t>(contextLength,source.Length()-skip);
+  if(length && skip+length<source.Length() && source[skip+length-1]>=0xd800 && source[skip+length-1]<=0xdbff && source[skip+length]>=0xdc00 && source[skip+length]<=0xdfff)--length;
+  if(start<base || uint64_t(end)>uint64_t(base)+length)return;
+  nsDependentSubstring value(source,skip,length);
+  input.start=start-base;input.end=end-base;input.textBase=base;
+  input.reversed=selection.mReply->mReversed;
+  WidgetQueryContentEvent caret(true,eQueryCaretRect,widget);
+  caret.InitForQueryCaretRect(input.reversed ? start : end);caret.mNeedsToFlushLayout=false;
+  widget->InitEvent(caret);widget->DispatchWindowEvent(caret);
+  if(!Current(session) || caret.Failed()) return;
+  auto rect=caret.mReply->mRect;
+  auto reference=static_cast<nsWindow*>(caret.mReply->mFocusedWidget ? caret.mReply->mFocusedWidget : widget.get());
+  reference=reference->GetTopLevelWindow(false);if(!reference)return;
+  rect.MoveBy(reference->WidgetToScreenOffset());
+  input.caret={rect.X(),rect.Y(),rect.X()+std::max(1,rect.Width()),rect.Y()+std::max(1,rect.Height())};
+  // TSF's view extent is the focused editor, not the outer native window.
+  // Match TSFTextStoreBase: clip Gecko's editor rect to the client bounds before
+  // converting to physical screen coordinates. The Japanese candidate UI can
+  // retain a pre-DPI anchor when the view extent is the whole browser instead.
+  WidgetQueryContentEvent editor(true,eQueryEditorRect,widget);
+  editor.mNeedsToFlushLayout=false;widget->InitEvent(editor);widget->DispatchWindowEvent(editor);
+  if(!Current(session) || editor.Failed()) return;
+  auto editorReference=static_cast<nsWindow*>(editor.mReply->mFocusedWidget ? editor.mReply->mFocusedWidget : widget.get());
+  editorReference=editorReference->GetTopLevelWindow(false);if(!editorReference)return;
+  auto editorRect=editorReference->GetClientBounds();editorRect.MoveTo(0,0);
+  editorRect.IntersectRect(editor.mReply->mRect,editorRect);
+  if(!editorRect.IsEmpty()) {
+    editorRect.MoveBy(editorReference->WidgetToScreenOffset());
+    input.editor={editorRect.X(),editorRect.Y(),editorRect.XMost(),editorRect.YMost()};
+  }
+  input.enabled=1;input.length=value.Length();input.text=reinterpret_cast<const wchar_t*>(value.BeginReading());
+  if(PublishIndependentPageInput(widget->GetWindowHandle(),input)==S_OK) {
+    if(session->pending.size()>=16)session->pending.pop_front();
+    session->pending.push_back({input.revision,base,length});
+  }
+}
+void Accept(const RefPtr<Session>& session,uint64_t revision) {
+  for(const auto& entry : session->pending) if(entry.revision==revision) {
+    session->textBase=entry.base;session->textLength=entry.length;session->publishedRevision=revision;break;
+  }
+  std::erase_if(session->pending,[revision](const Session::Pending& entry){return entry.revision<=revision;});
+}
+// One remote query in flight globally, with bounded FIFO work across windows.
+// Stale jobs are discarded before querying and again before publishing replies.
+using GeometryJob=std::pair<RefPtr<Session>,WinUIPageInputEvent>;
+std::deque<GeometryJob> sGeometryQueries;
+bool sGeometryBusy=false;
+bool GeometryCurrent(const RefPtr<Session>& session,const WinUIPageInputEvent& request) {
+  return Current(session) && session->focused && request.session==session->id &&
+      request.edit==session->dispatched && request.revision==session->publishedRevision;
+}
+void FinishGeometry(const RefPtr<Session>& session,const WinUIPageInputEvent& request,
+                    bool valid,LayoutDeviceIntRect rect={},LayoutDeviceIntRect editor={}) {
+  if(!GeometryCurrent(session,request))return;
+  auto widget=session->window;
+  WinUIPageGeometry reply{};reply.session=request.session;reply.edit=request.edit;
+  reply.revision=request.revision;reply.request=request.request;reply.start=request.start;reply.end=request.end;
+  if(valid) {
+    rect.SetWidth(std::max(1,rect.Width()));rect.SetHeight(std::max(1,rect.Height()));
+    auto visible=widget->GetClientBounds();visible.MoveTo(0,0);visible.IntersectRect(editor,visible);
+    auto clipped=rect.Intersect(visible);reply.clipped=clipped!=rect;
+    if(!clipped.IsEmpty()) {clipped.MoveBy(widget->WidgetToScreenOffset());reply.bounds={clipped.X(),clipped.Y(),clipped.XMost(),clipped.YMost()};}
+    reply.valid=1;
+  }
+  PublishIndependentPageGeometry(widget->GetWindowHandle(),reply);
+}
+void PumpGeometry();
+void QueryGeometry(const RefPtr<Session>& session,const WinUIPageInputEvent& request) {
+  if(!GeometryCurrent(session,request) || request.start>request.end || uint64_t(session->textBase)+request.end>UINT32_MAX)return;
+  auto widget=session->window;
+  const uint32_t offset=session->textBase+request.start,length=request.end-request.start;
+  RefPtr<dom::BrowserParent> browser=IMEStateManager::GetActiveBrowserParent();
+  if(browser) {
+    nsCOMPtr<nsIWidget> top=browser->GetTopLevelWidget();
+    if(!browser->CanSend() || !IMEStateManager::DoesBrowserParentHaveIMEFocus(browser) ||
+        !top || top->GetNativeData(NS_NATIVE_WINDOW)!=widget->GetWindowHandle()) {
+      FinishGeometry(session,request,false);return;
+    }
+    sGeometryBusy=true;
+    browser->SendFennQueryPageGeometry(offset,length)->Then(GetCurrentSerialEventTarget(),__func__,
+      [session,request,browser](const dom::FennPageGeometryResult& result) {
+        sGeometryBusy=false;
+        if(IMEStateManager::GetActiveBrowserParent()==browser && IMEStateManager::DoesBrowserParentHaveIMEFocus(browser))
+          FinishGeometry(session,request,result.valid(),browser->TransformChildToParent(result.textRect()),browser->TransformChildToParent(result.editorRect()));
+        PumpGeometry();
+      },
+      [session,request](const ipc::ResponseRejectReason&) {
+        sGeometryBusy=false;FinishGeometry(session,request,false);PumpGeometry();
+      });
+    return;
+  }
+  WidgetQueryContentEvent textRect(true,length ? eQueryTextRect : eQueryCaretRect,widget);
+  if(length)textRect.InitForQueryTextRect(offset,length);
+  else textRect.InitForQueryCaretRect(offset);
+  widget->InitEvent(textRect);widget->DispatchWindowEvent(textRect);
+  WidgetQueryContentEvent editorRect(true,eQueryEditorRect,widget);
+  widget->InitEvent(editorRect);widget->DispatchWindowEvent(editorRect);
+  if(textRect.Succeeded() && editorRect.Succeeded())FinishGeometry(session,request,true,textRect.mReply->mRect,editorRect.mReply->mRect);
+  else FinishGeometry(session,request,false);
+}
+void PumpGeometry() {
+  while(!sGeometryBusy && !sGeometryQueries.empty()) {
+    auto job=std::move(sGeometryQueries.front());sGeometryQueries.pop_front();
+    QueryGeometry(job.first,job.second);
+  }
+}
+void Geometry(const RefPtr<Session>& session,const WinUIPageInputEvent& request) {
+  std::erase_if(sGeometryQueries,[](const GeometryJob& job){return !GeometryCurrent(job.first,job.second);});
+  if(sGeometryQueries.size()>=16) {FinishGeometry(session,request,false);return;}
+  sGeometryQueries.emplace_back(session,request);PumpGeometry();
+}
+void Schedule(const RefPtr<Session>& session) {
+  if(!Current(session) || session->scheduled) return;
+  session->scheduled=true;
+  NS_DispatchToMainThread(NS_NewRunnableFunction("FennPageInputPublication",[session] {
+    session->scheduled=false;Publish(session);
+  }));
+}
+}
+void DrainIndependentPageIME(HWND hwnd) {
+  RefPtr<Session> session=Find(hwnd);
+  if(!session) {
+    // Events for an ended session, such as an IME's late commit: drain them so the store wakes
+    // Gecko again for the next one.
+    WinUIPageInputEvent event{};nsString text;text.SetLength(kMaxText);
+    for(unsigned i=0;i<128 && DrainIndependentPageInput(hwnd,event,reinterpret_cast<wchar_t*>(text.BeginWriting()),kMaxText)==S_OK;++i) {}
+    return;
+  }
+  if(!Current(session) || session->draining)return;
+  session->draining=true;
+  RefPtr<TextEventDispatcher> dispatcher=session->window->GetTextEventDispatcher();
+  nsString text;text.SetLength(kMaxText);
+  bool changed=false;unsigned consumed=0;
+  for(;consumed<128 && Current(session);++consumed) {
+    WinUIPageInputEvent event{};
+    if(DrainIndependentPageInput(hwnd,event,reinterpret_cast<wchar_t*>(text.BeginWriting()),kMaxText)!=S_OK)break;
+    if(event.session!=session->id || !session->focused)continue;
+    if(event.kind==kAccepted) {Accept(session,event.revision);continue;}
+    if(event.kind==6) {Geometry(session,event);continue;}
+    if(event.edit<=session->dispatched)continue;
+    changed=true;
+    if(NS_FAILED(dispatcher->BeginNativeInputTransaction()))break;
+    nsDependentSubstring data(text,0,event.length);nsEventStatus status=nsEventStatus_eIgnore;
+    session->dispatched=event.edit;
+    nsresult rv=NS_OK;
+    if(event.kind==1) {
+      if(!dispatcher->DispatchSetSelectionEvent(session->textBase+event.start,event.end-event.start,ExpandToClusterBoundary::No))break;
+      rv=dispatcher->StartComposition(status);
+    } else if(event.kind==2) {
+      RefPtr<TextRangeArray> ranges=new TextRangeArray;
+      const TextRangeType types[]={TextRangeType::eRawClause,TextRangeType::eRawClause,TextRangeType::eSelectedRawClause,TextRangeType::eConvertedClause,TextRangeType::eSelectedClause};
+      const TextRangeStyle::LineStyle lines[]={TextRangeStyle::LineStyle::None,TextRangeStyle::LineStyle::Solid,TextRangeStyle::LineStyle::Dotted,TextRangeStyle::LineStyle::Dashed,TextRangeStyle::LineStyle::Wavy};
+      bool valid=event.clauseCount<=64;uint32_t position=0;
+      auto color=[](uint32_t value){return NS_RGB(GetRValue(value),GetGValue(value),GetBValue(value));};
+      for(uint32_t i=0;valid && i<event.clauseCount;++i) {
+        const auto& clause=event.clauses[i];
+        if(clause.start!=position || clause.end<=clause.start || clause.end>event.length ||
+            clause.kind<1 || clause.kind>4 || clause.flags>15 || clause.line>4 || clause.bold>1) {valid=false;break;}
+        TextRange range;range.mStartOffset=clause.start;range.mEndOffset=clause.end;range.mRangeType=types[clause.kind];
+        auto& style=range.mRangeStyle;
+        if(clause.flags&1) {style.mDefinedStyles|=TextRangeStyle::DEFINED_FOREGROUND_COLOR;style.mForegroundColor=color(clause.foreground);}
+        if(clause.flags&2) {style.mDefinedStyles|=TextRangeStyle::DEFINED_BACKGROUND_COLOR;style.mBackgroundColor=color(clause.background);}
+        if(clause.flags&4) {style.mDefinedStyles|=TextRangeStyle::DEFINED_UNDERLINE_COLOR;style.mUnderlineColor=color(clause.underline);}
+        if(clause.flags&8) {style.mDefinedStyles|=TextRangeStyle::DEFINED_LINESTYLE;style.mLineStyle=lines[clause.line];style.mIsBoldLine=clause.bold!=0;}
+        ranges->AppendElement(range);position=clause.end;
+        if(getenv("FENN_PANE_DIAGNOSTICS"))fprintf(stderr,"FennPageIME clause=%u start=%u end=%u flags=%u\n",clause.kind,clause.start,clause.end,clause.flags);
+      }
+      if(!valid || (event.clauseCount && position!=event.length))break;
+      if(event.length && !event.clauseCount) {
+        TextRange raw;raw.mEndOffset=event.length;raw.mRangeType=TextRangeType::eRawClause;ranges->AppendElement(raw);
+      }
+      if(event.length) {
+        const auto* target=ranges->GetTargetClause();
+        if(!target || target->mRangeStyle.IsDefined() || event.caret<target->mStartOffset || event.caret>target->mEndOffset) {
+          TextRange caret;caret.mStartOffset=caret.mEndOffset=std::min(event.caret,event.length);caret.mRangeType=TextRangeType::eCaret;ranges->AppendElement(caret);
+        }
+      }
+      rv=dispatcher->SetPendingComposition(data,ranges);
+      if(NS_SUCCEEDED(rv))rv=dispatcher->FlushPendingComposition(status);
+    } else if(event.kind==3) {
+      rv=dispatcher->CommitComposition(status,&data);
+    } else if(event.kind==4) {
+      // Match TSFTextStore's non-composing replacement: Gecko owns selection,
+      // beforeinput/input, undo, and the temporary composition transaction.
+      if(!dispatcher->DispatchSetSelectionEvent(session->textBase+event.start,event.end-event.start,ExpandToClusterBoundary::No))break;
+      rv=dispatcher->StartComposition(status);
+      if(NS_SUCCEEDED(rv))rv=dispatcher->CommitComposition(status,&data);
+    } else if(event.kind==5) {
+      if(!dispatcher->DispatchSetSelectionEvent(session->textBase+event.start,event.end-event.start,ExpandToClusterBoundary::No,
+          event.caret ? RangeDirection::Reversed : RangeDirection::Normal))break;
+    }
+    if(NS_FAILED(rv))break;
+  }
+  session->draining=false;
+  if(Current(session) && !dispatcher->IsHandlingComposition())session->acknowledgment=session->dispatched;
+  if(changed)Schedule(session);
+  if(consumed==128 && Current(session))NS_DispatchToMainThread(NS_NewRunnableFunction("FennPageInputDrain",[session] {
+    if(Current(session))DrainIndependentPageIME(session->window->GetWindowHandle());
+  }));
+}
+// Commits are posted, so a session can end before the IME's commit arrives; that commit is then
+// dropped with the session. Close Gecko's composition as it stands, as a synchronous IME would
+// have, so a composition in a content process does not wait for it.
+void EndIndependentPageComposition(nsWindow* window) {
+  RefPtr<TextEventDispatcher> dispatcher=window->GetTextEventDispatcher();
+  if(!dispatcher->IsComposing() || NS_FAILED(dispatcher->BeginNativeInputTransaction()))return;
+  nsEventStatus status=nsEventStatus_eIgnore;
+  dispatcher->CommitComposition(status);
+}
+bool NotifyIndependentPageIME(nsWindow* window,const IMENotification& notification) {
+  HWND hwnd=window->GetWindowHandle();
+  if(!GetPropW(hwnd,WINUI_PANE_ENDPOINT_PROPERTY))return false;
+  RefPtr<Session> session=Find(hwnd);
+  if(getenv("FENN_PANE_DIAGNOSTICS")) fprintf(stderr,"FennPageIME notify=%u session=%llu\n",unsigned(notification.mMessage),session ? session->id : 0);
+  switch(notification.mMessage) {
+    case NOTIFY_IME_OF_FOCUS: {
+      const bool suspended=session && session->suspended;
+      if(session) {CommitIndependentPageInput(hwnd,false);DrainIndependentPageIME(hwnd);EndIndependentPageComposition(window);}
+      session=new Session(window);session->id=++sNextSession;session->suspended=suspended;sSessions[hwnd]=session;Schedule(session);break;
+    }
+    case NOTIFY_IME_OF_BLUR:
+      if(session) {
+        CommitIndependentPageInput(hwnd,false);DrainIndependentPageIME(hwnd);EndIndependentPageComposition(window);
+        session->focused=false;WinUIPageInput input{};input.session=session->id;input.revision=++session->revision;
+        PublishIndependentPageInput(hwnd,input);sSessions.erase(hwnd);
+      }break;
+    case REQUEST_TO_COMMIT_COMPOSITION:
+    case REQUEST_TO_CANCEL_COMPOSITION:
+      CommitIndependentPageInput(hwnd,notification.mMessage==REQUEST_TO_CANCEL_COMPOSITION);
+      DrainIndependentPageIME(hwnd);break;
+    case NOTIFY_IME_OF_COMPOSITION_EVENT_HANDLED:
+      if(session && !window->GetTextEventDispatcher()->IsHandlingComposition())session->acknowledgment=session->dispatched;
+      Schedule(session);break;
+    case NOTIFY_IME_OF_SELECTION_CHANGE:
+    case NOTIFY_IME_OF_TEXT_CHANGE:
+    case NOTIFY_IME_OF_POSITION_CHANGE:
+      Schedule(session);break;
+    default:break;
+  }
+  return true;
+}
+void RefreshIndependentPageIME(HWND hwnd) {Schedule(Find(hwnd));}
+void SuspendIndependentPageIME(HWND hwnd) {
+  RefPtr<Session> previous=Find(hwnd);
+  if(!previous)return;
+  EndIndependentPageComposition(previous->window);
+  if(!Current(previous))return;
+  // Keep Gecko's focus knowledge, not the old transport identity or callbacks.
+  RefPtr<Session> next=new Session(previous->window);
+  next->id=++sNextSession;next->focused=previous->focused;next->suspended=true;
+  sSessions[hwnd]=next;
+}
+void ResumeIndependentPageIME(HWND hwnd) {
+  RefPtr<Session> previous=Find(hwnd);
+  if(!previous || !previous->suspended)return;
+  RefPtr<Session> next=new Session(previous->window);
+  next->id=++sNextSession;next->focused=previous->focused;sSessions[hwnd]=next;
+  Schedule(next);
+}
+void ForgetIndependentPageIME(HWND hwnd) {sSessions.erase(hwnd);}
+bool IndependentPageComposing(nsWindow* window) {
+  return window->GetTextEventDispatcher()->IsComposing();
+}
+}
diff --git a/widget/windows/WinUIPageInput.h b/widget/windows/WinUIPageInput.h
