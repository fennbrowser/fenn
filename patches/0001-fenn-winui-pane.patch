+      if (!this.resetting) this.ownsReset = false;
+      this.invalidate();
+    };
+    this.ui.addListener(this.listener);
+    this.preferences = ['browser.uiCustomization.state','browser.tabs.inTitlebar',
+      'browser.uidensity','browser.touchmode.auto','browser.download.autohideButton',
+      'sidebar.position_start','sidebar.verticalTabs','extensions.activeThemeID',
+      'browser.toolbars.bookmarks.visibility'];
+    for (const pref of this.preferences) Services.prefs.addObserver(pref,this.invalidate);
