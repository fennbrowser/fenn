+/**
+ * Independent query consumer. No editor or view is constructed or emulated.
+ * The chrome host supplies identity and a pinned tab/document validity check.
+ * Editing is owned by UrlbarEditSession; navigation and activation remain host work.
+ * Per-query updates expose the current context, never the mutable controller.
+ * The host must close it on scope
+ * loss and teardown; the scope check also rejects races at dispatch, delivery,
+ * completion and presentation publication. It does not observe browser events.
+ */
+export class UrlbarQuerySession {
+  #context;
+  #isCurrent;
+  #query = null;
+  #closed = false;
+  #controller;
+  #onUpdate = null;
+  #frozen = null;
+  #finishState = null;
+  #onPresentationRequest;
+  #restartRequest = null;
+  #removedIds = new Set();
+  #activationCleanup = new Set();
+  #selectionRequest = null;
+  #engagementActive = false;
+  #aliasModeEngagements = new WeakSet();
+  #externalResultLoads = new WeakMap();
+  #endingEngagement = false;
+  #oneOffDismissalGeneration = 0;
+  #oneOffCommandPlans = new WeakSet();
+  #oneOffEngineTargets = new WeakMap();
+  #oneOffModeAttempts = new WeakSet();
+  #oneOffEligibility = new WeakMap();
+  #oneOffModeReceipts = new WeakMap();
+  #oneOffDispatches = new WeakMap();
+  #oneOffNewTabReceipts = new WeakMap();
+  #backgroundSourceReceipts = new WeakMap();
+  #oneOffTabTransferEligibility = new WeakMap();
+  #destinationQueryAdmissions = new WeakMap();
+
+  constructor({ context, isCurrent, onPresentationRequest = null }) {
+    if (typeof isCurrent != "function") throw new TypeError("Missing scope check");
+    if (onPresentationRequest !== null && typeof onPresentationRequest != "function") {
+      throw new TypeError("Invalid presentation request callback");
+    }
+    if (context.browserId !== undefined && (!Number.isSafeInteger(context.browserId) || context.browserId <= 0)) {
+      throw new TypeError("Invalid pinned browser identity");
+    }
+    this.#onPresentationRequest = onPresentationRequest;
+    this.#context = Object.freeze({ ...context });
+    this.#isCurrent = isCurrent;
+    if (!isCurrent()) throw new Error("Query session scope changed");
+    this.#controller = new UrlbarChildController({
+      context: this.#context,
+      isCurrent: () => !this.#closed && this.#isCurrent(),
+      restartPort: Object.freeze({
+        startQuery: options => this.#requestRestart({ kind: "query", options }),
+        setValue: value => this.#requestRestart({ kind: "value", value }),
+        search: (value, options) => this.#requestRestart({ kind: "search", value, options }),
+      }),
+    });
