+          (!result.autofill || result.autofill.type === "url") && result.type === UrlbarShared.RESULT_TYPE.URL) {
+        reintegrateURL = url;
+      }
+    }
+    return Object.freeze({ inputHistory, reintegrateURL });
+  }
+
+  /** Pre-load editor/focus/parameter policy. The host applies and acknowledges effects. */
+  static navigationPlan({ loadRequest, where, params, sapName, isPrivate, deferEnterFocus = false }) {
+    const isAddressbar = sapName === "urlbar";
+    const openParams = { ...params, allowThirdPartyFixup: true };
+    if (deferEnterFocus && where === "current") openParams.avoidBrowserFocus = true;
+    let editorValue;
+    if (isAddressbar && where === "current") {
+      if (loadRequest.engineSearch) {
+        editorValue = loadRequest.engineSearch.query;
+      } else {
+        const { url } = loadRequest.urlLoad;
+        try { editorValue = losslessDecodeURL(new URL(url)); }
+        catch { editorValue = url; }
+      }
+    }
