+    return null;
+  }
+
+  actionType(result) {
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+        return "switchtab";
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return "extension";
+      default:
+        return undefined;
+    }
+  }
