+    this.#modeApplication = null;
+    this.#modeRequery = null;
+    this.#modeStateReady = null;
+    this.#navigationWrite = null;
+    this.#navigationReady = null;
+    this.#navigationRecovery = null;
+    this.#navigationActivation = null;
