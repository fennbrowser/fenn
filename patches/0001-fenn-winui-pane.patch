+        icon: "chrome://branding/content/icon32.png",
+      },
+      rowLabel: !result.hideRowLabel && this.rowLabel(result, context),
+      hideRowLabel: result.hideRowLabel,
+      richSuggestionIconSize: 32,
+    });
+  }
