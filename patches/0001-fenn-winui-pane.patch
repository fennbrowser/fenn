+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+export class WinUIStartupPaintChild extends JSWindowActorChild {
+  receiveMessage({name}) {
+    if (name !== "Painted") return false;
+    const window = this.contentWindow, document = window.document;
+    if (document.documentURI !== "about:home" && document.documentURI !== "about:newtab") return false;
+    // A disabled New Tab page intentionally has no contentful paint.
+    return window.performance.getEntriesByType("paint").some(entry => entry.name === "first-contentful-paint") ||
+      (document.readyState === "complete" && document.body && !document.body.firstElementChild);
+  }
+}
diff --git a/browser/base/content/WinUIProcessStartup.sys.mjs b/browser/base/content/WinUIProcessStartup.sys.mjs
new file mode 100644
index 00000000000..58588ca6159
--- /dev/null
+++ b/browser/base/content/WinUIProcessStartup.sys.mjs
@@ -0,0 +1,125 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { ProcessRecoveryCoordinator } from "./WinUIProcessRecovery.sys.mjs";
+
+// One coordinator per browser process; this module routes each window's native
+// notifications without owning cross-window paint or restoration barriers.
+const recovery = new ProcessRecoveryCoordinator();
+const ProcessEvent = { BOUND: "1", RECOVERING: "5", READY: "6", STOCK: "7", EMPTY: "8", SUPPRESS: "9" };
+
+function beginStartup(window, pane) {
+  const startup = ChromeUtils.importESModule("chrome://browser/content/WinUIAutomaticStartup.sys.mjs");
+  pane.automaticStartupModule = startup;
+  startup.beginAutomaticStartup(window);
+  ChromeUtils.importESModule("chrome://browser/content/WinUIStartupPaint.sys.mjs").revealStartupPage(window);
+}
+
+export function watchProcessWindow(window) {
+  if (Services.env.get("FENN_NATIVE_SHELL_PROCESS") !== "1") return;
+  const pane = window.gWinUIPane;
+  const restoringEngine = recovery.restoringEngine;
+  const identity = Services.env.get("FENN_NATIVE_SHELL_RECOVERY") === "1"
+    ? ChromeUtils.importESModule("chrome://browser/content/WinUIRecoveryIdentity.sys.mjs").watchRecoveryIdentity(window, { restoring: restoringEngine })
+    : null;
+  let endpoint = window.docShell.treeOwner.QueryInterface(Ci.nsIBaseWindow).nativeHandle;
+  let ready = false;
+  let recovering = restoringEngine;
+  if (recovering) recovery.begin(window);
+  let terminal = false;
+  const fallback = () => {
+    window.document.documentElement.removeAttribute("winui-native-frame");
+    identity?.close();
+    pane.startupConnection?.disconnect();
+    pane.uninit();
+    window.document.documentElement.setAttribute("winui-startup-chrome-ready", "fallback");
+  };
+  const bind = () => {
+    if (ready) {
+      if (window.document.documentElement.getAttribute("winui-startup-chrome-ready") === "rebound") {
+        // A minimized binding can accept geometry without creating controls.
+        // Resume reannounces that same page; invalidate presentation caches,
+        // preserving the browser session, pending edits and endpoint identity.
+        if (pane.chromeLayout) pane.chromeLayout.signature = "";
+        pane.addressPublication = null;
+        pane.structuralDirty = pane.stripDirty = pane.contextDirty = pane.addressDirty = true;
+        pane.updateGeometry();
+        pane.publish(true);
+      }
+      return;
+    }
+    ready = true;
+    window.document.documentElement.setAttribute("winui-native-frame", "");
+    pane.endpoint = window.docShell.treeOwner.QueryInterface(Ci.nsIBaseWindow).nativeHandle;
+    if (!pane.element) pane.init();
+    pane.structuralDirty = pane.stripDirty = pane.contextDirty = pane.addressDirty = true;
+    pane.schedule();
+    identity?.completeRestore();
+    identity?.bind();
+    if (recovering) {
+      recovering = false;
+      window.document.documentElement.setAttribute("winui-startup-chrome-ready", "rebound");
+      recovery.rebound(window);
+      return;
+    }
+    beginStartup(window, pane);
+  };
+  const observer = (_, topic, data) => {
+    const [kind, proxy, shell] = String(data).split(":");
+    if (terminal || (endpoint !== proxy && endpoint !== shell)) return;
+    if (kind === ProcessEvent.SUPPRESS) {
+      if (recovery.restoringEngine && !ready) {
+        terminal = true;
+        identity?.close();
+        window.close();
+      }
+      return;
+    }
+    if (kind === ProcessEvent.EMPTY) {
+      if (recovery.restoringEngine && !ready) {
+        ChromeUtils.importESModule("chrome://browser/content/WinUIRecoveryIdentity.sys.mjs")
+          .createRecoveryEmptyWindows(window, window.windowUtils.drainWinUIRequests());
+      }
+      return;
+    }
+    if (kind === ProcessEvent.STOCK) {
+      terminal = true;
+      recovery.forget(window);
+      endpoint = proxy;
+      fallback();
+      recovery.queueStockFallback(window);
+      return;
+    }
+    if (kind === ProcessEvent.RECOVERING) {
+      identity?.disconnect();
+      recovery.begin(window);
+      endpoint = proxy;
+      recovering = true;
+      ready = false;
+      pane.startupConnection?.disconnect();
+      pane.uninit();
+      window.document.documentElement.setAttribute("winui-startup-chrome-ready", "recovering");
+      return;
+    }
+    if (kind === ProcessEvent.READY) {
+      window.document.documentElement.setAttribute("winui-startup-chrome-ready", "ready");
+      return;
+    }
+    if (kind !== ProcessEvent.BOUND) {
+      recovery.forget(window);
+      fallback();
+      recovery.finishRecovery();
+      return;
+    }
+    bind();
+  };
+  Services.obs.addObserver(observer, "fenn-process-window");
+  if (restoringEngine) identity?.bind();
+  window.addEventListener("unload", () => {
+    identity?.close();
+    Services.obs.removeObserver(observer,"fenn-process-window");
+    recovery.close(window);
+  }, {once:true});
+  if (Services.env.get("FENN_NATIVE_HOST_FAILED") === "1") fallback();
+}
diff --git a/browser/base/content/WinUIRecoveryIdentity.sys.mjs b/browser/base/content/WinUIRecoveryIdentity.sys.mjs
new file mode 100644
index 00000000000..a5aa3b66cc6
--- /dev/null
+++ b/browser/base/content/WinUIRecoveryIdentity.sys.mjs
@@ -0,0 +1,90 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+export const RECOVERY_WINDOW_KEY = "fenn-recovery-window";
+const VALID_KEY = /^(?!0{32}$)[0-9a-f]{32}$/;
+const emptyWindows = new WeakMap();
+const requestedKeys = new Set();
+let startupPlaceholder;
+
+export function createRecoveryEmptyWindows(window, raw) {
+  if (Services.env.get("FENN_ENGINE_RECOVERED") !== "1" || window.closed ||
+      window.PrivateBrowsingUtils.isWindowPrivate(window)) return;
+  const keys = JSON.parse(raw);
+  if (!Array.isArray(keys) || !keys.length || keys.length > 128 ||
+      new Set(keys).size !== keys.length || keys.some(key => typeof key !== "string" || !VALID_KEY.test(key) || requestedKeys.has(key))) {
+    throw new Error("Invalid empty recovery window request");
+  }
+  for (const key of keys) requestedKeys.add(key);
+  for (const key of keys) {
+    const args = Cc["@mozilla.org/supports-string;1"].createInstance(Ci.nsISupportsString);
+    args.data = "about:blank";
+    const created = window.OpenBrowserWindow({private:false, args});
+    if (!created) throw new Error("Empty recovery window creation failed");
+    emptyWindows.set(created, key);
+  }
+}
+
+export function watchRecoveryIdentity(window, { restoring = false } = {}) {
+  const privateWindow = window.PrivateBrowsingUtils.isWindowPrivate(window);
+  const emptyKey = emptyWindows.get(window);
+  emptyWindows.delete(window);
+  let bound = false, stopped = false, restored = false, busy = false, revision = 0;
+  const publish = () => {
+    if (!bound || stopped || window.closed) return;
+    let key = !privateWindow && !restored ? emptyKey ?? "" : "";
+    const placeholder = restoring && window === startupPlaceholder?.deref();
+    if (!privateWindow && restored && !busy && !placeholder) {
+      key = window.SessionStore.getCustomWindowValue(window, RECOVERY_WINDOW_KEY);
+      if (!key) {
+        key = Services.uuid.generateUUID().toString().replace(/[{}-]/g, "").toLowerCase();
+        if (!VALID_KEY.test(key)) throw new Error("Invalid recovery window identity");
+        window.SessionStore.setCustomWindowValue(window, RECOVERY_WINDOW_KEY, key);
+      }
+      if (!VALID_KEY.test(key)) key = "";
+    }
+    window.windowUtils.syncWinUITabMenu(JSON.stringify({ version: 2, publishOnly: true,
+      recoveryWindow: { revision: ++revision, privacy: privateWindow ? 2 : 1, key,
+        ...(placeholder ? {placeholder:true} : {}),
+        ...(restoring ? { restoreCount: (placeholder || emptyKey || (restored && !busy)) ? [...Services.wm.getEnumerator("navigator:browser")].filter(w => !window.PrivateBrowsingUtils.isWindowPrivate(w)).length : 0 } : {}) } }));
+  };
+  const onBusy = () => { busy = true; publish(); };
+  const onReady = () => { busy = false; publish(); };
+  if (!privateWindow) {
+    window.addEventListener("SSWindowStateBusy", onBusy, true);
+    window.addEventListener("SSWindowStateReady", onReady, true);
+    if (restoring && !emptyKey) {
+      const {SessionStartup} = ChromeUtils.importESModule("moz-src:///browser/components/sessionstore/SessionStartup.sys.mjs");
+      SessionStartup.onceInitialized.then(() => {
+        if (stopped || window.closed || startupPlaceholder) return;
+        if (SessionStartup.sessionType === SessionStartup.NO_SESSION) {
+          startupPlaceholder = new WeakRef(window);
+          publish();
+        }
+      }).catch(console.error);
+    }
+    const initialized = emptyKey
+      ? window.delayedStartupPromise.then(() => window.SessionStore.promiseAllWindowsRestored)
+      : window.SessionStore.promiseAllWindowsRestored;
+    initialized.then(() => {
+      if (stopped || window.closed) return;
+      if (emptyKey) window.SessionStore.setCustomWindowValue(window, RECOVERY_WINDOW_KEY, emptyKey);
+      restored = true;
+      publish();
+    }).catch(console.error);
+  }
+  return {
+    completeRestore() { restoring = false; },
+    bind() { bound = true; publish(); },
+    disconnect() { bound = false; },
+    close() {
+      stopped = true;
+      bound = false;
+      if (!privateWindow) {
+        window.removeEventListener("SSWindowStateBusy", onBusy, true);
+        window.removeEventListener("SSWindowStateReady", onReady, true);
+      }
+    },
+  };
+}
diff --git a/browser/base/content/WinUIAutomaticStartup.sys.mjs b/browser/base/content/WinUIAutomaticStartup.sys.mjs
new file mode 100644
index 00000000000..714829a81e0
--- /dev/null
+++ b/browser/base/content/WinUIAutomaticStartup.sys.mjs
@@ -0,0 +1,256 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const READY = "winui-startup-chrome-ready";
+export const STARTUP_CHROME_CSS = `@-moz-document url("chrome://browser/content/browser.xhtml") {
+  :root:not([${READY}]) #navigator-toolbox {
+    opacity: 0 !important;
+    pointer-events: none !important;
+  }
+}`;
+export function automaticStartupRequested() {
+  return Services.env.get("FENN_NATIVE_INTERACTIVE_STARTUP") === "1" || Services.env.get("FENN_NATIVE_SHELL_PROCESS") === "1";
+}
+
+// Called by BrowserGlue before opening a browser document, including before its
+// first paint. Opacity preserves the retained controllers' layout/visibility
+// queries. It does not affect the independent native HWNDs above that document.
+export function registerStartupChromeGate() {
+  if (!automaticStartupRequested()) return;
+  const sheets = Cc["@mozilla.org/content/style-sheet-service;1"].getService(Ci.nsIStyleSheetService);
+  const uri = Services.io.newURI("data:text/css;charset=utf-8," + encodeURIComponent(STARTUP_CHROME_CSS));
+  if (!sheets.sheetRegistered(uri, sheets.USER_SHEET)) sheets.loadAndRegisterSheet(uri, sheets.USER_SHEET);
+}
+
+const STARTUP_PREFS = ["sidebar.verticalTabs", "fenn.winui.tabstrip.replaceFirefoxTabs",
+  "fenn.winui.navigation.toolbar.enabled", "fenn.winui.address.private"];
+
+export function unsupportedStartupLayout(window) {
+  const pref = (key, fallback) => Services.prefs.getBoolPref(key, fallback);
+  if (pref(STARTUP_PREFS[0], false)) return "vertical-tabs";
+  if (!pref(STARTUP_PREFS[1], true)) return "retained-tabs";
+  if (!pref(STARTUP_PREFS[2], true)) return "retained-navigation";
+  if (window.gWinUIPane.addressAvailable?.() === false) return "private-address";
+  if (window.fullScreen || window.document.fullscreenElement) return "fullscreen";
+  if (window.document.documentElement.hasAttribute("customizing")) return "customizing";
+  if (window.gWinUIPane.hasUnreplacedTabControls?.()) return "unrepresented-tab-controls";
+  return null;
+}
+
+const RECOVERY_PREFS = {
+  "vertical-tabs": ["sidebar.verticalTabs", false],
+  "retained-tabs": ["fenn.winui.tabstrip.replaceFirefoxTabs", true],
+  "retained-navigation": ["fenn.winui.navigation.toolbar.enabled", true],
+};
+function recoveryPreference(reason) {
+  const setting = RECOVERY_PREFS[reason];
+  return setting && !Services.prefs.prefIsLocked(setting[0]) ? setting : null;
+}
+
+export function recoverAutomaticStartup(window, action) {
+  const state = window.gWinUIPane.automaticStartup;
+  if (action?.kind !== "startup-recovery" || state?.phase !== "blocked" ||
+      action.session !== state.session || action.revision !== String(state.presentationRevision) ||
+      state.reason !== unsupportedStartupLayout(window)) return 2;
+  const setting = recoveryPreference(state.reason);
+  if (!setting) return 2;
+  Services.prefs.setBoolPref(...setting);
+  advanceAutomaticStartup(window);
+  return 1;
+}
+
+// One active write and one latest pending value, shared across browser windows.
+// Only Firefox-resolved labels and inert fixed-control placement enter this cache.
+// No tab/page data, extension artwork, command identity or enabled state is stored.
+let cacheKey = "", pendingCache = null, cacheWriting = false;
+export async function cacheStartupLabels(labels, locale, io, paths, rtl = false, toolbar = null) {
+  const data = {version:3, locale, rtl, labels};
+  if (toolbar) data.toolbar = toolbar;
+  const key = JSON.stringify(data);
+  if (cacheKey === key) return;
+  cacheKey = key; pendingCache = data;
+  if (cacheWriting) return;
+  cacheWriting = true;
+  try {
+    const path = paths.join(paths.profileDir, "fenn-startup-labels.json");
+    while (pendingCache) {
+      const next = pendingCache; pendingCache = null;
+      await io.writeJSON(path, next, {tmpPath:path + ".tmp"});
+    }
+  } catch (error) { cacheKey = ""; pendingCache = null; throw error; }
+  finally { cacheWriting = false; }
+}
+
+function labelsFromLocalization(l10n) {
+  return Object.fromEntries([
+    ["newTab", "new-tab"], ["pending", "pending"], ["full", "full"],
+    ["composition", "composition"], ["address", "address"], ["unavailable", "unavailable"],
+    ["recovery", "recovery"], ["recoveryAction", "recovery-action"],
+  ].map(([key, suffix]) => [key, l10n.formatValueSync(`winui-startup-${suffix}`)]).concat(
+    [["engineTitle","title"],["engineMessage","message"],["engineRetry","retry"],
+     ["engineClose","close"],["engineWaiting","waiting"],["engineDraft","draft"]]
+      .map(([key,suffix])=>[key,l10n.formatValueSync(`winui-engine-recovery-${suffix}`)])));
+}
+function startupLabels(pane) {
+  return labelsFromLocalization(pane.localization());
+}
+
+// Routing has resolved the profile, but no browser document or native controls
+// exist yet. Use Firefox's negotiated Fluent resources and direction directly.
+export function prepareStartupPresentation() {
+  const l10n = new Localization(["branding/brand.ftl", "browser/tabbrowser.ftl"], true);
+  const labels = labelsFromLocalization(l10n);
+  for (const value of Object.values(labels)) {
+    if (typeof value !== "string" || !value.length || value.length > 1024 || value.includes("\0")) {
+      throw new Error("Invalid initial native startup label");
+    }
+  }
+  const toolbar = startupToolbarPresentation();
+  watchStartupPresentation();
+  persistStartupLabels({}, labels, toolbar);
+  return JSON.stringify({version:3, locale:Services.locale.appLocaleAsBCP47,
+    rtl:Services.locale.isAppLocaleRTL, labels, toolbar});
+}
+function startupToolbarPresentation() {
+  const { CustomizableUI } = ChromeUtils.importESModule("moz-src:///browser/components/customizableui/CustomizableUI.sys.mjs");
+  const { startupToolbarControls } = ChromeUtils.importESModule("chrome://browser/content/WinUIToolbarCustomization.sys.mjs");
+  const menuL10n = new Localization(["branding/brand.ftl", "browser/appmenu.ftl"], true);
+  const [menu] = menuL10n.formatMessagesSync([{id:"appmenu-menu-button-closed2"}]);
+  const attribute = name => menu?.attributes?.find(value => value.name === name)?.value || "";
+  const toolbar = {controls:startupToolbarControls(CustomizableUI),
+    productMenu:Services.prefs.getBoolPref("fenn.winui.productmenu.enabled", true),
+    menuLabel:attribute("label"), menuTooltip:attribute("tooltiptext")};
+  return toolbar;
+}
+
+// Profile-scoped observers deliberately live for the parent-process lifetime:
+// closing the first window must not stop saving subsequent customization.
+let watchingPresentation = false;
+function watchStartupPresentation() {
+  if (watchingPresentation || typeof IOUtils === "undefined") return;
+  watchingPresentation = true;
+  const changed = () => {
+    try { prepareStartupPresentation(); }
+    catch (error) { console.error("Native startup preview unavailable", error); }
+  };
+  for (const pref of ["browser.uiCustomization.state", "fenn.winui.productmenu.enabled"])
+    Services.prefs.addObserver(pref, changed);
+  // The existing window locale observer owns label refresh; do not race it.
+}
+function persistStartupLabels(state, labels, toolbar = null) {
+  if (typeof IOUtils !== "undefined") {
+    toolbar ||= startupToolbarPresentation();
+    cacheStartupLabels(labels, Services.locale.appLocaleAsBCP47, IOUtils, PathUtils, Services.locale.isAppLocaleRTL, toolbar)
+      .catch(error => { state.cacheError = String(error); });
+  }
+}
+function publishStartupPresentation(window) {
+  const pane = window.gWinUIPane, state = pane.automaticStartup;
+  const labels = startupLabels(pane);
+  persistStartupLabels(state, labels);
+  const body = { ...labels, rtl: Services.locale.isAppLocaleRTL,
+    blocked: !!state.reason, recoverable: !!recoveryPreference(state.reason) };
+  const key = JSON.stringify(body);
+  if (state.presentationKey === key) return;
+  const revision = (state.presentationRevision || 0) + 1;
+  const { transferStartup } = ChromeUtils.importESModule("chrome://browser/content/WinUIStartupTransfer.sys.mjs");
+  transferStartup(window, {version: 1, operation: 19, session: state.session, revision: String(revision), ...body})
+    .catch(error => { state.presentationError = String(error); });
+  delete state.presentationError;
+  state.presentationKey = key;
+  state.presentationRevision = revision;
+}
+
+export function beginAutomaticStartup(window) {
+  if (!automaticStartupRequested()) return;
+  const pane = window.gWinUIPane;
+  if (pane.automaticStartup) return;
+  const root = window.document.documentElement;
+  const state = pane.automaticStartup = { phase: "probing" };
+  const { transferStartup } = ChromeUtils.importESModule("chrome://browser/content/WinUIStartupTransfer.sys.mjs");
+  // The chrome stays hidden while probing; the answer takes one turn of the native thread.
+  transferStartup(window, { version: 1, operation: 15 })
+    .catch(() => null) // A window without an early native presenter uses normal fallback.
+    .then(probe => { if (!window.closed) continueAutomaticStartup(window, probe); });
+}
+
+function continueAutomaticStartup(window, probe) {
+  const pane = window.gWinUIPane, state = pane.automaticStartup;
+  const root = window.document.documentElement;
+  if (!probe?.early) {
+    state.phase = "fallback";
+    root.setAttribute(READY, "fallback");
+    return;
+  }
+  state.session = probe.session;
+  state.initialOpacity = window.getComputedStyle(window.document.getElementById("navigator-toolbox")).opacity;
+  state.phase = "waiting";
+  try { publishStartupPresentation(window); }
+  catch (error) { state.presentationError = String(error); }
+  const changed = () => advanceAutomaticStartup(window);
+  const localeChanged = () => {
+    persistStartupLabels(state, startupLabels(pane));
+    changed();
+  };
+  Services.obs.addObserver(localeChanged, "intl:app-locales-changed");
+  for (const pref of STARTUP_PREFS) Services.prefs.addObserver(pref, changed);
+  window.addEventListener("fullscreen", changed);
+  window.addEventListener("unload", () => {
+    for (const pref of STARTUP_PREFS) Services.prefs.removeObserver(pref, changed);
+    window.removeEventListener("fullscreen", changed);
+    Services.obs.removeObserver(localeChanged, "intl:app-locales-changed");
+  }, { once: true });
+  if (!window.gBrowserInit.delayedStartupFinished) {
+    const ready = subject => {
+      if (subject !== window) return;
+      Services.obs.removeObserver(ready, "browser-delayed-startup-finished");
+      state.browserReady = true;
+      advanceAutomaticStartup(window);
+    };
+    Services.obs.addObserver(ready, "browser-delayed-startup-finished");
+    window.addEventListener("unload", () => {
+      if (!state.browserReady) Services.obs.removeObserver(ready, "browser-delayed-startup-finished");
+    }, { once: true });
+  } else state.browserReady = true;
+  advanceAutomaticStartup(window);
+}
+
+export function advanceAutomaticStartup(window) {
+  const pane = window.gWinUIPane, state = pane.automaticStartup;
+  if (!["waiting", "blocked"].includes(state?.phase) || !state.browserReady) return;
+  state.reason = unsupportedStartupLayout(window);
+  state.phase = state.reason ? "blocked" : "waiting";
+  try { publishStartupPresentation(window); }
+  catch (error) { state.presentationError = String(error); }
+  if (state.reason) return;
+  const root = window.document.documentElement;
+  if (!pane.attached || !pane.nativeRevision || !pane.addressSession ||
+      !pane.addressToolbar?.active || !pane.addressToolbar.navigation ||
+      !root.hasAttribute("winui-replaces-tabs") || !root.hasAttribute("winui-hides-nav-bar")) return;
+  // Mark before calling the adapter: publishing rows can reenter this path.
+  state.phase = "connecting";
+  connectAutomaticStartup(window, state, root);
+}
+
+async function connectAutomaticStartup(window, state, root) {
+  try {
+    const { connectFirefoxStartup } = ChromeUtils.importESModule("chrome://browser/content/WinUIStartupTransfer.sys.mjs");
+    // The token names this native endpoint. The adapter separately captures and
+    // revalidates the resolved Firefox profile, privacy context and window.
+    const connection = await connectFirefoxStartup(window, state.session, state.session);
+    await connection.attachPresenter();
+    await connection.enableNormalTabs();
+    if (connection.stopped) throw new Error("Automatic startup binding was lost");
+    await connection.send(16);
+    connection.start();
+    state.phase = "connected";
+    state.connection = connection;
+    root.setAttribute(READY, "native");
+  } catch (error) {
+    // Never retry an uncertain browser side effect or discard the local editor.
+    state.phase = "failed";
+    state.error = String(error);
+    console.error("Native startup connection failed", error);
+  }
+}
diff --git a/widget/windows/FennCompositorParent.h b/widget/windows/FennCompositorParent.h
new file mode 100644
index 00000000000..40de554e099
--- /dev/null
+++ b/widget/windows/FennCompositorParent.h
@@ -0,0 +1,48 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_windows_FennCompositorParent_h
+#define widget_windows_FennCompositorParent_h
+
+#include <windows.h>
+
+namespace mozilla::widget {
+
+// The visible window for a widget: its native shell when nsWindow's own window is a hidden proxy.
+// Works from the GPU process too.
+inline HWND CompositorTarget(HWND aWidget) {
+  HWND shell = aWidget ? static_cast<HWND>(::GetPropW(aWidget, L"Fenn.ProxyShell")) : nullptr;
+  return shell ? shell : aWidget;
+}
+
+// Where software rendering draws for a widget: the native page input window, which covers the
+// page and clips it out of its parent's drawing, or else the compositor target.
+inline HWND SurfaceTarget(HWND aWidget) {
+  HWND target = CompositorTarget(aWidget);
+  HWND page = static_cast<HWND>(::GetPropW(target, L"Fenn.PageWindow"));
+  return page ? page : target;
+}
+
+// While the native startup host holds the page area, the compositor window
+// joins it hidden. The host shows it after the selected tab has painted.
+inline void SetCompositorParent(HWND aCompositorWnd, HWND aParentWnd) {
+  aParentWnd = CompositorTarget(aParentWnd);
+  static constexpr wchar_t kHold[] = L"Fenn.NativeStartupPageHold";
+  static constexpr UINT kFlags =
+      SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE;
+  const bool held = ::GetPropW(aParentWnd, kHold);
+  if (held) {
+    ::SetWindowPos(aCompositorWnd, nullptr, 0, 0, 0, 0,
+                   kFlags | SWP_HIDEWINDOW);
+  }
+  ::SetParent(aCompositorWnd, aParentWnd);
+  if (held && !::GetPropW(aParentWnd, kHold)) {
+    ::SetWindowPos(aCompositorWnd, nullptr, 0, 0, 0, 0,
+                   kFlags | SWP_SHOWWINDOW | SWP_ASYNCWINDOWPOS);
+  }
+}
+
+}  // namespace mozilla::widget
+
+#endif
