@@ -0,0 +1,349 @@
+// Presentation adapter for Firefox-owned address-bar controls. No browser policy lives here.
+const PAGE_ACTIONS = [
+  ['connection', 'identity-icon-box'],
+  ['reader', 'reader-mode-button'],
+  ['pip', 'picture-in-picture-button'],
+  ['taskbar', 'taskbar-tabs-button'],
+  ['translation', 'translations-button'],
+  ['share', 'share-button'],
+  ['permissions', 'identity-permission-box'],
+];
+const PIN_PREF = 'fenn.winui.address.actions.';
+
+export class WinUIOmnibarActions {
+  constructor(toolbar) {
+    this.toolbar = toolbar;
+    this.window = toolbar.window;
+    this.entries = new Map();
+    this.images = new Map();
+    this.loads = new Set();
+    this.nextId = 0;
+    this.events = new WeakSet();
+    this.closed = false;
+    this.invalidate = () => { if (!this.closed) toolbar.owner.invalidateAddress(); };
+    Services.prefs.addObserver(PIN_PREF, this.invalidate);
+    Services.prefs.addObserver('browser.menu.share_url.allow', this.invalidate);
+    this.observer = new this.window.MutationObserver(this.invalidate);
+    this.observer.observe(this.window.gURLBar, {subtree:true, childList:true, characterData:true, attributes:true});
+    this.theme = this.window.matchMedia('(prefers-color-scheme: dark)');
+    this.theme.addEventListener('change', this.invalidate);
+    this.contrast = this.window.matchMedia('(forced-colors: active)');
+    this.contrast.addEventListener('change', this.invalidate);
+    this.window.addEventListener('resize', this.invalidate);
+    this.originalInput = event => this.onOriginalInput(event);
+    this.window.addEventListener('click', this.originalInput, true);
+    this.window.addEventListener('keydown', this.originalInput, true);
+    this.observer.observe(this.window.document.documentElement, {attributes:true,attributeFilter:['lwtheme','lwt-textcolor','style']});
+  }
+  onOriginalInput(event) {
+    if (event.isTrusted && !this.events.has(event)) {
+      for (const entry of this.entries.values()) entry.pending = false;
+    }
+  }
+  context() {
+    return this.window.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+  }
+  visible(node) {
+    if (!node?.isConnected) return false;
+    for (let parent = node; parent && parent !== this.window.gURLBar.parentNode; parent = parent.parentElement) {
+      if (parent.hidden || parent.collapsed) return false;
+      const style = this.window.getComputedStyle(parent);
+      if (style.display === 'none' || style.visibility !== 'visible') return false;
+    }
+    return true;
+  }
+  label(key) {
+    this.l10n ??= new this.window.Localization(['browser/tabbrowser.ftl'], true);
+    return (this.l10n.formatValueSync(`winui-page-actions-${key}`) || '').slice(0, 4096);
+  }
+  entry(node) {
+    let entry = this.entries.get(node);
+    if (!entry) {
+      entry = {id:`action-${++this.nextId}`, node};
+      this.entries.set(node, entry);
+    }
+    return entry;
+  }
+  shareURL() {
+    if (!Services.prefs.getBoolPref('browser.menu.share_url.allow', true)) return null;
+    const {BrowserUtils} = ChromeUtils.importESModule('resource://gre/modules/BrowserUtils.sys.mjs');
+    return BrowserUtils.getShareableURL(this.window.gBrowser.selectedBrowser.currentURI);
+  }
+  pageActions() {
+    const document = this.window.document;
+    const items = PAGE_ACTIONS.map(([key, nodeId]) => {
+      const node = key === 'connection' ?
+        ['trust-icon-container', nodeId].map(id => document.getElementById(id)).find(n => this.visible(n)) :
+        document.getElementById(nodeId);
+      const enabled = key === 'share' ? !!node && !!this.shareURL() :
+        !!node && this.visible(node) && node.getAttribute('disabled') !== 'true';
+      const entry = node ? this.entry(node) : null;
+      return {key, id:entry?.id || `unavailable-${key}`, label:this.label(key), enabled,
+        reason:enabled ? '' : this.label(`${key}-unavailable`),
+        pinnable:!['connection','permissions'].includes(key), pinned:!['connection','permissions'].includes(key) && Services.prefs.getBoolPref(PIN_PREF + key, true)};
+    });
+    return {label:this.label('menu'), pinLabel:this.label('pin'), unpinLabel:this.label('unpin'), context:String(this.context() || ''), items};
+  }
+  connectionWarning(node) {
+    // Use Firefox's rendered security classification, never URL text.
+    if (node.id === 'trust-icon-container') return ['insecure','warning','breached'].some(c => node.classList.contains(c));
+    const box = this.window.document.getElementById('identity-box');
+    return ['notSecure','mixedActiveContent','mixedDisplayContent','mixedDisplayContentLoadedActiveBlocked',
+      'weakCipher','certErrorPage','httpsOnlyErrorPage','certUserOverridden'].some(c => box?.classList.contains(c));
+  }
+  nativePresentation(node, imageNode) {
+    // Read Firefox's rendered feature state, never URLs, labels or image names.
+    // Extension page actions alone retain their author-provided artwork.
+    const document = this.window.document;
+    const has = (target, name) => !!target?.hasAttribute(name);
+    const classes = (target, name) => !!target?.classList.contains(name);
+    let icon = '', iconState = 'normal';
+    const kinds = {
+      'reader-mode-button':'reader', 'picture-in-picture-button':'pip',
+      'taskbar-tabs-button':'taskbar', 'translations-button':'translation',
+      'urlbar-zoom-button':'zoom', 'split-view-button':'split', 'share-button':'share',
+      'star-button-box':'bookmark', 'urlbar-revert-button':'revert',
+    };
+    const permissions = {'desktop-notification':'notification', 'loopback-network':'network',
+      'local-network':'network', 'persistent-storage':'storage', 'autoplay-media':'autoplay'};
+    if (node.id === 'identity-permission-box') {
+      // This button presents the first visible child, which is omitted as a
+      // separate action below. Preserve its permission type and blocked state.
+      return imageNode !== node && imageNode.id !== 'permissions-granted-icon' ?
+        this.nativePresentation(imageNode, imageNode) : {icon:'permissions', iconState:'normal'};
+    }
+    if (node.matches('.blocked-permission-icon')) {
+      const permission = node.getAttribute('data-permission-id');
+      icon = permissions[permission] || permission || 'permissions';
+      iconState = 'blocked';
+    } else if (node.matches('.sharing-icon')) {
+      icon = node.id === 'webrtc-sharing-icon' ? node.getAttribute('sharing') :
+        ({'geo-sharing-icon':'geo','xr-sharing-icon':'xr','serial-sharing-icon':'serial'}[node.id] || 'permissions');
+      iconState = has(node, 'paused') ? 'paused' : 'recording';
+    } else if (node.matches('.notification-anchor-icon')) {
+      icon = ({'default':'notification', 'geo':'geo', 'loopback-network':'network',
+        'local-network':'network', 'xr':'xr', 'autoplay-media':'autoplay', 'addons':'install',
+        'canvas':'canvas', 'indexedDB':'storage', 'password':'password',
+        'web-notifications':'notification', 'webRTC-shareDevices':'camera',
+        'webRTC-shareMicrophone':'microphone', 'webRTC-shareScreen':'screen',
+        'webRTC-shareSpeaker':'speaker', 'servicesInstall':'service', 'eme':'drm',
+        'persistent-storage':'storage', 'midi':'midi', 'serial':'serial',
+        'webauthn':'password', 'identity-credential':'credential', 'storage-access':'storage-access',
+      })[node.id.replace(/-notification-icon$/, '')] || 'notification';
+    } else if (node.id === 'trust-icon-container' || node.id === 'identity-icon-box') {
+      const identity = node.id === 'trust-icon-container' ? node : document.getElementById('identity-box');
+      iconState = ['breached','certErrorPage','httpsOnlyErrorPage'].some(c => classes(identity,c)) ? 'danger' :
+        this.connectionWarning(node) ? 'warning' : 'normal';
+      icon = iconState === 'normal' ? 'connection' : iconState;
+    } else if (node.id === 'tracking-protection-icon-container') {
+      const box = document.getElementById('tracking-protection-icon-box');
+      icon = 'protection';
+      iconState = has(box,'hasException') ? 'blocked' : has(box,'active') ? 'active' : 'normal';
+    } else if (node.id === 'userContext-icons') {
+      icon = ['fingerprint','briefcase','dollar','cart','vacation','gift','food','fruit','pet','tree','chill','circle','fence']
+        .find(name => classes(imageNode, `identity-icon-${name}`)) || 'circle';
+    } else if (kinds[node.id]) {
+      icon = kinds[node.id];
+      if (icon === 'bookmark' && has(document.getElementById('star-button'),'starred')) icon = 'bookmark-filled';
+      if (icon === 'bookmark-filled' || node.getAttribute('readeractive') === 'true' ||
+          has(node,'pipactive') || has(node,'translationsactive')) iconState = 'active';
+      if (icon === 'translation' && this.visible(document.getElementById('translations-button-circle-arrows')))
+        iconState = 'busy';
+    }
+    return {icon, iconState, ...(node.id === 'userContext-icons' ? {iconColored:true} : {})};
+  }
+  snapshot() {
+    const document = this.window.document;
+    const left = ['trust-icon-container', 'tracking-protection-icon-container', 'identity-icon-box']
+      .map(id => document.getElementById(id));
+    // Notification indicators and extension page actions are dynamic Firefox children.
