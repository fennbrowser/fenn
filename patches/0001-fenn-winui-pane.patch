+    // Refresh that engine-local provider on Gecko, never from the page's pump.
+    if(result==CO_E_OBJNOTCONNECTED && mUia.load() && !mStale.exchange(true)) {
+      Trace("stale-backend");
+      static UINT wake=RegisterWindowMessageW(L"Fenn.NativeWindowHost.AccessibilityWake.v1");
+      if(!PostMessageW(mWidget,wake,0,0))mStale=false;
+    }
+    return result;
+  }
+  void Trace(const char* operation, long detail=0) const {
+    MOZ_LOG(sWinUIAccessibilityLog,LogLevel::Debug,
+        ("Root=%p operation=%s detail=%ld proxy=%p shell=%p page=%p caller=%lu shellThread=%lu pageThread=%lu",
+         this,operation,detail,mWidget,mShell,Window(),GetCurrentThreadId(),
+         GetWindowThreadProcessId(mShell,nullptr),GetWindowThreadProcessId(Window(),nullptr)));
+  }
+  ~WinUIAccessibleRoot() { MOZ_ASSERT(!mUia); }
+  template<class T> HRESULT Proxy(RefPtr<T>& out) {
+    if (OnWindowThread()) {
+      MOZ_LOG(sWinUIAccessibilityLog,LogLevel::Debug,("Reject native-thread semantic query"));
+      return UIA_E_ELEMENTNOTAVAILABLE;
+    }
+    const DWORD cookie=mUia.load();
+    if (!cookie) return CO_E_OBJNOTCONNECTED;
+    RefPtr<IRawElementProviderSimple> base;
+    HRESULT hr=mGit->GetInterfaceFromGlobal(cookie,__uuidof(IRawElementProviderSimple),getter_AddRefs(base));
+    if(FAILED(hr)) {
+      MOZ_LOG(sWinUIAccessibilityLog,LogLevel::Debug,("Root=%p GIT cookie=%lu result=%lx",this,cookie,hr));
+      return ObserveResult(hr);
+    }
+    hr=base->QueryInterface(__uuidof(T),getter_AddRefs(out));
+    if(FAILED(hr))MOZ_LOG(sWinUIAccessibilityLog,LogLevel::Debug,("Root=%p QI cookie=%lu result=%lx",this,cookie,hr));
+    return ObserveResult(hr);
+  }
+  std::atomic<ULONG> mReferences{0};
+  // The page input window answers for the page once it exists. It is created on its own thread
+  // and can appear after this root, so it is looked up on every use rather than once: a root that
+  // named the shell window would claim the shell's identity from inside it.
+  HWND Window() const {
+    HWND page=static_cast<HWND>(GetPropW(mShell,L"Fenn.PageWindow"));
+    return page && IsWindow(page) ? page : mShell;
+  }
+  // The shell's thread and the page window's thread must never wait for Gecko.
+  bool OnWindowThread() const {
+    const DWORD current=GetCurrentThreadId();
+    return current==GetWindowThreadProcessId(mShell,nullptr) || current==GetWindowThreadProcessId(Window(),nullptr);
+  }
+  HWND const mShell;
+  HWND const mWidget;
+  RefPtr<IUnknown> mMarshaler;
+  RefPtr<IGlobalInterfaceTable> mGit;
+  std::atomic<DWORD> mUia{0};
+  std::atomic<bool> mStale{false};
+  bool mSupportsUia=false; // immutable after publication, including disconnect
+
+ public:
+#define FENN_A11Y_FORWARD(type, method, signature, arguments) \
+  HRESULT STDMETHODCALLTYPE method signature override { \
+    RefPtr<type> proxy; HRESULT hr=Proxy(proxy); \
+    return ObserveResult(FAILED(hr) ? hr : proxy->method arguments); \
+  }
+  HRESULT STDMETHODCALLTYPE GetPatternProvider(PATTERNID id,IUnknown** out) override {
+    if (!out) return E_POINTER;
+    *out=nullptr;
+    if (OnWindowThread()) return S_OK;
+    RefPtr<IRawElementProviderSimple> proxy; HRESULT hr=Proxy(proxy);
+    return ObserveResult(FAILED(hr) ? hr : proxy->GetPatternProvider(id,out));
+  }
+  HRESULT STDMETHODCALLTYPE GetPropertyValue(PROPERTYID id,VARIANT* out) override {
+    if (!out) return E_POINTER;
+    VariantInit(out);
+    if (id==UIA_NativeWindowHandlePropertyId) {
+      out->vt=VT_I4; out->lVal=static_cast<LONG>(reinterpret_cast<LONG_PTR>(Window())); return S_OK;
+    }
+    if (OnWindowThread()) return S_OK; // native HWND provider fallback
+    RefPtr<IRawElementProviderSimple> proxy; HRESULT hr=Proxy(proxy);
+    return ObserveResult(FAILED(hr) ? hr : proxy->GetPropertyValue(id,out));
+  }
+  FENN_A11Y_FORWARD(IRawElementProviderFragment,Navigate,(NavigateDirection direction,IRawElementProviderFragment** out),(direction,out))
+  // HWND-root identity/geometry are native facts. UIA asks for them while
+  // constructing its node inside WM_GETOBJECT, before any worker-side calls.
+  HRESULT STDMETHODCALLTYPE GetRuntimeId(SAFEARRAY** out) override {
+    if (!out) return E_POINTER;
+    *out=nullptr; return S_OK; // UIA supplies the HWND-root runtime identity.
+  }
+  HRESULT STDMETHODCALLTYPE get_BoundingRectangle(UiaRect* out) override {
+    if (!out) return E_POINTER;
+    *out={}; RECT bounds{};
+    if (!mUia || !GetWindowRect(Window(),&bounds)) return UIA_E_ELEMENTNOTAVAILABLE;
+    *out={double(bounds.left),double(bounds.top),double(bounds.right-bounds.left),double(bounds.bottom-bounds.top)};
+    return S_OK;
+  }
+  FENN_A11Y_FORWARD(IRawElementProviderFragment,GetEmbeddedFragmentRoots,(SAFEARRAY** out),(out))
+  FENN_A11Y_FORWARD(IRawElementProviderFragment,SetFocus,(),())
+  FENN_A11Y_FORWARD(IRawElementProviderFragmentRoot,ElementProviderFromPoint,(double x,double y,IRawElementProviderFragment** out),(x,y,out))
+  FENN_A11Y_FORWARD(IRawElementProviderFragmentRoot,GetFocus,(IRawElementProviderFragment** out),(out))
+  HRESULT STDMETHODCALLTYPE get_FragmentRoot(IRawElementProviderFragmentRoot** out) override {
+    if (!out) return E_POINTER;
+    *out=nullptr;
+    if (!mUia) return UIA_E_ELEMENTNOTAVAILABLE;
+    *out=this; AddRef(); return S_OK;
+  }
+#undef FENN_A11Y_FORWARD
+};
+}  // namespace mozilla::widget
+#endif
+#endif
diff --git a/widget/windows/WinUIDropTarget.h b/widget/windows/WinUIDropTarget.h
new file mode 100644
index 00000000000..bfb68e93bda
--- /dev/null
+++ b/widget/windows/WinUIDropTarget.h
@@ -0,0 +1,80 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef mozilla_widget_WinUIDropTarget_h
+#define mozilla_widget_WinUIDropTarget_h
+
+#include <windows.h>
+#include <oleidl.h>
+
+namespace mozilla::widget {
+// One COM identity per page registration, on Gecko's OLE STA. Revoking an
+// HWND registration does not revoke interfaces already held by OLE clients.
+// Never rearm this object: replacement registrations allocate a new identity.
+class WinUIDropTarget final : public IDropTarget {
+ public:
+  explicit WinUIDropTarget(IDropTarget* target) : mTarget(target) {
+    if (mTarget) mTarget->AddRef();
+  }
+  void Retire() {
+    auto* target = mTarget;
+    mTarget = nullptr;
+    if (target) target->Release();
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    if (iid != IID_IUnknown && iid != IID_IDropTarget) return E_NOINTERFACE;
+    *out = static_cast<IDropTarget*>(this);
+    AddRef();
+    return S_OK;
+  }
+  ULONG STDMETHODCALLTYPE AddRef() override { return InterlockedIncrement(&mRefs); }
+  ULONG STDMETHODCALLTYPE Release() override {
+    const ULONG refs = InterlockedDecrement(&mRefs);
+    if (!refs) delete this;
+    return refs;
+  }
+  HRESULT STDMETHODCALLTYPE DragEnter(IDataObject* data, DWORD keys, POINTL point,
+                                      DWORD* effect) override {
+    if (!effect) return E_POINTER;
+    Target target(mTarget);
+    if (target.value) return target.value->DragEnter(data, keys, point, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE DragOver(DWORD keys, POINTL point, DWORD* effect) override {
+    if (!effect) return E_POINTER;
+    Target target(mTarget);
+    if (target.value) return target.value->DragOver(keys, point, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE DragLeave() override {
+    Target target(mTarget);
+    return target.value ? target.value->DragLeave() : S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE Drop(IDataObject* data, DWORD keys, POINTL point,
+                                 DWORD* effect) override {
+    if (!effect) return E_POINTER;
+    Target target(mTarget);
+    if (target.value) return target.value->Drop(data, keys, point, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+  }
+ private:
+  // A forwarded Gecko call may spin the event loop and retire this registration.
+  // Keep that already-entered call alive without retaining the target afterward.
+  struct Target {
+    IDropTarget* value;
+    explicit Target(IDropTarget* target) : value(target) { if (value) value->AddRef(); }
+    ~Target() { if (value) value->Release(); }
+    Target(const Target&) = delete;
+    Target& operator=(const Target&) = delete;
+  };
+  ~WinUIDropTarget() { Retire(); }
+  LONG mRefs = 0;
+  IDropTarget* mTarget;
+};
+}  // namespace mozilla::widget
+#endif
diff --git a/widget/windows/WinUIPageInput.cpp b/widget/windows/WinUIPageInput.cpp
