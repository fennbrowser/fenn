+        }
+      },
+    });
+  }
+
+  /**
+   * Providers restart queries from engagement callbacks through the controller's
+   * input. Here that only records a request, valid while an engagement is ending,
+   * which the editor surfaces as a proposal for the host to acknowledge.
+   */
+  #requestRestart(call) {
+    if (this.#closed || !this.#endingEngagement || !this.#isCurrent()) return Promise.resolve();
