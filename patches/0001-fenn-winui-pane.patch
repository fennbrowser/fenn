+++ b/browser/components/urlbar/content/UrlbarSearchModeModel.mjs
@@ -0,0 +1,503 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Shared search-mode policy. Services supply engine/localization data, semantic
+// state and browser commands; no presenter, element or window is retained here.
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+export class UrlbarSearchModeModel {
+  static MAX_OPENSEARCH_ENGINES = 3;
+
+  /** One-off destinations differ from generic link modifier policy. */
+  static oneOffOpenPolicy({ forceNewTab = false, loadInBackground = false,
+    wantsNewTab = false, tabIsEmpty = true, mouseBackground = false }) {
+    const where = forceNewTab || (wantsNewTab && !tabIsEmpty) || mouseBackground ? "tab" : "current";
+    const background = forceNewTab ? loadInBackground : mouseBackground;
+    return Object.freeze({ where, params: background ? Object.freeze({ inBackground: true }) : undefined });
+  }
+
+  static oneOffAllowsAutofill(searchMode) {
+    return !searchMode.engineName && searchMode.source !== UrlbarShared.RESULT_SOURCE.SEARCH;
+  }
+
+  /** Keep immediate engine searches distinct from entering a search mode. */
+  static oneOffCommandKind({ userTypedSearchString, hasEngine, shiftKey, where }) {
+    if (userTypedSearchString && hasEngine && (shiftKey || where !== "current")) return "navigation";
+    return where === "tab" ? "new-tab" : "query";
+  }
+
+  /** Shared legacy one-off engine eligibility, before any button construction. */
+  static oneOffEngines(engines, defaultEngine, includeCurrentEngine) {
+    const ignoredName = includeCurrentEngine ? null : defaultEngine.name;
+    return engines.filter(engine => (!ignoredName || engine.name !== ignoredName) && !engine.hideOneOffButton);
+  }
+
+  static engineOneOffsWillHide(engines, defaultEngine) {
+    return !engines.length || (engines.length === 1 && engines[0].name === defaultEngine.name);
+  }
+
+  /** The address bar additionally includes local modes and its disabling pref. */
+  static urlbarOneOffsWillHide(engineWillHide, { disabled, localModes }) {
+    return !!disabled || (!localModes && engineWillHide);
+  }
+
+  /** Resolve Firefox restriction tokens without retaining an input or store. */
+  static modeForToken(token, { isAddressbar, engineStore }) {
+    if (token == UrlbarShared.RESTRICT_TOKENS.SEARCH) {
+      return { engineName: engineStore.default?.name };
+    }
+    const mode = isAddressbar && UrlbarShared.LOCAL_SEARCH_MODES.find(m => m.restrict == token);
+    return mode ? { ...mode } : null;
+  }
+
+  /** First command token; preserve the original string for the eventual editor write. */
+  static searchCommandToken(value) {
+    const trimmedValue = value.trim();
+    const end = trimmedValue.search(UrlbarShared.REGEXP_SPACES);
+    return end == -1 ? trimmedValue : trimmedValue.substring(0, end);
+  }
+
+  /** Shared input.search text/mode policy; focus, composition and dispatch stay in the binding. */
+  static searchCommand(value, { searchEngine = null, searchModeEntry, resolveMode }) {
+    const firstToken = this.searchCommandToken(value);
+    let searchMode = resolveMode(firstToken);
+    let firstTokenIsRestriction = !!searchMode;
+    if (!searchMode && searchEngine) {
+      searchMode = { engineName: searchEngine.name };
+      firstTokenIsRestriction = searchEngine.aliases.includes(firstToken);
+    }
+    let changeSearchMode = false;
+    if (searchMode) {
+      searchMode = Object.freeze({ ...searchMode, entry: searchModeEntry });
+      changeSearchMode = true;
+      if (firstTokenIsRestriction) value = value.replace(firstToken, "");
+      // Firefox removes one leading whitespace character, not the entire prefix.
+      if (UrlbarShared.REGEXP_SPACES.test(value[0])) value = value.slice(1);
+    } else if (Object.values(UrlbarShared.RESTRICT_TOKENS).includes(firstToken)) {
+      searchMode = null;
+      changeSearchMode = true;
+      if (Object.values(UrlbarShared.RESTRICT_TOKENS).includes(value)) value += " ";
+    }
+    return Object.freeze({ value, changeSearchMode, searchMode: searchMode || null });
+  }
+
+  /** Result-to-mode policy; bindings supply action facts and token resolution. */
+  static modeForResult(result, { entry = null, actionEngine = null, modeForToken }) {
+    // Search mode is determined by the result's keyword or engine.
+    if (
+      !result.payload.keyword &&
+      !result.payload.engine &&
+      !actionEngine
+    ) {
+      return null;
+    }
+
+    let searchMode = modeForToken(result.payload.keyword);
+    // If result.originalEngine is set, then the user is Alt+Tabbing
+    // through the one-offs, so the keyword doesn't match the engine.
+    if (
+      !searchMode &&
+      result.payload.engine &&
+      (!result.payload.originalEngine ||
+        result.payload.engine == result.payload.originalEngine)
+    ) {
+      searchMode = { engineName: result.payload.engine };
+    } else if (actionEngine) {
+      searchMode = { engineName: actionEngine };
+    }
+
+    if (searchMode) {
+      if (result.type == UrlbarShared.RESULT_TYPE.RESTRICT) {
+        searchMode.restrictType = "keyword";
+      } else if (
+        UrlbarShared.SEARCH_MODE_RESTRICT.has(result.payload.keyword)
+      ) {
+        searchMode.restrictType = "symbol";
+      }
+      if (entry) {
+        searchMode.entry = entry;
+      } else {
+        switch (result.providerName) {
+          case "UrlbarProviderTopSites":
+            searchMode.entry = "topsites_urlbar";
+            break;
+          case "UrlbarProviderTabToSearch":
+            if (result.payload.dynamicType) {
+              searchMode.entry = "tabtosearch_onboard";
+            } else {
+              searchMode.entry = "tabtosearch";
+            }
+            break;
+          default:
+            searchMode.entry = "keywordoffer";
+            break;
+        }
+      }
+    }
+
+    return searchMode;
+  }
+
+  /** Plan a result-driven mode transition; the binding owns application/order. */
+  static resultTransition(result, { value, checkValue = true, startQuery = true,
+    nativeAction = false, resolveMode }) {
+    if (!result || (checkValue && value.trim() !== result.payload.keyword?.trim() &&
+        value.trim() !== result.payload.autofillKeyword?.trim())) return null;
+    const mode = resolveMode(result);
+    if (!mode) return null;
+    const confirmed = startQuery || nativeAction;
+    return Object.freeze({
+      searchMode: Object.freeze({ ...mode, ...(confirmed ? { isPreview: false } : {}) }),
+      value: result.payload.query?.trimStart() || "",
+      storeTypedValue: !!confirmed,
+      startQuery: !!startQuery,
+    });
+  }
+
+  /** Confirm a preview without mutating the query's pre-confirmation mode facts. */
+  /** confirmSearchMode only invokes the setter and clears one-offs for a preview. */
+  static confirmationPolicy(mode) {
+    const applyMode = !!mode?.isPreview;
+    return Object.freeze({ applyMode, clearOneOffSelection: applyMode,
+      searchMode: applyMode ? this.confirmedMode(mode) : (mode ? Object.freeze({ ...mode }) : null) });
+  }
+
+  static confirmedMode(mode) {
+    return mode ? Object.freeze({ ...mode, isPreview: false }) : null;
+  }
+
+  /** Normalize requested mode facts; engine is resolved by Firefox's live store. */
+  static normalizeMode(request, engine = null) {
+    if (request?.engineName && !engine) return null;
+    const { engineName, source, entry, restrictType, isPreview = true } = request || {};
+    let mode = null;
+    if (engineName) {
+      mode = { engineName, isGeneralPurposeEngine: engine.isGeneralPurposeEngine };
+      if (source) mode.source = source;
+      else if (mode.isGeneralPurposeEngine) mode.source = UrlbarShared.RESULT_SOURCE.SEARCH;
+    } else if (source) {
+      if (UrlbarShared.getResultSourceName(source)) mode = { source };
+      else console.error(`Unrecognized source: ${source}`);
+    }
+    if (!mode) return null;
+    mode.isPreview = isPreview;
+    mode.entry = UrlbarShared.SEARCH_MODE_ENTRY.has(entry) ? entry : "other";
+    if (restrictType) mode.restrictType = restrictType;
+    return Object.freeze(mode);
+  }
+
+  /** Mode UI removes an active autofill using Firefox's typed value. */
+  static modeEntryRestoresAutofill(hasPlaceholder, userTypedValue) {
+    return !!(hasPlaceholder && userTypedValue);
+  }
+
+  /** Final untrimmed value after mode UI policy, before result text is written. */
+  static modeEntryTypedValue({ untrimmedValue, pageProxyValid, hasAutofillPlaceholder,
+    userTypedValue }, normalizeTypedValue = value => value) {
+    if (pageProxyValid) return "";
+    return this.modeEntryRestoresAutofill(hasAutofillPlaceholder, userTypedValue)
+      ? normalizeTypedValue(userTypedValue) : untrimmedValue;
+  }
+
+  /** Firefox records only a changed, confirmed mode entry. */
+  static shouldRecordModeEntry(mode, modesAreSame) {
+    return !!mode && !mode.isPreview && !modesAreSame;
+  }
+
+  /** Read a copy; preview shadows confirmed state unless explicitly excluded. */
+  static readMode(modes, confirmedOnly = false) {
+    const mode = (!confirmedOnly && modes.preview) || modes.confirmed;
+    return mode ? { ...mode } : null;
+  }
+
+  /** Apply canonical mode facts to a caller-owned record, preserving its identity. */
+  static writeMode(modes, normalized) {
+    const mode = normalized ? { ...normalized } : null;
+    if (!mode) {
+      delete modes.preview;
+      delete modes.confirmed;
+    } else if (mode.isPreview) {
+      modes.preview = mode;
+    } else {
+      modes.confirmed = mode;
+      delete modes.preview;
+    }
+    return mode;
+  }
+
+  // Availability is explicit per-tab state. Preferences gate presentation but
+  // do not erase that state: a keyboard reveal survives until Firefox resets it.
+  static visibility({available, searchMode, isSearchbarSAP = false, smartbar = false}) {
+    const enabled = !smartbar && (isSearchbarSAP ||
+      UrlbarPrefs.get("searchModeSwitcher.featureGate") ||
+      UrlbarPrefs.get("scotchBonnet.enableOverride"));
+    const exit = !isSearchbarSAP && !!searchMode &&
+      !UrlbarPrefs.get("unifiedSearchButton.always");
+    return {enabled: !!enabled, exit,
+      modeButtonVisible: !!enabled && !!available,
+      modeExitVisible: !!enabled && !!available && exit};
+  }
+  /** Shared switcher eligibility, independent of menu construction. */
+  static availableModes(engines, sapName) {
+    const visible = engines.filter(engine => !engine.hideOneOffButton);
+    return sapName !== "urlbar" ? visible : visible.concat(UrlbarShared.LOCAL_SEARCH_MODES.filter(
+      mode => UrlbarPrefs.get("browser.settings-redesign.enabled") || UrlbarPrefs.get(mode.pref)));
+  }
+
+  static menuDisposition(where) {
+    return where.startsWith("tab") ? where : "current";
+  }
+
+  /** Describe a local/engine menu command with Firefox's page-text and modifier policy. */
+  static menuCommand(engine, { value, pageProxyValid }, { where = "current", shiftKey = false } = {}) {
+    const searchString = pageProxyValid ? "" : value;
+    if (engine.source) {
+      return Object.freeze({ kind: "query", value: engine.restrict + " " + searchString,
+        engineId: null, picked: "local_search" });
+    }
+    where = this.menuDisposition(where);
+    return Object.freeze({ kind: !shiftKey && where === "current" ? "query" : "navigation",
+      value: searchString, engineId: engine.id, where, inBackground: true,
+      picked: engine.isConfigEngine ? "builtin_search" : "addon_search" });
+  }
+
+  engines = [];
+  selectedIndex = 0;
+  #pendingInstalls = new Set();
+  #disposed = false;
+
+  // readState: {value, pageProxyValid, searchMode}; engineStore: Firefox's store;
+  // offeredEngines: current document's offers; installEngine: browser install;
+  // search/exit/openEngine/openPreferences: Firefox semantic commands;
+  // whereToOpenLink: Firefox modifier policy; recordPicked: SAP telemetry.
+  constructor(services) {
+    this.services = services;
+  }
+
+  dispose() {
+    this.#disposed = true;
+    for (const cleanup of this.#pendingInstalls) cleanup();
+  }
+
+  offeredEngines() {
+    return this.services.offeredEngines().slice(0, UrlbarSearchModeModel.MAX_OPENSEARCH_ENGINES);
+  }
+
+  searchString() {
+    const state = this.services.readState();
+    return state.pageProxyValid ? "" : state.value;
+  }
+
+  disposition(event) {
+    const where = this.services.whereToOpenLink(event);
+    // Shift requests a SERP, not a new window, in the mode switcher.
+    return UrlbarSearchModeModel.menuDisposition(where);
+  }
+
+  exit() {
+    this.services.exit();
+    this.selectedIndex = 0;
+    this.engines = [];
+  }
+
+  openPreferences() {
+    this.services.openPreferences();
+    this.services.recordPicked("settings");
+  }
+
+  localSearch(restrict, options = {}) {
+    const command = UrlbarSearchModeModel.menuCommand({ source: true, restrict }, this.services.readState());
+    this.services.search(command.value, { searchModeEntry: "searchbutton", ...options });
+    this.services.recordPicked(command.picked);
+  }
+
+  remoteSearch(engine, event, options = {}) {
+    const command = UrlbarSearchModeModel.menuCommand(engine, this.services.readState(), {
+      where: this.services.whereToOpenLink(event), shiftKey: event.shiftKey,
+    });
+    if (command.kind === "query") {
+      this.services.search(command.value, {
+        searchEngine: engine, searchModeEntry: "searchbutton", ...options,
+      });
+    } else {
+      this.services.openEngine(command.value, {
+        event, searchEngine: engine, where: command.where, inBackground: command.inBackground,
+      });
+    }
+    this.services.recordPicked(command.picked);
+    return command.kind;
+  }
+
+  async install(engine, options = {}, isCurrent = () => true) {
+    if (this.#disposed || !isCurrent()) return false;
+    const store = this.services.engineStore;
+    const cleanup = () => {
+      store.removeObserver(observer);
+      this.#pendingInstalls.delete(cleanup);
+    };
+    const observer = (_, newEngine) => {
+      if (this.#disposed || !isCurrent()) {
+        cleanup();
+        return;
+      }
+      try {
+        this.services.search(this.searchString(), {
+          searchEngine: newEngine, searchModeEntry: "searchbutton", ...options,
+        });
+      } finally {
+        cleanup();
+      }
+    };
+    this.#pendingInstalls.add(cleanup);
+    store.addObserver(observer);
+    this.services.recordPicked("addon_search");
+    try {
+      const added = await this.services.installEngine(engine);
+      if (!added || this.#disposed || !isCurrent()) cleanup();
+      return added && !this.#disposed;
+    } catch (error) {
+      cleanup();
+      throw error;
+    }
+  }
+
+  async activate(key, event, isCurrent, isContextCurrent = isCurrent) {
+    await this.populateEngines();
+    if (this.#disposed || !isCurrent()) return false;
+    const options = {focus: false, startQuery: false};
+    if (key.startsWith("install:")) {
+      const engine = this.offeredEngines().find(e => key == `install:${e.uri}`);
+      if (!engine) return false;
+      const added = await this.install(engine, options, isContextCurrent);
+      return added && isContextCurrent() ? "query" : false;
+    }
+    if (key == "settings") {
+      this.openPreferences();
+      return "settings";
+    }
+    if (key == "exit") {
+      this.exit();
+      return "query";
+    }
+    const engine = this.engines.find(item =>
+      key == (item.source ? `local:${item.restrict}` : `engine:${item.id}`));
+    if (!engine) return false;
+    if (engine.source) {
+      this.localSearch(engine.restrict, options);
+      return "query";
+    }
+    return this.remoteSearch(engine, event, options);
+  }
+
+  async populateEngines() {
+    let engines = [];
+    try {
+      await this.services.engineStore.init();
+      engines = this.services.engineStore.getEngines();
+    } catch {
+      // Search service failed but local modes remain available.
+    }
+    this.engines = UrlbarSearchModeModel.availableModes(engines, this.services.sapName);
+  }
+
+  async localLabel(source) {
+    let mode = UrlbarShared.LOCAL_SEARCH_MODES.find(m => m.source == source);
+    let [str] = await this.services.l10n.formatMessages([{ id: mode.uiLabel }]);
+    return str.value;
+  }
+
+  async displayedEngineDetails(searchMode = null) {
+    if (!searchMode || searchMode.engineName) {
+      try {
+        await this.services.engineStore.init();
+      } catch {
+        return { label: null, icon: UrlbarShared.ICON.SEARCH_GLASS };
+      }
+
+      let engine = searchMode
+        ? this.services.engineStore.getEngineByName(
+            searchMode.engineName
+          )
+        : this.services.engineStore.default;
+      if (!engine) {
+        return { label: null, icon: UrlbarShared.ICON.SEARCH_GLASS };
+      }
+      let icon = (await engine.getIconURL()) ?? UrlbarShared.ICON.SEARCH_GLASS;
+      return {
+        label: engine.name,
+        icon,
+        engine,
+      };
+    }
+
+    let mode = UrlbarShared.LOCAL_SEARCH_MODES.find(
+      m => m.source == searchMode.source
+    );
+    return {
+      label: await this.localLabel(searchMode.source),
+      icon: mode.icon,
+    };
+  }
+
+  async snapshot() {
+    await this.populateEngines();
+    const entries = await Promise.all(this.engines.map(async engine => ({
+      key: engine.source ? `local:${engine.restrict}` : `engine:${engine.id}`,
+      label: engine.source ? await this.localLabel(engine.source) : engine.name,
+      icon: engine.source ? null : await engine.getIconURL().catch(() => null),
+      symbol: engine.source ? UrlbarShared.getResultSourceName(engine.source) : "search",
+      local: !!engine.source,
+    })));
+    const offered = this.offeredEngines();
+    // The DOM inserts each offered engine after the same separator.
+    for (const engine of offered.toReversed()) {
+      entries.push({key:`install:${engine.uri}`, label:await this.services.l10n.formatValue(
+        "urlbar-searchmode-popup-add-engine", {engineName:engine.title}),
+        icon:engine.icon, symbol:"add", local:true});
+    }
+    const settingsId = UrlbarPrefs.get("browser.nova.enabled")
+      ? "urlbar-searchmode-popup-settings2" : "urlbar-searchmode-popup-search-settings2";
+    const [settings] = await this.services.l10n.formatMessages([{id: settingsId}]);
+    entries.push({key:"settings", label:settings.value || settings.attributes?.find(a => a.name == "label")?.value || "Settings", symbol:"settings", local:true});
+    const mode = this.services.readState().searchMode;
+    const displayed = await this.displayedEngineDetails(mode);
+    const [buttonMessage, exitMessage] = await this.services.l10n.formatMessages([
+      {id: displayed.label ? "urlbar-searchmode-button3" : "urlbar-searchmode-button-no-engine2", args:{engine:displayed.label || ""}},
+      {id:"urlbar-searchmode-exit-button2"},
+    ]);
+    const title = message => message.attributes?.find(a => a.name == "title")?.value || "";
+    return {buttonLabel:title(buttonMessage), exitLabel:title(exitMessage), entries, label:displayed.label || "Search", icon:(mode && !mode.engineName) || Object.values(UrlbarShared.ICON).includes(displayed.icon) ? null : displayed.icon,
+      symbol:mode && !mode.engineName ? UrlbarShared.getResultSourceName(mode.source) : "search",
+      active:!!mode};
+  }
+}
+
+/**
+ * Independent per-tab mode ownership. Keys are opaque tab identities; no input,
+ * browser state object, presenter or engine store is retained. Callers resolve
+ * live engines and own scope validation, persistence, telemetry and UI effects.
+ */
+export class UrlbarSearchModeState {
+  #tabs = new WeakMap();
+
+  get(tab, confirmedOnly = false) {
+    return UrlbarSearchModeModel.readMode(this.#tabs.get(tab) || {}, confirmedOnly);
+  }
+
+  set(tab, request, engine = null) {
+    const normalized = UrlbarSearchModeModel.normalizeMode(request, engine);
+    let modes = this.#tabs.get(tab);
+    if (!modes) {
+      modes = {};
+      this.#tabs.set(tab, modes);
+    }
+    UrlbarSearchModeModel.writeMode(modes, normalized);
+    return this.get(tab);
+  }
+
+  forget(tab) {
+    this.#tabs.delete(tab);
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarSearchModeBinding.mjs b/browser/components/urlbar/content/UrlbarSearchModeBinding.mjs
new file mode 100644
index 00000000000..e3ee46ce034
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarSearchModeBinding.mjs
@@ -0,0 +1,39 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Transitional binding to the retained input. This is the remaining input
+// dependency, kept separate from the shared model and from switcher rendering.
+import { UrlbarSearchModeModel } from "chrome://browser/content/urlbar/UrlbarSearchModeModel.mjs";
+import { UrlbarContentUtils } from "chrome://browser/content/urlbar/UrlbarContentUtils.mjs";
+
+const lazy = typeof ChromeUtils != "undefined" ? {} : null;
+if (lazy) ChromeUtils.defineESModuleGetters(lazy, {
+  OpenSearchManager: "moz-src:///browser/components/search/OpenSearchManager.sys.mjs",
+  SearchUIUtils: "moz-src:///browser/components/search/SearchUIUtils.sys.mjs",
+});
+
+export function bindSearchModeModel(input) {
+  return new UrlbarSearchModeModel({
+    sapName: input.sapName,
+    engineStore: input.controller.engineStore,
+    l10n: new Localization(["browser/browser.ftl"]),
+    readState: () => ({value: input.value,
+      pageProxyValid: input.getAttribute("pageproxystate") == "valid",
+      searchMode: input.searchMode}),
+    offeredEngines: () => {
+      const browser = input.window.gBrowser?.selectedBrowser;
+      return browser ? lazy.OpenSearchManager.getInstallableEngines(browser) : [];
+    },
+    installEngine: engine => lazy.SearchUIUtils.addOpenSearchEngine(
+      engine.uri, engine.icon, input.window.gBrowser.selectedBrowser.browsingContext),
+    whereToOpenLink: event => UrlbarContentUtils.whereToOpenLink(event),
+    search: (value, options) => input.search(value, options),
+    exit: () => { input.searchMode = null; },
+    openEngine: (value, options) => input.openSearchEnginePage(value, options),
+    openPreferences: () => input.parentController.openPreferences("paneSearch"),
+    recordPicked: kind => {
+      if (input.sapName == "urlbar") Glean.urlbarUnifiedsearchbutton.picked[kind].add(1);
+    },
+  });
+}
diff --git a/browser/components/urlbar/content/UrlbarClipboardText.mjs b/browser/components/urlbar/content/UrlbarClipboardText.mjs
new file mode 100644
index 00000000000..82d5029bd92
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarClipboardText.mjs
@@ -0,0 +1,155 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Firefox copy formatting from an explicit editor/URL-state snapshot.
+ * The caller owns selection and clipboard I/O. URI operations remain Firefox
+ * services, evaluated only when the selected text requires URL formatting.
+ */
+export function formatUrlbarClipboardText(state, services) {
+  let selectedVal = state.selectedValue;
+  // Handle multiple-range selection as a string for simplicity.
+  if (state.rangeCount > 1) {
+    return selectedVal;
+  }
+
+  // If the selection doesn't start at the beginning or doesn't span the
+  // full domain or the URL bar is modified or there is no text at all,
+  // nothing else to do here.
+  // TODO (Bug 1908360): the valueIsTyped usage here is confusing, as often
+  // it doesn't really indicate a user typed a value, it's rather used as
+  // a way to tell if the value was modified.
+  if (
+    state.selectionStart > 0 ||
+    selectedVal == "" ||
+    (state.valueIsTyped && !state.protocolIsTrimmed && !state.wwwIsTrimmed)
+  ) {
+    return selectedVal;
+  }
+
+  // The selection doesn't span the full domain if it doesn't contain a slash and is
+  // followed by some character other than a slash.
+  if (!selectedVal.includes("/")) {
+    let remainder = state.value.replace(selectedVal, "");
+    if (remainder != "" && remainder[0] != "/") {
+      return selectedVal;
+    }
+  }
+
+  let uri;
+  if (state.pageProxyValid) {
+    uri = services.getPageURI();
+  } else {
+    // The value could be:
+    // 1. a trimmed url, set by selecting a result
+    // 2. a search string set by selecting a result
+    // 3. a url that was confirmed but didn't finish loading yet
+    // If it's an url the untrimmedValue should resolve to a valid URI,
+    // otherwise it's a search string that should be copied as-is.
+
+    // If the copied text is that autofilled value, return the url including
+    // the protocol from its suggestion.
+    let result = state.resultForCurrentValue;
+
+    if (result?.autofill?.value == selectedVal) {
+      return result.payload.url;
+    }
+
+    uri = services.parseURI(state.untrimmedValue);
+    if (!uri) {
+      return selectedVal;
+    }
+  }
+  uri = services.makeURIReadable(uri);
+  let displaySpec = uri.displaySpec;
+
+  // If the entire URL is selected, just use the actual loaded URI,
+  // unless we want a decoded URI, or it's a data: or javascript: URI,
+  // since those are hard to read when encoded.
+  if (
+    state.value == selectedVal &&
+    !uri.schemeIs("javascript") &&
+    !uri.schemeIs("data") &&
+    !state.decodeURLsOnCopy
+  ) {
+    return displaySpec;
+  }
+
+  // Just the beginning of the URL is selected, or we want a decoded
+  // url. First check for a trimmed value.
+
+  // _trimValue may also trim a trailing slash, so we can't compare strings
+  // directly to tell what was trimmed; consult the trimmed prefix instead.
+  let trimmedPrefix = services.getTrimmedURLPrefix(displaySpec);
+  if (trimmedPrefix && !selectedVal.startsWith(trimmedPrefix)) {
+    selectedVal = trimmedPrefix + selectedVal;
+  }
+
+  // If selection starts from the beginning and part or all of the URL
+  // is selected, we check for decoded characters and encode them.
+  // Unless decodeURLsOnCopy is set. Do not encode data: URIs.
+  if (!state.decodeURLsOnCopy && !uri.schemeIs("data")) {
+    try {
+      if (services.canParse(selectedVal)) {
+        // Use encodeURI instead of URL.href because we don't want
+        // trailing slash.
+        selectedVal = encodeURI(selectedVal);
+      }
+    } catch (ex) {
+      // URL is invalid. Return original selected value.
+    }
+  }
+
+  return selectedVal;
+}
+
+// A semantic edit, not an editor transaction. The active presenter applies the
+// replacement and owns undo. Offsets use the editor's UTF-16 convention.
+function selectionReplacement(state, replacement) {
+  const {text, start, end} = state;
+  if (typeof text != "string" || !Number.isInteger(start) ||
+      !Number.isInteger(end) || start < 0 || end < start || end > text.length) {
+    return null;
+  }
+  const caret = start + replacement.length;
+  return {before: text, replaceStart: start, replaceEnd: end, replacement,
+    text: text.slice(0, start) + replacement + text.slice(end),
+    start: caret, end: caret};
+}
+
+export function planUrlbarCut(state) {
+  if (state.readOnly || state.start === state.end) return null;
+  return selectionReplacement(state, "");
+}
+
+/**
+ * Firefox's URL-specific paste override. Null means leave the trusted editor
+ * paste unchanged, including its newline, undo and event handling. It does not
+ * mean reject a paste. The caller supplies Firefox fixup and sanitizer services.
+ */
+export function planUrlbarPaste(state, originalPasteData, services) {
+  if (!originalPasteData || !selectionReplacement(state, "") ||
+      state.text.slice(0, state.start).trim()) return null;
+  const pasteData = services.sanitize(originalPasteData,
+    services.fixup(originalPasteData, state.isPrivate));
+  return originalPasteData === pasteData ? null : selectionReplacement(state, pasteData);
+}
+
+
+/**
+ * Shared Paste and Go command ordering. The binding supplies the existing
+ * trusted editor paste operation; this never reads or inserts clipboard text.
+ * Navigation remains fire-and-forget, as in the original menu command.
+ */
+export function executeUrlbarPasteAndGo(commands) {
+  commands.suppressQuery();
+  try {
+    commands.paste();
+    commands.clearResult();
+    commands.submit();
+    commands.clearQueryCache();
+  } finally {
+    commands.resumeQuery();
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarResultPresentation.mjs b/browser/components/urlbar/content/UrlbarResultPresentation.mjs
new file mode 100644
index 00000000000..f780289b35b
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarResultPresentation.mjs
@@ -0,0 +1,400 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/**
+ * Firefox result-display policy shared by DOM and native presenters. The model
+ * retains only a localization service; query results remain controller-owned.
+ * It neither constructs a view nor owns selection, exposure or blob lifetimes.
+ */
+export class UrlbarResultPresentation {
+  /** Firefox classification without row elements or selection. */
+  static telemetryTypeFromResult(result) {
+    if (!result) {
+      return "unknown";
+    }
+    switch (result.type) {
+      case UrlbarShared.RESULT_TYPE.TAB_SWITCH:
+        return "switchtab";
+      case UrlbarShared.RESULT_TYPE.SEARCH:
+        if (result.providerName == "UrlbarProviderRecentSearches") {
+          return "recent_search";
+        }
+        if (result.source == UrlbarShared.RESULT_SOURCE.HISTORY) {
+          return "formhistory";
+        }
+        if (result.providerName == "UrlbarProviderTabToSearch") {
+          return "tabtosearch";
+        }
+        if (result.providerName == "UrlbarProviderAiChat") {
+          return "ai_search_fallback";
+        }
+        if (result.payload.suggestion) {
+          let type = result.payload.trending ? "trending" : "searchsuggestion";
+          if (result.isRichSuggestion) {
+            type += "_rich";
+          }
+          return type;
+        }
+        return "searchengine";
+      case UrlbarShared.RESULT_TYPE.URL:
+        if (result.autofill) {
+          let { type } = result.autofill;
+          if (!type) {
+            type = "other";
+            console.error(
+              new Error(
+                "`result.autofill.type` not set, falling back to 'other'"
+              )
+            );
+          }
+          return `autofill_${type}`;
+        }
+        if (
+          result.source == UrlbarShared.RESULT_SOURCE.OTHER_LOCAL &&
+          result.heuristic
+        ) {
+          return "visiturl";
+        }
+        if (result.providerName == "UrlbarProviderQuickSuggest") {
+          return "quicksuggest";
+        }
+        if (result.providerName == "UrlbarProviderClipboard") {
+          return "clipboard";
+        }
+        {
+          let type =
+            result.source == UrlbarShared.RESULT_SOURCE.BOOKMARKS
+              ? "bookmark"
+              : "history";
+          if (result.providerName == "UrlbarProviderInputHistory") {
+            return type + "adaptive";
+          }
+          return type;
+        }
+      case UrlbarShared.RESULT_TYPE.KEYWORD:
+        return "keyword";
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return "extension";
+      case UrlbarShared.RESULT_TYPE.REMOTE_TAB:
+        return "remotetab";
+      case UrlbarShared.RESULT_TYPE.TIP:
+        return "tip";
+      case UrlbarShared.RESULT_TYPE.DYNAMIC:
+        if (result.providerName == "UrlbarProviderTabToSearch") {
+          // This is the onboarding result.
+          return "tabtosearch";
+        }
+        return "dynamic";
+      case UrlbarShared.RESULT_TYPE.RESTRICT:
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.BOOKMARK) {
+          return "restrict_keyword_bookmarks";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.OPENPAGE) {
+          return "restrict_keyword_tabs";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.HISTORY) {
+          return "restrict_keyword_history";
+        }
+        if (result.payload.keyword === UrlbarShared.RESTRICT_TOKENS.ACTION) {
+          return "restrict_keyword_actions";
+        }
+        break;
+      case UrlbarShared.RESULT_TYPE.AI_CHAT:
+        return "ai_chat";
+    }
+    return "unknown";
+  }
+
+  constructor(l10n) {
+    this.l10n = l10n;
+  }
+
+  shouldShowHeuristic(result) {
+    if (!result?.heuristic) {
+      throw new Error("A heuristic result must be given");
+    }
+    return !UrlbarPrefs.get("experimental.hideHeuristic") ||
+      result.type == UrlbarShared.RESULT_TYPE.TIP;
+  }
+
+  allowEmptySelection(context) {
+    return !context?.heuristicResult ||
+      !this.shouldShowHeuristic(context.heuristicResult);
+  }
+
+  /**
+   * Initial choice when neither a result nor a one-off is selected. The host
+   * resolves select-first to its first selectable element; associate-first
+   * binds the input's value without selecting a row (hidden heuristics and
+   * filtered search-mode offers). This never moves an existing user selection.
+   */
+  defaultSelection(context) {
+    const first = context?.results?.[0];
+    if (first?.heuristic) {
+      return Object.freeze(this.shouldShowHeuristic(first)
+        ? { kind: "select-first", valueResult: null }
+        : { kind: "associate-first", valueResult: first });
+    }
+    if (first?.payload.providesSearchMode && context.trimmedSearchString != "@") {
+      return Object.freeze({ kind: "associate-first", valueResult: first });
+    }
+    return Object.freeze({ kind: "none", valueResult: null });
+  }
+
+  /**
+   * Arrow-key row traversal. Row count and eligibility describe the presenter's
+   * complete displayed candidate list, including rows outside its viewport.
+   * The callback is synchronous and never retained. It keeps action controls
+   * and disabled-state inspection in the presenter, without passing nodes here.
+   *
+   * A clear descriptor preserves the original explicit deselection path; a row
+   * descriptor (including index -1) uses the presenter's row-selection path.
+   * Query freezing, preview, focus and provider notifications remain binding
+   * responsibilities. Tab-key traversal is a separate element-level policy.
+   */
+  arrowSelection({ selectedRowIndex, rowCount, amount, reverse = false,
+    allowEmptySelection, isSelectable }) {
+    const end = rowCount - 1;
+    const step = reverse ? -1 : 1;
+    if (selectedRowIndex == (reverse ? 0 : end)) {
+      return Object.freeze(allowEmptySelection
+        ? { kind: "clear" }
+        : { kind: "row", index: reverse ? end : 0 });
+    }
+    let index = reverse ? end : 0;
+    if (selectedRowIndex != -1) {
+      index = Math.min(end, Math.max(0, selectedRowIndex + amount * step));
+    }
+    // Preserve Firefox's edge wrap and directional scan order. In particular,
+    // the edge-wrap branch above does not rescan eligibility.
+    while (index >= 0 && index <= end && !isSelectable(index)) {
+      index += step;
+    }
+    return Object.freeze({ kind: "row", index: index > end ? -1 : index });
+  }
+
+  /**
+   * Non-URL input text for a selected result. Bindings capture dynamic element
+   * facts and semantic tip actions; no node or editor crosses this boundary.
+   * Null means use the binding's URL decoding/trimming path, not empty text.
+   * This describes text only: it does not authorize selection or navigation.
+   */
