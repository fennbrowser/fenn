+++ b/browser/base/content/WinUIOverflowMenu.sys.mjs
@@ -0,0 +1,131 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Firefox owns overflow membership, order, availability and widget commands.
+// Only the explicit stock-widget boundary and WebExtension actions are projected.
+export class WinUIOverflowMenu {
+  constructor(toolbar) {
+    this.toolbar=toolbar;this.window=toolbar.window;this.session=this.lastSession=0;
+    this.actions=new Map();
+  }
+  close(){this.closed=true;this.dismiss();}
+  dismiss(){
+    if(!this.session)return;
+    this.closedSession=this.session;this.session=0;this.addressTarget=false;this.description=this.context=this.bounds=null;
+    this.actions.clear();this.toolbar.owner.invalidateAddress();
+  }
+  live(){
+    const t=this.toolbar,w=this.window;
+    return !this.closed && t.active && t.navigation && t.supported() && !t.customization?.editorOpen && !w.gDialogBox?.isOpen &&
+      t.owner.addressSession?.sessionId===this.context?.session && t.owner.addressTab===this.context?.tab && t.owner.addressDocument===this.context?.document &&
+      t.owner.addressTab===w.gBrowser.selectedTab && t.owner.addressDocument===w.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+  }
+  // Use Firefox's real two lists, not a second interpretation of saved placement.
+  // A closed ancestor panel has no rendered layout; inspect visibility only up
+  // to its list and preserve each stock widget's explicit feature/policy gates.
+  members(){
+    const c=this.toolbar.customization,w=this.window,rows=[];
+    if(!c?.current)return rows;
+    for(const listId of ["widget-overflow-list","widget-overflow-fixed-list"]){
+      const list=w.document.getElementById(listId);
+      for(const node of list?.children || []){
+        if(node.hidden || node.collapsed || node.localName==="toolbarseparator" || node.localName==="toolbarspring")continue;
+        if(listId==="widget-overflow-list" && !c.nativeOverflow.has(node.id) && c.entries.has(node.id))continue;
+        const item=c.current.items.find(i=>c.entries.get(node.id)?.id===i.id);
+        if(!item || item.kind==="spring")continue;
+        if(item.stock){
+          if(!c.stock.eligible(node.id))continue;
+          for(const part of c.stock.snapshot(node.id,node,true,this.session && this.addressTarget ? true : undefined)){
+            if(part.shown && part.label)rows.push({key:node.id+"-"+part.id,label:part.label,enabled:part.enabled,
+              checked:part.checked,checkable:part.checkable,address:part.address,kind:"stock",widget:node.id,node,part:part.id,item:item.id});
+          }
+        }else if(item.extension){
+          const entry=this.toolbar.pinned?.paletteEntries?.get(node.id);
+          const button=node.querySelector(".webextension-browser-action");
+          const policy=button && w.WebExtensionPolicy.getByID(button.dataset.extensionid);
+          if(!entry || !policy?.extension.canAccessWindow(w) || !w.gUnifiedExtensions.browserActionFor(policy) || button.hidden)continue;
+          rows.push({key:item.id,label:button.getAttribute("tooltiptext") || policy.extension.name,enabled:!button.hasAttribute("disabled"),
+            checked:false,checkable:false,kind:"extension",widget:node.id,node,addon:button.dataset.extensionid});
+        }else{
+          const state=this.navigation?.[item.control];
+          if(state?.label && (state.shown ?? true))rows.push({key:item.control,label:state.label,enabled:state.enabled,
