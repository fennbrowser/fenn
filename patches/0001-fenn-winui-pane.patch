+        }
+        value += result.payload.suggestion || result.payload.query;
+        return Object.freeze({ value });
+      }
+      case UrlbarShared.RESULT_TYPE.OMNIBOX:
+        return Object.freeze({ value: result.payload.content });
+      case UrlbarShared.RESULT_TYPE.DYNAMIC:
+        return Object.freeze({
+          value: dynamicQuery || dynamicUrl || result.payload.input || result.payload.query || "",
+        });
+      case UrlbarShared.RESULT_TYPE.RESTRICT:
+        return Object.freeze({ value: result.payload.autofillKeyword + " " });
+      case UrlbarShared.RESULT_TYPE.AI_CHAT:
+        return Object.freeze({ value: result.payload.query ?? "" });
+      case UrlbarShared.RESULT_TYPE.TIP: {
+        let value = resultAction?.url || resultAction?.input;
+        if (value) {
+          return Object.freeze({ value });
+        }
+        break;
+      }
+    }
