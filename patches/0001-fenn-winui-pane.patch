+      if (this.#finishState === state) this.#update("finished", query);
+    }
+  }
+
+  /** Identity-stable facts for a successful finish; late result updates revoke them. */
+  describeFinishedQuery(queryId) {
+    this.#check();
+    return this.#query?.id === queryId && this.#finishState?.finished &&
+      !this.#finishState.cancelled ? this.#finishState.description : null;
+  }
+
+  /** Resolve legacy address one-off visibility from the independent engine store. */
+  async prepareOneOffVisibility() {
+    this.#check();
