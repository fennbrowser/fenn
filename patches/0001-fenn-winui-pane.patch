+// The endpoint's identity as chrome JavaScript sees it: the same formatting
+// nsIBaseWindow::nativeHandle uses, so a window can match the notification to
+// its own HWND without a new interface.
+static nsPrintfCString EndpointName(HWND aWindow) {
+  return nsPrintfCString("0x%p", aWindow);
+}
+
+// The pane's wakeup. Called on the WinUI owning thread, usually inside a XAML
+// callback, so it may only *post*: entering browser JavaScript from this stack
+// is exactly the reentrancy the request path exists to avoid. Returning false
+// tells the pane the wakeup did not happen, so a later request schedules a
+// fresh one instead of waiting for one that will never arrive.
+static BOOL WINAPI NotifyWinUIPaneDrain(void* aContext) {
+  if (sPaneStopped) return FALSE;
+  HWND window = static_cast<HWND>(aContext);
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "mozilla::widget::WinUIPaneDrain", [window]() {
+        if (sPaneStopped) return;
+        nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+        if (!observers) return;
+        // Keep custom-element reactions and mutation observers inside one
+        // browser command turn (an empty new group must survive until filled).
+        nsAutoMicroTask microtask;
+        observers->NotifyObservers(
+            nullptr, "winui-pane-drain",
+            NS_ConvertUTF8toUTF16(EndpointName(window)).get());
+      }));
+  return NS_SUCCEEDED(rv) ? TRUE : FALSE;
+}
+
+bool TransferWinUIStartup(HWND aWindow, const nsAString& aMessage, nsAString& aReply) {
+  aWindow = ShellOfProxy(aWindow);
+  aReply.Truncate();
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.startupTransfer || aMessage.Length() > 131072) return false;
+  nsAutoString message(aMessage);
+  auto output = mozilla::MakeUnique<wchar_t[]>(262144);
+  output[0] = 0;
+  if (FAILED(sPaneApi.startupTransfer(aWindow, message.get(), output.get(), 262144))) return false;
+  aReply.Assign(reinterpret_cast<const char16_t*>(output.get()));
+  return true;
+}
+
+bool DrainWinUIRequests(HWND aWindow, nsAString& aBatch) {
+  aWindow = ShellOfProxy(aWindow);
+  aBatch.Truncate();
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.drainRequests)
+    return false;
+  auto output = mozilla::MakeUnique<wchar_t[]>(262144);
+  output[0] = 0;
+  HRESULT hr = sPaneApi.drainRequests(aWindow, output.get(), 262144);
+  if (FAILED(hr)) return false;
+  aBatch.Assign(reinterpret_cast<const char16_t*>(output.get()));
+  return true;
+}
+
+bool CompleteWinUIRequests(HWND aWindow, const nsAString& aOutcomes) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.completeRequests || aOutcomes.Length() > 1048576)
+    return false;
+  nsAutoString outcomes(aOutcomes);
+  return SUCCEEDED(sPaneApi.completeRequests(aWindow, outcomes.get()));
+}
+
+uint32_t ApplyWinUITabDelta(HWND aWindow, const nsAString& aDelta) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.applyTabDelta || aDelta.Length() > 1048576)
+    return 0;
+  nsAutoString delta(aDelta);
+  uint32_t revision = 0;
+  // A zero revision is the caller's signal to send one full snapshot; it is
+  // never a reason to retry the same delta.
+  HRESULT hr = sPaneApi.applyTabDelta(aWindow, delta.get(), &revision);
+  if (FAILED(hr)) return 0;
+  // S_FALSE means the delta applied but the pane has fallen behind and wants a
+  // snapshot. Reporting no revision is how that reaches the producer, which
+  // sends exactly one -- the documented bounded recovery.
+  return hr == S_FALSE ? 0 : revision;
+}
+
+static bool PaneEnabled() {
+  return Preferences::GetBool("fenn.winui.pane.enabled",
+                              false) ||
+         Preferences::GetBool(
+             "fenn.winui.tabstrip.replaceFirefoxTabs",
+             false);
+}
+
+bool GetWinUIChromeLayout(HWND aWindow, uint32_t aStripHeight, bool aNavigation,
+                         uint32_t aInset, nsTArray<LayoutDeviceIntRect>& aRects) {
+  aRects.Clear();
+  if (!ProxyOf(aWindow)) return false;
+  if(auto* link=ProxyOf(aWindow);link && link->processPending)return false;
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || sPaneStopped ||
+      !Preferences::GetBool("fenn.winui.chrome.layout", false) || !PaneEnabled() || !LoadPane())
+    return false;
+  WinUIChromeLayout plan{};
+  HiddenProxy* link = ProxyOf(aWindow);
+  // Until the shell has applied Gecko's last window request, or while it is minimized and
+  // caption-sized, it does not have the size Gecko is laying out for: keep the last plan.
+  if (link && link->lastPlan.fits && (link->pending || IsIconic(link->shell))) {
+    plan = link->lastPlan;
+  } else {
+    if (FAILED(sPaneApi.measureChromeLayout(ShellOfProxy(aWindow), aStripHeight, aNavigation, aInset, &plan)) || !plan.fits)
+      return false;
+    if (link) link->lastPlan = plan;
+  }
+  for (const RECT& r : {plan.strip, plan.navigation, plan.content}) {
+    aRects.AppendElement(LayoutDeviceIntRect(r.left, r.top, r.right - r.left, r.bottom - r.top));
+  }
+  return true;
+}
+
+bool UpdateWinUIPane(HWND aWindow, const RECT& aRect, bool aVisible,
+                     bool aFocus, bool aBackwards,
+                     const nsTArray<LayoutDeviceIntRect>& aOcclusions) {
+  if(auto* link=ProxyOf(aWindow);link && link->processPending)return false;
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || sPaneStopped)
+    return false;
+  if (!ProxyOf(aWindow) || !PaneEnabled()) {
+    DestroyWinUIPane(aWindow);
+    return false;
+  }
+  sTraceEnabled = true;
+  if (!LoadPane()) return false;
+  EnsureIndependentAccessibility(aWindow);
+  // A publication can arrive while the shell is still minimized: it is stale, not refused,
+  // and the restore publishes again.
+  if (ProxyOf(aWindow) && IsIconic(ShellOfProxy(aWindow))) return true;
+  aWindow = ShellOfProxy(aWindow);
+  HRESULT hr = sPaneApi.updateTabStrip(aWindow, &aRect, aVisible);
+  if (SUCCEEDED(hr) && sPaneApi.setNotifySink) {
+    // Registered by the widget, not by chrome script, so the request path
+    // cannot end up with a queue and no wakeup because script failed to set
+    // one up. The context is the endpoint's own HWND.
+    hr = sPaneApi.setNotifySink(aWindow, NotifyWinUIPaneDrain, aWindow);
+  }
+  if (SUCCEEDED(hr)) {
+    nsTArray<RECT> occlusions;
+    for (const auto& r : aOcclusions) {
+      occlusions.AppendElement(RECT{r.x - aRect.left, r.y - aRect.top,
+                                    r.XMost() - aRect.left,
+                                    r.YMost() - aRect.top});
+    }
+    hr = sPaneApi.clip(aWindow, occlusions.Elements(), occlusions.Length());
+  }
+  if (SUCCEEDED(hr) && aVisible && aFocus)
+    hr = sPaneApi.focus(aWindow, aBackwards);
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("pane=update hwnd=%p visible=%d rect=%ld,%ld,%ld,%ld hr=0x%08lx",
+           aWindow, aVisible, aRect.left, aRect.top, aRect.right, aRect.bottom,
+           hr));
+  TraceWinUIPrototype("pane-update", aWindow);
+  if (FAILED(hr)) DestroyWinUIPane(aWindow);
+  return SUCCEEDED(hr);
+}
+
+uint32_t SyncWinUITabs(HWND aWindow, const nsTArray<uint32_t>& aIds,
+                       const nsTArray<nsString>& aTitles, const nsTArray<uint32_t>& aCommands, uint32_t aSelected, uint32_t aRevision) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || sPaneStopped ||
+      !sPaneApi.syncTabs || aIds.Length() != aTitles.Length() || aIds.Length() != aCommands.Length() ||
+      !PaneEnabled())
+    return 0;
+  nsTArray<WinUITab> tabs;
+  for (size_t i = 0; i < aIds.Length(); ++i) {
+    tabs.AppendElement(WinUITab{aIds[i], aTitles[i].get(), aCommands[i]});
+  }
+  uint32_t requested = 0;
+  if (FAILED(sPaneApi.syncTabs(aWindow, tabs.Elements(), tabs.Length(), aSelected, aRevision, &requested)))
+    return 0;
+  return requested;
+}
+
+bool RequestWinUIShare(HWND aWindow, uint64_t aSession, uint64_t aDocument,
+                      const nsAString& aTitle, const nsAString& aUrl) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.requestShare || !PaneEnabled()) return false;
+  nsAutoString title(aTitle), url(aUrl);
+  return SUCCEEDED(sPaneApi.requestShare(ShellOfProxy(aWindow), aSession, aDocument, title.get(), url.get()));
+}
+
+bool SyncWinUIAddress(HWND aWindow, const nsAString& aSnapshot) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.syncAddress || aSnapshot.Length() > 1048576 ||
+      !PaneEnabled()) return false;
+  nsAutoString snapshot(aSnapshot);
+  return SUCCEEDED(sPaneApi.syncAddress(aWindow, snapshot.get()));
+}
+
+bool UpdateWinUIAddress(HWND aWindow, const RECT& aRect, bool aVisible,
+                       bool aFocus, bool aSelectAll) {
+  if (!ProxyOf(aWindow)) return false;
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.updateAddress || !PaneEnabled()) return false;
+  if (aVisible && !Preferences::GetBool(
+          "fenn.winui.navigation.toolbar.enabled", false)) return false;
+  if (ProxyOf(aWindow) && IsIconic(ShellOfProxy(aWindow))) return true;
+  aWindow = ShellOfProxy(aWindow);
+  HRESULT hr = sPaneApi.updateAddress(aWindow, &aRect, aVisible);
+  if (SUCCEEDED(hr) && aVisible && aFocus)
+    hr = sPaneApi.focusAddress(aWindow, aSelectAll);
+  return SUCCEEDED(hr);
+}
+
+// Publication only: since ABI v12 the pane returns nothing here, so there is
+// no output buffer to allocate on every call either.
+bool SyncWinUITabMenu(HWND aWindow, const nsAString& aSnapshot) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.syncTabMenu || aSnapshot.Length() > 1048576 ||
+      !PaneEnabled()) return false;
+  nsAutoString snapshot(aSnapshot);
+  return SUCCEEDED(sPaneApi.syncTabMenu(aWindow, snapshot.get()));
+}
+
+void DestroyWinUIPane(HWND aWindow) {
+  aWindow = ShellOfProxy(aWindow);
+  if (!NS_IsMainThread() || !sPaneApi.destroy || sPaneStopped) return;
+  // Drop the wakeup before the endpoint goes away, so nothing can be posted
+  // for a pane that is already being torn down.
+  if (sPaneApi.setNotifySink) sPaneApi.setNotifySink(aWindow, nullptr, nullptr);
+  HRESULT hr = sPaneApi.destroy(aWindow);
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("pane=destroy hwnd=%p hr=0x%08lx", aWindow, hr));
+}
+
+void InitializeWinUIRuntime() {
+  if(FennProcessShellRequested())return;
+  if (GetEnvironmentVariableW(L"FENN_SHELL_PROCESS_FIXTURE", nullptr, 0)) return;
+  // Every lane uses the shared Microsoft.WindowsAppRuntime.2 framework. A
+  // packaged Firefox has it in its package graph; an unpackaged one joins it
+  // here, before the pane or WindowsUIUtils loads any Windows App SDK DLL, so
+  // that every such DLL comes from one runtime. On failure the pane cannot
+  // start and Firefox keeps its own UI.
+  static bool sAttempted = false;
+  if (sAttempted || !XRE_IsParentProcess()) return;
+  sAttempted = true;
+  if (FennStartupWindowIndependent()) return; // Native bootstrap joined the runtime before XUL.
+  UINT32 length = 0;
+  if (GetCurrentPackageFullName(&length, nullptr) != APPMODEL_ERROR_NO_PACKAGE) {
+    return;
+  }
+  wchar_t path[32768];
+  DWORD pathLength = GetModuleFileNameW(nullptr, path, std::size(path));
+  wchar_t* separator = pathLength && pathLength < std::size(path)
+                           ? wcsrchr(path, L'\\')
+                           : nullptr;
+  constexpr wchar_t bootstrap[] = WINUI_PANE_RUNTIME_BOOTSTRAP_DLL;
+  if (!separator || size_t(separator + 1 - path) + std::size(bootstrap) >
+                        std::size(path)) {
+    return;
+  }
+  wcscpy(separator + 1, bootstrap);
+  // Fixed executable-relative location, as for the pane itself.
+  HMODULE module = LoadLibraryExW(path, nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR |
+                                      LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!module) {
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Warning,
+            ("runtime=unavailable bootstrapWin32Error=%lu", GetLastError()));
+    return;
+  }
+  using InitializeFn = HRESULT(WINAPI*)(UINT32, PCWSTR, PACKAGE_VERSION, UINT32);
+  auto initialize = reinterpret_cast<InitializeFn>(
+      GetProcAddress(module, "MddBootstrapInitialize2"));
+  PACKAGE_VERSION minimum{};
+  minimum.Version = WINUI_PANE_RUNTIME_MIN_VERSION;
+  // MddBootstrapInitializeOptions_OnPackageIdentity_NOOP.
+  constexpr UINT32 kNoopWhenPackaged = 0x0010;
+  HRESULT hr = initialize ? initialize(WINUI_PANE_RUNTIME_MAJOR_MINOR, L"",
+                                       minimum, kNoopWhenPackaged)
+                          : E_NOINTERFACE;
+  MOZ_LOG(sWinUIPrototypeLog,
+          SUCCEEDED(hr) ? LogLevel::Info : LogLevel::Warning,
+          ("runtime=bootstrap hr=0x%08lx", static_cast<unsigned long>(hr)));
+}
+
+bool TranslateWinUIPane(MSG& aMessage) {
+  return NS_IsMainThread() && !sPaneStopped && sPaneApi.translate &&
+         sPaneApi.translate(&aMessage);
+}
+
+void ShutdownWinUIPane() {
+  if (!NS_IsMainThread() || sPaneStopped) return;
+  sPaneStopped = true;
+  if (sPaneApi.shutdown) {
+    HRESULT hr = sPaneApi.shutdown();
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+            ("pane=shutdown hr=0x%08lx", hr));
+  }
+}
+
+static void WINAPI ProcessReply(void*,HWND proxy,HWND shell,uint32_t kind,HRESULT result) {
+  if(kind==4) {
+    MOZ_ASSERT(NS_IsMainThread());
+    if(auto* link=ProxyOf(proxy)) {
+      link->dropRetired=true;
+      RevokePageDrop(proxy,*link);
+      if(link->dropTarget) {
+        RefPtr<nsNativeDragTarget> target=link->dropTarget;
+        NS_DispatchToMainThread(NS_NewRunnableFunction("FennRetirePageDrag",[target] {
+          target->DragCancel();
+        }));
+      }
+    }
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction("FennProcessWindowReply",[proxy,shell,kind,result] {
+    if(sPaneStopped || !IsWindow(proxy))return;
+    HiddenProxy* link=ProxyOf(proxy);if(!link)return;
+    const uint32_t outcome=kind==3 && link->processPending?2:kind;
+    if(kind==5) {
+      SuspendIndependentPageIME(proxy);
+#ifdef ACCESSIBILITY
+      if(link->accessibility){link->accessibility->Disconnect();link->accessibility=nullptr;}
+#endif
+      link->shell=proxy;link->processPending=true;
+      SetPropW(proxy,kProxyShell,proxy);
+    } else if(kind==1 && SUCCEEDED(result)) {
+      if(FAILED(sPaneApi.bindIndependentEndpoint(shell,link->identity,proxy)))return;
+      if(link->processPending) {
+        link->shell=shell;link->processPending=false;link->dropRetired=false;
+        SetPropW(proxy,kProxyShell,shell);SetPropW(shell,kEndpointProperty,proxy);
+        WinUtils::SetNSWindowPtr(shell,reinterpret_cast<nsWindow*>(link->identity));
+        UpdatePageDrop(proxy,*link);
+        SyncFromShell(proxy,*link);
+        link->fromShell=true;ShowWindow(proxy,SW_HIDE);link->fromShell=false;
+        for(HWND child=FindWindowExW(proxy,nullptr,L"MozillaCompositorWindowClass",nullptr);child;) {
+          HWND next=FindWindowExW(proxy,child,L"MozillaCompositorWindowClass",nullptr);
+          SetCompositorParent(child,proxy);child=next;
+        }
+        for(WPARAM type:{WPARAM(ICON_BIG),WPARAM(ICON_SMALL)}) {
+          const auto icon=reinterpret_cast<HICON>(SendMessageW(proxy,WM_GETICON,type,0));
+          if(HICON copy=icon?CopyIcon(icon):nullptr)RequestShell(*link,WinUIPaneWindowIcon,reinterpret_cast<LONG_PTR>(copy),uint32_t(type));
+        }
+        EnsureIndependentAccessibility(proxy);
+        ResumeIndependentPageIME(proxy);
+      }
+    } else if((kind!=6 && kind!=8 && kind!=9) || FAILED(result)) {
+      SetEnvironmentVariableW(L"FENN_NATIVE_HOST_FAILED",L"1");
+      if(outcome==2 || outcome==7) {
+        RefPtr<nsNativeDragTarget> target=link->dropTarget;
+        if(outcome==7)reinterpret_cast<nsWindow*>(link->identity)->ArmFennStockRepaint();
+        ReleaseHiddenProxy(proxy);
+        if(target)RegisterDragDrop(proxy,target);
+        if(outcome==2)ShowWindow(proxy,SW_SHOWNORMAL);
+        SetWindowPos(proxy,nullptr,0,0,0,0,SWP_NOMOVE|SWP_NOSIZE|SWP_NOZORDER|SWP_NOACTIVATE|SWP_FRAMECHANGED);
+      } else {
+        ForgetIndependentPageIME(proxy);
+#ifdef ACCESSIBILITY
+        if(link->accessibility){link->accessibility->Disconnect();link->accessibility=nullptr;}
+#endif
+      }
+    }
+    if(nsCOMPtr<nsIObserverService> observers=services::GetObserverService()) {
+      nsAutoString data;data.AppendInt(outcome);data.Append(u':');data.Append(NS_ConvertUTF8toUTF16(EndpointName(proxy)));
+      data.Append(u':');data.Append(NS_ConvertUTF8toUTF16(EndpointName(shell)));
+      observers->NotifyObservers(nullptr,"fenn-process-window",data.get());
+    }
+    if(outcome==7) {
+      EnableWindow(proxy,TRUE);
+      ShowWindow(proxy,IsIconic(proxy)?SW_SHOWMINNOACTIVE:SW_SHOWNOACTIVATE);
+    }
+  }));
+}
+
+void TraceWinUIPrototype(const char* aPhase, HWND aWindow) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || !sTraceEnabled) return;
+  APTTYPE apartment = APTTYPE_CURRENT;
+  APTTYPEQUALIFIER qualifier = APTTYPEQUALIFIER_NONE;
+  const HRESULT hr = CoGetApartmentType(&apartment, &qualifier);
+  DWORD ownerProcess = 0;
+  DWORD ownerThread =
+      aWindow ? GetWindowThreadProcessId(aWindow, &ownerProcess) : 0;
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("phase=%s pid=%lu tid=%lu hwnd=%p ownerPid=%lu ownerTid=%lu "
+           "apartmentHr=0x%08lx apartment=%d qualifier=%d "
+           "windowing=%p frameworkUdk=%p xaml=%p",
+           aPhase, GetCurrentProcessId(), GetCurrentThreadId(), aWindow,
+           ownerProcess, ownerThread, static_cast<unsigned long>(hr),
+           static_cast<int>(apartment), static_cast<int>(qualifier),
+           GetModuleHandleW(L"Microsoft.UI.Windowing.dll"),
+           GetModuleHandleW(L"Microsoft.Internal.FrameworkUdk.dll"),
+           GetModuleHandleW(L"Microsoft.UI.Xaml.dll")));
+}
+}  // namespace mozilla::widget
