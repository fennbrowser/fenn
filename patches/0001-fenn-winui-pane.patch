+          badge:(node.querySelector('#translations-button-locale')?.textContent || '').slice(0,4096),
+          background:[0,0,0,0], foreground:(style.color.match(/[\d.]+/g)?.slice(0,3).map(value=>Math.round(Math.max(0,Math.min(255,Number(value)*(style.color.startsWith('color(srgb') ? 255 : 1))))) || [128,128,128]).concat(255), image:this.images.get(imageKey) || null});
