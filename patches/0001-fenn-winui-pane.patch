+  }
+
+  /** Mode UI removes an active autofill using Firefox's typed value. */
+  static modeEntryRestoresAutofill(hasPlaceholder, userTypedValue) {
+    return !!(hasPlaceholder && userTypedValue);
+  }
+
+  /** Final untrimmed value after mode UI policy, before result text is written. */
+  static modeEntryTypedValue({ untrimmedValue, pageProxyValid, hasAutofillPlaceholder,
+    userTypedValue }, normalizeTypedValue = value => value) {
+    if (pageProxyValid) return "";
+    return this.modeEntryRestoresAutofill(hasAutofillPlaceholder, userTypedValue)
+      ? normalizeTypedValue(userTypedValue) : untrimmedValue;
+  }
+
+  /** Firefox records only a changed, confirmed mode entry. */
+  static shouldRecordModeEntry(mode, modesAreSame) {
+    return !!mode && !mode.isPreview && !modesAreSame;
+  }
+
+  /** Read a copy; preview shadows confirmed state unless explicitly excluded. */
+  static readMode(modes, confirmedOnly = false) {
+    const mode = (!confirmedOnly && modes.preview) || modes.confirmed;
+    return mode ? { ...mode } : null;
+  }
+
+  /** Apply canonical mode facts to a caller-owned record, preserving its identity. */
+  static writeMode(modes, normalized) {
+    const mode = normalized ? { ...normalized } : null;
+    if (!mode) {
+      delete modes.preview;
+      delete modes.confirmed;
+    } else if (mode.isPreview) {
+      modes.preview = mode;
+    } else {
+      modes.confirmed = mode;
+      delete modes.preview;
+    }
+    return mode;
+  }
+
+  // Availability is explicit per-tab state. Preferences gate presentation but
+  // do not erase that state: a keyboard reveal survives until Firefox resets it.
+  static visibility({available, searchMode, isSearchbarSAP = false, smartbar = false}) {
+    const enabled = !smartbar && (isSearchbarSAP ||
+      UrlbarPrefs.get("searchModeSwitcher.featureGate") ||
+      UrlbarPrefs.get("scotchBonnet.enableOverride"));
+    const exit = !isSearchbarSAP && !!searchMode &&
+      !UrlbarPrefs.get("unifiedSearchButton.always");
+    return {enabled: !!enabled, exit,
+      modeButtonVisible: !!enabled && !!available,
+      modeExitVisible: !!enabled && !!available && exit};
+  }
+  /** Shared switcher eligibility, independent of menu construction. */
+  static availableModes(engines, sapName) {
+    const visible = engines.filter(engine => !engine.hideOneOffButton);
+    return sapName !== "urlbar" ? visible : visible.concat(UrlbarShared.LOCAL_SEARCH_MODES.filter(
+      mode => UrlbarPrefs.get("browser.settings-redesign.enabled") || UrlbarPrefs.get(mode.pref)));
+  }
+
+  static menuDisposition(where) {
+    return where.startsWith("tab") ? where : "current";
+  }
+
+  /** Describe a local/engine menu command with Firefox's page-text and modifier policy. */
+  static menuCommand(engine, { value, pageProxyValid }, { where = "current", shiftKey = false } = {}) {
+    const searchString = pageProxyValid ? "" : value;
