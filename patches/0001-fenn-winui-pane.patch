+      return Object.freeze({ kind: "query", value: engine.restrict + " " + searchString,
+        engineId: null, picked: "local_search" });
+    }
+    where = this.menuDisposition(where);
+    return Object.freeze({ kind: !shiftKey && where === "current" ? "query" : "navigation",
+      value: searchString, engineId: engine.id, where, inBackground: true,
+      picked: engine.isConfigEngine ? "builtin_search" : "addon_search" });
+  }
+
+  engines = [];
+  selectedIndex = 0;
+  #pendingInstalls = new Set();
+  #disposed = false;
+
+  // readState: {value, pageProxyValid, searchMode}; engineStore: Firefox's store;
+  // offeredEngines: current document's offers; installEngine: browser install;
+  // search/exit/openEngine/openPreferences: Firefox semantic commands;
+  // whereToOpenLink: Firefox modifier policy; recordPicked: SAP telemetry.
+  constructor(services) {
+    this.services = services;
+  }
+
+  dispose() {
+    this.#disposed = true;
+    for (const cleanup of this.#pendingInstalls) cleanup();
+  }
+
+  offeredEngines() {
+    return this.services.offeredEngines().slice(0, UrlbarSearchModeModel.MAX_OPENSEARCH_ENGINES);
+  }
+
+  searchString() {
+    const state = this.services.readState();
+    return state.pageProxyValid ? "" : state.value;
+  }
+
+  disposition(event) {
+    const where = this.services.whereToOpenLink(event);
+    // Shift requests a SERP, not a new window, in the mode switcher.
+    return UrlbarSearchModeModel.menuDisposition(where);
+  }
+
+  exit() {
+    this.services.exit();
+    this.selectedIndex = 0;
+    this.engines = [];
+  }
+
+  openPreferences() {
+    this.services.openPreferences();
+    this.services.recordPicked("settings");
+  }
+
+  localSearch(restrict, options = {}) {
+    const command = UrlbarSearchModeModel.menuCommand({ source: true, restrict }, this.services.readState());
+    this.services.search(command.value, { searchModeEntry: "searchbutton", ...options });
+    this.services.recordPicked(command.picked);
+  }
+
+  remoteSearch(engine, event, options = {}) {
+    const command = UrlbarSearchModeModel.menuCommand(engine, this.services.readState(), {
+      where: this.services.whereToOpenLink(event), shiftKey: event.shiftKey,
+    });
+    if (command.kind === "query") {
+      this.services.search(command.value, {
+        searchEngine: engine, searchModeEntry: "searchbutton", ...options,
+      });
+    } else {
+      this.services.openEngine(command.value, {
+        event, searchEngine: engine, where: command.where, inBackground: command.inBackground,
+      });
+    }
+    this.services.recordPicked(command.picked);
+    return command.kind;
+  }
+
+  async install(engine, options = {}, isCurrent = () => true) {
+    if (this.#disposed || !isCurrent()) return false;
+    const store = this.services.engineStore;
+    const cleanup = () => {
+      store.removeObserver(observer);
+      this.#pendingInstalls.delete(cleanup);
+    };
+    const observer = (_, newEngine) => {
+      if (this.#disposed || !isCurrent()) {
+        cleanup();
+        return;
+      }
+      try {
+        this.services.search(this.searchString(), {
+          searchEngine: newEngine, searchModeEntry: "searchbutton", ...options,
+        });
+      } finally {
+        cleanup();
+      }
+    };
+    this.#pendingInstalls.add(cleanup);
+    store.addObserver(observer);
+    this.services.recordPicked("addon_search");
+    try {
+      const added = await this.services.installEngine(engine);
+      if (!added || this.#disposed || !isCurrent()) cleanup();
+      return added && !this.#disposed;
+    } catch (error) {
+      cleanup();
+      throw error;
+    }
+  }
+
+  async activate(key, event, isCurrent, isContextCurrent = isCurrent) {
+    await this.populateEngines();
+    if (this.#disposed || !isCurrent()) return false;
+    const options = {focus: false, startQuery: false};
+    if (key.startsWith("install:")) {
+      const engine = this.offeredEngines().find(e => key == `install:${e.uri}`);
+      if (!engine) return false;
+      const added = await this.install(engine, options, isContextCurrent);
+      return added && isContextCurrent() ? "query" : false;
+    }
+    if (key == "settings") {
+      this.openPreferences();
+      return "settings";
+    }
+    if (key == "exit") {
+      this.exit();
+      return "query";
+    }
+    const engine = this.engines.find(item =>
+      key == (item.source ? `local:${item.restrict}` : `engine:${item.id}`));
+    if (!engine) return false;
+    if (engine.source) {
+      this.localSearch(engine.restrict, options);
+      return "query";
+    }
+    return this.remoteSearch(engine, event, options);
+  }
+
+  async populateEngines() {
+    let engines = [];
+    try {
+      await this.services.engineStore.init();
+      engines = this.services.engineStore.getEngines();
+    } catch {
+      // Search service failed but local modes remain available.
+    }
+    this.engines = UrlbarSearchModeModel.availableModes(engines, this.services.sapName);
+  }
+
+  async localLabel(source) {
+    let mode = UrlbarShared.LOCAL_SEARCH_MODES.find(m => m.source == source);
+    let [str] = await this.services.l10n.formatMessages([{ id: mode.uiLabel }]);
+    return str.value;
+  }
+
+  async displayedEngineDetails(searchMode = null) {
+    if (!searchMode || searchMode.engineName) {
+      try {
+        await this.services.engineStore.init();
+      } catch {
+        return { label: null, icon: UrlbarShared.ICON.SEARCH_GLASS };
+      }
+
+      let engine = searchMode
+        ? this.services.engineStore.getEngineByName(
+            searchMode.engineName
+          )
+        : this.services.engineStore.default;
+      if (!engine) {
+        return { label: null, icon: UrlbarShared.ICON.SEARCH_GLASS };
+      }
+      let icon = (await engine.getIconURL()) ?? UrlbarShared.ICON.SEARCH_GLASS;
+      return {
+        label: engine.name,
+        icon,
+        engine,
+      };
+    }
+
+    let mode = UrlbarShared.LOCAL_SEARCH_MODES.find(
+      m => m.source == searchMode.source
+    );
+    return {
+      label: await this.localLabel(searchMode.source),
+      icon: mode.icon,
+    };
+  }
+
+  async snapshot() {
+    await this.populateEngines();
+    const entries = await Promise.all(this.engines.map(async engine => ({
+      key: engine.source ? `local:${engine.restrict}` : `engine:${engine.id}`,
+      label: engine.source ? await this.localLabel(engine.source) : engine.name,
+      icon: engine.source ? null : await engine.getIconURL().catch(() => null),
+      symbol: engine.source ? UrlbarShared.getResultSourceName(engine.source) : "search",
+      local: !!engine.source,
+    })));
+    const offered = this.offeredEngines();
+    // The DOM inserts each offered engine after the same separator.
+    for (const engine of offered.toReversed()) {
+      entries.push({key:`install:${engine.uri}`, label:await this.services.l10n.formatValue(
+        "urlbar-searchmode-popup-add-engine", {engineName:engine.title}),
+        icon:engine.icon, symbol:"add", local:true});
+    }
+    const settingsId = UrlbarPrefs.get("browser.nova.enabled")
+      ? "urlbar-searchmode-popup-settings2" : "urlbar-searchmode-popup-search-settings2";
+    const [settings] = await this.services.l10n.formatMessages([{id: settingsId}]);
+    entries.push({key:"settings", label:settings.value || settings.attributes?.find(a => a.name == "label")?.value || "Settings", symbol:"settings", local:true});
+    const mode = this.services.readState().searchMode;
+    const displayed = await this.displayedEngineDetails(mode);
+    const [buttonMessage, exitMessage] = await this.services.l10n.formatMessages([
+      {id: displayed.label ? "urlbar-searchmode-button3" : "urlbar-searchmode-button-no-engine2", args:{engine:displayed.label || ""}},
+      {id:"urlbar-searchmode-exit-button2"},
+    ]);
+    const title = message => message.attributes?.find(a => a.name == "title")?.value || "";
+    return {buttonLabel:title(buttonMessage), exitLabel:title(exitMessage), entries, label:displayed.label || "Search", icon:(mode && !mode.engineName) || Object.values(UrlbarShared.ICON).includes(displayed.icon) ? null : displayed.icon,
+      symbol:mode && !mode.engineName ? UrlbarShared.getResultSourceName(mode.source) : "search",
+      active:!!mode};
+  }
+}
+
+/**
+ * Independent per-tab mode ownership. Keys are opaque tab identities; no input,
+ * browser state object, presenter or engine store is retained. Callers resolve
+ * live engines and own scope validation, persistence, telemetry and UI effects.
+ */
+export class UrlbarSearchModeState {
+  #tabs = new WeakMap();
+
+  get(tab, confirmedOnly = false) {
+    return UrlbarSearchModeModel.readMode(this.#tabs.get(tab) || {}, confirmedOnly);
+  }
+
+  set(tab, request, engine = null) {
+    const normalized = UrlbarSearchModeModel.normalizeMode(request, engine);
+    let modes = this.#tabs.get(tab);
+    if (!modes) {
+      modes = {};
+      this.#tabs.set(tab, modes);
+    }
+    UrlbarSearchModeModel.writeMode(modes, normalized);
+    return this.get(tab);
+  }
+
+  forget(tab) {
+    this.#tabs.delete(tab);
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarSearchModeBinding.mjs b/browser/components/urlbar/content/UrlbarSearchModeBinding.mjs
