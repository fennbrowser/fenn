+        this.invalidate();
+      }
+    }
+  }
+  activate(command, bounds, event) {
+    const contextMenu = command.startsWith('omni-menu:');
+    const id = command.slice(command.indexOf(':')+1);
+    const state = this.snapshot();
+    const live = [...state.omnibarLeft,...state.omnibarRight].find(item=>item.id === id);
