+  displayText(result, context) {
+    const descriptor = this.title(result);
+    const {showUrl, isVisitAction} = this.urlPresentation(result);
+    const title = descriptor?.text !== undefined ? {value:descriptor.text} :
+      result.getDisplayableValueAndHighlights("title", {tokens:context.tokens});
+    const url = showUrl ? result.getDisplayableValueAndHighlights("url", {tokens:context.tokens, isURL:true}) : {};
