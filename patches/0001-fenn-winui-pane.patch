+    const anchor = this.toolbar.menuAnchor(`omni:${id}`, bounds);
+    if (!anchor) return 2;
+    entry.pending = true;
+    entry.document = this.context();
+    entry.tab = this.window.gBrowser.selectedTab;
+    if (contextMenu) {
