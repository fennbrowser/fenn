@@ -0,0 +1,28 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/** Firefox typed-input bookkeeping over explicit text, without field or view. */
+export class UrlbarInputIdentity {
+  static typedValue(value) {
+    if (typeof value !== "string") throw new TypeError("Invalid typed input value");
+    return Object.freeze({ valueIsTyped: true, untrimmedValue: value,
+      protocolIsTrimmed: false, wwwIsTrimmed: false, resultForCurrentValue: null,
+      userTypedValue: value, userSelectionBehavior: "none" });
+  }
+
+  /** Compare displayed text, not a parsed URL or a connection/security claim. */
+  static invalidatesPageProxy(value, lastValidURL) {
+    if (typeof value !== "string") throw new TypeError("Invalid displayed input value");
+    return value != lastValidURL;
+  }
+
+  /** Effects for an actual observed edit; applying UI attributes remains host work. */
+  static describe(value, { pageProxyValid, lastValidURL } = {}) {
+    if (typeof pageProxyValid !== "boolean") throw new TypeError("Invalid page proxy observation");
+    const typed = this.typedValue(value);
+    const invalidatePageProxy = pageProxyValid && this.invalidatesPageProxy(value, lastValidURL);
+    return Object.freeze({ ...typed, userTyping: !!value, actionType: null,
+      pageProxyValid: pageProxyValid && !invalidatePageProxy, invalidatePageProxy });
+  }
+}
diff --git a/browser/components/urlbar/content/UrlbarBrowserState.mjs b/browser/components/urlbar/content/UrlbarBrowserState.mjs
new file mode 100644
index 0000000000..a756900c50
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarBrowserState.mjs
@@ -0,0 +1,168 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarSearchModeModel } from "chrome://browser/content/urlbar/UrlbarSearchModeModel.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  UrlbarSearchTermsPersistence: "moz-src:///browser/components/urlbar/UrlbarSearchTermsPersistence.sys.mjs",
+});
+
+/** Independent browser-lifetime mode/persistence state, separate from gURLBar.
+ * Prepared changes are invisible until committed. The browser controller must
+ * validate tab/document scope and host acknowledgment before commit. A controller
+ * closing does not erase committed per-tab state; browser collection releases it.
+ */
+export class UrlbarBrowserState {
+  #browsers = new WeakMap();
+
+  snapshot(browser) {
+    const state = this.#browsers.get(browser)?.state;
+    const copy = mode => mode ? Object.freeze({ ...mode }) : null;
+    return Object.freeze({ confirmed: copy(state?.searchModes?.confirmed),
+      preview: copy(state?.searchModes?.preview),
+      persistedSearchTerms: !!state?.persist?.shouldPersist,
+      searchTerms: state?.persist?.searchTerms ?? "" });
+  }
+
+  #prepare(browser, update) {
+    let slot = this.#browsers.get(browser);
+    if (!slot) {
+      slot = { state: { searchModes: {} }, pending: null };
+      this.#browsers.set(browser, slot);
+    }
+    const token = Object.freeze({});
+    slot.latest = token;
+    slot.pending = { token };
+    const draft = { ...slot.state, searchModes: { ...slot.state.searchModes } };
+    if (slot.state.persist) draft.persist = { ...slot.state.persist };
+    try {
+      const effects = Object.freeze(update(draft));
+      // Service callbacks must not revive a superseded preparation or forget.
+      if (this.#browsers.get(browser) !== slot || slot.pending?.token !== token) return null;
+      slot.pending = { token, draft };
+      return Object.freeze({ token, effects });
+    } catch (error) {
+      this.discard(browser, token);
+      throw error;
+    }
+  }
+
+  /** The caller supplies a mode already normalized against its live engine store. */
+  prepareMode(browser, normalized, requested = normalized) {
+    return this.#prepare(browser, state => {
+      const previous = UrlbarSearchModeModel.readMode(state.searchModes);
+      const modesAreSame = (!previous && !requested) || UrlbarShared.deepEqual(previous, requested);
+      const searchMode = UrlbarSearchModeModel.writeMode(state.searchModes, normalized);
+      const persistenceChanged = lazy.UrlbarSearchTermsPersistence.updateSearchModeState(state);
+      return { searchMode: searchMode ? Object.freeze({ ...searchMode }) : null, persistenceChanged,
+        persistedSearchTerms: !!state.persist?.shouldPersist,
+        recordModeEntry: UrlbarSearchModeModel.shouldRecordModeEntry(searchMode, modesAreSame) };
+    });
+  }
+
+  /** Capture read-only revision authority, revoked even by a later discarded preparation. */
+  captureRevision(browser) {
+    const slot = this.#browsers.get(browser), latest = slot?.latest;
+    if (slot?.pending) return null;
+    return () => this.#browsers.get(browser) === slot && slot?.latest === latest && !slot?.pending;
+  }
+
+  /** A background mode setter refreshes persistence on the selected source, preserving its modes. */
+  prepareModeNotification(browser, observedMode, persistedSearchTerms) {
+    const current = this.captureRevision(browser);
+    if (!current) return null;
+    const snapshot = this.snapshot(browser);
+    if (snapshot.persistedSearchTerms !== persistedSearchTerms ||
+        !UrlbarShared.deepEqual(snapshot.preview ?? snapshot.confirmed, observedMode) || !current()) return null;
+    return this.#prepare(browser, state => {
+      const persistenceChanged = lazy.UrlbarSearchTermsPersistence.updateSearchModeState(state);
+      const searchMode = UrlbarSearchModeModel.readMode(state.searchModes);
+      return { searchMode: searchMode ? Object.freeze({ ...searchMode }) : null,
+        persistenceChanged, persistedSearchTerms: !!state.persist?.shouldPersist };
+    });
+  }
+
+  /** Establish a continuation receipt without invoking a mode setter or its effects. */
+  preparePreservedMode(browser, observedMode) {
+    const snapshot = this.snapshot(browser);
+    if (!UrlbarShared.deepEqual(snapshot.preview ?? snapshot.confirmed, observedMode)) return null;
+    return this.#prepare(browser, state => ({
+      searchMode: observedMode ? Object.freeze({ ...observedMode }) : null,
+      persistedSearchTerms: !!state.persist?.shouldPersist,
+    }));
+  }
+
+  /** Closing an open preview clears the mode using the same setter policy. */
+  preparePreviewDismissal(browser, observedMode) {
+    if (observedMode?.isPreview !== true ||
+        !UrlbarShared.deepEqual(this.snapshot(browser).preview, observedMode)) return null;
+    return this.prepareMode(browser, null);
+  }
+
+  preparePersistence(browser, facts) {
+    return this.#prepare(browser, state => lazy.UrlbarSearchTermsPersistence.updateState(state, facts));
+  }
+
+  /** An observed edit preserves the active owned mode; it is not a mode setter. */
+  prepareEditInput(browser, value, observedMode) {
+    if (typeof value !== "string") throw new TypeError("Invalid browser input value");
+    const snapshot = this.snapshot(browser);
+    if (!UrlbarShared.deepEqual(snapshot.preview ?? snapshot.confirmed, observedMode)) return null;
+    return this.prepareInput(browser, value);
+  }
+
+  /** Prepare input effects without mutating browser text or the committed mode. */
+  prepareInput(browser, value) {
+    if (typeof value !== "string") throw new TypeError("Invalid browser input value");
+    return this.#prepare(browser, state => {
+      const persistenceChanged = lazy.UrlbarSearchTermsPersistence.updateInputState(state, value);
+      return { userTypedValue: value, persistenceChanged, persistedSearchTerms: !!state.persist?.shouldPersist };
+    });
+  }
+
+  prepareRecovery(browser, facts) {
+    return this.#prepare(browser, state => {
+      const wasPersisting = !!state.persist?.shouldPersist;
+      UrlbarSearchModeModel.writeMode(state.searchModes, null);
+      lazy.UrlbarSearchTermsPersistence.updateSearchModeState(state);
+      const effects = lazy.UrlbarSearchTermsPersistence.updateState(state, { ...facts,
+        userTypedValue: null, hideSearchTerms: true, dueToTabSwitch: true, isSameDocument: false });
+      return { ...effects, persistenceChanged: wasPersisting && !effects.shouldPersist };
+    });
+  }
+
+  isCurrent(browser, token) {
+    const pending = this.#browsers.get(browser)?.pending;
+    return !!pending?.draft && pending.token === token;
+  }
+
+  commit(browser, token) {
+    if (!this.isCurrent(browser, token)) return false;
+    const slot = this.#browsers.get(browser);
+    slot.state = slot.pending.draft;
+    slot.lastCommit = token;
+    slot.pending = null;
+    return true;
+  }
+
+  /** Later preparations revoke effect authority even if subsequently discarded. */
+  isCommitted(browser, token) {
+    const slot = this.#browsers.get(browser);
+    return !!slot && slot.lastCommit === token && slot.latest === token;
+  }
+
+  discard(browser, token) {
+    const slot = this.#browsers.get(browser);
+    if (!slot?.pending || slot.pending.token !== token) return false;
+    slot.pending = null;
+    return true;
+  }
+
+  forget(browser) { this.#browsers.delete(browser); }
+}
+
+// Shared by independent controllers, weakly keyed by actual browser objects.
+// Neither retained input state nor controller/session objects are stored here.
+export const independentUrlbarBrowserState = new UrlbarBrowserState();
diff --git a/browser/components/urlbar/content/UrlbarSelectedSearch.mjs b/browser/components/urlbar/content/UrlbarSelectedSearch.mjs
new file mode 100644
index 0000000000..f565507d28
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarSelectedSearch.mjs
@@ -0,0 +1,33 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarQueryModel } from "chrome://browser/content/urlbar/UrlbarQueryModel.mjs";
+
+const selectedSearchLazy = typeof ChromeUtils != "undefined" ? {} : null;
+if (selectedSearchLazy) {
+  ChromeUtils.defineESModuleGetters(selectedSearchLazy, {
+    QuickSuggest: "moz-src:///browser/components/urlbar/QuickSuggest.sys.mjs",
+    UrlbarTokenizer: "moz-src:///browser/components/urlbar/UrlbarTokenizer.sys.mjs",
+    UrlUtils: "resource://gre/modules/UrlUtils.sys.mjs",
+  });
+}
+
+/** Shared selected-search effect. The host captures live context; Firefox gates remote data. */
+export function querySelectedSearch(result, facts, makeContext, isCurrent = () => true) {
+  if (!isCurrent()) return false;
+  if (!UrlbarQueryModel.searchBackendEligible(result, facts)) return true;
+  const backend = selectedSearchLazy.QuickSuggest.getFeature("SuggestBackendMerino");
+  if (!backend?.isEnabled) return true;
+  const selection = (result.payload.suggestion || result.payload.query)?.trim();
+  // Even origins allowed as searches must not be disclosed by this effect.
+  if (!selection || selectedSearchLazy.UrlUtils.looksLikeOrigin(selection) !=
+      selectedSearchLazy.UrlUtils.LOOKS_LIKE_ORIGIN.NONE) return true;
+  // Rebuild around the selection, never reuse tokens from the typed query.
+  const context = makeContext(selection);
+  context.tokens = selectedSearchLazy.UrlbarTokenizer.tokenize(context);
+  if (!isCurrent()) return false;
+  // The backend retains allowRemoteResults() and its request/session policy.
+  backend.query(selection, { queryContext: context }).catch(console.error);
+  return true;
+}
diff --git a/browser/components/urlbar/content/UrlbarUrlValue.mjs b/browser/components/urlbar/content/UrlbarUrlValue.mjs
new file mode 100644
index 0000000000..56df21727b
--- /dev/null
+++ b/browser/components/urlbar/content/UrlbarUrlValue.mjs
@@ -0,0 +1,164 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarContentUtils } from "chrome://browser/content/urlbar/UrlbarContentUtils.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/** Shared trim decision; callers supply Firefox services and presentation facts. */
+export function trimDisplayValue(value, { trimURLs, trimURL, isTextDirectionRTL,
+  preserveMixedContentProtocol }) {
+  const trimmed = trimURLs ? trimURL(value) : value;
+  // Preserve the retained binding's short-circuit order.
+  return isTextDirectionRTL(trimmed) || preserveMixedContentProtocol(value)
+    ? value : trimmed;
+}
+
+/** Loaded-URI display policy shared by setURI and independent recovery descriptions. */
+export function loadedURIValue(getDisplaySpec, { hideInitialPage, isBlankPage,
+  isExtensionUrl = false, dueToSessionRestore = false }, decode = losslessDecodeDisplaySpec) {
+  let value = "";
+  if (!hideInitialPage) {
+    try { value = decode(getDisplaySpec()); }
+    catch { value = "about:blank"; }
+  }
+  return { value, valid: !dueToSessionRestore &&
+    (!isBlankPage || isExtensionUrl || !hideInitialPage) };
+}
+
+/** Firefox's HTTPS-First input classification, preserving case-sensitive policy. */
+export function isSchemelessInput(value) {
+  return ["http://", "https://", "file://"].every(
+    scheme => !value.trim().startsWith(scheme)
+  );
+}
+
+/**
+ * URL branch of result input text. Non-URL result text takes precedence in the
+ * caller. Decode may be supplied by a retained binding (Smartbar uses nsIURI).
+ * Facts describe browser/editor state, never an editor or presentation node.
+ */
+export function resultURLValue(result, {
+  urlOverride = null, userTypedValue, isAddressbar = false, isPrivate = false,
+} = {}, decode = losslessDecodeURL) {
+  if (urlOverride !== null) {
+    const url = URL.parse(urlOverride);
+    return url ? decode(url) : "";
+  }
+  const parsedUrl = URL.parse(result.payload.url);
+  if (!parsedUrl) return "";
+  const url = decode(parsedUrl);
+  const stripHttp = isAddressbar && result.heuristic &&
+    result.payload.url.startsWith("http://") && userTypedValue &&
+    isSchemelessInput(userTypedValue);
+  if (!stripHttp) return url;
+  // Preserve the full URL when stripping would turn the displayed value into
+  // a search. In particular, never downgrade a displayed https URL to http.
+  const trimmedUrl = UrlbarShared.stripPrefixAndTrim(url, { stripHttp })[0];
+  return UrlbarContentUtils.getFixupPrimitives(trimmedUrl, isPrivate)?.keywordAsSent
+    ? url : trimmedUrl;
+}
+
+/**
+ * Decodes the given URI for displaying it in the address bar without losing
+ * information, such that hitting Enter again will load the same URI.
+ *
+ * @param {string} displaySpec
+ *   The URI's display spec.
+ * @returns {string}
+ *   The decoded URI
+ */
+export function losslessDecodeDisplaySpec(displaySpec, scheme = displaySpec.slice(0, displaySpec.indexOf(":"))) {
+  let value = displaySpec;
+
+  // Try to decode as UTF-8 if there's no encoding sequence that we would break.
+  if (!/%25(?:3B|2F|3F|3A|40|26|3D|2B|24|2C|23)/i.test(value)) {
+    let decodeASCIIOnly = !["https", "http", "file", "ftp"].includes(scheme);
+    if (decodeASCIIOnly) {
+      // This only decodes ascii characters (hex) 20-7e, except 25 (%).
+      // This avoids both cases stipulated below (%-related issues, and \r, \n
+      // and \t, which would be %0d, %0a and %09, respectively) as well as any
+      // non-US-ascii characters.
+      value = value.replace(
+        /%(2[0-4]|2[6-9a-f]|[3-6][0-9a-f]|7[0-9a-e])/g,
+        decodeURI
+      );
+    } else {
+      try {
+        value = decodeURI(value)
+          // decodeURI decodes %25 to %, which creates unintended encoding
+          // sequences. Re-encode it, unless it's part of a sequence that
+          // survived decodeURI, i.e. one for:
+          // ';', '/', '?', ':', '@', '&', '=', '+', '$', ',', '#'
+          // (RFC 3987 section 3.2)
+          .replace(
+            /%(?!3B|2F|3F|3A|40|26|3D|2B|24|2C|23)/gi,
+            encodeURIComponent
+          );
+      } catch (e) {}
+    }
+  }
+
+  // IMPORTANT: The following regular expressions are Unicode-aware due to /v.
+  // Avoid matching high or low surrogate pairs directly, always work with
+  // full Unicode scalar values.
+
+  // Encode potentially invisible characters:
+  //   U+0000-001F: C0/C1 control characters
+  //   U+007F-009F: commands
+  //   U+00A0, U+1680, U+2000-200A, U+202F, U+205F, U+3000: other spaces
+  //   U+2028-2029: line and paragraph separators
+  //   U+2800: braille empty pattern
