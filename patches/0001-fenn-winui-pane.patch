+        return false;
+      const current = this.describe();
+      if (this.consumed || !this.sameStructure(current)) return false;
+      const index = current.rows.findIndex(r => r.id === event.id);
+      if (index < 0) return false;
+      const ungroup = event.ungroup === true;
+      if (ungroup && (!current.rows[index].groupSource ||
