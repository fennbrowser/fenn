+          (entry !== undefined && !UrlbarShared.SEARCH_MODE_ENTRY.has(entry))) {
+        pending.unsupported = true;
+      } else {
+        pending.search = Object.freeze({ value: call.value, engineName: engine?.name ?? null,
+          aliases: Object.freeze([...(engine?.aliases ?? [])].filter(alias => typeof alias === "string")),
