+      "moz-src:///browser/components/customizableui/CustomizableUI.sys.mjs");
+    const { ExtensionParent } = ChromeUtils.importESModule("resource://gre/modules/ExtensionParent.sys.mjs");
+    this.ui = CustomizableUI;
+    this.iconDetails = ExtensionParent.IconDetails;
+    this.invalidate = () => { if (!this.closed) toolbar.owner.invalidateAddress(); };
+    this.listener = {onWidgetAdded:this.invalidate, onWidgetRemoved:this.invalidate,
+      onWidgetMoved:this.invalidate, onWidgetAfterDOMChange:this.invalidate};
