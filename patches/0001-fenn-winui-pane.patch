diff --git a/browser/base/content/WinUIChromeLayout.sys.mjs b/browser/base/content/WinUIChromeLayout.sys.mjs
new file mode 100644
index 00000000000..7eb6bb931fd
--- /dev/null
+++ b/browser/base/content/WinUIChromeLayout.sys.mjs
@@ -0,0 +1,138 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const PREF = "fenn.winui.chrome.layout";
+const ATTRIBUTE = "winui-native-layout";
+const REGIONS = ["strip", "navigation", "content"];
+const FIELDS = ["x", "y", "width", "height"];
+
+// Native code allocates the rows and Gecko browser area. The DOM elements
+// consume those rectangles; they no longer reserve row heights in normal flow.
+// Firefox still owns page layout, browser controllers and fallback eligibility.
+export class WinUIChromeLayout {
+  constructor(window, owner) {
+    this.window = window;
+    this.owner = owner;
+    this.plan = null;
+    this.signature = "";
+    this.ready = false;
+    this.failed = false;
+    this.updating = false;
+    this.closed = false;
+    this.link = window.document.createElementNS("http://www.w3.org/1999/xhtml", "link");
+    this.link.rel = "stylesheet";
+    this.link.href = "chrome://browser/content/WinUIChromeLayout.css";
+    this.link.onload = () => { this.ready = true; owner.schedule(); };
+    window.document.documentElement.append(this.link);
+    this.preference = {observe: () => { this.failed = false; this.update(); owner.schedule(); }};
+    Services.prefs.addObserver(PREF, this.preference);
+    this.changed = () => { this.update(); owner.schedule(); };
+    this.bars = new window.MutationObserver(this.changed);
+    this.barResize = new window.ResizeObserver(this.changed);
+    for (const bar of window.document.querySelectorAll("#navigator-toolbox toolbar")) {
+      if (!["TabsToolbar", "nav-bar"].includes(bar.id)) this.barResize.observe(bar);
+    }
+    for (const id of ["toolbar-menubar", "PersonalToolbar"]) {
+      const bar = window.document.getElementById(id);
+      if (bar) this.bars.observe(bar, {attributes: true,
+        attributeFilter: ["hidden", "collapsed", "autohide", "inactive", "style", "class"]});
+    }
+    window.addEventListener("toolbarvisibilitychange", this.changed);
+  }
+
+  eligible() {
+    const {window, owner} = this;
+    const root = window.document.documentElement;
+    const toolbar = owner.addressToolbar;
+    if (!this.ready || this.closed || this.failed || owner.uninitializing ||
+        !Services.prefs.getBoolPref(PREF, false) || !owner.attached ||
+        !toolbar?.active || !toolbar.navigation || !toolbar.supported() ||
+        root.hasAttribute("mini-window") ||
+        !root.hasAttribute("winui-replaces-tabs") || !root.hasAttribute("winui-hides-nav-bar") ||
+        owner.stripVisibility().hidden || !owner.stripVisibility().replace) return false;
+    // Extra browser toolbars keep their existing layout. Their visibility is
+    // a fallback decision, never a second source of native row dimensions.
+    return !Array.from(window.document.querySelectorAll("#navigator-toolbox toolbar")).some(bar => {
+      if (["TabsToolbar", "nav-bar"].includes(bar.id)) return false;
+      const style = window.getComputedStyle(bar);
+      return !bar.hidden && !bar.collapsed && style.display !== "none" &&
+        style.visibility === "visible" && bar.getBoundingClientRect().height > 0;
+    });
+  }
+
+  update() {
+    if (this.updating || this.closed) return this.plan;
+    this.updating = true;
+    try {
+      if (!this.eligible()) { this.reset(); return null; }
+      const {window, owner} = this;
+      const root = window.document.documentElement;
+      const requested = Services.prefs.getIntPref(owner.stripHeightPref, 40);
+      const height = [32, 40, 48].includes(requested) ? requested : 40;
+      const frame = window.getComputedStyle(root).getPropertyValue("--winui-content-frame").trim();
+      const inset = frame ? Number(frame.replace(/px$/, "")) : 4;
+      if (!Number.isInteger(inset) || inset < 0 || inset > 32) { this.reset(); return null; }
+      let values;
+      try { values = window.windowUtils.getWinUIChromeLayout(height, true, inset); }
+      catch { this.reset(); return null; } // Includes minimized/insufficient space.
+      if (!Array.isArray(values) || values.length !== 12 ||
+          values.some(value => !Number.isFinite(value) || Math.abs(value) > 100000)) {
+        this.reset(); return null;
+      }
+      const plan = {};
+      for (const [index, region] of REGIONS.entries()) {
+        const [x, y, width, height] = values.slice(index * 4, index * 4 + 4);
+        if (width <= 0 || height <= 0) { this.reset(); return null; }
+        plan[region] = {x, y, width, height, left:x, top:y, right:x + width, bottom:y + height};
+      }
+      const signature = values.join(",");
+      if (signature === this.signature) return this.plan;
+      // Attach/place both native surfaces before taking the DOM reservations
+      // out of flow. Focus and publication identities remain with their owners.
+      const s = plan.strip, n = plan.navigation;
+      let accepted = false;
+      try {
+        accepted = window.windowUtils.updateWinUIPane(s.x, s.y, s.width, s.height, true, false, false, owner.occlusions(s)) &&
+          window.windowUtils.updateWinUIAddress(n.x, n.y, n.width, n.height, true, false, false);
+      } catch {}
+      if (!accepted) {
+        this.failed = true; // Retry only on explicit preference change/recreation.
+        this.reset(); owner.schedule(); return null;
+      }
+      if (this.closed || owner.uninitializing || !owner.attached) { this.reset(); return null; }
+      for (const region of REGIONS) {
+        for (const field of FIELDS) root.style.setProperty(`--winui-layout-${region}-${field}`, `${plan[region][field]}px`);
+      }
+      this.plan = plan;
+      this.signature = signature;
+      root.setAttribute(ATTRIBUTE, "");
+      return plan;
+    } finally { this.updating = false; }
+  }
+
+  reset() {
+    if (!this.plan) return;
+    const root = this.window.document.documentElement;
+    this.plan = null;
+    this.signature = "";
+    root.removeAttribute(ATTRIBUTE);
+    for (const region of REGIONS) {
+      for (const field of FIELDS) root.style.removeProperty(`--winui-layout-${region}-${field}`);
+    }
+    // Restore native bounds from the original DOM geometry on the existing
+    // event-driven path. uninit's guard suppresses scheduling during teardown.
+    this.owner.schedule();
+  }
+
+  close() {
+    this.closed = true;
+    this.reset();
+    this.link.onload = null;
+    this.link.remove();
+    this.bars.disconnect();
+    this.barResize.disconnect();
+    this.window.removeEventListener("toolbarvisibilitychange", this.changed);
+    Services.prefs.removeObserver(PREF, this.preference);
+  }
+}
diff --git a/browser/base/content/WinUIChromeLayout.css b/browser/base/content/WinUIChromeLayout.css
new file mode 100644
index 00000000000..8dc7fe66a43
--- /dev/null
+++ b/browser/base/content/WinUIChromeLayout.css
@@ -0,0 +1,51 @@
+/* Native allocations are the only dimensions for these three regions.
+   The two retained row elements are focus/popup anchors, not reservations. */
+:root[winui-native-layout] #winui-prototype-pane {
+  position: fixed !important;
+  inset: auto !important;
+  margin: 0 !important;
+  min-height: 0 !important;
+  left: var(--winui-layout-strip-x) !important;
+  top: var(--winui-layout-strip-y) !important;
+  width: var(--winui-layout-strip-width) !important;
+  height: var(--winui-layout-strip-height) !important;
+}
+:root[winui-native-layout] #winui-navigation-toolbar:not([hidden]) {
+  position: fixed !important;
+  inset: auto !important;
+  margin: 0 !important;
+  min-block-size: 0 !important;
+  left: var(--winui-layout-navigation-x) !important;
+  top: var(--winui-layout-navigation-y) !important;
+  width: var(--winui-layout-navigation-width) !important;
+  height: var(--winui-layout-navigation-height) !important;
+}
+:root[winui-native-layout] #browser {
+  position: fixed !important;
+  inset: auto !important;
+  box-sizing: border-box !important;
+  margin: 0 !important;
+  padding: 0 !important;
+  min-width: 0 !important;
+  min-height: 0 !important;
+  left: var(--winui-layout-content-x) !important;
+  top: var(--winui-layout-content-y) !important;
+  width: var(--winui-layout-content-width) !important;
+  height: var(--winui-layout-content-height) !important;
+}
+
+/* The process shell owns the material outside these allocated browser bounds.
+   Keep Gecko's page clipping and viewport, but do not paint a second window
+   surround over the WinUI backdrop. Stock/unsupported layouts are unchanged. */
