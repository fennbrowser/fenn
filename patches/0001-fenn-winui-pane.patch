+    if (!entry || !row || revision<entry.issued || this.consumed.has(id)) return 2;
+    const prerequisite=JSON.stringify([entry.command,entry.command==="downloadsCmd_pauseResume" ? entry.download.stopped : null,
+      ["downloadsCmd_open","downloadsCmd_show"].includes(entry.command) ? entry.download.target.path : null]);
+    if(prerequisite!==entry.prerequisite)return 2;
+    const shell = this.shell(row);
+    // Revalidate the live object and exact command immediately before dispatch.
+    if (!shell.isCommandEnabled(entry.command) || (entry.command === "downloadsCmd_open" && !entry.download.succeeded)) return 2;
+    if (["downloadsCmd_open","downloadsCmd_show"].includes(entry.command) && entry.download.target.path) {
