+    }
+    const trigger = new this.window.MouseEvent("command", {bubbles:true, cancelable:true,
+      button:0, ctrlKey:event.ctrlKey, shiftKey:event.shiftKey, altKey:event.altKey, metaKey:event.metaKey});
