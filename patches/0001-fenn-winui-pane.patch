+    const widgets = palette ? [...new Set([ui.AREA_NAVBAR,ui.AREA_FIXED_OVERFLOW_PANEL,ui.AREA_ADDONS].flatMap(area=>ui.getWidgetIdsInArea(area)))] : ui.getWidgetIdsInArea(ui.AREA_NAVBAR);
