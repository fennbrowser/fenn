+    const left = ['trust-icon-container', 'tracking-protection-icon-container', 'identity-icon-box', 'identity-permission-box']
+      .map(id => document.getElementById(id));
+    // Notification indicators and extension page actions are dynamic Firefox children.
+    left.push(...document.querySelectorAll('#identity-permission-box .sharing-icon, #identity-permission-box .blocked-permission-icon, #notification-popup-box > [role="button"]'));
