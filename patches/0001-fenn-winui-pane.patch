index 00000000000..1dbff3ea703
--- /dev/null
+++ b/browser/base/content/WinUIPrivacyPanels.sys.mjs
@@ -0,0 +1,106 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Two bounded confirmation presentations. Clearing, window closure, private
+// session reset, preferences and notifications remain Firefox operations.
+export class WinUIPrivacyPanels {
+  constructor(toolbar) {
+    this.toolbar=toolbar;this.window=toolbar.window;
+    this.panels=[{kind:1,key:"forgetPanel",widget:"panic-button",session:0,lastSession:0},
+      {kind:2,key:"clearPrivatePanel",widget:"reset-pbm-toolbar-button",session:0,lastSession:0}];
+    this.changed=()=>{this.l10n=null;this.dismissAll();};
+    this.prefs=["privacy.panicButton.enabled","browser.privatebrowsing.resetPBM.enabled","browser.privatebrowsing.resetPBM.showConfirmationDialog"];
+    for(const pref of this.prefs)Services.prefs.addObserver(pref,this.changed);
+    Services.obs.addObserver(this.changed,"intl:app-locales-changed");
+  }
+  close(){if(this.closed)return;this.closed=true;this.dismissAll();for(const pref of this.prefs)Services.prefs.removeObserver(pref,this.changed);Services.obs.removeObserver(this.changed,"intl:app-locales-changed");}
+  dismiss(p){if(!p.session)return;p.closed=p.session;p.session=0;p.description=p.context=p.sourceNode=null;this.toolbar.owner.invalidateAddress();}
+  dismissAll(){for(const p of this.panels)this.dismiss(p);}
+  source(p){
+    const t=this.toolbar,c=t.customization,w=this.window;
+    if(this.closed || this.busy || !t.active || !t.navigation || !t.supported() || c?.editorOpen || w.gDialogBox?.isOpen)return null;
+    if(!Services.prefs.getBoolPref(p.kind===1?this.prefs[0]:this.prefs[1],false))return null;
+    if(p.kind===2 && !w.PrivateBrowsingUtils.isWindowPrivate(w))return null;
+    const node=c?.ui.getWidget(p.widget)?.forWindow(w)?.node,entry=c?.entries.get(p.widget);
+    const item=c?.current?.items.find(row=>row.id===entry?.id);
+    const part=p.kind===1?item?.stock?.find(row=>row.id===p.widget):this.navigation?.["reset-pbm"];
+    return node && node===entry?.node && item?.placed && part?.enabled && (p.kind!==1 || part.shown) &&
+      !c.nativeOverflow.has(p.widget) ? {node,label:String(part.label).slice(0,512)} : null;
+  }
+  live(p){
+    const t=this.toolbar,w=this.window;
+    return !!this.source(p) && t.owner.addressSession?.sessionId===p.context?.session &&
+      t.owner.addressTab===p.context?.tab && t.owner.addressDocument===p.context?.document &&
+      t.owner.addressTab===w.gBrowser.selectedTab && t.owner.addressDocument===w.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+  }
+  snapshot(navigation){
+    this.navigation=navigation;
+    return Object.fromEntries(this.panels.map(p=>{
+      const source=this.source(p);
+      if(p.session && (!this.live(p) || source.node!==p.sourceNode || (p.description && source.label!==p.description.sourceLabel)))this.dismiss(p);
+      return [p.key,{enabled:!!source,closed:p.closed || 0,...(p.description || {})}];
+    }));
+  }
+  label(id,attribute){
+    this.l10n ??= new this.window.Localization(["branding/brand.ftl","browser/browser.ftl","browser/panicButton.ftl"],true);
+    const [message]=this.l10n.formatMessagesSync([{id}]);
+    return String(message?.attributes?.find(a=>a.name===attribute)?.value ?? message?.value ?? "").replace(/<\/?strong>/g,"").slice(0,2048);
+  }
+  controllers(){
+    const {CustomizableWidgets}=ChromeUtils.importESModule("moz-src:///browser/components/customizableui/CustomizableWidgets.sys.mjs");
+    const {ResetPBMPanel}=ChromeUtils.importESModule("moz-src:///browser/components/privatebrowsing/ResetPBMPanel.sys.mjs");
+    return {forget:CustomizableWidgets.find(widget=>widget.id==="panic-button"),reset:ResetPBMPanel};
+  }
+  perform(kind,choice,remember){
+    if(this.busy || this.closed)return;
+    this.busy=true;this.dismissAll();this.toolbar.owner.invalidateAddress();
+    try {
+      const {forget,reset}=this.controllers();
+      const operation=kind===1 ? forget.forgetWindow(this.window,[5,2,6][choice-1]) :
+        reset.restartFromToolbar(this.window,{confirmed:choice!==0,alwaysAsk:remember});
+      Promise.resolve(operation).catch(console.error).finally(()=>{this.busy=false;if(!this.closed)this.toolbar.owner.invalidateAddress();});
+    } catch(error){this.busy=false;if(!this.closed)this.toolbar.owner.invalidateAddress();console.error(error);}
+  }
+  open(p,session){
+    this.dismissAll();p.session=session;p.sourceNode=this.source(p)?.node;
+    const t=this.toolbar;
+    p.context={session:t.owner.addressSession?.sessionId,tab:t.owner.addressTab,document:t.owner.addressDocument};
+    if(!this.live(p)){this.dismiss(p);return;}
+    if(p.kind===2 && !Services.prefs.getBoolPref(this.prefs[2],true)){
+      this.dismiss(p);this.perform(2,0,false);return;
+    }
+    const sourceLabel=this.source(p).label;
+    const common={session,revision:1,sourceLabel,cancel:this.label("reset-pbm-panel-cancel-button","label"),remember:true};
+    p.description=p.kind===1 ? {...common,title:sourceLabel,
+      group:this.label("panic-main-timeframe-desc"),
+      options:["panic-button-5min","panic-button-2hr","panic-button-day"].map((id,index)=>({id:index+1,label:this.label(id,"label").slice(0,512)})),
+      body:["panic-button-action-desc","panic-button-delete-tabs-and-windows","panic-button-delete-cookies","panic-button-delete-history","panic-button-open-new-window"].map(id=>this.label(id)).join("\n"),
+      warning:this.label("panic-button-undo-warning"),checkbox:"",confirm:this.label("panic-button-forget-button","label")} :
+      {...common,title:this.label("reset-pbm-panel-heading2"),group:"",options:[],
+      body:this.label("reset-pbm-panel-description2"),warning:"",checkbox:this.label("reset-pbm-panel-always-ask-checkbox","label"),confirm:this.label("reset-pbm-panel-confirm-button2","label")};
+    if(p.kind===2)Glean.privateBrowsingResetPbm.confirmPanel.record({action:"show",reason:"toolbar-btn"});
+    t.owner.invalidateAddress();
+  }
+  execute(action){
+    const match=/^privacy-panel:(open|dismiss|cancel|confirm):([12]):([1-9][0-9]*)(?::([1-9][0-9]*):([0-3]):([01]))?$/.exec(action.command);
+    if(!match)return 2;
+    const p=this.panels[Number(match[2])-1],session=Number(match[3]);
+    if(session>0xffffffff)return 2;
+    if(match[1]!=="dismiss" && match[1]!=="cancel")this.toolbar.navigationState();
+    if(match[1]==="open"){
+      if(match[4] || session<=p.lastSession || !this.source(p) || !this.toolbar.menuAnchor("privacy-panel-"+p.kind,action))return 2;
+      p.lastSession=session;this.open(p,session);return 1;
+    }
+    if(session!==p.session)return 2;
+    if(match[1]==="dismiss" || match[1]==="cancel"){
+      if(match[4])return 2;
+      if(match[1]==="cancel" && p.kind===2)Glean.privateBrowsingResetPbm.confirmPanel.record({action:"hide",reason:"cancel-btn"});
+      this.dismiss(p);return 1;
+    }
+    const choice=Number(match[5]),remember=match[6]==="1";
+    if(!this.live(p) || p.sourceNode!==this.source(p).node || Number(match[4])!==p.description?.revision ||
+      (p.kind===1 ? ![1,2,3].includes(choice) : choice!==0))return 2;
+    this.dismiss(p);this.perform(p.kind,p.kind===2?1:choice,remember);return 1;
+  }
+}
