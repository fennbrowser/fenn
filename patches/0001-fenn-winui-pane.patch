diff --git a/widget/windows/WinUIAccessibleRoot.h b/widget/windows/WinUIAccessibleRoot.h
new file mode 100644
index 00000000000..7e675fd1ba6
--- /dev/null
+++ b/widget/windows/WinUIAccessibleRoot.h
@@ -0,0 +1,192 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef mozilla_widget_WinUIAccessibleRoot_h
+#define mozilla_widget_WinUIAccessibleRoot_h
+
+#ifdef ACCESSIBILITY
+#include <atomic>
+#include <uiautomation.h>
+#include "mozilla/a11y/LazyInstantiator.h"
+#include "mozilla/a11y/Compatibility.h"
+#include "mozilla/RefPtr.h"
+#include "mozilla/Logging.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla::widget {
+inline LazyLogModule sWinUIAccessibilityLog("WinUIAccessibility");
+// The HWND thread answers WM_GETOBJECT using this agile identity. Semantic
+// requests run on UIA/COM client threads and use normal COM marshaling to the
+// Gecko STA. Never synchronously ask Gecko for information on the HWND thread:
+// Gecko can itself be waiting for a native pane publication to finish.
+class WinUIAccessibleRoot final : public IRawElementProviderSimple,
+                                  public IRawElementProviderFragment,
+                                  public IRawElementProviderFragmentRoot {
+ public:
+  // window is the visible shell; widget is the hidden window Gecko's accessibility tree belongs to.
+  WinUIAccessibleRoot(HWND window, HWND widget) : mShell(window), mWidget(widget) {}
+  HRESULT Initialize() {
+    MOZ_ASSERT(NS_IsMainThread());
+    HRESULT hr=CoCreateFreeThreadedMarshaler(
+        static_cast<IRawElementProviderSimple*>(this),getter_AddRefs(mMarshaler));
+    if (FAILED(hr)) return hr;
+    hr=CoCreateInstance(CLSID_StdGlobalInterfaceTable,nullptr,CLSCTX_INPROC_SERVER,
+        IID_IGlobalInterfaceTable,getter_AddRefs(mGit));
+    if (FAILED(hr)) return hr;
+    RefPtr<IRawElementProviderSimple> uia=a11y::LazyInstantiator::GetRootUia(mWidget);
+    if (!uia) return a11y::Compatibility::IsUiaEnabled() ? E_PENDING : S_FALSE;
+    DWORD cookie=0;
+    hr=mGit->RegisterInterfaceInGlobal(uia,__uuidof(IRawElementProviderSimple),&cookie);
+    if (FAILED(hr)) return hr;
+    mUia=cookie;
+    mSupportsUia=true;
+    Trace("initialize");
+    MOZ_LOG(sWinUIAccessibilityLog,LogLevel::Debug,("Root=%p backend=%p",this,uia.get()));
+    a11y::LazyInstantiator::EnableBlindAggregation(mWidget);
+    return S_OK;
+  }
+  void Disconnect() {
+    MOZ_ASSERT(NS_IsMainThread());
+    Trace("disconnect");
