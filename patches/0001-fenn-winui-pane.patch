+      if (ids.length > 55 || new Set(ids).size !== ids.length) return 2;
+      const widgets = [];
+      for (const id of ids) {
+        const item = this.current.items.find(item => item.id === id && item.canAutoOverflow);
+        const entry = [...this.entries.values()].find(entry => entry.id === id);
+        if (!item || !entry) return 2;
+        widgets.push(entry.widget);
+      }
+      this.nativeOverflow = new Set(widgets);
+      this.toolbar.window.document.getElementById('nav-bar').overflowable.setNativeOverflow(widgets);
+      this.invalidate();
+      return 1;
+    }
+    const global = /^customize:([0-9]+):(reset|undo-reset)$/.exec(command);
+    if (global) {
+      this.toolbar.navigationState();
+      const [,revision,verb] = global;
+      if (!actionStampMatches(readActionStamp(revision), this.current.revision) || !this.editorOpen ||
+          !(verb === 'reset' ? this.current.canReset : this.current.canUndoReset)) return 2;
+      this.resetting = true;
+      try {
+        if (verb === 'reset') { this.ui.reset(); this.ownsReset = true; }
+        else { this.ui.undoReset(); this.ownsReset = false; }
+      } finally { this.resetting = false; this.invalidate(); }
+      return 1;
+    }
+    const match=/^customize:([0-9]+):(widget-[0-9]+):(before|end|remove|add|overflow|insert)(?::(widget-[0-9]+))?$/.exec(command);
+    if (!match || this.toolbar.window.gDialogBox?.isOpen) return 2;
+    this.toolbar.navigationState();
+    const [,revision,id,verb,targetId]=match, state=this.current;
+    if (!actionStampMatches(readActionStamp(revision), state.revision)) return 2;
+    const item=state.items.find(i=>i.id===id), entry=[...this.entries.values()].find(i=>i.id===id);
+    if (!item || !entry || !item.movable) return 2;
+    const {ui}=this;
+    if (verb==='insert') {
+      if (!this.editorOpen || item.placed) return 2;
+      let position=ui.getWidgetIdsInArea(ui.AREA_NAVBAR).length;
+      if (targetId) {
+        const target=state.items.find(i=>i.id===targetId && i.placed);
+        if (!target || target.id===id) return 2;
+        position=target.position;
+      }
+      ui.addWidgetToArea(entry.widget,ui.AREA_NAVBAR,position);
+    } else if (verb==='overflow') {
+      if (!item.canOverflow || targetId) return 2;
+      ui.addWidgetToArea(entry.widget,ui.AREA_FIXED_OVERFLOW_PANEL);
+    } else if (verb==='remove') {
+      if (!item.placed || !item.removable || targetId) return 2;
