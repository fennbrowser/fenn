+    const label=String(t.owner.localization().formatValueSync("winui-overflow-more-tools")).slice(0,512);
+    this.actions.set(61,{kind:"original"});items.push({id:61,key:"more",label,enabled:true,checked:false,checkable:false});
+    this.description={session,revision:1,label:String(this.navigation.overflow.label).slice(0,512),items};t.owner.invalidateAddress();
+  }
+  execute(action){
+    const match=/^overflow-menu:(open|dismiss|invoke):([1-9][0-9]*)(?::([1-9][0-9]*):([1-9][0-9]*))?$/.exec(action.command);
+    if(!match)return 2;
+    const session=Number(match[2]);if(!Number.isInteger(session) || session>0xffffffff)return 2;
+    if(match[1]==="open"){
+      const t=this.toolbar;
+      if(this.closed || match[3] || session<=this.lastSession || t.customization?.editorOpen || this.window.gDialogBox?.isOpen || !t.menuAnchor("overflow",action))return 2;
