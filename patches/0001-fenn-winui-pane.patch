+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { UrlbarSearchModeModel } from "chrome://browser/content/urlbar/UrlbarSearchModeModel.mjs";
+import UrlbarPrefs from "chrome://browser/content/urlbar/UrlbarContentPrefs.mjs";
+import { UrlbarCompositionModel } from "chrome://browser/content/urlbar/UrlbarCompositionModel.mjs";
+import { UrlbarInputIdentity } from "chrome://browser/content/urlbar/UrlbarInputIdentity.mjs";
+import { UrlbarQueryModel } from "chrome://browser/content/urlbar/UrlbarQueryModel.mjs";
+import { UrlbarQuerySession } from "chrome://browser/content/urlbar/UrlbarQuerySession.mjs";
+import { UrlbarAutofillModel } from "chrome://browser/content/urlbar/UrlbarAutofillModel.mjs";
+import { UrlbarResultPresentation } from "chrome://browser/content/urlbar/UrlbarResultPresentation.mjs";
+import { resultURLValue } from "chrome://browser/content/urlbar/UrlbarUrlValue.mjs";
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+/**
+ * Independent editor-to-query binding. Owns observed text/selection, not a DOM
+ * editor or a second result store. Host revisions describe committed editor
+ * snapshots; completion proposals never mutate that observed state. The host
+ * validates a one-use token before a write and acknowledges its exact observed
+ * text/selection afterward. Acknowledgment never starts a query.
+ * Explicit keep-open composition can query and expose rows without activating them.
+ * Result-mode writes have an exact host acknowledgment, but mode persistence,
+ * browser effects, undo and activation remain host work. Mode requery is an
+ * explicit one-use step after acknowledgment, never an implicit text-edit query.
+ * In particular, this is not a navigation controller.
+ */
+export class UrlbarEditSession {
+  static #oneOffDestinations = new WeakMap();
+  static #oneOffDeselections = new WeakMap();
+  #context;
+  #oneOffDestinationQuery = null;
+  #queries;
+  #isPrivate;
+  #typedText = "";
+  #presentation = new UrlbarResultPresentation(null);
+  #isCurrent;
+  #onUpdate;
+  #edit = null;
+  #inputState = null;
+  #inputPresentation = null;
+  #inputPresentationState = null;
+  #inputPopupClose = null;
+  #previewCloseReady = null;
+  #committingPreviewClose = null;
+  #identityEdit = null;
+  #identityRequest = null;
+  #identityState = null;
+  #compositionPresentation = null;
+  #compositionStart = null;
+  #compositionHistory = null;
+  #compositionEnd = null;
+  #compositionReopen = null;
+  #reopeningComposition = null;
+  #compositionStateReady = null;
+  #committingComposition = null;
+  #closed = false;
+  #completion = null;
+  #finishedPresentation = null;
+  #finishedPresentationState = null;
+  #oneOffCommand = null;
+  #oneOffModeApplication = null;
+  #oneOffModeStateReady = null;
+  #oneOffRequery = null;
+  #oneOffTabContinuation = null;
+  #oneOffForegroundSource = null;
+  #oneOffBackgroundSource = null;
+  #autofill = null;
+  #placeholder = null;
+  #closeRequest = null;
+  #closeRecordingReady = null;
+  #recordingClose = null;
+  #selectionRequest = null;
+  #resultPreview = null;
+  #modeApplication = null;
+  #modeRequery = null;
+  #modeStateReady = null;
+  #aliasModeActivation = null;
+  #externalNavigationActivation = null;
+  #committingModeState = null;
+  #searchCommandRequery = null;
+  #searchCommandRequest = null;
+  #modeRestoreRequest = null;
+  #modeExitRequest = null;
+  #modeExitRequery = null;
+  #searchMode = null;
+  #navigationWrite = null;
+  #navigationReady = null;
+  #navigationRecovery = null;
+  #navigationActivation = null;
+  #selectionGeneration = 0;
+  #activationSelecting = null;
+  #hiddenResults = null;
+  #onPresentationRequest;
+  #restartRequest = null;
+  #onModeStateChanged;
+
+  constructor({ context, isCurrent, onUpdate, onPresentationRequest = null, onModeStateChanged = null }) {
+    if (typeof onUpdate != "function") throw new TypeError("Missing editor listener");
+    if (onPresentationRequest !== null && typeof onPresentationRequest != "function") {
+      throw new TypeError("Invalid editor presentation listener");
+    }
+    if (onModeStateChanged !== null && typeof onModeStateChanged !== "function") {
+      throw new TypeError("Invalid mode-state listener");
+    }
+    this.#context = Object.freeze({ ...context });
+    this.#onModeStateChanged = onModeStateChanged;
+    this.#isCurrent = isCurrent;
+    this.#onUpdate = onUpdate;
+    this.#onPresentationRequest = onPresentationRequest;
+    this.#queries = new UrlbarQuerySession({ context, isCurrent,
+      onPresentationRequest: request => this.#requestPresentation(request) });
+    this.#isPrivate = context.isPrivate;
+  }
+
+  get snapshot() { return this.#edit; }
+
+  /** Last observed edit's committed browser effects; no write/dispatch authority. */
+  get inputState() { return this.#inputState; }
+
+  /** Required host effects for the exact observed edit; this is not an acknowledgment. */
+  get inputPresentation() {
+    if (this.#closed) return null;
+    if (!this.#isCurrent()) { this.close(); return null; }
+    return this.#inputPresentation?.edit === this.#edit &&
+      this.#inputPresentation.searchMode === this.#searchMode ? this.#inputPresentation : null;
+  }
+
+  /** Validate immediately before applying host popup effects. */
+  getInputPresentation(token) {
+    const request = this.inputPresentation;
+    return request?.token === token ? request : null;
+  }
+
+  /** Record observed host effects once, without repeating browser commits or queries. */
+  acknowledgeInputPresentation(token, observation) {
+    const request = this.getInputPresentation(token);
+    if (!request || !observation) return false;
+    const { rollupCompleted, resultsCleared, open, accessibleFocusCleared } = observation;
+    const editKeys = ["text", "selectionStart", "selectionEnd", "selectionDirection", "composing"];
+    if (editKeys.some(key => observation[key] !== request.edit[key]) || typeof open !== "boolean" ||
+        (request.rollupPopups && rollupCompleted !== true) ||
+        (request.clearResults && resultsCleared !== true) ||
+        (request.close && open !== false) ||
+        (request.removeAccessibleFocus && accessibleFocusCleared !== true) ||
+        this.getInputPresentation(token) !== request) return false;
+    this.#inputPresentation = null;
+    // Keep the immutable request, never caller-owned observations.
+    this.#inputPresentationState = request;
+    this.#inputPopupClose = request.close && request.searchMode?.isPreview ? request : null;
+    if (request.close) this.#closeRecordingReady = request;
+    return true;
+  }
+
+  /** Consume acknowledged preview-close browser effects once; never requery. */
+  commitInputPopupClose(token, { userTypedValue, persistedSearchTerms } = {}) {
+    this.#check();
+    if ((userTypedValue !== null && typeof userTypedValue !== "string") ||
+        typeof persistedSearchTerms !== "boolean") throw new TypeError("Invalid popup close browser facts");
+    const request = this.#inputPopupClose;
+    if (!request || request.token !== token) return null;
+    this.#inputPopupClose = null;
+    const current = () => !this.#closed && this.#isCurrent() && this.#edit === request.edit &&
+      this.#searchMode === request.searchMode && this.#inputPresentationState === request;
+    return this.#commitPreviewClose(request, request.searchMode,
+      { userTypedValue, persistedSearchTerms }, current, "input-popup-preview-close");
+  }
+
+  #commitPreviewClose(request, previousMode, observation, current, reason, stillOwned = () => true) {
+    if (!current()) return null;
+    const outcome = this.#queries.commitPreviewDismissal(previousMode, observation, current);
+    if (!outcome?.applied) return null;
+    const { browserCurrent, ...status } = outcome;
+    if (!outcome.current || !browserCurrent?.() || !current()) return Object.freeze({ ...status, current: false });
