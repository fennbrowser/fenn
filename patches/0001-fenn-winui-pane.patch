+function emptyTotals() {
+  return { queries: 0, activations: 0, commands: 0, modes: 0, restarts: 0, replays: 0, inherited: 0,
+    fallbackTotal: 0, handoffs: 0, fallbackReasons: {} };
+}
+
+function addTotals(into, from) {
+  for (const key of Object.keys(emptyTotals())) {
+    if (key === "fallbackReasons") continue;
+    into[key] = (Number.isFinite(into[key]) ? into[key] : 0) + (Number.isFinite(from[key]) ? from[key] : 0);
+  }
+  into.fallbackReasons ??= {};
+  for (const [reason, n] of Object.entries(from.fallbackReasons ?? {})) {
+    if (Number.isFinite(n)) into.fallbackReasons[reason] = (into.fallbackReasons[reason] ?? 0) + n;
+  }
+  return into;
+}
+
+function isEmptyTotals(totals) {
+  return Object.entries(totals).every(([key, value]) =>
+    key === "fallbackReasons" ? Object.keys(value).length === 0 : value === 0);
