+    }
+    if(session!==this.session)return 2;
+    if(match[1]==="dismiss"){if(match[3])return 2;this.dismiss();return 1;}
+    // Refresh the authoritative model before resolving the described item.
+    this.window.goUpdateGlobalEditMenuItems?.(true);
+    this.toolbar.navigationState();
+    if(session!==this.session || !this.live() || Number(match[3])!==this.description?.revision)return 2;
+    const entry=this.actions.get(Number(match[4]));if(!entry || entry.enabled===false)return 2;
+    if(entry.kind!=="original" && !this.members().some(row=>row.widget===entry.widget && row.node===entry.node && row.part===entry.part && row.control===entry.control && row.enabled))return 2;
