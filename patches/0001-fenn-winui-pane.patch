new file mode 100644
index 00000000000..bb72ba58e27
--- /dev/null
+++ b/browser/base/content/WinUIProcessRecovery.sys.mjs
@@ -0,0 +1,114 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Cross-window Firefox recovery barriers. Native recovery budgets, peer identity
+// and transport remain in ShellCore and the native host; this owns only browser
+// restoration/compositor readiness and the associated listener lifetimes.
+export class ProcessRecoveryCoordinator {
+  #recoveringWindows = new Set();
+  #reboundWindows = new Set();
+  #paintWaiters = new Map();
+  #stockWindows = new Set();
+  #stockScheduled = false;
+  #engineRecoveryPending;
+
+  get restoringEngine() {
+    return this.#engineRecoveryPending ??= Services.env.get("FENN_ENGINE_RECOVERED") === "1";
+  }
+
+  begin(window) {
+    this.#cancelPaint(window);
+    this.#reboundWindows.delete(window);
+    this.#recoveringWindows.add(window);
+  }
+
+  forget(window) {
+    this.#cancelPaint(window);
+    this.#recoveringWindows.delete(window);
+    this.#reboundWindows.delete(window);
+  }
+
+  rebound(window) {
+    this.#recoveringWindows.delete(window);
+    this.#reboundWindows.add(window);
+    this.finishRecovery();
+  }
+
+  queueStockFallback(window) {
+    this.#stockWindows.add(window);
+    if (!this.#stockScheduled) {
+      this.#stockScheduled = true;
+      Services.tm.dispatchToMainThread(() => this.#finishStockFallback());
+    }
+  }
+
+  close(window) {
+    this.forget(window);
+    this.#stockWindows.delete(window);
+    this.finishRecovery();
+  }
+
+  #finishStockFallback() {
+    this.#stockScheduled = false;
+    const survivors = [...this.#stockWindows].filter(window => !window.closed);
+    this.#stockWindows.clear();
+    const oldGPU = survivors[0]?.windowUtils.gpuProcessPid;
+    for (const window of survivors) {
+      this.#cancelPaint(window);
+      const painted = () => {
+        if (this.#paintWaiters.get(window) !== painted || window.closed || window.windowUtils.gpuProcessPid <= 0 || window.windowUtils.gpuProcessPid === oldGPU) return;
+        this.#cancelPaint(window);
+        window.document.documentElement.setAttribute("winui-startup-chrome-ready", "stock-ready");
+      };
+      this.#paintWaiters.set(window, painted);
+      window.addEventListener("MozAfterPaint", painted);
+    }
+    survivors[0]?.windowUtils.terminateGPUProcess();
+  }
+
+  #cancelPaint(window) {
+    const listener = this.#paintWaiters.get(window);
+    if (listener) {
+      window.removeEventListener("MozAfterPaint", listener);
+      window.removeEventListener("SSTabRestored", listener);
+    }
+    this.#paintWaiters.delete(window);
+  }
+
+  finishRecovery() {
+    if (this.#recoveringWindows.size) return;
+    const freshEngine = this.#engineRecoveryPending;
+    this.#engineRecoveryPending = false;
+    const survivor = [...this.#reboundWindows].find(window => !window.closed);
+    if (survivor) {
+      const oldGPU = survivor.windowUtils.gpuProcessPid;
+      for (const window of this.#reboundWindows) {
+        if (window.closed) continue;
+        this.#cancelPaint(window);
+        let initialPaintReady = !freshEngine;
+        const painted = () => {
+          if (!initialPaintReady || this.#paintWaiters.get(window) !== painted || window.closed || window.windowUtils.gpuProcessPid <= 0 ||
+              (!freshEngine && window.windowUtils.gpuProcessPid === oldGPU) ||
+              (freshEngine && window.SessionStore.isTabRestoring(window.gBrowser.selectedTab))) return;
+          this.#cancelPaint(window);
+          const features = Cc["@mozilla.org/gfx/info;1"].getService(Ci.nsIGfxInfo).getFeatures();
+          window.gWinUIPane.publish(true);
+          window.windowUtils.syncWinUITabMenu(JSON.stringify({version:2,publishOnly:true,recoveryPainted:true,
+            software:features.compositor === "webrender_software"}));
+        };
+        this.#paintWaiters.set(window, painted);
+        window.addEventListener("MozAfterPaint", painted);
+        if (freshEngine) window.addEventListener("SSTabRestored", painted);
+        // A replacement engine owns a fresh compositor and new document actors.
+        // Both initial painting and the selected tab's SessionStore restoration
+        // must finish. Its restored document replaces the provisional address
+        // session; accepting a retained draft earlier would lose that edit.
+        // Do not kill the compositor while restored actors initialize.
+        if (freshEngine) window.gBrowserInit.firstContentWindowPaintPromise.then(() => { initialPaintReady = true; painted(); });
+      }
+    }
+    this.#reboundWindows.clear();
+    if (!freshEngine) survivor?.windowUtils.terminateGPUProcess();
+  }
+}
