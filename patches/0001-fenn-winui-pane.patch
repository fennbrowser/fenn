+    this.theme.addEventListener("change", this.invalidate);
+  }
+  observeWidgets() {
+    for (const id of ["nav-bar", "unified-extensions-area", "widget-overflow-fixed-list"]) {
+      const node = this.window.document.getElementById(id);
+      if (!node || this.observed.has(node)) continue;
