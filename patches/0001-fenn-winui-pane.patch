+void nsWindow::NotifyCompositorSessionLost(
+    mozilla::layers::CompositorSession* aSession) {
+  const bool repaint = aSession && mFennStockRepaintSession == aSession;
+  // Consume before teardown: a later generation must not inherit this request.
+  mFennStockRepaintSession = nullptr;
+  nsIWidget::NotifyCompositorSessionLost(aSession);
+  if (repaint && mWnd && !mDestroyCalled && !mOnDestroyCalled &&
+      !::GetPropW(mWnd, L"Fenn.ProxyShell")) {
+    // Queue ordinary WM_PAINT after the old renderer has been destroyed.
+    // Do not synchronously paint inside GPU teardown or change window bounds.
+    // Minimized/covered windows keep Windows' normal deferred painting behavior.
+    Invalidate(false, false, true);
+  }
+}
