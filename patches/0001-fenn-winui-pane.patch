+    if(this.session && !this.live())this.dismiss();
+    if(this.session && this.accountState && this.accountSignature(this.services().UIState.get())!==this.accountState)this.dismiss();
+    return {enabled:true,closed:this.closedSession || 0,...(this.description || {})};
+  }
+  async open(session,bounds) {
+    this.dismiss();this.session=session;this.bounds=bounds;
+    const t=this.toolbar;
+    this.context={session:t.owner.addressSession?.sessionId,tab:t.owner.addressTab,document:t.owner.addressDocument};
+    const panel=this.window.document.getElementById("customizationui-widget-panel");
+    if(panel && ["open","showing","hiding"].includes(panel.state)) {
+      await new Promise(resolve=>{panel.addEventListener("popuphidden",resolve,{once:true});if(panel.state!=="hiding")panel.hidePopup();});
