+const started = new WeakSet();
+const builtin = uri => uri === "about:home" || uri === "about:newtab";
+let registered = false;
+
+// No browser data or commands cross this actor: only the current document's
+// paint readiness. The parent checks the exact WindowGlobal again on reply.
+export class WinUIStartupPaintParent extends JSWindowActorParent {}
+
+export function revealStartupPage(window) {
+  if (started.has(window)) return;
+  started.add(window);
+  let queries = 0;
+  const reveal = (reason = "error") => {
+    if (window.gWinUIPane) window.gWinUIPane.startupPaintStatus = {reason, queries};
+    if (!window.closed) {
+      try { window.windowUtils.syncWinUITabMenu(JSON.stringify({version:2,publishOnly:true,startupPagePainted:true})); } catch {}
+    }
+  };
+  Promise.resolve(window.gBrowserInit.firstContentWindowPaintPromise).then(async () => {
+    if (window.closed) return;
+    const initial = await window.gBrowserInit.uriToLoadPromise;
+    if (!builtin(initial) || window.closed || window.document.hidden ||
+        window.SessionStore?.isTabRestoring(window.gBrowser.selectedTab)) { reveal("existing-barrier"); return; }
