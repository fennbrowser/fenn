+      ChromeUtils.registerWindowActor("WinUIStartupPaint", {
+        parent: {esModuleURI:"chrome://browser/content/WinUIStartupPaint.sys.mjs"},
+        child: {esModuleURI:"chrome://browser/content/WinUIStartupPaintChild.sys.mjs"},
+        matches:["about:home", "about:newtab"], allFrames:false,
+      });
+      registered = true;
+    }
+    const browser = window.gBrowser.selectedBrowser;
+    let done = false, next, limit;
+    const finish = (reason = "interrupted") => {
+      if (done) return;
+      done = true;
+      window.clearTimeout(next); window.clearTimeout(limit);
+      window.gBrowser.tabContainer.removeEventListener("TabSelect", selected);
+      window.removeEventListener("unload", finish);
+      window.gBrowser.removeTabsProgressListener(progress);
+      reveal(typeof reason === "string" ? reason : "interrupted");
+    };
+    const selected = () => { if (window.gBrowser.selectedBrowser !== browser) finish(); };
+    const progress = {
+      onLocationChange(changed, webProgress, request, location) {
+        if (changed === browser && webProgress.isTopLevel && location.spec !== initial) finish();
+      },
+    };
+    const probe = async () => {
+      if (done) return;
+      if (window.closed || window.gBrowser.selectedBrowser !== browser || window.document.hidden) { finish(); return; }
+      try {
+        const uri = browser.currentURI.spec;
+        if (uri !== initial && uri !== "about:blank") { finish(); return; }
+        const global = browser.browsingContext.currentWindowGlobal;
+        if (uri === initial && global?.documentURI.spec === initial) {
+          ++queries;
+          const painted = await global.getActor("WinUIStartupPaint").sendQuery("Painted");
+          if (done) return;
+          if (painted && browser.browsingContext.currentWindowGlobal === global &&
+              window.gBrowser.selectedBrowser === browser) { finish("document-painted"); return; }
+        }
+      } catch { finish("query-error"); return; }
+      // At most one query is outstanding. This startup-only check never waits
+      // for a network page; the native ten-second hold remains the backstop.
+      if (!done) next = window.setTimeout(probe, 50);
+    };
+    window.gBrowser.addTabsProgressListener(progress);
+    window.gBrowser.tabContainer.addEventListener("TabSelect", selected);
+    window.addEventListener("unload", finish, {once:true});
+    limit = window.setTimeout(() => finish("timeout"), 10000);
+    probe();
+  }).catch(() => reveal("error"));
+}
