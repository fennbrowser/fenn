+// nsWindow's own window, kept hidden, standing for the shell on Gecko's thread. Gecko's calls on it
+// return at once and reach the shell as posted requests; the shell's input is posted to it.
+struct HiddenProxy {
+  HWND shell; WNDPROC gecko=nullptr;
+  bool processPending=false;
+  uintptr_t identity{};
+  nsNativeDragTarget* dropTarget=nullptr; // Borrowed from nsWindow; cleared before its release.
