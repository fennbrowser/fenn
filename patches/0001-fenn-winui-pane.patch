+      getHelpLinkURL: topic => input.window.getHelpLinkURL(topic),
+      formatMessages: specs => input.document.l10n.formatMessages(specs),
+      formatValue: (id, args) => input.document.l10n.formatValue(id, args),
+      updateMenuButtonKeyboardAccessibility: () => input.view.updateMenuButtonKeyboardAccessibility(),
+      openContainerCreationPanel: source => input.controller.parentController.openContainerCreationPanel(source),
+      openPreferences: (pane, options) => input.controller.parentController.openPreferences(pane, options),
+      pickResult: options => input.pickResult(options),
+      get isPrivate() { return input.isPrivate; },
+      get handlesOpenInCommands() { return input.handlesOpenInCommands; },
+      defaultEngineName: () => input.controller.engineStore.default?.name,
+    });
+  }
+  invalidate(result) { this.commandsCache.delete(result); }
