index 16b4b7bf0e1..6df6c842c59 100644
--- a/browser/components/places/PlacesUIUtils.sys.mjs
+++ b/browser/components/places/PlacesUIUtils.sys.mjs
@@ -354,2 +354,59 @@ export var PlacesUIUtils = {
   BookmarkState,
+  // Shared by the retained overlay and native bookmark presentation.
+  // Shared system-module lifetime: native drafts may finish after window unload.
+  async storeRecentlyUsedBookmarkFolder(selectedFolderGuid, didChangeFolder) {
+    if (!selectedFolderGuid) {
+      return;
+    }
+
+    // If we're changing where a bookmark gets saved, persist that location,
+    // unless it is the mobile root.
+    if (
+      didChangeFolder &&
+      selectedFolderGuid !== lazy.PlacesUtils.bookmarks.mobileGuid
+    ) {
+      Services.prefs.setCharPref(
+        "browser.bookmarks.defaultLocation",
+        selectedFolderGuid
+      );
+    }
+
+    // Don't store folders that are always displayed in "Recent Folders".
+    if (lazy.PlacesUtils.bookmarks.userContentRoots.includes(selectedFolderGuid)) {
+      return;
+    }
+
+    // List of recently used folders:
+    let lastUsedFolderGuids = await lazy.PlacesUtils.metadata.get(
+      this.LAST_USED_FOLDERS_META_KEY,
+      []
+    );
+
+    let index = lastUsedFolderGuids.indexOf(selectedFolderGuid);
+    if (index > 1) {
+      // The guid is in the array but not the most recent.
+      lastUsedFolderGuids.splice(index, 1);
+      lastUsedFolderGuids.unshift(selectedFolderGuid);
+    } else if (index == -1) {
+      lastUsedFolderGuids.unshift(selectedFolderGuid);
+    }
+    while (lastUsedFolderGuids.length > this.maxRecentFolders) {
+      lastUsedFolderGuids.pop();
+    }
+
+    await lazy.PlacesUtils.metadata.set(
+      this.LAST_USED_FOLDERS_META_KEY,
+      lastUsedFolderGuids
+    );
+  },
+
+  parseBookmarkTags(value) {
+    return value.trim().split(/\s*,\s*/).filter(tag => !!tag.length);
+  },
+  toggleBookmarkTag(value, tag, checked) {
+    const tags = this.parseBookmarkTags(value), index = tags.indexOf(tag);
+    if (checked && index === -1) tags.push(tag);
+    else if (!checked && index !== -1) tags.splice(index, 1);
+    return tags.join(", ");
+  },
   _bookmarkToolbarTelemetryListening: false,
