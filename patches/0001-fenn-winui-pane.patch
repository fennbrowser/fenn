+      resetSelection: isAddressbar && !openParams.avoidBrowserFocus,
+      revertBeforeLoad: where !== "current" && !UrlbarShared.isSearchbarSAP(sapName) };
+  }
+
+  /** nsILoadInfo schemeful/schemeless values, also usable in content realms. */
+  static schemelessInput(value) {
+    return isSchemelessInput(value) ? 2 : 1;
+  }
+
+  /** URL/keyword adjustments shared with pickResult; never resolves or loads. */
+  static resultLoadPolicy(result, loadRequest, originalUntrimmedValue) {
+    const openParams = {};
+    if (result.type === UrlbarShared.RESULT_TYPE.URL && result.heuristic) {
+      // Keep enterprise DNS-first single-word resolution in docshell, as before.
+      if (UrlbarPrefs.get("browser.fixup.dns_first_for_single_words") &&
+          UrlbarShared.looksLikeSingleWordHost(originalUntrimmedValue)) {
+        loadRequest = { ...loadRequest, urlLoad: { ...loadRequest.urlLoad, url: originalUntrimmedValue } };
+      }
+      openParams.schemelessInput = this.schemelessInput(originalUntrimmedValue);
+    } else if (result.type === UrlbarShared.RESULT_TYPE.KEYWORD) {
+      // Bookmark keywords retain the document principal for bookmarklets.
+      openParams.allowInheritPrincipal = true;
+    }
+    return { loadRequest, openParams };
+  }
+
+  /**
+   * Validate the host's result-action fact. Only the open-in family is supported;
+   * commands, URLs, inputs, help and button names are explicitly unsupported.
+   */
+  static normalizeResultAction(action) {
+    if (action === null || action === undefined) return null;
+    if (typeof action !== "object") throw new TypeError("Invalid result action");
+    const unsupported = Object.keys(action).filter(key =>
+      !["openIn", "userContextId", "url", "name"].includes(key) && action[key] !== undefined);
+    if (unsupported.length) throw new TypeError("Unsupported result action");
+    const { openIn, userContextId, url, name } = action;
+    if (url !== undefined) {
+      if (openIn !== undefined || userContextId !== undefined || typeof url !== "string" ||
+          url.length > 8192 || !URL.parse(url) || (name !== undefined && typeof name !== "string")) {
+        throw new TypeError("Invalid result action URL");
+      }
+      return Object.freeze(name === undefined ? { url } : { url, name });
+    }
+    if (name !== undefined) throw new TypeError("Unsupported result action");
+    if (!["tab", "container-tab", "window", "private-window"].includes(openIn)) {
+      throw new TypeError("Invalid result action destination");
+    }
+    if (openIn === "container-tab") {
+      if (typeof userContextId !== "string" || !/^[1-9]\d{0,9}$/.test(userContextId)) {
+        throw new TypeError("Invalid result action container");
+      }
+      return Object.freeze({ openIn, userContextId });
+    }
+    if (userContextId !== undefined) throw new TypeError("Unexpected result action container");
+    return Object.freeze({ openIn });
+  }
