+
+  /** Resolve Firefox restriction tokens without retaining an input or store. */
+  static modeForToken(token, { isAddressbar, engineStore }) {
+    if (token == UrlbarShared.RESTRICT_TOKENS.SEARCH) {
+      return { engineName: engineStore.default?.name };
+    }
