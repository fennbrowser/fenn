@@ -0,0 +1,101 @@
+// Firefox owns result-menu commands; native receives only scoped opaque IDs.
+export class WinUIResultContextMenu {
+  constructor(session) { this.session = session; this.generation = 0; }
+  close() {
+    this.generation++;
+    this.state = null;
+    if (this.session.resultMenuSnapshot) {
+      this.session.resultMenuSnapshot = null;
+      this.session.changed();
+    }
+  }
+  current(state) {
+    const s=this.session, active=s.active, win=s.window;
+    return !s.closed && !win.gDialogBox?.isOpen && active && active === state.active &&
+      s.input.view.nativePresentation === s && s.nativeOpen &&
+      s.nativeVisible?.includes(state.id) &&
+      win.gBrowser.selectedBrowser === state.browser &&
+      state.document && state.document === state.browser.browsingContext.currentWindowGlobal?.innerWindowId &&
+      state.page === state.browser.currentURI?.spec &&
+      state.editId === s.editId && state.text === s.input.inputField.value &&
+      active.rows.some(row=>row.id===state.id) &&
+      active.context?.results.includes(state.result) &&
+      (!state.button || state.signature === JSON.stringify(state.result.payload.buttons));
+  }
+  async open(request) {
+    this.close();
+    const s=this.session, active=s.active;
+    if (request.version !== 1 || request.session !== s.sessionId || !active || request.editId !== s.editId || request.revision !== active.revision ||
+        !s.nativeVisible?.includes(request.resultId)) return;
+    const index=active.rows.findIndex(row=>row.id===request.resultId);
+    const result=active.results[active.resultIndexes[index]];
+    if (!result) return;
+    const button = request.buttonId ? active.rows[index].tipButtons?.find(b=>b.id===request.buttonId && b.menu && b.enabled) : null;
+    if (request.buttonId && (!button || !button.document ||
+        button.document !== active.browser.browsingContext.currentWindowGlobal?.innerWindowId ||
+        button.signature !== JSON.stringify(result.payload.buttons))) return;
+    const generation=this.generation;
+    const state={button,signature:button?.signature,active,result,id:request.resultId,browser:active.browser,
+      document:active.browser.browsingContext.currentWindowGlobal?.innerWindowId,
+      page:active.browser.currentURI?.spec,
+      editId:s.editId,text:s.input.inputField.value,actions:new Map()};
+    if (!this.current(state)) return;
+    const descriptors=await s.resultActions.describeMenu(result, button?.name ?? null);
+    if (generation!==this.generation || !this.current(state) || !descriptors) return;
+    let count=0;
+    const read=(descriptors,depth=0)=>{
+      if(depth>4) throw new Error("Result menu too deep");
+      return descriptors.map(descriptor=>{
+        if(++count>128) throw new Error("Result menu too large");
+        if(descriptor.separator) return {separator:true};
+        const id=`${generation}:${count}`;
+        state.actions.set(id,descriptor);
+        const item={id,label:descriptor.label.trim().slice(0,4096),enabled:descriptor.enabled,
+          checkable:descriptor.checkable, checked:descriptor.checked,
+          accessKey:(descriptor.accessKey || '').slice(0,16)};
+        if(descriptor.children) item.children=read(descriptor.children,depth+1);
+        return item;
+      }).filter(item=>item.separator || item.label);
+    };
+    const items=read(descriptors);
+    this.state=state;
+    s.resultMenuSnapshot={generation,editId:s.editId,resultId:state.id,items};
+    s.changed();
+  }
+  async activate(state, descriptor, generation) {
+    const s=this.session;
+    const key=item => JSON.stringify(item.action);
+    const wanted=key(descriptor);
+    const descriptors=await s.resultActions.describeMenu(state.result, state.button?.name ?? null);
+    if(generation!==this.generation) return;
+    if(!this.current(state)) {this.close();return;}
+    const find=items=>items?.flatMap(item=>item.children ? find(item.children) : [item]) || [];
+    const fresh=find(descriptors).find(item=>item.enabled && key(item)===wanted);
+    try {
+      if(fresh) {
+        const event=new s.window.MouseEvent('click',{bubbles:true,view:s.window,button:0});
+        if(s.invokeResultMenu) s.invokeResultMenu(state.result,fresh.action,event);
+        else s.resultActions.invokeMenu(state.result,fresh.action,event,state.browser.browserId);
+      }
+    } finally {if(generation===this.generation)this.close();}
+  }
+  execute(request) {
+    const s=this.session, state=this.state;
+    if (request.version !== 1 || request.session !== s.sessionId || !state || request.generation!==this.generation || request.resultId!==state.id ||
+        !this.current(state)) { this.close(); return 2; }
+    if(request.kind==='context-close') {if(!state.invoking)this.close();return 1;}
+    if(request.kind!=='context-action') return 2;
+    const descriptor=state.actions.get(request.id);
+    if(!descriptor || !descriptor.enabled || descriptor.children) return 2;
+    // Rebuild through Firefox immediately before dispatch. Container and policy
+    // changes while the flyout was open must revoke commands as well.
+    if(state.invoking) return 2;
+    state.invoking=true;
+    const generation=this.generation;
+    this.activate(state,descriptor,generation).catch(error=>{
+      if(generation===this.generation)this.close();
+      console.error(error);
+    });
+    return 1;
+  }
+}
