+// Firefox owns extension placement, action policy, icons and command execution.
+export class WinUIPinnedExtensions {
+  constructor(toolbar) {
+    this.toolbar = toolbar;
+    this.window = toolbar.window;
+    this.entries = new Map();
+    this.nextId = 0;
+    this.images = new Map();
+    this.loads = new Set();
+    this.events = new WeakMap();
