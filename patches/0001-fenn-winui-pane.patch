+  }
+  snapshot(navigation) {
+    const {ui,toolbar} = this, {window} = toolbar;
+    const fixed = new Map([['back-button','back'],['forward-button','forward'],['stop-reload-button','reload'],
+      ['urlbar-container','address'],['fxa-toolbar-menu-button','profile'],['unified-extensions-button','extensions'],['home-button','home'],['downloads-button','downloads'],['history-panelmenu','history'],['bookmarks-menu-button','bookmarks']]);
+    const placements = ui.getWidgetIdsInArea(ui.AREA_NAVBAR);
+    const candidates = [...new Set([...placements,...ui.getWidgetIdsInArea(ui.AREA_FIXED_OVERFLOW_PANEL),...fixed.keys(),...ui.getWidgetIdsInArea(ui.AREA_ADDONS),'spring'])];
