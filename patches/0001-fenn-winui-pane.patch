+    return this.#controller.parentController.recordSearchModeMenuPicked(kind);
+  }
+
+  /** Capture a one-use dispatch guard without storing authority on the provider query. */
+  createSearchCommandQueryAuthority(value, options, description, stateToken, userTypedValue, searchMode = null, engineId = null) {
+    this.#check();
+    const browserCurrent = this.#controller.parentController.captureIndependentQueryAuthority(
+      this.#context.browserId, stateToken, userTypedValue);
+    if (!browserCurrent) return null;
+    return () => !this.#closed && this.#isCurrent() && browserCurrent() &&
+      (!searchMode?.engineName || this.#controller.engineStore.getEngineByName(searchMode.engineName)?.id === engineId) &&
+      UrlbarShared.deepEqual(this.describeSearchCommand(value, options), description);
+  }
+
+  /** Apply the command input stage before its preview confirmation or cleared-mode query. */
+  commitSearchCommandInput(value, options, description, text, observation, isCurrent) {
+    this.#check();
+    const current = () => !this.#closed && this.#isCurrent() && isCurrent() &&
+      (!observation.searchMode?.engineName || this.#controller.engineStore.getEngineByName(observation.searchMode.engineName)?.id === observation.engineId) &&
+      UrlbarShared.deepEqual(this.describeSearchCommand(value, options), description);
+    if (!current()) return null;
+    const outcome = this.#controller.parentController.commitIndependentInputState(this.#context.browserId,
+      text, observation, current);
+    if (outcome?.applied && outcome.current && current()) this.#controller.userSelectionBehavior = "none";
+    return outcome;
+  }
+
+  /** Confirm the initial command preview, retaining its original mode for query dispatch. */
+  commitSearchCommandConfirmation(value, options, description, confirmedMode, observation, isCurrent, onCommitted = null) {
+    this.#check();
+    if (!Number.isSafeInteger(this.#context.browserId) || this.#context.browserId <= 0) {
+      throw new Error("Mode state requires a pinned browser");
+    }
+    const previewMode = observation.previewMode;
+    if (!observation.stateToken || !previewMode?.isPreview ||
+        !UrlbarShared.deepEqual(confirmedMode, UrlbarSearchModeModel.confirmedMode(previewMode)) ||
+        (description.changeSearchMode && !UrlbarShared.deepEqual(previewMode, description.searchMode))) return null;
+    const current = () => !this.#closed && this.#isCurrent() && isCurrent() &&
+      (!previewMode.engineName || (observation.engineId &&
+        this.#controller.engineStore.getEngineByName(previewMode.engineName)?.id === observation.engineId)) &&
+      UrlbarShared.deepEqual(this.describeSearchCommand(value, options), description);
+    if (!current()) return null;
+    return this.#controller.parentController.commitIndependentModeState(this.#context.browserId,
+      confirmedMode, { persistedSearchTerms: observation.persistedSearchTerms,
+        engineId: observation.engineId, modeEntry: observation.modeEntry, expectedStateToken: observation.stateToken }, current, onCommitted);
+  }
+
+  /** Resolve a stored confirmed mode without starting a query or consulting an input. */
+  async prepareSearchModeRestoration(confirmedMode) {
+    this.#check();
+    if (confirmedMode !== null && confirmedMode?.isPreview !== false) {
+      throw new TypeError("Restoration requires a confirmed mode or null");
+    }
+    const requested = confirmedMode ? Object.freeze({ ...confirmedMode }) : null;
+    if (requested?.engineName) await this.#controller.engineStore.init();
+    this.#check();
+    return this.describeSearchModeRestoration(requested);
+  }
+
+  /** Revalidate immediately before an observed host write, including engine removal. */
+  describeSearchModeRestoration(confirmedMode) {
+    this.#check();
+    if (confirmedMode !== null && confirmedMode?.isPreview !== false) {
+      throw new TypeError("Restoration requires a confirmed mode or null");
+    }
+    if (confirmedMode?.engineName && !this.#controller.engineStore.initialized) {
+      throw new Error("Search mode engines are not initialized");
+    }
+    const engine = confirmedMode?.engineName
+      ? this.#controller.engineStore.getEngineByName(confirmedMode.engineName) : null;
+    return UrlbarSearchModeModel.normalizeMode(confirmedMode, engine);
+  }
+
+  /** Describe mode policy only; action facts grant no selection/navigation authority. */
+  describeResultSearchMode(queryId, result, { entry = null, actionEngine = null } = {}) {
+    if (!this.ownsResult(queryId, result)) throw new Error("Stale result search mode");
+    const mode = UrlbarSearchModeModel.modeForResult(result, {
+      entry, actionEngine,
+      modeForToken: token => UrlbarSearchModeModel.modeForToken(token, {
+        isAddressbar: this.#context.sapName === "urlbar",
+        engineStore: this.#controller.engineStore,
+      }),
+    });
+    return mode ? Object.freeze(mode) : null;
+  }
+
+  /** Describe result-mode transition policy without applying browser state. */
+  describeResultModeTransition(queryId, result, { value, checkValue = true,
+    startQuery = true, entry = null, nativeAction = false, actionEngine = null } = {}) {
+    if (!this.ownsResult(queryId, result)) throw new Error("Stale result mode transition");
+    if (typeof value !== "string" || typeof checkValue !== "boolean" ||
+        typeof startQuery !== "boolean" || typeof nativeAction !== "boolean" ||
+        (actionEngine !== null && typeof actionEngine !== "string")) throw new TypeError("Invalid mode transition facts");
+    return UrlbarSearchModeModel.resultTransition(result, { value, checkValue, startQuery, nativeAction,
+      resolveMode: current => this.describeResultSearchMode(queryId, current, { entry, actionEngine }) });
+  }
+
+  /** Describe a normalized mode using the current visible-engine store. */
+  describeResultModeApplication(queryId, result, options) {
+    const transition = this.describeResultModeTransition(queryId, result, options);
+    if (!transition) return null;
+    const requested = transition.searchMode;
+    const engine = requested.engineName
+      ? this.#controller.engineStore.getEngineByName(requested.engineName) : null;
