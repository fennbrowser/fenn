+      request.generation === this.modeGeneration && this.window.gBrowser.selectedBrowser === browser &&
+      browser.currentURI.spec === page;
+    const result = await this.input.searchModeSwitcher.nativeActivate(key,
+      new this.window.MouseEvent("click", request.intent), current, () =>
+        !this.closed && operation === this.modeOperation && editId === this.editId &&
+        this.window.gBrowser.selectedBrowser === browser && browser.currentURI.spec === page);
