+// Firefox owns result-menu commands; native receives only scoped opaque IDs.
+export class WinUIResultContextMenu {
+  constructor(session) { this.session = session; this.generation = 0; }
+  close() {
+    this.generation++;
+    this.state = null;
+    if (this.session.resultMenuSnapshot) {
+      this.session.resultMenuSnapshot = null;
+      this.session.changed();
+    }
+  }
+  current(state) {
+    const s=this.session, active=s.active, win=s.window;
+    return !s.closed && !win.gDialogBox?.isOpen && active && active === state.active &&
+      s.input.view.nativePresentation === s && s.nativeOpen &&
+      s.nativeVisible?.includes(state.id) &&
+      win.gBrowser.selectedBrowser === state.browser &&
+      state.document && state.document === state.browser.browsingContext.currentWindowGlobal?.innerWindowId &&
+      state.page === state.browser.currentURI?.spec &&
+      state.editId === s.editId && state.text === s.input.inputField.value &&
+      active.rows.some(row=>row.id===state.id) &&
+      active.context?.results.includes(state.result) &&
+      (!state.button || state.signature === JSON.stringify(state.result.payload.buttons));
+  }
+  async open(request) {
+    this.close();
+    const s=this.session, active=s.active;
+    if (request.version !== 1 || request.session !== s.sessionId || !active || request.editId !== s.editId || request.revision !== active.revision ||
+        !s.nativeVisible?.includes(request.resultId)) return;
+    const index=active.rows.findIndex(row=>row.id===request.resultId);
+    const result=active.results[active.resultIndexes[index]];
+    if (!result) return;
+    const button = request.buttonId ? active.rows[index].tipButtons?.find(b=>b.id===request.buttonId && b.menu && b.enabled) : null;
+    if (request.buttonId && (!button || !button.document ||
+        button.document !== active.browser.browsingContext.currentWindowGlobal?.innerWindowId ||
+        button.signature !== JSON.stringify(result.payload.buttons))) return;
+    const generation=this.generation;
+    const state={button,signature:button?.signature,active,result,id:request.resultId,browser:active.browser,
+      document:active.browser.browsingContext.currentWindowGlobal?.innerWindowId,
+      page:active.browser.currentURI?.spec,
+      editId:s.editId,text:s.input.inputField.value,nodes:new Map()};
+    if (!this.current(state)) return;
+    const panel=await s.input.view.prepareNativeResultMenu(result, button?.name ?? null);
+    if (generation!==this.generation || !this.current(state) || !panel) return;
+    let count=0;
+    const read=(parent,depth=0)=>{
+      if(depth>4) throw new Error("Result menu too deep");
+      return [...parent.children].map(node=>{
+        if(++count>128) throw new Error("Result menu too large");
+        if(node.localName==='hr') return {separator:true};
