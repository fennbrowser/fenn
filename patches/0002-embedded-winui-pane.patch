+    this.window = window;
+    this.input = window.gURLBar;
+    // Every mutation that changes what a publication would say already advances
+    // one of these two counters -- including the asynchronous label and image
+    // completions, which have no event of their own. Routing them through
+    // accessors is what lets the host publish on change instead of on a timer:
+    // it captures every existing site, and every future one, without each
+    // having to remember to announce itself.
+    this._revision = 0;
+    this._sequence = 0;
+    this.onChanged = null;
+    this.closed = false;
+    this.active = null;
+    this.editId = 0;
+    this.selectionId = 0;
+    this.imageLoads = new Set();
+    this.modeImageLoads = new Set();
+    this.modeGeneration = 0;
+    this.modeApplied = 0;
+    this.modeOperation = 0;
+    this.modeDirty = true;
+    this.modeChanged = () => {
+      for (const image of this.modeImageLoads) image.src = "";
+      this.modeImageLoads.clear();
+      this.modeDirty = true; this.modeGeneration++;
+      this.changed();
+    };
+    this.modePrefs = ["browser.urlbar.shortcuts.", "browser.settings-redesign.enabled", "browser.nova.enabled"];
+    this.modePrefsObserver = {observe:this.modeChanged};
+    for (const pref of this.modePrefs) Services.prefs.addObserver(pref, this.modePrefsObserver);
+    this.input.controller.engineStore.addObserver(this.modeChanged);
+    this.modeSignature = JSON.stringify(this.input.searchMode);
+    this.modeStateChanged = () => {
+      const signature = JSON.stringify(this.input.searchMode);
+      if (signature !== this.modeSignature) {
+        this.modeSignature = signature; this.modeChanged();
+      }
+    };
