+        id:`${this.sessionId}:mode:${generation}:${i}`}));
+      const button = {id:"button"};
+      menu.rows.push(button);
+      this.modeMenu = menu;
+      const valid = () => !this.closed && this.modeMenu === menu && generation === this.modeGeneration;
+      for (const row of menu.rows) {
+        const icon = row === button ? data.icon : row.icon;
+        delete row.icon;
+        if (icon) this.loadNativeImage(menu, row, {icon, size:16}, valid);
+      }
+      this.changed();
+    }).catch(console.error).finally(() => { this.modeLoading = false; });
+  }
+
+  nativeModes() {
+    const context = JSON.stringify([this.window.gBrowser.selectedBrowser.currentURI.spec,
+      this.input.addSearchEngineHelper.engines.map(e => [e.uri,e.title,e.icon])]);
