+  auto* widget = GetWidget();
+  return widget && widget->SyncWinUIAddress(aSnapshot) ? NS_OK : NS_ERROR_NOT_AVAILABLE;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::SyncWinUITabMenu(const nsAString& aSnapshot) {
