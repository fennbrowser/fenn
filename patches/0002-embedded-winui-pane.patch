+uint32_t ApplyWinUITabDelta(HWND aWindow, const nsAString& aDelta) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.applyTabDelta || aDelta.Length() > 1048576)
+    return 0;
+  nsAutoString delta(aDelta);
