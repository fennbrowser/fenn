+            ("runtime=unavailable bootstrapWin32Error=%lu", GetLastError()));
+    return;
+  }
+  using InitializeFn = HRESULT(WINAPI*)(UINT32, PCWSTR, PACKAGE_VERSION, UINT32);
+  auto initialize = reinterpret_cast<InitializeFn>(
+      GetProcAddress(module, "MddBootstrapInitialize2"));
+  PACKAGE_VERSION minimum{};
+  minimum.Version = WINUI_PANE_RUNTIME_MIN_VERSION;
+  // MddBootstrapInitializeOptions_OnPackageIdentity_NOOP.
+  constexpr UINT32 kNoopWhenPackaged = 0x0010;
+  HRESULT hr = initialize ? initialize(WINUI_PANE_RUNTIME_MAJOR_MINOR, L"",
+                                       minimum, kNoopWhenPackaged)
+                          : E_NOINTERFACE;
+  MOZ_LOG(sWinUIPrototypeLog,
+          SUCCEEDED(hr) ? LogLevel::Info : LogLevel::Warning,
+          ("runtime=bootstrap hr=0x%08lx", static_cast<unsigned long>(hr)));
+}
