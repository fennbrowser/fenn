+
+// The v11 request path keeps the same privileged-entry checks as every other
+// WinUI entry point here: parent process, system principal, and the browser
+// document itself. These carry browser commands; page content must never
+// reach them.
+NS_IMETHODIMP
+nsDOMWindowUtils::DrainWinUIRequests(nsAString& aBatch) {
+  aBatch.Truncate();
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc || !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral("chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  auto* widget = GetWidget();
+  if (!widget) return NS_ERROR_NOT_AVAILABLE;
+  // Nothing to drain is not an error: it returns an empty batch, which the
+  // caller reads as "no work".
+  widget->DrainWinUIRequests(aBatch);
+  return NS_OK;
+}
