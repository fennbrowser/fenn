+                              const nsTArray<nsString>& aTitles,
+                              const nsTArray<uint32_t>& aCommands,
+                              uint32_t aSelected, uint32_t* aResult) {
+  *aResult = 0;
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc ||
+      !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral(
+          "chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  if (aIds.Length() != aTitles.Length() || aIds.Length() != aCommands.Length() || aIds.Length() > 10000)
+    return NS_ERROR_INVALID_ARG;
+  for (auto commands : aCommands) {
+    if ((commands & ~31u) || (commands & 12u) == 12u) return NS_ERROR_INVALID_ARG;
+  }
+  for (const auto& title : aTitles) {
+    if (title.Length() > 32768) return NS_ERROR_INVALID_ARG;
+  }
