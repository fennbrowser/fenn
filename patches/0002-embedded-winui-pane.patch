+    this.window.document.getElementById("nav-bar")?.overflowable?.setNativeOverflow(null);
+    const hadFocus = this.active && this.focusOwned;
+    this.active = false;
+    this.customization?.endEditor();
+    this.row.hidden = true;
+    this.window.document.documentElement.removeAttribute("winui-address-active");
+    this.input.removeAttribute("aria-hidden");
+    this.switcher.removeAttribute("aria-hidden");
+    this.switcher.inert = !!this.switcherWasInert;
+    this.owner.addressSession?.releaseNativePresentation();
+    try { this.window.windowUtils.updateWinUIAddress(0, 0, 0, 0, false, false, false); } catch {}
+    if (hadFocus) this.window.gURLBar.focus();
+  }
+  bounds() {
+    if (this.navigation) return this.row.getBoundingClientRect();
+    const rect = this.slot.getBoundingClientRect();
+    const container = this.input.closest(".urlbar-input-container").getBoundingClientRect();
+    const toolbar = this.window.document.getElementById("nav-bar")?.getBoundingClientRect();
+    const height = Math.max(container.height, toolbar?.height || 0) >= 32 ? Math.max(32, rect.height) : rect.height;
+    return {x:rect.x, y:rect.y - (height - rect.height)/2, width:rect.width, height};
+  }
+  close() {
+    this.restore();
+    this.historyMenu.close();
+    this.resize.disconnect();
+    this.navigationObserver.disconnect();
+    this.customization?.close();
+    this.pinned?.close();
+    this.omnibar?.close();
+    this.window.gBrowser.removeTabsProgressListener(this.progress);
+    this.input.removeEventListener("beforefocus", this.beforeFocus);
+    this.input.removeEventListener("beforeselect", this.beforeFocus);
+    this.proxy.remove();
+    this.menuAnchors?.clear();
+    this.row.remove();
+    this.link.remove();
+  }
+}
