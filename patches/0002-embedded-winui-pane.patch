+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// First-stage adapter: Firefox's real input/view still own all browser semantics.
+// Not a native ABI or a replacement for UrlbarChildController.
+import { UrlbarShared } from "chrome://browser/content/urlbar/UrlbarShared.mjs";
+
+let nextSession = 0;
+
+export class WinUIUrlbarSession {
+  constructor(window) {
+    if (
+      window.document.documentURI !==
+        "chrome://browser/content/browser.xhtml" ||
+      !window.gWinUIPane?.attached
