+    this.editState = null;
+    this.input.controller.addListener(this);
+    this.invalidate = () => this.cancel();
+    window.gBrowser.tabContainer.addEventListener("TabSelect", this.invalidate);
+    window.addEventListener("unload", this);
+    this.input.inputField.addEventListener("input", this.invalidate);
