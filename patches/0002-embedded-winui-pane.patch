+    if (request.kind === 4) return this.executeNewTabRequest();
+    if (request.kind === 5) return this.executeStripRequest(action);
+    if (request.kind === 9) return this.executeStripPreview(action);
+    if (request.kind === 10) return this.addressToolbar?.executeNavigation(action) || 2;
