+      s.input.pickResult({result:entry.tip, element:entry.element,
+        event:new s.window.KeyboardEvent('keydown',{key:'Enter'}),browserId:entry.active.browser.browserId});
+    } finally { this.remove(entry.tip.id); }
+    return 'activated';
+  }
+}
