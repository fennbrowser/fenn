+  get revision() { return this._revision; }
+  set revision(value) {
+    const changed = value !== this._revision;
+    this._revision = value;
+    if (changed) this.changed();
+  }
+
+  get sequence() { return this._sequence; }
+  set sequence(value) {
+    const changed = value !== this._sequence;
+    this._sequence = value;
+    if (changed) this.changed();
+  }
+
+  // A publication would now say something different. Never throws into a
+  // caller that was only updating state: a broken host must not corrupt the
+  // session.
+  changed() {
