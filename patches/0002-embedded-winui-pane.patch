+      await this.query(this.input.inputField.value, new this.window.MouseEvent("mousedown"));
+    }
+  }
+
+  handleEvent() {
+    this.close();
+  }
+  observe() {
+    if (!Services.prefs.getBoolPref(this.window.gWinUIPane.pref, false))
+      this.close();
+  }
+
+  beginNativePresentation() {
+    if (this.closed || this.input.view.nativePresentation === this) return;
+    if (this.input.view.nativePresentation)
+      throw new Error("Presentation already owned");
+    this.input.view.close();
