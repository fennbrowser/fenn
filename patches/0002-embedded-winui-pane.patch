@@ -0,0 +1,87 @@
+// Firefox owns context item eligibility, localization and browser actions.
+export class WinUIAddressContextMenu {
+  constructor(session) { this.session = session; this.generation = 0; }
+  close() {
+    this.generation++;
+    this.state = null;
+    this.nodes = null;
+    this.session.contextSnapshot = null;
+    const popup = this.popup;
+    this.popup = null;
+    if (popup?.state === "closed") popup.dispatchEvent(new this.session.window.Event("popuphidden"));
+  }
+  async open(request) {
+    this.close();
+    const session = this.session, win = session.window;
+    if (win.gDialogBox?.isOpen || session.syncNativeSelection(request) !== 1 || session.closed) return;
+    const generation = this.generation;
+    const tab = win.gBrowser.selectedTab;
+    const document = tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+    const event = new win.MouseEvent("contextmenu", {view:win});
+    const popup = win.EditContextMenu.prepare(session.input.inputField, event);
+    this.popup = popup;
+    await win.document.l10n.translateElements([...popup.querySelectorAll("[data-l10n-id]")]);
+    if (generation !== this.generation || session.closed || win.gDialogBox?.isOpen || request.editId !== session.editId ||
+        request.text !== session.input.inputField.value || win.gBrowser.selectedTab !== tab ||
+        document !== tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId) return;
+    const nodes = new Map(); let count = 0;
+    const standard = new Set(["cmd_undo", "cmd_redo", "cmd_cut", "cmd_copy", "cmd_paste", "cmd_delete", "cmd_selectAll"]);
+    const read = (parent, depth=0) => {
+      if (depth > 4) throw new Error("Context menu too deep");
+      return [...parent.children].filter(node => !node.hidden && !node.collapsed && node.getAttribute("hidden") !== "true" && node.getAttribute("collapsed") !== "true").map(node => {
+        if (++count > 128) throw new Error("Context menu too large");
+        if (node.localName === "menuseparator") return {separator:true};
+        const command = node.getAttribute("command");
+        const id = standard.has(command) ? command : `${generation}:${count}`;
+        nodes.set(id, node);
+        const item = {id, label:(node.getAttribute("label") || "").slice(0,4096),
+          accessKey:node.getAttribute("accesskey") || "", enabled:node.getAttribute("disabled") !== "true",
+          checked:node.getAttribute("checked") === "true", checkable:node.getAttribute("type") === "checkbox"};
+        if (standard.has(command)) item.enabled = !!session.input.inputField.controllers.getControllerForCommand(command)?.isCommandEnabled(command);
+        if (node.localName === "menu") item.children = read(node.menupopup || node.querySelector("menupopup"), depth+1);
+        return item;
