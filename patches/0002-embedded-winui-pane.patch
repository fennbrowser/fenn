+  return widget && widget->SyncWinUITabMenu(aSnapshot) ? NS_OK : NS_ERROR_NOT_AVAILABLE;
+}
+
+// The v11 request path keeps the same privileged-entry checks as every other
+// WinUI entry point here: parent process, system principal, and the browser
+// document itself. These carry browser commands; page content must never
+// reach them.
+NS_IMETHODIMP
+nsDOMWindowUtils::DrainWinUIRequests(nsAString& aBatch) {
+  aBatch.Truncate();
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc || !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral("chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  auto* widget = GetWidget();
+  if (!widget) return NS_ERROR_NOT_AVAILABLE;
+  // Nothing to drain is not an error: it returns an empty batch, which the
+  // caller reads as "no work".
+  widget->DrainWinUIRequests(aBatch);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::CompleteWinUIRequests(const nsAString& aOutcomes) {
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc || !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral("chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  if (aOutcomes.Length() > 1048576 || aOutcomes.FindChar(char16_t(0)) != kNotFound) return NS_ERROR_INVALID_ARG;
+  auto* widget = GetWidget();
+  return widget && widget->CompleteWinUIRequests(aOutcomes) ? NS_OK : NS_ERROR_NOT_AVAILABLE;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::ApplyWinUITabDelta(const nsAString& aDelta, uint32_t* aRevision) {
+  *aRevision = 0;
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc || !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral("chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  if (aDelta.Length() > 1048576 || aDelta.FindChar(char16_t(0)) != kNotFound) return NS_ERROR_INVALID_ARG;
+  auto* widget = GetWidget();
+  if (!widget) return NS_ERROR_NOT_AVAILABLE;
+  *aRevision = widget->ApplyWinUITabDelta(aDelta);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::SyncWinUITabs(const nsTArray<uint32_t>& aIds,
+                              const nsTArray<nsString>& aTitles,
+                              const nsTArray<uint32_t>& aCommands,
+                              uint32_t aSelected, uint32_t* aResult) {
+  *aResult = 0;
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc ||
+      !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral(
+          "chrome://browser/content/browser.xhtml")) return NS_ERROR_NOT_AVAILABLE;
+  if (aIds.Length() != aTitles.Length() || aIds.Length() != aCommands.Length() || aIds.Length() > 10000)
+    return NS_ERROR_INVALID_ARG;
+  for (auto commands : aCommands) {
+    if ((commands & ~31u) || (commands & 12u) == 12u) return NS_ERROR_INVALID_ARG;
+  }
+  for (const auto& title : aTitles) {
+    if (title.Length() > 32768) return NS_ERROR_INVALID_ARG;
+  }
+  auto* widget = GetWidget();
+  if (!widget) return NS_ERROR_NOT_AVAILABLE;
+  *aResult = widget->SyncWinUITabs(aIds, aTitles, aCommands, aSelected);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::UpdateWinUIPane(double aX, double aY, double aWidth,
+                                  double aHeight, bool aVisible, bool aFocus,
+                                  bool aBackwards,
+                                  const nsTArray<double>& aOcclusions,
+                                  bool* aResult) {
+  *aResult = false;
+  auto* doc = GetDocument();
+  if (!XRE_IsParentProcess() || !doc ||
+      !doc->NodePrincipal()->IsSystemPrincipal() ||
+      !doc->GetDocumentURI()->GetSpecOrDefault().EqualsLiteral(
+          "chrome://browser/content/browser.xhtml")) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  auto* pc = GetPresContext();
+  nsPoint offset;
+  auto* widget = GetWidget(&offset);
+  if (!pc || !widget || !std::isfinite(aX) || !std::isfinite(aY) ||
+      !std::isfinite(aWidth) || !std::isfinite(aHeight) || aWidth < 0 ||
+      aHeight < 0 || std::abs(aX) > 100000 || std::abs(aY) > 100000 ||
+      aWidth > 100000 || aHeight > 100000) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  CSSRect cssRect(aX, aY, aWidth, aHeight);
+  cssRect.MoveBy(CSSPoint::FromAppUnits(offset));
+  auto rect = LayoutDeviceIntRect::Round(cssRect * pc->CSSToDevPixelScale());
+  if (aOcclusions.Length() % 4 || aOcclusions.Length() > 4096)
+    return NS_ERROR_INVALID_ARG;
+  nsTArray<LayoutDeviceIntRect> occlusions;
+  for (size_t i = 0; i < aOcclusions.Length(); i += 4) {
+    for (size_t j = 0; j < 4; ++j) {
+      if (!std::isfinite(aOcclusions[i + j]) ||
+          std::abs(aOcclusions[i + j]) > 100000)
+        return NS_ERROR_INVALID_ARG;
+    }
+    if (aOcclusions[i + 2] < 0 || aOcclusions[i + 3] < 0)
+      return NS_ERROR_INVALID_ARG;
+    CSSRect exclusion(aOcclusions[i], aOcclusions[i + 1], aOcclusions[i + 2],
+                      aOcclusions[i + 3]);
+    exclusion.MoveBy(CSSPoint::FromAppUnits(offset));
+    occlusions.AppendElement(
+        LayoutDeviceIntRect::RoundOut(exclusion * pc->CSSToDevPixelScale()));
+  }
+  *aResult =
+      widget->UpdateWinUIPane(rect, aVisible, aFocus, aBackwards, occlusions);
+  return NS_OK;
+}
