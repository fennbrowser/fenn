+// The endpoint's identity as chrome JavaScript sees it: the same formatting
+// nsIBaseWindow::nativeHandle uses, so a window can match the notification to
+// its own HWND without a new interface.
+static nsPrintfCString EndpointName(HWND aWindow) {
+  return nsPrintfCString("0x%p", aWindow);
+}
+
+// The pane's wakeup. Called on the main thread, usually from inside a XAML
+// callback, so it may only *post*: entering browser JavaScript from this stack
+// is exactly the reentrancy the request path exists to avoid. Returning false
+// tells the pane the wakeup did not happen, so a later request schedules a
+// fresh one instead of waiting for one that will never arrive.
+static BOOL WINAPI NotifyWinUIPaneDrain(void* aContext) {
+  if (!NS_IsMainThread() || sPaneStopped) return FALSE;
+  HWND window = static_cast<HWND>(aContext);
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "mozilla::widget::WinUIPaneDrain", [window]() {
+        if (sPaneStopped) return;
+        nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+        if (!observers) return;
+        // Keep custom-element reactions and mutation observers inside one
+        // browser command turn (an empty new group must survive until filled).
+        nsAutoMicroTask microtask;
+        observers->NotifyObservers(
+            nullptr, "winui-pane-drain",
+            NS_ConvertUTF8toUTF16(EndpointName(window)).get());
+      }));
+  return NS_SUCCEEDED(rv) ? TRUE : FALSE;
+}
+
+bool DrainWinUIRequests(HWND aWindow, nsAString& aBatch) {
+  aBatch.Truncate();
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.drainRequests)
+    return false;
+  auto output = mozilla::MakeUnique<wchar_t[]>(262144);
+  output[0] = 0;
+  HRESULT hr = sPaneApi.drainRequests(aWindow, output.get(), 262144);
+  if (FAILED(hr)) return false;
+  aBatch.Assign(reinterpret_cast<const char16_t*>(output.get()));
+  return true;
+}
+
+bool CompleteWinUIRequests(HWND aWindow, const nsAString& aOutcomes) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess() || sPaneStopped ||
+      !sPaneApi.completeRequests || aOutcomes.Length() > 1048576)
+    return false;
+  nsAutoString outcomes(aOutcomes);
+  return SUCCEEDED(sPaneApi.completeRequests(aWindow, outcomes.get()));
+}
