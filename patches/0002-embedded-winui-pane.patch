+// Presentation adapter for Firefox-owned address-bar controls. No browser policy lives here.
+export class WinUIOmnibarActions {
+  constructor(toolbar) {
+    this.toolbar = toolbar;
+    this.window = toolbar.window;
+    this.entries = new Map();
+    this.images = new Map();
+    this.loads = new Set();
+    this.nextId = 0;
+    this.events = new WeakSet();
+    this.closed = false;
+    this.invalidate = () => { if (!this.closed) toolbar.owner.invalidateAddress(); };
+    this.observer = new this.window.MutationObserver(this.invalidate);
+    this.observer.observe(this.window.gURLBar, {subtree:true, childList:true, characterData:true, attributes:true});
+    this.theme = this.window.matchMedia('(prefers-color-scheme: dark)');
+    this.theme.addEventListener('change', this.invalidate);
+    this.contrast = this.window.matchMedia('(forced-colors: active)');
+    this.contrast.addEventListener('change', this.invalidate);
+    this.window.addEventListener('resize', this.invalidate);
+    this.originalInput = event => this.onOriginalInput(event);
+    this.window.addEventListener('click', this.originalInput, true);
+    this.window.addEventListener('keydown', this.originalInput, true);
+    this.observer.observe(this.window.document.documentElement, {attributes:true,attributeFilter:['lwtheme','lwt-textcolor','style']});
+  }
+  onOriginalInput(event) {
+    if (event.isTrusted && !this.events.has(event)) {
+      for (const entry of this.entries.values()) entry.pending = false;
+    }
+  }
+  context() {
+    return this.window.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal?.innerWindowId;
+  }
