+    if (!menu || this.modeDirty || menu.generation !== this.modeGeneration) return null;
+    return {generation:menu.generation, applied:this.modeApplied, active:menu.active,
+      label:menu.label, symbol:menu.symbol, buttonLabel:menu.buttonLabel, exitLabel:menu.exitLabel,
+      image:menu.rows.at(-1).image || null,
+      entries:menu.rows.slice(0,-1).map(({id,label,symbol,local,image}) =>
+        ({id,label,symbol,local,image:image || null}))};
+  }
+
+  async selectNativeMode(request) {
