+    if(!this.current(state)) {this.close();return;}
+    const fresh=panel && [...panel.querySelectorAll('panel-item')].find(item=>
+      !item.disabled && !item.hidden && !item.querySelector('panel-list') && key(item)===wanted);
+    try {
+      if(fresh) s.input.view.activateNativeResultMenu(state.result,fresh,
+        new s.window.MouseEvent('click',{bubbles:true,view:s.window,button:0}));
+    } finally {this.close();}
+  }
+  execute(request) {
+    const s=this.session, state=this.state;
+    if (request.version !== 1 || request.session !== s.sessionId || !state || request.generation!==this.generation || request.resultId!==state.id ||
