@@ -5,6 +5,116 @@
 var TabContextMenu = {
   contextTab: null,
 
+  // Shared by DOM and native menu adapters. An unselected background target
+  // acts on itself; a multiselected target acts on Firefox's selected set.
+  // Copy the set so commands that mutate it retain their original targets.
+  getCommandTabs(contextTab) {
+    return contextTab.multiselected
+      ? Array.from(gBrowser.selectedTabs)
+      : [contextTab];
+  },
+
+  // DOM-independent description for the core native menu. Browser state and
+  // command implementations stay here; the native renderer sees only labels
+  // and opaque IDs. Dynamic integrations are added in later milestones.
+  describeCoreCommands(tab) {
+    const tabs = this.getCommandTabs(tab);
+    const multi = tab.multiselected;
+    const count = tabs.length;
+    const valid = !gDialogBox.isOpen && tabs.every(t => t.isConnected && !t.closing && !t.hidden &&
+      !t._pendingPermitUnload && t.linkedBrowser);
+    if (!count || tabs.some(t => !t.linkedBrowser)) return [];
+    const command = (id, resource, enabled = true, tabCount = count) =>
+      ({ kind: "command", id, resource, enabled: valid && enabled, tabCount });
