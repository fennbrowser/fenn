+    s.resultMenuSnapshot={generation,editId:s.editId,resultId:state.id,items};
+    s.changed();
+  }
+  async activate(state, node, generation) {
+    const s=this.session;
+    const key=item => JSON.stringify([item.dataset.command, item.dataset.openIn,
+      item.dataset.usercontextid, item.getAttribute('data-l10n-id')]);
