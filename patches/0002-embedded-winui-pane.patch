+    items.push({ kind: "separator" },
+      command("container-add", label("user-context-add-container")),
+      command("container-manage", label("user-context-manage-containers")));
+    return { items };
+  },
+
+  async prepareContainerMenu(publication) {
+    const images = new Map();
+    const visit = async items => Promise.all(items.map(async item => {
+      if (item.items) return { ...item, items: await visit(item.items) };
+      if (!item.containerIcon) return item;
+      const url = ContextualIdentityService.getContainerIconURL(item.containerIcon);
+      if (!url) return item;
+      const key = `${url}:${item.containerColorName}`;
+      if (!images.has(key)) images.set(key, this.renderContainerMenuIcon(url, item.containerColorName));
+      return { ...item, image: await images.get(key) };
+    }));
+    return { ...publication, menu: { ...publication.menu, items: await visit(publication.menu.items) } };
+  },
+
+  async renderContainerMenuIcon(url, colorName) {
+    // Only ContextualIdentityService's packaged resource URLs reach this method.
+    // Gecko selects the SVG's Nova/Proton variant; native never loads a URL.
+    const image = new window.Image();
+    let probe;
+    try {
+      image.src = url;
+      await image.decode();
+      probe = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+      probe.className = `identity-color-${colorName}`;
+      probe.style.cssText = "position:fixed;visibility:hidden;color:var(--identity-fill-color,var(--identity-icon-color));";
+      document.documentElement.append(probe);
+      const color = window.getComputedStyle(probe).color;
+      const canvas = document.createElementNS("http://www.w3.org/1999/xhtml", "canvas");
+      canvas.width = canvas.height = 32;
+      const ctx = canvas.getContext("2d");
+      const nova = Services.prefs.getBoolPref("browser.nova.enabled", false);
+      ctx.drawImage(image, nova ? 4 : 0, nova ? 4 : 0, nova ? 24 : 32, nova ? 24 : 32);
+      ctx.globalCompositeOperation = "source-in";
+      ctx.fillStyle = color;
+      ctx.fillRect(0, 0, 32, 32);
+      if (nova) {
+        ctx.globalCompositeOperation = "destination-over";
+        ctx.globalAlpha = .15;
+        ctx.beginPath(); ctx.arc(16, 16, 16, 0, Math.PI * 2); ctx.fill();
+      }
+      const rgba = ctx.getImageData(0, 0, 32, 32).data;
+      let pixels = "";
+      for (let i = 0; i < rgba.length; i += 4) {
+        const a = rgba[i + 3];
+        for (const value of [Math.round(rgba[i + 2] * a / 255),
+          Math.round(rgba[i + 1] * a / 255), Math.round(rgba[i] * a / 255), a])
+          pixels += value.toString(16).padStart(2, "0");
+      }
+      return { width: 32, height: 32, pixels };
+    } catch (error) {
+      console.error("Native container icon decode failed", error);
+      return null;
+    } finally {
+      probe?.remove();
+      image.src = "";
+    }
+  },
+
+  runContainerCommand(tab, command) {
+    if (!this.describeContainerMenu(tab).items.some(item => item.id === command && item.enabled)) return;
+    const source = tab ? "tab_context_menu" : "new_tab_button";
+    if (command === "container-add") {
+      ContainerCreationPanel.open(window, source);
+    } else if (command === "container-manage") {
+      openPreferences("paneContainers", { urlParams: { entrypoint: source } });
+    } else {
+      const userContextId = Number(command.slice("container:".length));
+      if (tab) TabContextMenu.reopenTabsInContainer(TabContextMenu.getCommandTabs(tab), userContextId);
+      else openTrustedLinkIn(BROWSER_NEW_TAB_URL, "tab", {
+        userContextId, eventDetail: { containerSource: source } });
+    }
+  },
+
+  // Single-tab commands, using the same browser operations as main-popupset.js.
+  // Keep eligibility here, alongside Firefox state, never in the XAML callbacks.
+  tabCommands(tab) {
+    const pinned = tab?.pinned ? 16 : 0;
+    if (
+      !tab?.isConnected ||
+      tab.closing ||
+      tab.hidden ||
+      tab._pendingPermitUnload ||
+      !tab.linkedBrowser
+    )
+      return pinned;
+    const pin = tab.pinned
+      ? 8
+      : tab.linkedBrowser.currentURI.spec === "about:opentabs"
+        ? 0
+        : 4;
+    return 1 | 2 | pin | pinned;
+  },
+
+  runTabCommand(tab, command) {
+    if (this.processingAction) return;
+    this.processingAction = true;
+    try {
+      if (command.startsWith("container")) this.runContainerCommand(tab, command);
+      else TabContextMenu.executeCoreCommand(tab, command);
+    } finally {
+      this.processingAction = false;
+    }
+  },
+
+  // Decide the smallest publication that tells the pane what changed. A quiet
+  // window reaches this with nothing dirty and publishes nothing at all.
+  publish(force = false) {
+    if (!this.element || !this.attached || this.processingAction) return;
+    if (force || this.structuralDirty || !this.nativeRevision) {
+      this.syncTabs();
+      return;
+    }
+    // A selection change also changes the published context (active tab and
+    // multiselected set), which the list presentation binds to and which every
+    // later request is validated against.
+    if (this.dirtySelection || this.contextDirty) {
+      const tabs = this.visibleTabs();
+      const ids = tabs.map(tab => this.tabIds.get(tab));
+      // Selecting away from a collapsed group's retained active member can
+      // change tab.visible without a TabHide event. Any membership change
+      // needs an ordered snapshot, even when every tab already has an ID.
+      if (ids.length !== this.publishedIds.size || ids.some(id => !id || !this.publishedIds.has(id))) {
+        this.syncTabs();
+        return;
+      }
+      this.contextDirty = false;
+      this.publishTabContext(tabs, ids);
+    }
+    if (this.tabStrip && this.stripDirty) {
+      this.stripDirty = false;
+      this.publishStrip();
+    }
+    if (this.dirtyTitles.size || this.dirtySelection) this.publishTabDelta();
+    if (this.addressDirty) {
+      this.addressDirty = false;
+      try {
+        this.syncAddress();
+      } catch (error) {
+        // Unchanged from the interval this replaced: a failed address
+        // publication disables that surface and leaves the rest of the pane
+        // running, rather than taking the window down with it.
+        console.error("Native address synchronization failed", error);
+        this.addressSession?.close();
+        this.addressSession = null;
+        this.addressFailed = true;
+        try {
+          window.windowUtils.syncWinUIAddress(
+            JSON.stringify({ version: 1, enabled: false })
+          );
+        } catch {}
+      }
+    }
+  },
+
+  // Anything that could change what the address publication would say. Cheap
+  // and idempotent: it sets a flag and asks for the frame that is already
+  // coming, so callers do not have to know whether a change is real.
+  invalidateAddress() {
+    this.addressDirty = true;
+    this.schedule();
+  },
+
+  visibleTabs() {
+    return Array.from(gBrowser.tabs).filter(
+      tab => !tab.closing && !tab.hidden && (!this.tabStrip || tab.visible)
+    );
+  },
+
+  // One tab's title, or the active tab, applied without rebuilding anything.
+  // The delta names the revision it was computed against; a refusal means the
+  // two sides diverged and is answered with exactly one snapshot.
+  publishTabDelta() {
+    const titles = [];
+    for (const tab of this.dirtyTitles) {
+      const id = this.tabIds.get(tab);
+      if (!id || !this.publishedIds.has(id) || !tab.isConnected || tab.closing) continue;
+      titles.push({ id, title: (tab.label || "New tab").slice(0, 32768) });
+    }
+    const delta = { version: 1, base: this.nativeRevision, titles };
+    if (this.dirtySelection) {
+      const selected = this.tabIds.get(gBrowser.selectedTab) || 0;
+      delta.selected = this.publishedIds.has(selected) ? selected : 0;
+    }
+    this.dirtyTitles.clear();
+    this.dirtySelection = false;
+    if (!titles.length && delta.selected === undefined) return;
+    const revision = window.windowUtils.applyWinUITabDelta(JSON.stringify(delta));
+    if (!revision) {
+      this.syncTabs();
+      return;
+    }
+    this.nativeRevision = revision;
+  },
+
+  syncTabs() {
+    if (!this.element || !this.attached || this.processingAction) return;
+    const tabs = this.visibleTabs();
+    const ids = tabs.map(tab => {
+      if (!this.tabIds.has(tab)) this.tabIds.set(tab, this.nextTabId++);
+      return this.tabIds.get(tab);
+    });
+    this.publishedIds = new Set(ids);
+    // Publish identities before syncWinUITabs can expose a new native row.
+    this.publishTabContext(tabs, ids);
+    if (this.tabStrip) this.publishStrip();
+    this.stripDirty = false;
+    const titles = tabs.map(tab => (tab.label || "New tab").slice(0, 32768));
+    const selected = this.tabIds.get(gBrowser.selectedTab) || 0;
+    // Since ABI v14 this publishes and nothing more: close, new tab and every
+    // other native intent arrive as drained requests.
+    this.nativeRevision = window.windowUtils.syncWinUITabs(
+      ids,
+      titles,
+      tabs.map(tab => this.tabCommands(tab)),
+      ids.includes(selected) ? selected : 0
+    );
+    // This snapshot is authoritative for everything recorded so far.
+    this.dirtyTitles.clear();
+    this.dirtySelection = false;
+    this.contextDirty = false;
+    this.structuralDirty = false;
+  },
+
+  // Close one tab, drained from the request queue. Firefox owns beforeunload
+  // prompts, undo-close state, final-tab behaviour and successor selection;
+  // this never selects a background tab just to close it.
+  executeCloseRequest(action) {
+    const tab = this.resolveStripTab(action?.tab);
+    if (!tab) return 2;
+    // The pane holds this close as outstanding until an outcome answers it,
+    // and a cancelled close changes no tab state to trigger a snapshot. Ask
+    // for one explicitly, or the pane would refuse the user's next close of
+    // the same tab forever.
+    this.structuralDirty = true;
+    // permitUnload spins a nested event loop. A repeated native request must
+    // not reenter removeTab and bypass the confirmation already in progress.
+    if (tab._pendingPermitUnload) return 2;
+    this.processingAction = true;
+    try {
+      gBrowser.removeTab(tab, { animate: true });
+    } finally {
+      this.processingAction = false;
+    }
+    return 1;
+  },
+
+  // Use the same command as Ctrl+T: Firefox owns the new-tab URL, selection,
+  // notifications, policies and address-bar focus. Rows arrive via tab events.
+  executeNewTabRequest() {
+    this.structuralDirty = true;
+    BrowserCommands.openTab();
+    return 1;
+  },
+
+  observe(subject, topic, data) {
+    if (topic.startsWith("contextual-identity-") || data === "privacy.userContext.enabled" ||
+        data === "browser.nova.enabled") {
+      this.stripDirty = this.contextDirty = true;
+      this.schedule();
+      return;
+    }
+    if (topic === "nsPref:changed" && this.groupingPrefs.includes(data)) {
+      this.stripDirty = true;
+      this.schedule();
+      return;
+    }
+    if (topic === "winui-pane-drain") {
+      // One wakeup, one drain. Other windows' endpoints are ignored.
+      if (this.element && data === this.endpoint) this.drain();
+      return;
+    }
+    if (topic === "intl:app-locales-changed") {
+      // Every cached label is stale. Replace the bundle and the label cache,
+      // and force the next publication so the native side discards the
+      // description it is holding -- the session itself (and its revision
+      // sequence) is kept, since replacing it would move the revision
+      // backwards and the pane would ignore the new state.
+      this.tabMenuLabelCache = null;
+      if (this.tabMenuL10n) {
+        this.tabMenuL10n = new Localization(
+          ["browser/tabContextMenu.ftl", "browser/tabbrowser.ftl", "browser/toolbarContextMenu.ftl"], true);
+      }
+      if (this.tabMenuSession) this.tabMenuSession.forceUpdate = true;
+      this.stripDirty = true;
+      this.structuralDirty = true;
+      this.schedule();
+      return;
+    }
+    if (data === this.stripPref) {
+      this.uninit();
+      this.init();
+      return;
+    }
+    if (data === this.stripHeightPref) {
+      if (this.tabStrip && this.element) {
+        const requested = Services.prefs.getIntPref(this.stripHeightPref, 40);
+        const height = [32, 40, 48].includes(requested) ? requested : 40;
+        this.element.style.height = this.element.style.minHeight = `${height}px`;
+        this.schedule();
+      }
+      return;
+    }
+    if (data === this.addressPref) {
+      // Turning the surface on or off changes what the next publication says,
+      // including the one that tells native to hide it.
+      this.invalidateAddress();
+      return;
+    }
+    if (!Services.prefs.getBoolPref(this.pref, false)) {
+      this.update();
+      this.uninit();
+    }
+  },
+
+  handleEvent(event) {
+    if (event.type == "keydown") {
+      this.backwards = event.shiftKey;
+      return;
+    }
+    if (this.windowEvents.includes(event.type) ||
+        event.target === this.urlbarInput) {
+      this.invalidateAddress();
+      if (this.windowEvents.includes(event.type)) return;
+    }
+    // Record what changed, at the producer, so the publication below can be a
+    // delta instead of a rebuilt description of every tab.
+    if (event.type === "TabSelect") {
+      this.dirtySelection = true;
+    } else if (event.type === "TabMultiSelect") {
+      this.stripDirty = true;
+      // The tab set and its order are unchanged; only which tabs are selected.
+      this.contextDirty = true;
+    } else if (event.type === "TabAttrModified") {
+      if (event.detail?.changed?.includes("label")) this.dirtyTitles.add(event.target);
+      // Titles and selection have their own incremental path. Only attributes
+      // actually read by describeStrip need metadata publication.
+      const changed = event.detail?.changed;
+      if (!changed || changed.some(name =>
+        ["image", "busy", "muted", "soundplaying", "pinned", "usercontextid"].includes(name)))
+        this.stripDirty = true;
+    } else if (this.tabEvents.includes(event.type)) {
+      // Open, close, move, hide, show, pin, unpin: the tab set or its order
+      // changed, which needs a snapshot rather than a delta.
+      this.structuralDirty = true;
+      this.stripDirty = true;
+    } else if (this.stripStateEvents.includes(event.type)) {
+      // Group and split-view state. A collapse or a regrouping changes which
+      // tabs are visible and in what order, so it needs a snapshot; a group's
+      // name or a split-view pairing only changes what a row says.
+      this.stripDirty = true;
+      if (this.stripStructuralEvents.has(event.type)) this.structuralDirty = true;
+    }
+    if (event.type == "popupshown") {
+      this.popups.add(event.target);
+      this.observer.observe(event.target);
+      this.update();
+    }
+    if (event.type == "popuphidden") {
+      this.popups.delete(event.target);
+      this.observer.unobserve(event.target);
+      this.update();
+    }
+    this.schedule();
+  },
+
+  schedule() {
+    if (!this.frame && this.element) {
+      this.frame = requestAnimationFrame(() => {
+        this.frame = 0;
+        this.update();
+      });
+    }
+  },
+
+  occlusions(rect) {
+    // XUL panels and menus have their own native popup windows. Windows
+    // composites them above the intact island, including transparent corners.
+    // Only the in-window HTML URL view needs a native exclusion.
+    const overlays = [];
+    if (this.urlbar.hasAttribute("open")) overlays.push(this.urlbarPanel);
+    return overlays
+      .filter(element => element.isConnected)
+      .flatMap(element => {
+        const popup = element.getBoundingClientRect();
+        const left = Math.max(rect.left, popup.left);
+        const top = Math.max(rect.top, popup.top);
+        const right = Math.min(rect.right, popup.right);
+        const bottom = Math.min(rect.bottom, popup.bottom);
+        return popup.width > 0 &&
+          popup.height > 0 &&
+          right > left &&
+          bottom > top
+          ? [left, top, right - left, bottom - top]
+          : [];
+      });
+  },
+
+  update(focus = false) {
+    if (!this.element) return;
+    const hidden = window.fullScreen || !!document.fullscreenElement;
+    this.element.style.display = hidden ? "none" : "";
+    const r = this.element.getBoundingClientRect();
+    try {
+      const ok = window.windowUtils.updateWinUIPane(
+        r.x,
+        r.y,
+        r.width,
+        r.height,
+        !hidden && r.width > 0 && r.height > 0,
+        focus,
+        this.backwards,
+        this.occlusions(r)
+      );
+      this.attached = ok;
+      if (!ok) this.uninit();
+      else this.publish();
+      // Geometry/visibility work often runs right after a modal dialog closes,
+      // which is the natural moment to tell the pane it may proceed again.
+      if (this.blocked && !gDialogBox.isOpen && !this.processingAction)
+        this.setBlocked(false);
+    } catch (error) {
+      console.error("WinUI pane attachment failed", error);
+      this.uninit();
+    }
+  },
+
+  uninit() {
+    if (!this.element) return;
+    if (this.unblockTimer) window.clearTimeout(this.unblockTimer);
+    this.unblockTimer = 0;
+    this.blocked = false;
+    this.draining = false;
+    this.nativeRevision = 0;
+    this.dirtyTitles.clear();
+    this.dirtySelection = false;
+    this.structuralDirty = true;
+    this.publishedIds = new Set();
+    try {
+      Services.obs.removeObserver(this, "winui-pane-drain");
+      Services.obs.removeObserver(this, "intl:app-locales-changed");
+      for (const topic of ["created", "updated", "deleted", "reordered", "service-load-finished"])
+        Services.obs.removeObserver(this, `contextual-identity-${topic}`);
+    } catch {}
+    this.addressSession?.close();
+    this.addressSession = null;
+    this.tabMenuSession = null;
+    this.stripSession = null;
+    this.tabMenuL10n = null;
+    this.tabMenuLabelCache = null;
+    for (const type of this.tabEvents)
+      gBrowser.tabContainer.removeEventListener(type, this);
+    // Unconditional: the strip pref can have been flipped since init(), and
+    // removing a listener that was never added is a no-op.
+    for (const type of this.stripStateEvents)
+      gBrowser.tabContainer.removeEventListener(type, this);
+    for (const type of this.windowEvents)
+      window.removeEventListener(type, this, true);
+    if (this.urlbarInput) {
+      for (const type of ["input", "focus", "blur"])
+        this.urlbarInput.removeEventListener(type, this, true);
+      this.urlbarInput = null;
+    }
+    if (this.attached) {
+      try {
+        window.windowUtils.updateWinUIPane(0, 0, 0, 0, false, false, false, []);
+      } catch {}
+    }
+    this.attached = false;
+    cancelAnimationFrame(this.frame);
+    this.frame = 0;
+    this.observer.disconnect();
+    this.mutation.disconnect();
+    for (let type of this.events) {
+      window.removeEventListener(type, this, true);
+    }
+    for (const query of this.groupColorMedia || []) query.removeEventListener("change", this.groupColorChanged);
+    this.groupColorMedia = null;
+    this.groupColorChanged = null;
+    Services.prefs.removeObserver(this.pref, this);
+    Services.prefs.removeObserver(this.stripPref, this);
+    Services.prefs.removeObserver(this.stripHeightPref, this);
+    for (const pref of this.groupingPrefs) Services.prefs.removeObserver(pref, this);
+    Services.prefs.removeObserver(this.addressPref, this);
+    Services.prefs.removeObserver("privacy.userContext.enabled", this);
+    Services.prefs.removeObserver("browser.nova.enabled", this);
+    this.element.remove();
+    this.element = null;
+    this.popups.clear();
+    this.urlbar = null;
+    this.urlbarPanel = null;
+  },
+};
+
+window.addEventListener("load", () => gWinUIPane.init(), { once: true });
+window.addEventListener("unload", () => gWinUIPane.uninit(), { once: true });
diff --git a/widget/windows/WinUIPaneApi.h b/widget/windows/WinUIPaneApi.h
new file mode 100644
index 0000000000..6c9c6f54a5
--- /dev/null
+++ b/widget/windows/WinUIPaneApi.h
@@ -0,0 +1,126 @@
+#pragma once
+#include <windows.h>
+#include <stdint.h>
+
+// Owning-thread HWND marker: while present, Windows App SDK owns caption
+// button input and Gecko must not redirect non-client presses to DOM buttons.
+#define WINUI_PANE_SYSTEM_CAPTION_PROPERTY L"FirefoxWinUIPane.SystemCaption.1"
+
+// v14 puts the last two commands -- close and new tab -- on the v11 request
+// path. syncTabs therefore drains nothing: it loses its close/new-tab
+// out-parameters and the reserved context/command pair with them, keeping only
+// the presentation-model revision. No call in this ABI drains anything, and
+// nothing in the shell polls.
+// v13 put the address surface's own intents on the v11 request path as well,
+// including the visibility of its rows -- the one thing about it that no
+// browser event reports. syncAddress therefore returns nothing and loses its
+// output buffer, and no entry point in this ABI is asked whether it has work.
+// v12 put the TabView strip's own gestures (group toggle, reorder, detach,
+// adopt) on the v11 request path, so syncTabMenu no longer returns anything and
+// loses its output buffer: it is now a publication only, and nothing in the
+// pane's protocol has to be asked whether it has work.
+// v11 added the event-driven request path (setNotifySink / drainRequests /
+// completeRequests) and incremental tab deltas (applyTabDelta), and retired
+// syncTabs' selection out-parameter. v10 added an explicit strip-only host,
+// retaining the sidebar entry point.
+#define WINUI_PANE_ABI_VERSION 14u
+
+// All calls run on the browser's owning STA. Coordinates are client physical
+// pixels. The module remains loaded until process exit, including after shutdown.
+// Legacy availability bits for tab snapshots and invalidation. Menu action IDs
+// are opaque strings in the published state; native code assigns no command
+// semantics.
+enum WinUITabCommand : uint32_t {
+    WinUITabReload = 1u, WinUITabDuplicate = 2u,
+    WinUITabPin = 4u, WinUITabUnpin = 8u,
+};
+constexpr uint32_t WinUITabPinned = 16u; // State, not an executable command.
+struct WinUITab {
+    uint32_t id; // Nonzero, window-local identity; never reused during a pane lifetime.
+    const wchar_t* title; // Borrowed only for the duration of syncTabs.
+    uint32_t commands{}; // Availability plus Pinned state; never both Pin and Unpin.
+};
+
+// Wakeup callback for the v11 request path. The pane calls this when, and only
+// when, its queue transitions from "nothing outstanding" to "work waiting": at
+// most one call is outstanding per endpoint until the host drains.
+//
+// It is called on the owning STA, frequently from inside a XAML callback. The
+// implementation may only *schedule* work -- post a task to the browser's own
+// event loop -- and must never run browser code on that stack. `context` is the
+// value passed to setNotifySink and is never interpreted by the pane.
+//
+// Return FALSE if the wakeup could not be scheduled (shutdown, a failed task
+// post). The pane then puts its queue back into a state where the next request
+// schedules a fresh wakeup, rather than waiting forever for one that will never
+// arrive. Returning FALSE is not an error the host must otherwise handle.
+using WinUIPaneNotifyFn = BOOL (WINAPI*)(void* context);
+
+struct WinUIPaneApi {
+    uint32_t size;
+    uint32_t version;
+    HRESULT (WINAPI* update)(HWND, const RECT*, BOOL);
+    HRESULT (WINAPI* focus)(HWND, BOOL);
+    HRESULT (WINAPI* destroy)(HWND);
+    BOOL (WINAPI* translate)(MSG*);
+    HRESULT (WINAPI* shutdown)();
+    // Copies a snapshot and drains one close or new-tab request.
+    // Since v11 the first output is the pane's presentation-model revision
+    // after this snapshot, which the next applyTabDelta must name as its base;
+    // selection travels on the request path below instead, so no command
+    // reaches Firefox through both executors. The final two outputs are
+    // reserved and always zero.
+    // Only one action is drained per snapshot; Firefox revalidates availability.
+    // A close request does not remove a row or choose a successor. The next
+    // snapshot acknowledges it: do not sync while Firefox is deciding closure.
+    // Publication only since v14; the single out-parameter is the pane's
+    // presentation-model revision after this snapshot.
+    HRESULT (WINAPI* syncTabs)(HWND, const WinUITab*, uint32_t, uint32_t, uint32_t*);
+    // Versioned JSON messages, copied during the call; output capacity is in wchar_t.
+    // Publication only since v13; intents arrive through drainRequests.
+    HRESULT (WINAPI* syncAddress)(HWND, const wchar_t*);
+    // Exclusions are pane-local physical pixels; an empty list restores the pane.
+    HRESULT (WINAPI* clip)(HWND, const RECT*, uint32_t);
+    // Menu protocol v2: published state, copied as JSON. The published state
+    // carries tab identities and the selected set only; a tab's command
+    // description is published on demand under the "menu" key, in answer to a
+    // drained menu-open request. Since v12 this returns nothing: every native
+    // intent, including the strip's own gestures, arrives through
+    // drainRequests.
+    HRESULT (WINAPI* syncTabMenu)(HWND, const wchar_t*);
+    // Same lifetime/geometry contract as update; one presentation per HWND.
+    HRESULT (WINAPI* updateTabStrip)(HWND, const RECT*, BOOL);
+
+    // --- v11: event-driven requests -------------------------------------
+    // Register (or, with a null callback, clear) the wakeup for one endpoint.
+    // Clearing is part of teardown: the pane makes no further calls afterwards.
+    HRESULT (WINAPI* setNotifySink)(HWND, WinUIPaneNotifyFn, void*);
+    // Take one bounded batch of native requests as JSON:
+    //   {"version":1,"generation":N,"legacy":bool,
+    //    "requests":[{"id":..,"kind":..,"tab":..,"revision":..,"action":{...}}]}
+    // "kind" is 1 select-tab, 2 tab-menu transition, 3 close tab, 4 new tab,
+    // 5 strip gesture, 6 address intent, 7 search-mode intent, 8 address
+    // visibility report. Every native intent appears here and nowhere else, so
+    // none of them has two executors.
+    // Returns S_FALSE with an empty output when there was nothing to take, or
+    // when a drain is already open. Every batch must be closed by
+    // completeRequests, including when execution is refused; otherwise the
+    // endpoint stays busy.
+    HRESULT (WINAPI* drainRequests)(HWND, wchar_t*, uint32_t);
+    // Close the drain with explicit per-request outcomes:
+    //   {"version":1,"generation":N,"outcomes":[{"id":..,"outcome":1..4}],
+    //    "blocked":bool}
+    // "blocked" tells the pane the host cannot execute right now (a nested
+    // modal loop, a command already running); the pane then waits for an
+    // unblocking completeRequests rather than re-posting notifications.
+    HRESULT (WINAPI* completeRequests)(HWND, const wchar_t*);
+    // Apply an incremental presentation update:
+    //   {"version":1,"base":R,"selected":id?,"titles":[{"id":..,"title":".."}]}
+    // "base" must equal the pane's current model revision; the out-parameter
+    // receives the revision after applying, for the next delta's base.
+    // E_NOT_VALID_STATE means the producer and the pane have diverged: answer
+    // with one syncTabs snapshot, never with a retry loop. S_FALSE means the
+    // delta applied but the pane wants a snapshot for an unrelated reason.
+    HRESULT (WINAPI* applyTabDelta)(HWND, const wchar_t*, uint32_t*);
+};
+using WinUIPaneGetApiFn = HRESULT (WINAPI*)(uint32_t, uint32_t, WinUIPaneApi*);
