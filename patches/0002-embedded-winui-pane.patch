+// Opt-in History root. Firefox owns data, navigation policy and commands.
+export class WinUIHistoryMenu {
+  constructor(toolbar) {
+    this.toolbar=toolbar;this.session=0;this.lastSession=0;this.actions=new Map();
+    this.preferenceChanged=()=>{if(!this.enabled && this.session)this.dismiss();else toolbar.owner.invalidateAddress();};
+    Services.prefs.addObserver("widget.windows.winui-prototype.navigation.history.menu.enabled",this.preferenceChanged);
+  }
+  close() {this.dismiss();Services.prefs.removeObserver("widget.windows.winui-prototype.navigation.history.menu.enabled",this.preferenceChanged);}
+  get enabled() { return Services.prefs.getBoolPref("widget.windows.winui-prototype.navigation.history.menu.enabled",false); }
+  snapshot() {
+    if(this.session && (!this.enabled || !this.toolbar.active || this.toolbar.customization?.editorOpen ||
+       this.context?.tab!==this.toolbar.owner.addressTab || this.context?.document!==this.toolbar.owner.addressDocument))this.dismiss();
+    return {enabled:this.enabled,closed:this.closed || 0,...(this.description || {})};
+  }
+  dismiss() {
+    if(this.session)this.closed=this.session;
+    this.session=0;this.description=null;this.actions.clear();
+    if(this.root){this.root.containerOpen=false;this.root=null;}this.result=null;
+    this.toolbar.owner.invalidateAddress();
+  }
+  async open(session,bounds) {
+    this.dismiss();this.session=session;this.bounds=bounds;
+    this.context={tab:this.toolbar.owner.addressTab,document:this.toolbar.owner.addressDocument};
+    const {window,owner}=this.toolbar;
+    const messages=await window.document.l10n.formatMessages([
+      {id:"appmenu-search-history"},{id:"appmenu-clear-history"},{id:"appmenu-manage-history"}]);
+    if(this.session!==session || !this.enabled || !this.toolbar.active)return;
+    const label=m=>m.attributes?.find(a=>a.name==="label")?.value || m.value;
+    const labels=messages.map(label);
+    if(labels.some(v=>!v))throw new Error("Missing History menu localization");
+    const {PlacesUtils}=ChromeUtils.importESModule("resource://gre/modules/PlacesUtils.sys.mjs");
+    const query=PlacesUtils.history.getNewQuery(), options=PlacesUtils.history.getNewQueryOptions();
+    options.queryType=Ci.nsINavHistoryQueryOptions.QUERY_TYPE_HISTORY;
+    options.sortingMode=Ci.nsINavHistoryQueryOptions.SORT_BY_DATE_DESCENDING;
+    options.maxResults=42;options.excludeQueries=true;
+    this.result=PlacesUtils.history.executeQuery(query,options);this.root=this.result.root;this.root.containerOpen=true;
+    const items=[];let id=0;
+    const add=(text,action)=>{const key=++id;this.actions.set(key,action);items.push({id:key,label:String(text).slice(0,128),enabled:true,navigable:action.kind==="visit"});};
+    add(labels[0],{kind:"search"});add(labels[1],{kind:"clear"});
+    items.push({separator:true});
+    for(let i=0;i<this.root.childCount;i++) {const node=this.root.getChild(i);add(node.title || node.uri,{kind:"visit",node,uri:node.uri});}
+    if(!this.root.childCount)items.push({id:++id,label:owner.localization().formatValueSync("winui-history-empty"),enabled:false});
+    items.push({separator:true});add(labels[2],{kind:"manage"});
+    add(owner.localization().formatValueSync("winui-history-open-firefox"),{kind:"original"});
+    this.description={session,revision:1,items};owner.invalidateAddress();
+  }
+  execute(action) {
+    const m=/^history-menu:(open|dismiss|invoke|middle):([1-9][0-9]*)(?::([1-9][0-9]*):([1-9][0-9]*))?$/.exec(action.command);
+    if(!m || !this.enabled)return 2;
+    const session=Number(m[2]);if(!Number.isSafeInteger(session) || session>0xffffffff)return 2;
+    if(m[1]==="open") {
+      if(session<=this.lastSession || m[3] || !this.toolbar.menuAnchor("history",action))return 2;
+      this.lastSession=session;
+      this.open(session,action).catch(error=>{
+        if(this.session===session){
+          if(this.root){this.root.containerOpen=false;this.root=null;}this.result=null;
+          this.actions.clear();this.actions.set(1,{kind:"original"});
+          this.description={session,revision:1,items:[{id:1,label:this.toolbar.owner.localization().formatValueSync("winui-history-open-firefox"),enabled:true}]};
+          this.toolbar.owner.invalidateAddress();
+        }
+        console.error(error);
+      });return 1;
+    }
+    if(session!==this.session)return 2;
+    if(m[1]==="dismiss"){if(m[3])return 2;this.dismiss();return 1;}
+    if(Number(m[3])!==this.description?.revision)return 2;
+    const entry=this.actions.get(Number(m[4]));if(!entry || (m[1]==="middle" && entry.kind!=="visit"))return 2;
+    const {window}=this.toolbar, bounds=this.bounds;
+    const event=new window.MouseEvent("click",{view:window,button:m[1]==="middle"?1:0,ctrlKey:!!(action.modifiers&1),altKey:!!(action.modifiers&2),shiftKey:!!(action.modifiers&4),metaKey:!!(action.modifiers&8)});
+    if(entry.kind==="visit") {
+      // Retained result nodes are live. Deletion or replacement invalidates the action.
+      if(!this.root || entry.node.parent!==this.root || entry.node.uri!==entry.uri){this.dismiss();return 2;}
+      const {BrowserUtils}=ChromeUtils.importESModule("resource://gre/modules/BrowserUtils.sys.mjs");
+      window.PlacesUIUtils.openNodeIn(entry.node,BrowserUtils.whereToOpenLink(event,false,true),{ownerWindow:window});
+      this.dismiss();return 1;
+    }
+    this.dismiss();
+    if(entry.kind==="search")window.PlacesCommandHook.searchHistory();
+    else if(entry.kind==="clear")window.Sanitizer.showUI(window);
+    else if(entry.kind==="manage")window.PlacesCommandHook.showPlacesOrganizer("History");
+    else if(entry.kind==="original")this.toolbar.openMenu("history",bounds,event);
+    return 1;
+  }
+}
