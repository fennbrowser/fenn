+    session.changed();
+  }
+  execute(request) {
+    const s = this.session, state = this.state, win = s.window;
+    if (!request || request.version !== 1 || !["context-action", "context-close"].includes(request.kind)) return 2;
+    if (request.generation !== this.generation || !state || request.session !== s.sessionId) return 2;
+    // A close request can carry an edit just like activation. Validate its
+    // document before accepting text, even if outer session teardown is late.
+    if (s.closed || win.EditContextMenu.input !== s.input.inputField || win.gBrowser.selectedTab !== state.tab ||
+        state.document !== state.tab.linkedBrowser.browsingContext.currentWindowGlobal?.innerWindowId) {
+      this.close();
+      return 2;
+    }
+    if (request.kind === "context-close") {
+      // Closing can overtake TextChanged (Undo/Redo/Delete). The request carries
+      // that edit, so acknowledge it before revoking this menu opening.
+      const result = s.syncNativeSelection(request);
