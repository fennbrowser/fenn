+static BOOL WINAPI NotifyWinUIPaneDrain(void* aContext) {
+  if (!NS_IsMainThread() || sPaneStopped) return FALSE;
+  HWND window = static_cast<HWND>(aContext);
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "mozilla::widget::WinUIPaneDrain", [window]() {
+        if (sPaneStopped) return;
+        nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+        if (!observers) return;
