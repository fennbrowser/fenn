+void InitializeWinUIRuntime() {
+  // Every lane uses the shared Microsoft.WindowsAppRuntime.2 framework. A
+  // packaged Firefox has it in its package graph; an unpackaged one joins it
+  // here, before the pane or WindowsUIUtils loads any Windows App SDK DLL, so
+  // that every such DLL comes from one runtime. On failure the pane cannot
+  // start and Firefox keeps its own UI.
+  static bool sAttempted = false;
+  if (sAttempted || !XRE_IsParentProcess()) return;
+  sAttempted = true;
+  UINT32 length = 0;
+  if (GetCurrentPackageFullName(&length, nullptr) != APPMODEL_ERROR_NO_PACKAGE) {
+    return;
+  }
+  wchar_t path[32768];
+  DWORD pathLength = GetModuleFileNameW(nullptr, path, std::size(path));
+  wchar_t* separator = pathLength && pathLength < std::size(path)
+                           ? wcsrchr(path, L'\\')
+                           : nullptr;
+  constexpr wchar_t bootstrap[] = WINUI_PANE_RUNTIME_BOOTSTRAP_DLL;
+  if (!separator || size_t(separator + 1 - path) + std::size(bootstrap) >
+                        std::size(path)) {
+    return;
+  }
+  wcscpy(separator + 1, bootstrap);
+  // Fixed executable-relative location, as for the pane itself.
+  HMODULE module = LoadLibraryExW(path, nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR |
+                                      LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!module) {
