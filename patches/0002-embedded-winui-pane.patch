+        // browser command turn (an empty new group must survive until filled).
+        nsAutoMicroTask microtask;
+        observers->NotifyObservers(
+            nullptr, "winui-pane-drain",
+            NS_ConvertUTF8toUTF16(EndpointName(window)).get());
