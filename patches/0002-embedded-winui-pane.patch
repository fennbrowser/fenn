+      this.consumed = true;
+      this.collapse(target, event.collapsed);
+      return true;
+    }
+    if (event.kind === "strip-reorder") {
+      // beforeId 0 means "move to the end"; any other value must still name
+      // a row in the fresh snapshot, same as the group id check above.
+      if (!Number.isSafeInteger(event.id) || !Number.isSafeInteger(event.beforeId) || event.beforeId < 0)
+        return false;
+      const current = this.describe();
+      if (this.consumed || !this.same(current, this.state)) return false;
+      const index = current.rows.findIndex(r => r.id === event.id);
+      if (index < 0) return false;
+      if (event.beforeId) {
+        if (!current.rows.some(r => r.id === event.beforeId)) return false;
+        if (current.rows[index + 1]?.id === event.beforeId) return false;
+      } else if (index === current.rows.length - 1) return false;
