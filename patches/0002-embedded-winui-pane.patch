+      if (this.consumed || event.session !== this.windowDragSession || event.revision !== this.revision ||
+          !Number.isSafeInteger(event.group) || event.group <= 0 ||
+          !Number.isSafeInteger(event.id) || event.id <= 0 || !this.selectGroupTab) return false;
