+      } else if (!moves && index === current.rows.length - 1) return false;
+      this.consumed = true;
+      return this.reorder(event.id, event.beforeId, ungroup, unpin) !== false;
+    }
+    if (event.kind === "strip-detach") {
+      if (!Number.isSafeInteger(event.id) || !Number.isFinite(event.screenX) || !Number.isFinite(event.screenY))
+        return false;
+      const current = this.describe();
+      if (this.consumed || !this.same(current, this.state)) return false;
+      if (!current.rows.some(r => r.id === event.id)) return false;
+      // Consume before Firefox mutates state or enters any nested browser work.
+      this.consumed = true;
+      return this.detach(event.id, { screenX: event.screenX, screenY: event.screenY }) !== false;
+    }
+    if (event.kind === "strip-adopt") {
+      // Unlike the other kinds, `id` names a row in the SOURCE window's own
+      // session, not this one's -- there is no local snapshot to revalidate
+      // it against. Consume the action revision, but keep publishedRevision
+      // unchanged: the consumer has not received that new revision yet.
+      if (!Number.isSafeInteger(event.sourceHwnd) || !Number.isSafeInteger(event.id) ||
+          !Number.isSafeInteger(event.index) || event.index < 0)
+        return false;
+      if (this.revision === 0xffffffff) throw new Error("Native strip revision exhausted");
+      this.revision++;
+      this.consumed = true;
+      return this.adopt(event.sourceHwnd, event.id, event.index) !== false;
+    }
+    return false;
+  }
+}
diff --git a/browser/base/content/WinUITabMenuSession.sys.mjs b/browser/base/content/WinUITabMenuSession.sys.mjs
new file mode 100644
index 0000000000..961c3b61a4
--- /dev/null
+++ b/browser/base/content/WinUITabMenuSession.sys.mjs
@@ -0,0 +1,178 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// One current window snapshot, published before its native tabs.
+//
+// Publication carries *identities and the selected set* -- what the tab list
+// needs in order to exist -- and nothing about commands. A tab's command
+// description is produced only when that tab's menu is actually opening, which
+// is what `receive({kind: "open"})` answers. Opening establishes an input
+// session; the description is computed once, for one tab, at that moment.
+//
+// Two validity checks, deliberately different:
+//
+// * `structureCurrent` guards selection. Its prerequisites are that the tab
+//   still resolves to the same published target and the published context is
+//   unchanged. A title or favicon change does not revoke a selection.
+// * `current` guards a menu command. Its prerequisite is that this tab's whole
+//   authoritative description is still the one the user is looking at, so it
+//   re-describes that one tab and compares.
+export class WinUITabMenuSession {
+  constructor({ resolveTab, describe, execute, select = null, context = () => null }) {
+    Object.assign(this, { resolveTab, describe, execute, select, context });
+    this.lastSession = 0;
+    this.revision = 0;
+    this.tabs = new Map();
+    this.active = null;
+  }
+
+  update(targets) {
+    if (targets.size > 10000) throw new Error("Too many native menu targets");
+    const liveContext = this.context();
+    const context = JSON.stringify(liveContext);
+    const tabs = new Map();
+    const bindings = [];
+    for (const [id, target] of targets) {
+      if (!Number.isSafeInteger(id) || id < 1 || id > 0xffffffff || !target)
+        throw new Error("Invalid native menu target");
+      tabs.set(id, { target });
+      bindings.push({ tab: id, ...(Array.isArray(liveContext?.selection)
+        ? { selected: liveContext.selection.includes(id) } : {}) });
+    }
+    // The published state is small and linear in tab count: identities, order
+    // and selection. Comparing it costs one serialization, not a description of
+    // every tab, so an unchanged window publishes nothing.
+    const fingerprint = JSON.stringify(bindings);
+    if (!this.forceUpdate && context === this.contextFingerprint &&
+        fingerprint === this.tabsFingerprint) return null;
+    if (this.revision === 0xffffffff)
+      throw new Error("Native menu snapshot limit exceeded");
+    const snapshot = { version: 2, publishOnly: true,
+      state: { revision: this.revision + 1, tabs: bindings } };
+    if (JSON.stringify(snapshot).length > 1048576)
+      throw new Error("Native menu snapshot is too large");
+    this.revision++;
+    this.forceUpdate = false;
+    this.tabs = tabs;
+    this.contextFingerprint = context;
+    this.tabsFingerprint = fingerprint;
+    // A new publication invalidates any open menu's description, so the native
+    // side discards what it cached and any answer still in flight.
+    this.active = null;
+    return snapshot;
+  }
+
+  snapshot() {
+    const result = { version: 2 };
+    if (this.revoke) {
+      result.revoke = this.revoke;
+      this.revoke = 0;
+    }
+    return result;
+  }
+
+  // The description to publish for the menu that is currently opening, or null
+  // when nothing is open. Bound to the opening request, so a native side that
+  // has since dismissed, retargeted or been torn down can reject it.
+  menuPublication() {
+    if (!this.active) return null;
+    return { version: 2, publishOnly: true, menu: {
+      session: this.active.session, tab: this.active.tab,
+      revision: this.active.revision, items: this.active.record.items } };
+  }
+
+  // Semantic prerequisites for acting on a tab identity: it still names the
+  // same live, published target, and the published context is unchanged.
+  structureCurrent(id, record) {
+    return !!record && this.resolveTab(id) === record.target &&
+      JSON.stringify(this.context()) === this.contextFingerprint;
+  }
+
+  // Prerequisites for running a command the user is looking at: everything
+  // above, plus this tab's description still being the displayed one. One tab
+  // is described here, never the whole window.
+  current(id, record) {
+    return this.structureCurrent(id, record) &&
+      JSON.stringify(this.describe(record.target, record.surface)) === record.fingerprint;
+  }
+
+  // Re-check an open menu against current browser state. Called when something
+  // relevant changed while a menu is open, which is the only time a description
+  // is worth producing outside an opening. Returns true if the session was
+  // revoked, so the caller can publish the revocation.
+  revalidateActive() {
+    const active = this.active;
+    if (!active) return false;
+    if (this.current(active.tab, active.record)) return false;
+    this.revoke = active.session;
+    this.active = null;
+    return true;
+  }
+
+  receive(event) {
+    if (event?.kind === "selection") {
+      if (!this.select || this.active || event.revision !== this.revision ||
+          (event.control !== undefined && typeof event.control !== "boolean") ||
+          (event.shift !== undefined && typeof event.shift !== "boolean") ||
+          !Array.isArray(event.tabs) || !event.tabs.length || event.tabs.length > 10000 ||
+          new Set(event.tabs).size !== event.tabs.length || !event.tabs.includes(event.tab) ||
+          !event.tabs.every(id => Number.isSafeInteger(id) &&
+            this.structureCurrent(id, this.tabs.get(id))))
+        return false;
+      this.select(this.resolveTab(event.tab), event.tabs.map(id => this.resolveTab(id)), event);
+      return true;
+    }
+    if (!event || !Number.isSafeInteger(event.session) || event.session < 1 ||
+        event.session > 0xffffffff || !Number.isSafeInteger(event.tab) ||
+        event.tab < 1 || event.tab > 0xffffffff) return false;
+    if (event.kind === "open") {
+      if (event.surface !== undefined && !["tab", "new-tab", "tab-bar"].includes(event.surface)) return false;
+      if (event.session <= this.lastSession) return false;
+      this.lastSession = event.session;
+      const record = this.tabs.get(event.tab);
+      this.active = null;
+      if (event.revision !== this.revision || !this.structureCurrent(event.tab, record)) {
+        this.revoke = event.session;
+        return false;
+      }
+      // The one description this window produces, for the one tab whose menu is
+      // opening. Nothing else is described, now or on a timer.
+      const surface = event.surface || "tab";
+      const description = this.describe(record.target, surface);
+      this.active = { session: event.session, tab: event.tab,
+        revision: this.revision,
+        record: { target: record.target, surface, items: description.items,
+          fingerprint: JSON.stringify(description) } };
+      return true;
+    }
+    const active = this.active;
+    if (!active || event.session !== active.session || event.tab !== active.tab) return false;
+    if (event.kind === "dismiss") {
+      this.active = null;
+      return true;
+    }
+    if (event.kind !== "activate" || typeof event.id !== "string" ||
+        event.revision !== active.revision || event.revision !== this.revision) return false;
+    // Revalidate without consuming publication state or entering browser code
+    // from XAML. A command can run only once, including during nested loops.
+    if (!this.current(active.tab, active.record)) {
+      this.revoke = active.session;
+      this.active = null;
+      return false;
+    }
+    const find = items => items.some(item => item.enabled &&
+      ((item.kind === "command" && item.id === event.id) ||
+       (item.kind === "submenu" && find(item.items))));
+    if (!find(active.record.items)) return false;
+    this.active = null;
+    try {
+      this.execute(active.record.target, event.id, active.record.surface);
+    } finally {
+      // Browser commands may spin a modal loop without changing tab state
+      // (notably a cancelled close). Revoke input queued during that command.
+      this.forceUpdate = true;
+    }
+    return true;
+  }
+}
