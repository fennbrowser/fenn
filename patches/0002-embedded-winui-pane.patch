new file mode 100644
index 0000000000..36d8ac8e91
--- /dev/null
+++ b/browser/base/content/WinUIDismissalAcknowledgments.sys.mjs
@@ -0,0 +1,86 @@
+// Presentation-only Firefox dismissal tips. Never add these to query results.
+export class WinUIDismissalAcknowledgments {
+  constructor(session) {
+    this.session = session;
+    this.entries = new Map();
+    this.serial = 0;
+  }
+  clear() { this.entries.clear(); }
+  current(entry) {
+    const s = this.session;
+    return !s.closed && s.active === entry.active && s.input.view.nativePresentation === s &&
+      s.window.gBrowser.selectedBrowser === entry.active.browser &&
+      entry.active.page === entry.active.browser.currentURI.spec &&
+      entry.document && entry.document === entry.active.browser.browsingContext.currentWindowGlobal?.innerWindowId &&
+      entry.editId === s.editId && s.input.inputField.value === entry.active.inputValue;
+  }
+  async add(result, message, index) {
+    const s = this.session, active = s.active;
+    if (!active || index < 0 || this.entries.size >= 100 ||
+        !s.nativeVisible?.includes(active.rows[index]?.id)) return;
+    const originalRow = active.rows[index];
+    index = this.decorate(active.rows).findIndex(row => row.id === originalRow.id);
+    const id = `${s.sessionId}:ack:${++this.serial}`;
+    const tip = s.input.view.createDismissalAcknowledgment(result, message);
+    const entry = {id, active, tip, index, focus:s.nativeSelected === result, editId:s.editId,
+      document:active.browser.browsingContext.currentWindowGlobal?.innerWindowId};
+    this.entries.set(id, entry);
+    let title, elements;
+    try {
+      [title, elements] = await Promise.all([
+      s.window.document.l10n.formatValue(message.id, message.args),
+      s.input.view.prepareNativeTipButtons(tip, true),
+      ]);
+    } catch (error) {
+      this.entries.delete(id);
+      throw error;
+    }
+    if (this.entries.get(id) !== entry || !this.current(entry) || !elements?.length) {
+      this.entries.delete(id); return;
+    }
+    const element = elements[0];
+    entry.element = element;
+    entry.row = {id, title:title.slice(0,1024), feedback:title.slice(0,1024), symbol:"page", imageSize:32, sectionLabel:originalRow.sectionLabel || "", focusButton:entry.focus,
+      tipButtons:[{id:`${id}:confirm`,label:(element.textContent || element.getAttribute('aria-label') || '').slice(0,1024),enabled:true}]};
+    s.sequence++;
+    s.loadNativeImage?.(active, entry.row, {icon:tip.payload.icon,size:32},
+      () => this.entries.get(id) === entry && this.current(entry));
+  }
+  decorate(rows) {
+    const result = [...rows];
+    for (const entry of [...this.entries.values()].sort((a, b) => a.index - b.index)) {
+      if (!this.current(entry)) { this.entries.delete(entry.id); continue; }
+      if (entry.row) result.splice(Math.min(entry.index,result.length),0,entry.row);
+    }
+    return result.slice(0,100);
+  }
+  hasVisibleRow(id) {
+    const entry = this.entries.get(id);
+    return !!entry?.row && this.current(entry);
+  }
+  remove(resultId) {
+    for (const entry of this.entries.values()) {
+      if (entry.tip.id !== resultId) continue;
+      this.entries.delete(entry.id);
+      for (const other of this.entries.values()) if (other.index > entry.index) other.index--;
+      this.session.sequence++;
+      return true;
+    }
+    return false;
+  }
+  activate(request) {
+    const s = this.session, entry = this.entries.get(request.id);
+    if (!entry?.row || !this.current(entry) || !s.nativeOpen || s.input.readOnly || s.window.gDialogBox?.isOpen ||
+        request.version !== 1 || request.session !== s.sessionId || request.revision !== entry.active.revision ||
+        request.actionId !== entry.row.tipButtons[0].id || !s.nativeVisible?.includes(entry.id) || entry.invoking)
