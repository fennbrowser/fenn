diff --git a/widget/windows/WinUIPrototype.cpp b/widget/windows/WinUIPrototype.cpp
new file mode 100644
index 0000000000..c6e02a8696
--- /dev/null
+++ b/widget/windows/WinUIPrototype.cpp
@@ -0,0 +1,72 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "WinUIPrototype.h"
+#include "WinUIBridgeApi.h"
+#include <objbase.h>
+#include <iterator>
+#include "mozilla/Logging.h"
+#include "mozilla/Preferences.h"
+#include "nsThreadUtils.h"
+#include "nsXULAppAPI.h"
+
+namespace mozilla::widget {
+static LazyLogModule sWinUIPrototypeLog("WinUIPrototype");
+static bool sTraceEnabled = false;  // Main-thread only; inert after enablement.
+
+void TraceWinUIPrototype(const char* aPhase, HWND aWindow) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() || !sTraceEnabled) return;
+  APTTYPE apartment = APTTYPE_CURRENT;
+  APTTYPEQUALIFIER qualifier = APTTYPEQUALIFIER_NONE;
+  const HRESULT hr = CoGetApartmentType(&apartment, &qualifier);
+  DWORD ownerProcess = 0;
+  DWORD ownerThread = aWindow ? GetWindowThreadProcessId(aWindow, &ownerProcess) : 0;
+  MOZ_LOG(sWinUIPrototypeLog, LogLevel::Info,
+          ("phase=%s pid=%lu tid=%lu hwnd=%p ownerPid=%lu ownerTid=%lu "
+           "apartmentHr=0x%08lx apartment=%d qualifier=%d "
+           "windowing=%p frameworkUdk=%p xaml=%p", aPhase,
+           GetCurrentProcessId(), GetCurrentThreadId(), aWindow, ownerProcess,
+           ownerThread, static_cast<unsigned long>(hr), static_cast<int>(apartment),
+           static_cast<int>(qualifier), GetModuleHandleW(L"Microsoft.UI.Windowing.dll"),
+           GetModuleHandleW(L"Microsoft.Internal.FrameworkUdk.dll"),
+           GetModuleHandleW(L"Microsoft.UI.Xaml.dll")));
+}
+
+void ProbeWinUIPrototype(HWND aWindow) {
+  if (!XRE_IsParentProcess() || !NS_IsMainThread() ||
+      !Preferences::GetBool("widget.windows.winui-prototype.enabled", false)) return;
+  sTraceEnabled = true;
+  TraceWinUIPrototype("window-created", aWindow);
+  // Fixed executable-relative location. Never use cwd, PATH, or a preference
+  // supplied DLL path. The bridge has only system dependencies and a static CRT.
+  wchar_t path[32768];
+  const DWORD length = GetModuleFileNameW(nullptr, path, std::size(path));
+  if (!length || length >= std::size(path)) return;
+  wchar_t* separator = wcsrchr(path, L'\\');
+  constexpr wchar_t suffix[] = L"native\\FirefoxWinUIBridge.dll";
+  if (!separator || size_t(separator + 1 - path) + std::size(suffix) > std::size(path)) return;
+  wcscpy(separator + 1, suffix);
+  HMODULE module = LoadLibraryExW(path, nullptr,
+      LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!module) {
+    MOZ_LOG(sWinUIPrototypeLog, LogLevel::Warning,
+            ("bridge=unavailable win32Error=%lu; ordinary Firefox continues", GetLastError()));
+    return;
+  }
+  const auto probe = reinterpret_cast<WinUIBridgeProbeFn>(
+      GetProcAddress(module, "WinUIBridgeProbe"));
+  WinUIBridgeInfo info{};
+  HRESULT hr = probe ? probe(aWindow, WINUI_BRIDGE_ABI_VERSION, sizeof(info), &info) : E_NOINTERFACE;
+  const bool valid = SUCCEEDED(hr) && info.size == sizeof(info) &&
+      info.abiVersion == WINUI_BRIDGE_ABI_VERSION &&
+      info.processId == GetCurrentProcessId() && info.threadId == GetCurrentThreadId();
+  MOZ_LOG(sWinUIPrototypeLog, valid ? LogLevel::Info : LogLevel::Warning,
+          ("bridge=%s hr=0x%08lx abi=%u pid=%u tid=%u apartment=%d qualifier=%d",
+           valid ? "ok" : "incompatible", static_cast<unsigned long>(hr),
+           info.abiVersion, info.processId, info.threadId, info.apartmentType,
+           info.apartmentQualifier));
+  // ABI v1 retains nothing and starts no work, so immediate unloading is safe.
+  FreeLibrary(module);
+  TraceWinUIPrototype("probe-complete", aWindow);
+}
+}  // namespace mozilla::widget
