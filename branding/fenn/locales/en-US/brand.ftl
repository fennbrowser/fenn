## Fenn and Mozilla brands
##
## Fenn and Mozilla are brands. They cannot be transliterated or
## translated, and declension should be avoided where possible, leaving
## the brand unaltered in prominent UI positions.

-brand-shorter-name = Fenn
-brand-short-name = Fenn
-brand-shortcut-name = Fenn
-brand-full-name = Fenn
# The product name where it must stay the same across release channels.
-brand-product-name = Fenn
# Fenn keeps Mozilla as the vendor here: strings using this term name Mozilla's
# own services and policies (accounts, privacy notices), which Fenn still uses.
-vendor-short-name = Mozilla
trademarkInfo = { " " }
