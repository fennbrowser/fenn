<?xml version="1.0" encoding="utf-8"?>
<!-- Re-indexes upstream's prebuilt MSIX Resources.pri under this package's identity.
     makepri takes the map name from the manifest passed with /mn. The PRI indexer
     merges nothing on its own; it needs the folder indexer beside it. The source
     folder holds only upstream's PRI, so the folder indexer adds no files. -->
<resources targetOsVersion="10.0.0" majorVersion="1">
  <index root="\" startIndexAt="\">
    <default><qualifier name="Language" value="en-US"/></default>
    <indexer-config type="folder" foldernameAsQualifier="true" filenameAsQualifier="true" qualifierDelimiter="."/>
    <indexer-config type="PRI"/>
  </index>
</resources>
